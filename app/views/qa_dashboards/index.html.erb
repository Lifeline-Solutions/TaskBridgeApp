<div class="max-w-7xl mx-auto px-4 py-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">QA Dashboards</h1>
    <%= link_to new_qa_dashboard_path, class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors" do %>
      <i class="fas fa-plus mr-2"></i>
      Create Dashboard
    <% end %>
  </div>

  <% if @dashboards.empty? %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-12 text-center">
      <i class="fas fa-chart-pie text-6xl text-gray-300 dark:text-gray-600 mb-4"></i>
      <h2 class="text-xl font-medium text-gray-900 dark:text-white mb-2">No Dashboards Yet</h2>
      <p class="text-gray-500 dark:text-gray-400 mb-6">
        Create your first dashboard to visualize defect data based on saved filters.
      </p>
      <%= link_to new_qa_dashboard_path, class: "inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium" do %>
        <i class="fas fa-plus mr-2"></i>
        Create Your First Dashboard
      <% end %>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @dashboards.each do |dashboard| %>
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow hover:shadow-lg transition-shadow">
          <div class="p-6">
            <div class="mb-4">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                <%= dashboard.name %>
              </h3>
            </div>

            <% if dashboard.description.present? %>
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                <%= dashboard.description %>
              </p>
            <% end %>

            <div class="space-y-2 mb-4">
              <div class="flex items-center text-sm text-gray-600 dark:text-gray-400">
                <i class="fas fa-filter w-5"></i>
                <%= dashboard.defect_filter.name %>
              </div>
              <div class="flex items-center text-sm text-gray-600 dark:text-gray-400">
                <i class="fas fa-chart-bar w-5"></i>
                <%= pluralize(dashboard.widgets.length, 'widget') %>
              </div>
              <% if dashboard.auto_refresh_interval %>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400">
                  <i class="fas fa-sync-alt w-5"></i>
                  Refreshes every <%= distance_of_time_in_words(dashboard.auto_refresh_interval) %>
                </div>
              <% end %>
            </div>

            <div class="flex gap-2">
              <%= link_to qa_dashboard_path(dashboard), class: "flex-1 text-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium" do %>
                <i class="fas fa-eye mr-1"></i>
                View
              <% end %>
              
              <%= link_to edit_qa_dashboard_path(dashboard), class: "flex-1 text-center px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors font-medium" do %>
                <i class="fas fa-edit mr-1"></i>
                Edit
              <% end %>
              
              <%= button_to qa_dashboard_path(dashboard), 
                  method: :delete,
                  data: { turbo_confirm: "Are you sure you want to delete this dashboard? This action cannot be undone." },
                  form_class: "flex-1",
                  class: "w-full text-center px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium" do %>
                <i class="fas fa-trash mr-1"></i>
                Delete
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
