<div class="container mx-auto px-4 py-6">
  <!-- Dashboard Header -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
    <div class="flex justify-between items-start mb-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">
          <%= @dashboard.name %>
        </h1>
        <% if @dashboard.description.present? %>
          <p class="text-gray-600 dark:text-gray-400">
            <%= @dashboard.description %>
          </p>
        <% end %>
      </div>
      <div class="flex gap-2">
        <%= link_to edit_qa_dashboard_path(@dashboard), 
                    class: "inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition duration-150" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit
        <% end %>
        
        <%= button_to qa_dashboard_path(@dashboard), 
                      method: :delete,
                      data: { 
                        turbo_method: :delete,
                        turbo_confirm: "Are you sure you want to delete this dashboard? This action cannot be undone." 
                      },
                      class: "inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg transition duration-150" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          Delete
        <% end %>
        
        <%= link_to qa_dashboards_path, 
                    class: "inline-flex items-center px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white font-medium rounded-lg transition duration-150" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Dashboards
        <% end %>
      </div>
    </div>

    <!-- Dashboard Metadata -->
    <div class="flex flex-wrap gap-4 text-sm text-gray-600 dark:text-gray-400">
      <div class="flex items-center">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
        </svg>
        <strong>Filter:</strong>&nbsp;<%= @dashboard.defect_filter.name %>
      </div>
      <div class="flex items-center">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
        </svg>
        <strong>Widgets:</strong>&nbsp;<%= @dashboard.widgets.count %>
      </div>
      <% if @dashboard.auto_refresh_interval.present? %>
        <div class="flex items-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <strong>Auto-Refresh:</strong>&nbsp;Every <%= @dashboard.auto_refresh_interval %> seconds
        </div>
      <% end %>
    </div>
  </div>

  <!-- Current Project Scope Display -->
  <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4 mb-6">
    <div class="flex items-center justify-between">
      <div class="flex items-center">
        <svg class="w-5 h-5 mr-2 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        <span class="text-sm font-medium text-blue-800 dark:text-blue-200">
          Current Project Scope:
        </span>
      </div>
      <div class="px-3 py-1 bg-blue-100 dark:bg-blue-800 text-blue-800 dark:text-blue-200 rounded-full text-sm font-semibold">
        <%= @current_project_names %>
      </div>
    </div>
  </div>

  <!-- Project Selection Filter (Multiple Checkboxes - Same as QA Reports) -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
    <%= form_with url: qa_dashboard_path(@dashboard), method: :get, local: true, id: 'dashboard-filter-form' do |f| %>
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4 flex-1">
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
            </svg>
            <label class="text-sm font-semibold text-gray-700 dark:text-gray-300">
              Select Projects (QA Only):
            </label>
          </div>
          
          <div class="dropdown-group relative flex-1">
            <button type="button" id="productDropdownButton" 
                    class="w-full max-w-md px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white text-left focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors flex items-center justify-between">
              <span>
                <% if @selected_product_ids.any? %>
                  <%= "#{@selected_product_ids.size} project(s) selected" %>
                <% else %>
                  Select projects...
                <% end %>
              </span>
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            
            <div id="product-options" 
                 class="dropdown-options hidden absolute z-10 mt-1 w-full max-w-md bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg shadow-lg max-h-80 overflow-y-auto">
              <div class="p-2">
                <% if @product_options.any? %>
                  <% @product_options.each do |name, id| %>
                    <label class="block px-3 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 rounded cursor-pointer">
                      <%= check_box_tag 'product_id[]', id, @selected_product_ids.include?(id.to_s), 
                            class: 'product-checkbox mr-2' %>
                      <span class="text-sm text-gray-700 dark:text-gray-300"><%= name %></span>
                    </label>
                  <% end %>
                <% else %>
                  <div class="px-3 py-2 text-sm text-gray-500 dark:text-gray-400">
                    No QA projects available
                  </div>
                <% end %>
              </div>
              
              <% if @product_options.any? %>
                <div class="border-t border-gray-200 dark:border-gray-600 p-2">
                  <button type="button" id="applyProductSelection" 
                          class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded transition-colors text-sm font-medium">
                    Apply Selection
                  </button>
                </div>
              <% end %>
            </div>
          </div>
          
          <% if @selected_product_ids.any? %>
            <%= link_to qa_dashboard_path(@dashboard), 
                class: "inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white rounded-lg transition-colors" do %>
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              Clear
            <% end %>
          <% end %>
        </div>
        
        <% if @selected_product_ids.any? %>
          <div class="ml-4 px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm font-medium">
            <%= pluralize(@selected_product_ids.size, 'project') %> selected
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Widgets Grid -->
  <% if @charts.blank? %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-12 text-center">
      <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
      </svg>
      <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">No Data</h3>
      <p class="text-gray-600 dark:text-gray-400 mb-4">This dashboard's filter doesn't have any active parameters.</p>
      <%= link_to "Back to Dashboards", qa_dashboards_path, 
                  class: "inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition duration-150" %>
    </div>
  <% else %>
    <!-- Total Records Card -->
    <div class="bg-gradient-to-r from-blue-600 to-blue-700 dark:from-blue-700 dark:to-blue-800 rounded-lg shadow-lg p-6 mb-6 text-white">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-medium opacity-90 mb-1">Total Records</h2>
          <div class="text-4xl font-bold"><%= @total_count %></div>
          <p class="text-sm opacity-75 mt-1">Defects matching filter criteria</p>
        </div>
        <div class="bg-white bg-opacity-20 rounded-full p-4">
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Active Filter Parameters -->
    <% if @filter_params.present? %>
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center">
          <svg class="w-5 h-5 mr-2 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
          Active Filter Parameters
        </h2>
        <div class="flex flex-wrap gap-2">
          <% @filter_params.each do |key, value| %>
            <% next if value.blank? || %w[page order query].include?(key) %>
            <span class="inline-flex items-center px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm">
              <strong><%= filter_param_label(key) %>:</strong>&nbsp;<%= format_filter_value(key, value) %>
            </span>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Auto-Generated Charts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% @charts.each do |field, chart_data| %>
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
          <!-- Chart Header -->
          <div class="mb-4 pb-4 border-b border-gray-200 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
              <%= field %>
            </h3>
            <div class="flex items-center gap-2 mt-2 text-sm text-gray-600 dark:text-gray-400">
              <span class="inline-flex items-center px-2 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded">
                Pie Chart
              </span>
              <span class="inline-flex items-center px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded">
                <%= chart_data.values.sum %> Total
              </span>
            </div>
          </div>

          <!-- Pie Chart -->
          <div class="mb-6">
            <%= pie_chart chart_data, 
                          donut: true,
                          colors: ["#3B82F6", "#10B981", "#F59E0B", "#EF4444", "#8B5CF6", "#EC4899", "#14B8A6", "#F97316", "#6366F1", "#84CC16"],
                          library: { 
                            plugins: { 
                              legend: { 
                                position: 'bottom',
                                labels: {
                                  boxWidth: 12,
                                  padding: 10,
                                  font: { size: 11 }
                                }
                              } 
                            } 
                          } %>
          </div>

          <!-- Breakdown Table -->
          <div class="border-t border-gray-200 dark:border-gray-700 pt-4">
            <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Breakdown</h4>
            <div class="space-y-2">
              <% chart_data.sort_by { |_k, v| -v }.each do |label, count| %>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-700 dark:text-gray-300 flex-1 truncate">
                    <%= label.presence || '(Not Set)' %>
                  </span>
                  <span class="font-semibold text-gray-900 dark:text-white ml-2">
                    <%= count %>
                  </span>
                  <span class="text-gray-500 dark:text-gray-400 ml-2 text-xs">
                    <%= number_to_percentage((count.to_f / chart_data.values.sum * 100), precision: 1) %>
                  </span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Auto-refresh functionality -->
<% if @dashboard.auto_refresh_interval.present? %>
  <script>
    // Auto-refresh the page based on dashboard settings
    setTimeout(function() {
      location.reload();
    }, <%= @dashboard.auto_refresh_interval * 1000 %>);
  </script>
<% end %>

<!-- Project dropdown functionality (compatible with Turbo) -->
<script>
  // Function to initialize dropdown
  function initializeProjectDropdown() {
    const productButton = document.getElementById('productDropdownButton');
    const productOptions = document.getElementById('product-options');
    const applyButton = document.getElementById('applyProductSelection');
    const form = document.getElementById('dashboard-filter-form');
    
    if (productButton && productOptions) {
      // Remove existing listeners to prevent duplicates
      const newProductButton = productButton.cloneNode(true);
      productButton.parentNode.replaceChild(newProductButton, productButton);
      
      // Toggle dropdown
      newProductButton.addEventListener('click', function(e) {
        e.stopPropagation();
        productOptions.classList.toggle('hidden');
      });
      
      // Close dropdown when clicking outside
      document.addEventListener('click', function(e) {
        if (!productOptions.contains(e.target) && e.target !== newProductButton) {
          productOptions.classList.add('hidden');
        }
      });
      
      // Apply selection
      if (applyButton && form) {
        applyButton.addEventListener('click', function() {
          form.submit();
        });
      }
    }
  }
  
  // Initialize on DOMContentLoaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeProjectDropdown);
  } else {
    // DOM is already ready
    initializeProjectDropdown();
  }
  
  // Re-initialize on Turbo load (Rails 7)
  document.addEventListener('turbo:load', initializeProjectDropdown);
  
  // Also support older turbolinks (just in case)
  document.addEventListener('turbolinks:load', initializeProjectDropdown);
</script>
