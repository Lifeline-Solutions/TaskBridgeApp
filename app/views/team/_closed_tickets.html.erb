<div class="overflow-x-auto shadow-md sm:rounded-lg w-full p-1">
  <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm text-left text-gray-500 dark:text-gray-400">
    <thead class="bg-gray-50 dark:bg-gray-700">
      <tr>
        <th scope="col" class="px-2 py-3 whitespace-nowrap">Client Name</th>
        <th scope="col" class="px-2 py-3 whitespace-nowrap">
          <div class="flex items-center gap-1">
            Ticket ID
            <a href="#" class="hover:text-blue-600">
              <svg class="w-3 h-3" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8.574 11.024h6.852a2.075 2.075 0 0 0 1.847-1.086 1.9 1.9 0 0 0-.11-1.986L13.736 2.9a2.122 2.122 0 0 0-3.472 0L6.837 7.952a1.9 1.9 0 0 0-.11 1.986 2.074 2.074 0 0 0 1.847 1.086Zm6.852 1.952H8.574a2.072 2.072 0 0 0-1.847 1.087 1.9 1.9 0 0 0 .11 1.985l3.426 5.05a2.123 2.123 0 0 0 3.472 0l3.427-5.05a1.9 1.9 0 0 0 .11-1.985 2.074 2.074 0 0 0-1.846-1.087Z"/>
              </svg>
            </a>
          </div>
        </th>
        <th scope="col" class="px-2 py-3 whitespace-nowrap">
          <div class="flex items-center gap-1">
            Issue
            <a href="#" class="hover:text-blue-600">
              <svg class="w-3 h-3" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8.574 11.024h6.852a2.075 2.075 0 0 0 1.847-1.086 1.9 1.9 0 0 0-.11-1.986L13.736 2.9a2.122 2.122 0 0 0-3.472 0L6.837 7.952a1.9 1.9 0 0 0-.11 1.986 2.074 2.074 0 0 0 1.847 1.086Zm6.852 1.952H8.574a2.072 2.072 0 0 0-1.847 1.087 1.9 1.9 0 0 0 .11 1.985l3.426 5.05a2.123 2.123 0 0 0 3.472 0l3.427-5.05a1.9 1.9 0 0 0 .11-1.985 2.074 2.074 0 0 0-1.846-1.087Z"/>
              </svg>
            </a>
          </div>
        </th>
        <th scope="col" class="px-2 py-3 whitespace-nowrap">
          <div class="flex items-center gap-1">
            Priority
            <a href="#" class="hover:text-blue-600">
              <svg class="w-3 h-3" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8.574 11.024h6.852a2.075 2.075 0 0 0 1.847-1.086 1.9 1.9 0 0 0-.11-1.986L13.736 2.9a2.122 2.122 0 0 0-3.472 0L6.837 7.952a1.9 1.9 0 0 0-.11 1.986 2.074 2.074 0 0 0 1.847 1.086Zm6.852 1.952H8.574a2.072 2.072 0 0 0-1.847 1.087 1.9 1.9 0 0 0 .11 1.985l3.426 5.05a2.123 2.123 0 0 0 3.472 0l3.427-5.05a1.9 1.9 0 0 0 .11-1.985 2.074 2.074 0 0 0-1.846-1.087Z"/>
              </svg>
            </a>
          </div>
        </th>
        <th scope="col" class="px-2 py-3 whitespace-nowrap">
          <div class="flex items-center gap-1">
            Summary
            <a href="#" class="hover:text-blue-600">
              <svg class="w-3 h-3" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8.574 11.024h6.852a2.075 2.075 0 0 0 1.847-1.086 1.9 1.9 0 0 0-.11-1.986L13.736 2.9a2.122 2.122 0 0 0-3.472 0L6.837 7.952a1.9 1.9 0 0 0-.11 1.986 2.074 2.074 0 0 0 1.847 1.086Zm6.852 1.952H8.574a2.072 2.072 0 0 0-1.847 1.087 1.9 1.9 0 0 0 .11 1.985l3.426 5.05a2.123 2.123 0 0 0 3.472 0l3.427-5.05a1.9 1.9 0 0 0 .11-1.985 2.074 2.074 0 0 0-1.846-1.087Z"/>
              </svg>
            </a>
          </div>
        </th>
        <th scope="col" class="px-2 py-3 whitespace-nowrap">
          <div class="flex items-center gap-1">
            Status
            <a href="#" class="hover:text-blue-600">
              <svg class="w-3 h-3" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8.574 11.024h6.852a2.075 2.075 0 0 0 1.847-1.086 1.9 1.9 0 0 0-.11-1.986L13.736 2.9a2.122 2.122 0 0 0-3.472 0L6.837 7.952a1.9 1.9 0 0 0-.11 1.986 2.074 2.074 0 0 0 1.847 1.086Zm6.852 1.952H8.574a2.072 2.072 0 0 0-1.847 1.087 1.9 1.9 0 0 0 .11 1.985l3.426 5.05a2.123 2.123 0 0 0 3.472 0l3.427-5.05a1.9 1.9 0 0 0 .11-1.985 2.074 2.074 0 0 0-1.846-1.087Z"/>
              </svg>
            </a>
          </div>
        </th>
        <th scope="col" class="px-2 py-3 whitespace-nowrap">View</th>
      </tr>
    </thead>
    <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
      <% @closed_tickets.each do |ticket| %>
        <% if ticket.present? %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
            <td class="px-2 py-2 font-medium text-gray-900 dark:text-white capitalize max-w-[120px] truncate">
              <%= link_to ticket.project.title, project_ticket_path(ticket.project, ticket), class: "hover:underline" %>
            </td>
            <td class="px-2 py-2 font-medium text-gray-900 dark:text-white uppercase max-w-[80px] truncate">
              <% if ticket.unique_id.present? %>
                <%= link_to ticket.unique_id, project_ticket_path(ticket.project, ticket), class: "hover:underline" %>
              <% end %>
            </td>
            <td class="px-2 py-2 font-medium text-gray-900 dark:text-white max-w-[120px] truncate">
              <%= link_to ticket.issue, project_ticket_path(ticket.project, ticket), class: "hover:underline" %>
            </td>
            <td class="px-2 py-2">
              <% if ticket.priority == 'SEVERITY 1' %>
                <span class='bg-red-900 px-2 py-1 text-xs text-white font-bold rounded block text-center'><%= ticket.priority %></span>
              <% elsif ticket.priority == 'SEVERITY 2' %>
                <span class='bg-red-600 px-2 py-1 text-xs text-white font-bold rounded block text-center'><%= ticket.priority %></span>
              <% elsif ticket.priority == 'SEVERITY 3' %>
                <span class='bg-yellow-500 px-2 py-1 text-xs text-white font-bold rounded block text-center'><%= ticket.priority %></span>
              <% else %>
                <span class='bg-blue-500 px-2 py-1 text-xs text-white font-bold rounded block text-center'><%= ticket.priority %></span>
              <% end %>
            </td>
            <td class="px-2 py-2 max-w-[180px] truncate">
              <% if ticket.subject.present? %>
                <span title="<%= ticket.subject %>"><%= ticket.subject.truncate(50) %></span>
              <% end %>
            </td>
            <td class="px-2 py-2">
              <div class="flex flex-wrap gap-1">
                <% ticket.statuses.each do |status| %>
                  <% case status.name %>
                  <% when 'Resolved' %>
                    <span class='bg-green-500 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-green-600'><%= status.name %></span>
                  <% when 'Closed' %>
                    <span class='bg-gray-800 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-gray-900'><%= status.name %></span>
                  <% when 'Reopened' %>
                    <span class="bg-red-900 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-red-800"><%= status.name %></span>
                  <% when 'New' %>
                    <span class="bg-red-500 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-red-600"><%= status.name %></span>
                  <% when 'Under Development' %>
                    <span class='bg-blue-300 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-blue-400'><%= status.name %></span>
                  <% when 'Work in Progress' %>
                    <span class='bg-gray-500 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-gray-600'><%= status.name %></span>
                  <% when 'QA Testing' %>
                    <span class='bg-pink-500 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-pink-600'><%= status.name %></span>
                  <% when 'Awaiting Build' %>
                    <span class='text-xs text-gray-900 dark:text-slate-100 font-semibold rounded px-2 py-1 border border-b-2 border-black dark:border-slate-100'><%= status.name %></span>
                  <% when 'Client Confirmation Pending' %>
                    <span class='bg-purple-500 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-purple-600'><%= status.name %></span>
                  <% when 'On-Hold' %>
                    <span class='bg-yellow-300 text-xs text-black font-semibold rounded px-2 py-1 border-b-2 border-yellow-400'><%= status.name %></span>
                  <% when 'Assigned' %>
                    <span class='bg-blue-800 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-blue-900'><%= status.name %></span>
                  <% when 'Approved' %>
                    <span class='bg-green-800 text-xs text-slate-100 font-bold rounded px-2 py-1 border-b-2 border-green-900'><%= status.name %></span>
                  <% when 'Pending' %>
                    <span class='bg-gradient-to-r from-green-800 to-black text-xs text-slate-100 font-bold rounded px-2 py-1 border-b-2 border-green-900'><%= status.name %></span>
                  <% when 'Declined' %>
                    <span class='bg-gray-800 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-gray-900'><%= status.name %></span>
                  <% end %>
                <% end %>
              </div>
            </td>
            <td class="px-2 py-2">
              <%= link_to 'VIEW', project_ticket_path(ticket.project, ticket), class: 'bg-[#3F8CFF] hover:bg-[#3A81EB] px-3 py-1 rounded font-bold text-xs text-slate-100 transition-colors duration-150' %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
  <!-- Responsive fallback for small screens -->
  <div class="sm:hidden mt-4 space-y-4">
    <% @closed_tickets.each do |ticket| %>
      <% if ticket.present? %>
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-3 flex flex-col gap-2">
          <div class="flex justify-between items-center">
            <span class="font-semibold text-gray-900 dark:text-white capitalize"><%= ticket.project.title %></span>
            <span class="text-xs text-gray-500 dark:text-gray-300 uppercase"><%= ticket.unique_id %></span>
          </div>
          <div class="text-sm text-gray-700 dark:text-gray-200"><strong>Issue:</strong> <%= ticket.issue %></div>
          <div>
            <strong>Priority:</strong>
            <% if ticket.priority == 'SEVERITY 1' %>
              <span class='bg-red-900 px-2 py-1 text-xs text-white font-bold rounded'><%= ticket.priority %></span>
            <% elsif ticket.priority == 'SEVERITY 2' %>
              <span class='bg-red-600 px-2 py-1 text-xs text-white font-bold rounded'><%= ticket.priority %></span>
            <% elsif ticket.priority == 'SEVERITY 3' %>
              <span class='bg-yellow-500 px-2 py-1 text-xs text-white font-bold rounded'><%= ticket.priority %></span>
            <% else %>
              <span class='bg-blue-500 px-2 py-1 text-xs text-white font-bold rounded'><%= ticket.priority %></span>
            <% end %>
          </div>
          <div class="truncate"><strong>Summary:</strong> <%= ticket.subject.truncate(50) if ticket.subject.present? %></div>
          <div class="flex flex-wrap gap-1">
            <% ticket.statuses.each do |status| %>
              <% case status.name %>
              <% when 'Resolved' %>
                <span class='bg-green-500 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-green-600'><%= status.name %></span>
              <% when 'Closed' %>
                <span class='bg-gray-800 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-gray-900'><%= status.name %></span>
              <% when 'Reopened' %>
                <span class="bg-red-900 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-red-800"><%= status.name %></span>
              <% when 'New' %>
                <span class="bg-red-500 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-red-600"><%= status.name %></span>
              <% when 'Under Development' %>
                <span class='bg-blue-300 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-blue-400'><%= status.name %></span>
              <% when 'Work in Progress' %>
                <span class='bg-gray-500 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-gray-600'><%= status.name %></span>
              <% when 'QA Testing' %>
                <span class='bg-pink-500 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-pink-600'><%= status.name %></span>
              <% when 'Awaiting Build' %>
                <span class='text-xs text-gray-900 dark:text-slate-100 font-semibold rounded px-2 py-1 border border-b-2 border-black dark:border-slate-100'><%= status.name %></span>
              <% when 'Client Confirmation Pending' %>
                <span class='bg-purple-500 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-purple-600'><%= status.name %></span>
              <% when 'On-Hold' %>
                <span class='bg-yellow-300 text-xs text-black font-semibold rounded px-2 py-1 border-b-2 border-yellow-400'><%= status.name %></span>
              <% when 'Assigned' %>
                <span class='bg-blue-800 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-blue-900'><%= status.name %></span>
              <% when 'Approved' %>
                <span class='bg-green-800 text-xs text-slate-100 font-bold rounded px-2 py-1 border-b-2 border-green-900'><%= status.name %></span>
              <% when 'Pending' %>
                <span class='bg-gradient-to-r from-green-800 to-black text-xs text-slate-100 font-bold rounded px-2 py-1 border-b-2 border-green-900'><%= status.name %></span>
              <% when 'Declined' %>
                <span class='bg-gray-800 text-xs text-slate-100 font-semibold rounded px-2 py-1 border-b-2 border-gray-900'><%= status.name %></span>
              <% end %>
            <% end %>
          </div>
          <div>
            <%= link_to 'VIEW', project_ticket_path(ticket.project, ticket), class: 'bg-[#3F8CFF] hover:bg-[#3A81EB] px-3 py-1 rounded font-bold text-xs text-slate-100 transition-colors duration-150' %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
