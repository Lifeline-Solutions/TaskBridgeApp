<div class="bg-white dark:bg-gray-900 shadow rounded-lg px-4 py-3 mb-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
  <!-- Left: Back and Add Team -->
  <div class="flex flex-row gap-2 w-full md:w-auto">
  <%= link_to project_index_path, class: 'flex items-center gap-1 bg-[#0052CC] hover:bg-[#0747A6] px-3 py-2 rounded font-semibold text-white dark:text-white shadow-sm transition-colors duration-150 w-full md:w-auto', title: "Back to Projects" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
  <span class="dark:text-white">Back</span>
    <% end %>
    <% unless current_user.has_role?(:observer) %>
  <%= link_to new_team_path, class: 'flex items-center gap-1 bg-[#0052CC] hover:bg-[#0747A6] px-3 py-2 rounded font-semibold text-white dark:text-white shadow-sm transition-colors duration-150 w-full md:w-auto', title: "Add New Team" do %>
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
  <span class="dark:text-white">Add New Team</span>
      <% end %>
    <% end %>
  </div>

  <!-- Right: Search -->
  <div class="w-full md:w-auto">
    <%= form_with url: team_index_path, method: :get, class: 'flex flex-col gap-2 md:flex-row md:items-end md:gap-2 w-full' do |f| %>
      <div class="flex flex-col w-full">
        <%= f.text_field :query, placeholder: "Search teams...", class: "w-full px-3 py-2 border border-[#0052CC] rounded-md focus:ring-2 focus:ring-[#2684FF] focus:border-[#2684FF] transition dark:bg-gray-900 dark:text-white" %>
      </div>
      <div class="flex gap-2 w-full md:w-auto">
  <%= f.submit "Search", class: 'w-full md:w-auto bg-[#0052CC] hover:bg-[#0747A6] px-3 py-2 rounded font-semibold text-white dark:text-white shadow-sm transition-colors duration-150' %>
  <%= button_to "Clear", team_index_path, method: :get, class: 'w-full md:w-auto bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 px-3 py-2 rounded font-semibold text-[#0052CC] dark:text-white shadow-sm transition-colors duration-150', form_class: 'inline' %>
      </div>
    <% end %>
  </div>
</div>

<% if flash[:prompt] %>
  <div id="custom-alert" class="fixed inset-0 flex justify-center items-center z-50" style="background-color: rgba(0, 0, 0, 0.5);">
    <div class="bg-white dark:bg-gray-900 rounded-lg p-6 max-w-sm w-full shadow-lg">
      <h2 class="text-xl font-semibold mb-4 text-gray-800 dark:text-white">Notice</h2>
      <p class="text-gray-600 dark:text-white"><%= flash[:prompt] %></p>
      <div class="mt-4 text-right">
        <button id="close-alert" class="bg-[#0052CC] text-white dark:text-white px-4 py-2 rounded hover:bg-[#0747A6]">
          OK
        </button>
      </div>
    </div>
  </div>
  <script type="text/javascript">
    document.addEventListener("turbo:load", function() {
      const alertBox = document.getElementById("custom-alert");
      const closeButton = document.getElementById("close-alert");
      closeButton.addEventListener("click", function() {
        alertBox.remove();
      });
    });
  </script>
<% end %>
