                        <path fill-rule="evenodd" d="M4.5 2.25a.75.75 0 0 0-.75.75v18a.75.75 0 0 0 .75.75h15a.75.75 0 0 0 .75-.75V3a.75.75 0 0 0-.75-.75h-15ZM9 6a.75.75 0 0 0 0 1.5h1.5a.75.75 0 0 0 0-1.5H9Zm-.75 3.75A.75.75 0 0 1 9 9h1.5a.75.75 0 0 1 0 1.5H9a.75.75 0 0 1-.75-.75ZM9 12a.75.75 0 0 0 0 1.5h1.5a.75.75 0 0 0 0-1.5H9Zm3.75-5.25A.75.75 0 0 1 13.5 6H15a.75.75 0 0 1 0 1.5h-1.5a.75.75 0 0 1-.75-.75ZM13.5 9a.75.75 0 0 0 0 1.5H15A.75.75 0 0 0 15 9h-1.5Zm-.75 3.75a.75.75 0 0 1 .75-.75H15a.75.75 0 0 1 0 1.5h-1.5a.75.75 0 0 1-.75-.75ZM9 19.5v-2.25a.75.75 0 0 1 .75-.75h4.5a.75.75 0 0 1 .75.75v2.25a3 3 0 0 1-6 0Z" clip-rule="evenodd" />
                      </svg>
                      <span class="flex-1 ms-3 whitespace-nowrap group-hover/item:text-blue-700 dark:group-hover/item:text-blue-800 <%= 'text-blue-700 dark:text-blue-800 font-medium' if request.path == cbk_groupware_report_path %>">CBK Report</span>
                    </div>
                  </li>
                <% end %>
              <% end %>
              <% if current_user.has_role? :agent or current_user.has_role? :admin or current_user.has_role? :observer or current_user.has_role?('project manager') %>
                <%= link_to reports_path do %>
                  <li>
                    <div class="flex items-center p-2 rounded-lg hover:bg-transparent dark:hover:bg-gray-700 group">
                      <svg class="w-4 h-5 text-[#fff] transition duration-75 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M6 6h12v12H6V6zm1 1v10h10V7H7zm3 3h4v4h-4v-4z" />
                      </svg>
                      <span class="flex-1 hover:text-[#3F8CFF] ms-3 whitespace-nowrap">QA Report</span>
                    </div>
                  </li>
                <% end %>
              <% end %>
                </ul>
          </li>
        </ul>

          <% end %>
    </aside>
  </div>
<% end %>

<script>
  document.addEventListener("turbo:load", function() {
    // Check if element exists before adding event listener
    const dropdownDashboard = document.getElementById("dropdownDashboard");
    if (dropdownDashboard) {
      dropdownDashboard.addEventListener("click", function() {
        const dropdownMenuDashboard = document.getElementById("dropdownMenuDashboard");
        dropdownMenuDashboard.classList.toggle("hidden");
      });
    }
  });
</script>