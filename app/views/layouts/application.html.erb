<!DOCTYPE html>
<html>
<head>
  <title><%= full_title(yield(:title)) %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
  <%= favicon_link_tag asset_path('loading.png') %>
  <%= stylesheet_link_tag "application", "mobile_responsive", "data-turbo-track": "reload" %>
  <%= javascript_include_tag 'controllers/ckeditor_init' %>
  <%= javascript_importmap_tags %>
  <% if defined?(Sentry) && ENV["SENTRY_DSN"].present? %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  <% end %>
  <%= javascript_include_tag "loading" %>
  <%= javascript_include_tag "chartkick" %>
  <%= javascript_include_tag "Chart.bundle" %>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tributejs/dist/tribute.css"/>
  <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
  <link
    rel="stylesheet"
    type="text/css"
    href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css"
    />

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-slate-100 dark:bg-gray-900 text-gray-900 dark:text-slate-100">
<main class="relative">
  <% if current_user && user_signed_in?  %>
    <!-- Sidebar -->
    <%= render 'layouts/sidebar' %>
    
    <!-- Main Content -->
    <div id="mainContent" class="transition-all duration-300 bg-slate-100 dark:bg-gray-900 text-gray-900 dark:text-slate-100 ml-16 lg:ml-64 min-h-screen">
      <div class="p-1">
        <%= turbo_frame_tag "modal" %>
        <%= render 'layouts/topbar' %>
        <%= yield %>
      </div>
    </div>
  <% else %>
    <main class="mx-auto bg-slate-100 dark:bg-gray-900 text-gray-900 dark:text-slate-100">
      <%= render 'layouts/sidebar' %>
      <div>
        <%= render 'layouts/topbar' %>
        <%= yield %>
      </div>
    </main>
  <% end %>
</main>

<script>
  document.addEventListener('turbo:load', () => {
    const mainContent = document.getElementById('mainContent');
    
    if (mainContent) {
      // Function to update main content margin based on sidebar width and screen size
      function updateMainContentMargin() {
        const sidebarWrapper = document.getElementById('sidebar-wrapper');
        if (sidebarWrapper) {
          if (window.innerWidth < 1024) {
            // On mobile/tablet, sidebar overlays content
            mainContent.style.marginLeft = '4rem'; // Always collapsed spacing on mobile
          } else {
            // On desktop, check sidebar state
            if (sidebarWrapper.classList.contains('w-16')) {
              // Collapsed sidebar (64px = 4rem)
              mainContent.style.marginLeft = '4rem';
            } else {
              // Expanded sidebar (256px = 16rem)
              mainContent.style.marginLeft = '16rem';
            }
          }
        }
      }

      // Initial setup
      updateMainContentMargin();

      // Listen for sidebar width changes
      const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
            updateMainContentMargin();
          }
        });
      });

      // Start observing sidebar wrapper for class changes
      const sidebarWrapper = document.getElementById('sidebar-wrapper');
      if (sidebarWrapper) {
        observer.observe(sidebarWrapper, {
          attributes: true,
          attributeFilter: ['class']
        });
      }

      // Handle window resize for responsive behavior
      window.addEventListener('resize', () => {
        updateMainContentMargin();
      });
    }
  });
</script>

<!-- Additional scripts from dev branch (if any) -->
<script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js" crossorigin="anonymous"></script>
<script>
  document.addEventListener("turbo:load", function () {
    document.querySelectorAll('textarea.rich').forEach(function (el) {
      if (!el.dataset.ckeditorInstantiated) {
        ClassicEditor.create(el).catch(e => console.error(e));
        el.dataset.ckeditorInstantiated = true;
      }
    });
  });
</script>

</body>
</html>