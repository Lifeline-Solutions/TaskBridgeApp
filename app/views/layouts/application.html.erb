<!DOCTYPE html>
<html>
<head>
  <title><%= full_title(yield(:title)) %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
  <%# Removed conflicting javascript_include_tag "application" %>
  <%= favicon_link_tag asset_path('loading.png') %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "mobile_responsive", "data-turbo-track": "reload" %>
  <%= javascript_include_tag 'controllers/ckeditor_init' %>
  <%= javascript_importmap_tags %>
  
  <style>
    /* Hide CKEditor security warning banner */
    .cke_notification_warning,
    .cke_notifications_area {
      display: none !important;
    }
  </style>
  <% if defined?(Sentry) && ENV["SENTRY_DSN"].present? %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  <% end %>
  <%= javascript_include_tag "loading" %>
  <%= javascript_include_tag "chartkick" %>
  <%= javascript_include_tag "Chart.bundle" %>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tributejs/dist/tribute.css"/>
  <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
    />

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  
  <script>
    // Theme initialization - must run before body loads to prevent flash
    (function() {
      // Force override any existing theme settings
      const savedTheme = localStorage.getItem('theme') || 'system';
      const html = document.documentElement;
      const body = document.body;
      
      // console.log('Initial theme load:', savedTheme);
      
      function forceApplyTheme(theme) {
        // Remove all possible theme classes
        html.classList.remove('dark', 'light');
        if (body) {
          body.classList.remove('dark', 'light');
        }
        
        if (theme === 'dark') {
          html.classList.add('dark');
          if (body) body.classList.add('dark');
          html.style.colorScheme = 'dark';
        } else if (theme === 'light') {
          html.classList.add('light');
          if (body) body.classList.add('light');
          html.style.colorScheme = 'light';
        } else { // system
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (prefersDark) {
            html.classList.add('dark');
            if (body) body.classList.add('dark');
            html.style.colorScheme = 'dark';
          } else {
            html.classList.add('light');
            if (body) body.classList.add('light');
            html.style.colorScheme = 'light';
          }
        }
        
        // console.log('Applied theme:', theme, 'HTML classes:', html.className);
      }
      
      // Apply theme immediately
      forceApplyTheme(savedTheme);
      
      // Make the function available globally
      window.forceApplyTheme = forceApplyTheme;
    })();
  </script>
</head>
<body class="bg-slate-100 dark:bg-gray-900 text-gray-900 dark:text-slate-100">
<main class="relative">
  <% if current_user && user_signed_in?  %>
    <!-- Sidebar -->
    <%= render 'layouts/sidebar' %>
    
    <!-- Main Content -->
    <div id="mainContent" class="transition-all duration-300 bg-slate-100 dark:bg-gray-900 text-gray-900 dark:text-slate-100 ml-16 lg:ml-64 min-h-screen">
      <%= turbo_frame_tag "modal" %>
      <%= render 'layouts/topbar' %>
      <div class="p-2">
        <%= yield %>
      </div>
    </div>
  <% else %>
    <main class="mx-auto bg-slate-100 dark:bg-gray-900 text-gray-900 dark:text-slate-100">
      <%= render 'layouts/sidebar' %>
      
      <%= render 'layouts/topbar' %>
      <div class="p-2">
        <%= yield %>
      </div>
    </main>
  <% end %>
</main>

<!-- CKEditor 4 (Local) -->
<script src="/ckeditor/ckeditor.js"></script>

<!-- Global Turbo Frame Load Handler for Edit Forms -->
<script>
  // Define the dropdown initialization function globally
  window.initSearchableDropdowns = function() {
    
    // ===== Projects ====
    const projectInput = document.getElementById("project-search");
    const projectResults = document.getElementById("project-results");
    const projectHidden = document.getElementById("project-id-field");

    if (projectInput && projectResults && window.projectsData) {
      // Preselect from server-side values
      const preselectedId = projectHidden ? projectHidden.value : null;
      if (preselectedId) {
        const match = window.projectsData.find(p => String(p.id) === String(preselectedId));
        if (match) {
          projectInput.value = match.name;
          if (projectHidden) projectHidden.value = match.id;
        }
      }

      function renderProjects(projects) {
        projectResults.innerHTML = "";
        if (projects.length > 0) {
          projectResults.classList.remove("hidden");
          projects.forEach(p => {
            const li = document.createElement("li");
            li.textContent = p.name;
            li.className = "px-3 py-2 hover:bg-blue-500 hover:text-white cursor-pointer";
            li.addEventListener("click", function () {
              projectInput.value = p.name;
              if (projectHidden) projectHidden.value = p.id;
              projectResults.classList.add("hidden");
              // Reload edit page with new product
              const defectId = window.location.pathname.match(/\/defect\/([^\/]+)\/edit/)[1];
              window.location.href = `/defect/${defectId}/edit?product_id=${encodeURIComponent(p.id)}`;
            });
            projectResults.appendChild(li);
          });
        } else {
          projectResults.classList.add("hidden");
        }
      }

      projectInput.addEventListener("input", function () {
        const query = this.value.toLowerCase();
        if (query.length === 0) {
          projectResults.classList.add("hidden");
          return;
        }
        const matches = window.projectsData.filter(p => p.name.toLowerCase().includes(query));
        renderProjects(matches);
      });

      projectInput.addEventListener("focus", function () {
        renderProjects(window.projectsData);
      });

      document.addEventListener("click", function (e) {
        if (projectResults && !projectResults.contains(e.target) && e.target !== projectInput) {
          projectResults.classList.add("hidden");
        }
      });
    }
      
    // ===== Banking Type Search =====
    const bankingTypeInput = document.getElementById("banking-type-search");
    const bankingTypeResults = document.getElementById("banking-type-results");
    const bankingTypeHidden = document.getElementById("banking-type-id-field");

    // Preselect banking type
    const preselectedBankingTypeId = bankingTypeHidden ? bankingTypeHidden.value : null;
    if (preselectedBankingTypeId && window.bankingTypesData) {
      const match = window.bankingTypesData.find(bt => String(bt.id) === String(preselectedBankingTypeId));
      if (match && bankingTypeInput) {
        bankingTypeInput.value = match.name;
        bankingTypeHidden.value = match.id;
      }
    }

    if (bankingTypeInput && bankingTypeResults && window.bankingTypesData) {
      function renderBankingTypes(list) {
        bankingTypeResults.innerHTML = "";
        if (list.length > 0) {
          bankingTypeResults.classList.remove("hidden");
          list.forEach(bt => {
            const li = document.createElement("li");
            li.textContent = bt.name;
            li.className = "px-3 py-2 hover:bg-blue-500 hover:text-white cursor-pointer";
            li.addEventListener("click", function () {
              bankingTypeInput.value = bt.name;
              if (bankingTypeHidden) bankingTypeHidden.value = bt.id;
              bankingTypeResults.classList.add("hidden");
            });
            bankingTypeResults.appendChild(li);
          });
        } else {
          bankingTypeResults.classList.add("hidden");
        }
      }

      bankingTypeInput.addEventListener("input", function () {
        const query = this.value.toLowerCase();
        if (query.length === 0) {
          bankingTypeResults.classList.add("hidden");
          return;
        }
        const matches = window.bankingTypesData.filter(bt => bt.name.toLowerCase().includes(query));
        renderBankingTypes(matches);
      });

      bankingTypeInput.addEventListener("focus", function () {
        renderBankingTypes(window.bankingTypesData);
      });

      document.addEventListener("click", function (e) {
        if (bankingTypeResults && !bankingTypeResults.contains(e.target) && e.target !== bankingTypeInput) {
          bankingTypeResults.classList.add("hidden");
        }
      });
      
    }

    // ===== Assignee Search =====
    const assigneeInput = document.getElementById("assignee-search");
    const assigneeResults = document.getElementById("assignee-results");
    const assigneeHidden = document.getElementById("assignee-id-field");

    const preselectedAssigneeId = assigneeHidden ? assigneeHidden.value : null;
    if (preselectedAssigneeId && window.assigneeUsersData) {
      const match = window.assigneeUsersData.find(user => String(user.id) === String(preselectedAssigneeId));
      if (match && assigneeInput) {
        assigneeInput.value = match.name;
        assigneeHidden.value = match.id;
      }
    }

    if (assigneeInput && assigneeResults && window.assigneeUsersData) {
      function renderAssignees(list) {
        assigneeResults.innerHTML = "";
        if (list.length > 0) {
          assigneeResults.classList.remove("hidden");
          list.forEach(user => {
            const li = document.createElement("li");
            li.textContent = user.name;
            li.className = "px-3 py-2 hover:bg-blue-500 hover:text-white cursor-pointer";
            li.addEventListener("click", function () {
              assigneeInput.value = user.name;
              if (assigneeHidden) assigneeHidden.value = user.id;
              assigneeResults.classList.add("hidden");
            });
            assigneeResults.appendChild(li);
          });
        } else {
          assigneeResults.classList.add("hidden");
        }
      }

      assigneeInput.addEventListener("input", function () {
        const query = this.value.toLowerCase();
        if (assigneeHidden) assigneeHidden.value = "";
        if (query.length === 0) {
          assigneeResults.classList.add("hidden");
          return;
        }
        const matches = window.assigneeUsersData.filter(user => user.name.toLowerCase().includes(query));
        renderAssignees(matches);
      });

      assigneeInput.addEventListener("focus", function () {
        renderAssignees(window.assigneeUsersData);
      });

      document.addEventListener("click", function (e) {
        if (assigneeResults && !assigneeResults.contains(e.target) && e.target !== assigneeInput) {
          assigneeResults.classList.add("hidden");
        }
      });
    }
    
  };

  // Listen for Turbo Frame loads
  document.addEventListener('turbo:frame-load', function(event) {
    
    const bankingTypeContainer = document.querySelector('[data-banking-types]');
    
    if (!bankingTypeContainer) {
      
      return;
    }
    
    
    try {
      window.bankingTypesData = JSON.parse(bankingTypeContainer.dataset.bankingTypes || '[]');
      window.assigneeUsersData = JSON.parse(bankingTypeContainer.dataset.assigneeUsers || '[]');
      window.projectsData = JSON.parse(bankingTypeContainer.dataset.projects || '[]');
      
      
      
      
      // Initialize the dropdowns
      if (typeof window.initSearchableDropdowns === 'function') {
        window.initSearchableDropdowns();
        
      }
    } catch (e) {
      // Silently handle errors
    }
  });
</script>

</body>
</html>