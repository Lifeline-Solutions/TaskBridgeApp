<li class="relative pl-6 sm:pl-8 <%= 'bg-yellow-50 dark:bg-yellow-900/20' if item.is_a?(Issue) && item.message_type == 'internal' %>" id="<%= dom_id(item) %>">
  <!-- Timeline dot -->
  <span class="absolute left-0 flex items-center justify-center w-5 h-5 sm:w-6 sm:h-6 bg-blue-100 rounded-full ring-4 sm:ring-8 ring-white dark:ring-gray-800 dark:bg-blue-900">
    <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3 text-blue-800 dark:text-blue-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
      <path d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z"/>
    </svg>
  </span>

  <!-- Message Card -->
  <div class="p-3 sm:p-4 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
    <!-- Message Header -->
    <div class="flex items-start justify-between mb-2 gap-2">
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 flex-1 min-w-0">
        <span class="font-medium text-gray-900 dark:text-white truncate">
          <%= item.user.name %>
        </span>
        <span class="text-xs text-gray-500 dark:text-gray-400">
          <%= item.created_at.strftime("%I:%M %p at %d %B %Y") %>
        </span>
      </div>
      
      <!-- Mobile/Desktop Responsive Message Actions -->
      <div class="flex gap-1 sm:gap-2 flex-shrink-0">
        <% if can?(:edit, item) %>
          <button type="button"
                  class="p-1.5 sm:px-2.5 sm:py-0.5 rounded bg-blue-100 text-blue-800 hover:bg-blue-200 dark:bg-blue-900/50 dark:text-blue-300 dark:hover:bg-blue-900 transition-colors"
                  data-action="click->messages#showEditForm"
                  data-message-id="<%= item.id %>"
                  title="Edit message">
            <!-- Mobile: Icon only, Desktop: Icon + Text -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span class="hidden sm:inline text-xs">Edit</span>
          </button>
        <% end %>

        <% if can?(:delete, item) %>
          <%= link_to [item.ticket.project, @ticket, item], 
              method: :delete, 
              data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' },
              title: "Delete message",
              class: 'p-1.5 sm:px-2.5 sm:py-0.5 rounded bg-red-100 text-red-800 hover:bg-red-200 dark:bg-red-900/50 dark:text-red-300 dark:hover:bg-red-900 transition-colors inline-flex items-center' do %>
            <!-- Mobile: Icon only, Desktop: Icon + Text -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            <span class="hidden sm:inline text-xs">Delete</span>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Message Content -->
    <div class="prose prose-sm sm:prose dark:prose-invert max-w-none text-gray-700 dark:text-gray-300 break-words">
      <%= render partial: 'issues/messages_template', locals: { item: item } %>
    </div>

    <!-- Edit Form (hidden by default) -->
    <div id="edit-form-<%= item.id %>" 
         class="hidden mt-4 p-4 border border-gray-200 dark:border-gray-600 rounded-lg"
         data-messages-target="editForm">
      <%= render 'issues/edit_form', issue: item, project: @project, ticket: @ticket %>
    </div>
  </div>
</li>