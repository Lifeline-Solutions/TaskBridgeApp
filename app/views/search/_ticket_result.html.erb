<%= link_to project_ticket_path(ticket.project, ticket), class: "block" do %>
  <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 hover:border-blue-500 dark:hover:border-blue-400 hover:shadow-md transition-all duration-200">
    <div class="flex items-start justify-between">
      <div class="flex-1 min-w-0">
        <!-- Ticket ID and Title -->
        <div class="flex items-center gap-2 mb-2">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
            <%= ticket.unique_id %>
          </span>
          <% if ticket.statuses.any? %>
            <% status = ticket.statuses.first %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium 
              <%= case status.name
                  when 'Closed', 'Resolved' then 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'
                  when 'In Progress', 'Work in Progress' then 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200'
                  when 'On-Hold' then 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200'
                  else 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200'
                  end %>">
              <%= status.name %>
            </span>
          <% end %>
        </div>
        
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1 line-clamp-1">
          <%= ticket.subject %>
        </h3>
        
        <!-- Metadata -->
        <div class="flex items-center gap-4 text-sm text-gray-600 dark:text-gray-400">
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
            </svg>
            <span><%= ticket.project.title %></span>
          </div>
          
          <% if ticket.priority.present? %>
            <div class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
              </svg>
              <span><%= ticket.priority %></span>
            </div>
          <% end %>
          
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span><%= time_ago_in_words(ticket.created_at) %> ago</span>
          </div>
        </div>
      </div>
      
      <!-- Arrow Icon -->
      <div class="ml-4 flex-shrink-0">
        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </div>
    </div>
  </div>
<% end %>
