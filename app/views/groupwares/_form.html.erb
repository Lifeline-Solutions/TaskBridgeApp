<%= form_with(model: [software, software.groupwares.build], html: { class: "max-w-2xl mx-auto bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 md:p-10 border border-gray-200 dark:border-gray-700" }) do |f| %>
  <div class="space-y-8">
    <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-6 flex items-center gap-2">
      <svg class="w-7 h-7 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 17v-2a4 4 0 0 1 4-4h2"></path><circle cx="12" cy="12" r="10"></circle></svg>
      Create Groupware Task
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :name, ('Name *'), class: "block text-sm font-semibold text-gray-700 dark:text-gray-200 mb-2" %>
        <%= f.text_field :name, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded focus:ring-2 focus:ring-blue-600 focus:border-blue-600 dark:bg-gray-700 dark:text-gray-100 transition", placeholder: 'Enter groupware name', required: true %>
      </div>
      <div>
        <%= f.label :user_id, ('Assignee *'), class: "block text-sm font-semibold text-gray-700 dark:text-gray-200 mb-2" %>
        <%= f.select :user_id, User.with_agent_project_manager_role.order(:first_name, :last_name).map { |user| [user.name, user.id] },
                     { include_blank: 'Select Assignee' },
                     class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded focus:ring-2 focus:ring-blue-600 focus:border-blue-600 dark:bg-gray-700 dark:text-gray-100 transition"
        %>
      </div>
    </div>
    <div>
      <%= f.label :description, ('Description *'), class: "block text-sm font-semibold text-gray-700 dark:text-gray-200 mb-2" %>
      <%= f.text_area :description, rows: 4, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded focus:ring-2 focus:ring-blue-600 focus:border-blue-600 dark:bg-gray-700 dark:text-gray-100 transition resize-none", placeholder: 'Describe the task', required: true %>
    </div>
    <div>
      <%= f.label :image, ('Task Image (Only Images)'), class: "block text-sm font-semibold text-gray-700 dark:text-gray-200 mb-2" %>
      <div class="flex items-center gap-4">
        <%= f.file_field :image, accept: 'image/*', class: "flex-1 px-4 py-2 border border-gray-300 dark:border-gray-700 rounded focus:ring-2 focus:ring-blue-600 focus:border-blue-600 dark:bg-gray-700 dark:text-gray-100 transition" %>
        <span class="text-xs text-gray-500 dark:text-gray-400">PNG, JPG, GIF</span>
      </div>
    </div>
    <div class="flex justify-end mt-8">
      <%= f.submit "Create Task", class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-8 rounded shadow transition w-full sm:w-auto flex items-center gap-2" %>
    </div>
  </div>
<% end %>