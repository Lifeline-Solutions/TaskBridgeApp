<%= form_with(model: [software, software.groupwares.build], html: { class: "max-w-xl mx-auto bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 md:p-8" }) do |f| %>
  <div class="space-y-6">
    <div>
      <%= f.label :name, ('Name *'), class: "block text-base font-semibold text-gray-700 dark:text-gray-200 mb-2" %>
      <%= f.text_field :name, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-100 transition", placeholder: 'Enter groupware name', required: true %>
    </div>
    <div>
      <%= f.label :description, ('Description *'), class: "block text-base font-semibold text-gray-700 dark:text-gray-200 mb-2" %>
      <%= f.text_area :description, rows: 3, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-100 transition", placeholder: 'Describe the task', required: true %>
    </div>
    <div>
      <%= f.label :image, ('Task Image (Only Images)'), class: "block text-base font-semibold text-gray-700 dark:text-gray-200 mb-2" %>
      <%= f.file_field :image, accept: 'image/*', class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-100 transition" %>
    </div>
    <div>
      <%= f.label :Assignee, ('Assignee *'), class: "block text-base font-semibold text-gray-700 dark:text-gray-200 mb-2" %>
      <%= f.select :user_id, User.with_agent_project_manager_role.order(:first_name, :last_name).map { |user| [user.name, user.id] },
                   { include_blank: true },
                   class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-700 rounded focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-100 transition",
                   placeholder: 'Assign User'
      %>
    </div>
    <div class="flex justify-end">
      <%= f.submit "Create", class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded shadow transition w-full sm:w-auto" %>
    </div>
  </div>
<% end %>