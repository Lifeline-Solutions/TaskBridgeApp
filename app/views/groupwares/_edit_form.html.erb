<%= form_with(model: [@software, @groupware], method: :put) do |f| %>
  <div class="relative z-0 w-full mb-6 group">
    <%= f.label :name, ('name *'), class: "capitalize block mb-1 text-sm font-medium" %><br />
    <%= f.text_field :name, class: "border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: '' %>
    <%= f.label :name, ('Description *'), class: "capitalize block m-1 text-sm font-medium" %><br />
    <%= f.text_field :description, class: "border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: '' %>
    <div class="relative z-0 w-full mb-6 group">
      <%= f.label :Assignee, ('Assignee *'), class: "capitalize block mb-1 text-sm font-medium text-gray-900 dark:text-white"  %><br />
      <%= f.select :user_id,
                   User.with_agent_project_manager_role.order(:first_name, :last_name).map { |user| [user.name, user.id] },
                   { include_blank: true },
                   class: "border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: '' %>
    </div>
    <%= f.label :image, 'Groupware Image', class: "block font-medium mb-1" %>
    <%= f.file_field :image, class: "w-full mb-4 p-2 border rounded" %>
    <%= f.submit "Submit",   class: 'mb-4 h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] p-3 rounded font-bold rounded-lg text-slate-100'   %>
  </div>
<% end %>