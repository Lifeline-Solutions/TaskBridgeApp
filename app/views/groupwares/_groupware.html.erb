<!-- Desktop Table View (hidden on mobile, shown on md and up) -->
<div class="hidden md:block overflow-x-auto w-full">
  <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-800 rounded-xl shadow-lg">
    <thead class="bg-gradient-to-r from-blue-50 via-blue-100 to-blue-50 dark:from-gray-700 dark:via-gray-800 dark:to-gray-700">
      <tr>
        <th scope="col" class="px-5 py-4 text-xs font-bold text-blue-800 dark:text-white uppercase tracking-wider">
          Software Product
        </th>
        <th scope="col" class="px-5 py-4 text-xs font-bold text-blue-800 dark:text-white uppercase tracking-wider">
          Description
        </th>
        <th scope="col" class="px-5 py-4 text-xs font-bold text-blue-800 dark:text-white uppercase tracking-wider">
          Project Manager
        </th>
        <th scope="col" class="px-5 py-4 text-xs font-bold text-blue-800 dark:text-white uppercase tracking-wider text-center">
          Actions
        </th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
      <% @groupware.each do |group| %>
        <tr class="hover:bg-blue-100 dark:hover:bg-gray-700 transition-colors">
          <td class="px-5 py-4 whitespace-nowrap font-semibold text-gray-900 dark:text-white">
            <%= group.name %>
          </td>
          <td class="px-5 py-4 whitespace-normal text-gray-700 dark:text-white">
            <%= group.description %>
          </td>
          <td class="px-5 py-4 whitespace-nowrap text-gray-700 dark:text-white capitalize">
            <%= group.user.present? ? group.user.name : 'No User Assigned' %>
          </td>
          <td class="px-5 py-4 whitespace-nowrap text-center">
            <div class="flex justify-center gap-2">
              <%= link_to 'View', [group.software, group], class: 'inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors text-xs md:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-400' %>
              <%= link_to 'Edit', edit_software_groupware_path(group.software, group), class: 'inline-block bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors text-xs md:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-green-400' %>
              <% if can? :destroy, group %>
                <%= button_to 'Delete', [group.software, group], method: :delete, data: { 'turbo_method': :delete, 'turbo-confirm': 'Are you sure?' }, class: 'inline-block bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded-lg transition-colors text-xs md:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-red-400' %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<!-- Mobile Card View (shown on mobile, hidden on md and up) -->
<div class="md:hidden space-y-4 mt-4">
  <% @groupware.each do |group| %>
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-4 flex flex-col gap-2 border border-blue-100 dark:border-gray-700">
  <div class="font-bold text-blue-700 dark:text-white text-lg flex items-center gap-2">
        <span class="inline-block w-2 h-2 bg-blue-400 rounded-full"></span>
        <%= group.name %>
      </div>
  <div class="text-gray-700 dark:text-white text-sm"><%= group.description %></div>
      <div class="text-gray-500 dark:text-gray-300 text-xs mb-2">
        <span class="font-semibold dark:text-white">Project Manager:</span>
        <span class="capitalize dark:text-white"><%= group.user.present? ? group.user.name : 'No User Assigned' %></span>
      </div>
      <div class="flex gap-2 mt-2">
        <%= link_to 'View', [group.software, group], class: 'bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-3 rounded-lg text-xs shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-400' %>
        <%= link_to 'Edit', edit_software_groupware_path(group.software, group), class: 'bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-3 rounded-lg text-xs shadow-sm focus:outline-none focus:ring-2 focus:ring-green-400' %>
        <% if can? :destroy, group %>
          <%= button_to 'Delete', [group.software, group], method: :delete, data: { 'turbo_method': :delete, 'turbo-confirm': 'Are you sure?' }, class: 'bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-3 rounded-lg text-xs shadow-sm focus:outline-none focus:ring-2 focus:ring-red-400' %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
