<div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
  <!-- Mobile card view for small screens -->
  <div class="block sm:hidden">
    <% @project.each do |project| %>
      <% if project.assigned_to?(current_user) || current_user.has_role?(:admin) || current_user.has_role?(:observer) || current_user.has_role?(:agent) %>
        <div class="border-b border-gray-200 dark:border-gray-700 p-4 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer" onclick="window.location='<%= project_path(project.id) %>'">
          <!-- Mobile card header -->
          <div class="flex items-start space-x-3 mb-3">
            <div class="flex-shrink-0">
              <% if project.image.present? %>
                <%= image_tag(project.image, class: 'w-12 h-12 rounded-lg object-cover') %>
              <% else %>
                <%= image_tag 'default.png', class: 'w-12 h-12 rounded-lg object-cover' %>
              <% end %>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-white truncate">
                <%= project.title %>
              </h3>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">
                <%= project.description.truncate(80) %>
              </p>
            </div>
            <div class="flex-shrink-0">
              <% if current_user.has_role? :admin %>
                <% if can?(:edit, project) || can?(:delete, project) %>
                  <div data-controller="dropdown" data-dropdown-ticket-id-value="<%= project.id %>" onclick="event.stopPropagation()">
                    <%= render partial: 'project/action_dropdown', locals: { project: project } %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
          
          <!-- Mobile card details -->
          <div class="grid grid-cols-2 gap-4 text-xs">
            <div>
              <span class="text-gray-500 dark:text-gray-400 block">Total Tickets</span>
              <span class="font-medium text-gray-900 dark:text-white"><%= project.tickets.count %></span>
            </div>
            <div>
              <span class="text-gray-500 dark:text-gray-400 block">Assignee</span>
              <span class="font-medium text-gray-900 dark:text-white truncate block"><%= project.user.name %></span>
            </div>
            <div>
              <span class="text-gray-500 dark:text-gray-400 block">Client</span>
              <span class="font-medium text-gray-900 dark:text-white truncate block">
                <% if project.present? && project.client.present? %>
                  <%= project.client.name %>
                <% else %>
                  No Client
                <% end %>
              </span>
            </div>
            <div>
              <span class="text-gray-500 dark:text-gray-400 block">Product</span>
              <span class="font-medium text-gray-900 dark:text-white truncate block">
                <% project.softwares.each do |software| %>
                  <%= software.name %>
                <% end %>
              </span>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- Desktop table view -->
  <div class="hidden sm:block overflow-x-auto">
    <table class="w-full text-xs sm:text-sm text-left rtl:text-right text-gray-900 dark:text-gray-400">
      <thead class="text-xs uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-300 border-b border-gray-200 dark:border-gray-600">
        <tr>
          <th scope="col" class="px-3 sm:px-6 py-3 font-medium">Logo</th>
          <th scope="col" class="px-3 sm:px-6 py-3 font-medium">Name</th>
          <th scope="col" class="hidden md:table-cell px-3 sm:px-6 py-3 font-medium">Product Description</th>
          <th scope="col" class="px-3 sm:px-6 py-3 font-medium text-center">Total Tickets</th>
          <th scope="col" class="hidden lg:table-cell px-3 sm:px-6 py-3 font-medium">Assignee</th>
          <th scope="col" class="hidden xl:table-cell px-3 sm:px-6 py-3 font-medium">Client</th>
          <th scope="col" class="hidden xl:table-cell px-3 sm:px-6 py-3 font-medium">Product Category</th>
          <% if current_user.has_role? :admin %>
            <% if can?(:edit, @project) || can?(:delete, @project) %>
              <th scope="col" class="px-3 sm:px-6 py-3 font-medium text-center">Actions</th>
            <% end %>
          <% end %>
        </tr>
      </thead>
      <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
        <% @project.each do |project| %>
          <% if project.assigned_to?(current_user) || current_user.has_role?(:admin) || current_user.has_role?(:observer) || current_user.has_role?(:agent) %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors cursor-pointer" onclick="window.location='<%= project_path(project.id) %>'">
              <td class="px-3 sm:px-6 py-4">
                <div class="flex-shrink-0">
                  <% if project.image.present? %>
                    <%= image_tag(project.image, class: 'w-10 h-10 sm:w-12 sm:h-12 rounded-lg object-cover') %>
                  <% else %>
                    <%= image_tag 'default.png', class: 'w-10 h-10 sm:w-12 sm:h-12 rounded-lg object-cover' %>
                  <% end %>
                </div>
              </td>
              <td class="px-3 sm:px-6 py-4">
                <div class="text-sm font-medium text-gray-900 dark:text-white">
                  <%= project.title.truncate_words(3) %>
                </div>
              </td>
              <td class="hidden md:table-cell px-3 sm:px-6 py-4">
                <div class="text-sm text-gray-500 dark:text-gray-400 max-w-xs truncate">
                  <%= project.description.truncate(50) %>
                </div>
              </td>
              <td class="px-3 sm:px-6 py-4 text-center">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                  <%= project.tickets.count %>
                </span>
              </td>
              <td class="hidden lg:table-cell px-3 sm:px-6 py-4">
                <div class="text-sm text-gray-900 dark:text-white truncate max-w-32">
                  <%= project.user.name %>
                </div>
              </td>
              <td class="hidden xl:table-cell px-3 sm:px-6 py-4">
                <div class="text-sm text-gray-500 dark:text-gray-400 truncate max-w-32">
                  <% if project.present? && project.client.present? %>
                    <%= project.client.name %>
                  <% else %>
                    <span class="text-gray-400 italic">No Client Assigned</span>
                  <% end %>
                </div>
              </td>
              <td class="hidden xl:table-cell px-3 sm:px-6 py-4">
                <div class="text-sm text-gray-500 dark:text-gray-400 truncate max-w-32">
                  <% project.softwares.each do |software| %>
                    <%= software.name %>
                  <% end %>
                </div>
              </td>
              <% if current_user.has_role? :admin %>
                <% if can?(:edit, project) || can?(:delete, project) %>
                  <td class="px-3 sm:px-6 py-4 text-center" onclick="event.stopPropagation()">
                    <div data-controller="dropdown" data-dropdown-ticket-id-value="<%= project.id %>">
                      <%= render partial: 'project/action_dropdown', locals: { project: project } %>
                    </div>
                  </td>
                <% end %>
              <% end %>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Project count footer -->
  <% if (current_user.has_role?(:'project manager') || current_user.has_role?(:agent)) && current_user.projects.count > 0 %>
    <div class="px-4 sm:px-6 py-3 bg-gray-50 dark:bg-gray-700 border-t border-gray-200 dark:border-gray-600">
      <p class="text-sm text-gray-600 dark:text-gray-400">
        <span class="font-medium"><%= current_user.projects.count %></span>
        project<%= 's' if current_user.projects.count != 1 %> assigned to you
      </p>
    </div>
  <% end %>
</div>
