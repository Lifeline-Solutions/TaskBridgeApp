<% provide(:title, "Add Support Desk") %>

<!-- Main container with responsive padding -->
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 p-2 sm:p-4 lg:p-6">
  <!-- Back button section -->
  <div class="mb-6">
    <div class="flex items-center">
      <%= button_to project_index_path, method: :get, 
          class: 'inline-flex items-center px-4 py-2 bg-gray-600 hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 text-white text-sm font-medium rounded-lg transition-all duration-200 focus:outline-none dark:bg-gray-600 dark:hover:bg-gray-700 dark:focus:ring-gray-800', 
          id: 'button' do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Support Desks
      <% end %>
    </div>
    
    <!-- Breadcrumb -->
    <nav class="flex mt-4 text-sm text-gray-500 dark:text-gray-400" aria-label="Breadcrumb">
      <%= link_to project_index_path, class: "hover:text-blue-600 dark:hover:text-blue-400 transition-colors" do %>
        Support Desks
      <% end %>
      <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
      </svg>
      <span class="text-gray-900 dark:text-white font-medium">Add New</span>
    </nav>
  </div>

  <!-- Form container -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-4 sm:p-6 lg:p-8">
    <div class="mb-6">
      <h1 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">Create New Support Desk</h1>
      <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">Fill in the details to create a new support desk for your organization.</p>
    </div>

    <%= form_with model: @project, url: project_index_url, method: :post, data: { turbo: false }, local: true, 
        class: "space-y-6" do |f| %>
      
      <!-- Basic Information Section -->
      <div class="space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Title Field -->
          <div class="space-y-2">
            <%= f.label :title, 'Support Desk Title *', 
                class: "block text-sm font-medium text-gray-900 dark:text-white" %>
            <%= f.text_field :title, 
                class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 transition-colors", 
                placeholder: 'Enter support desk title', 
                required: true %>
          </div>

          <!-- Profile Picture Field -->
          <div class="space-y-2">
            <%= f.label :image, 'Profile Picture', 
                class: "block text-sm font-medium text-gray-900 dark:text-white" %>
            <div class="relative">
              <%= f.file_field :image, 
                  class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white file:mr-4 file:py-1 file:px-3 file:rounded-full file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 dark:file:bg-gray-600 dark:file:text-gray-300" %>
            </div>
          </div>
        </div>

        <!-- Description and Assignee -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Description Field -->
          <div class="space-y-2">
            <%= f.label :description, 'Description *', 
                class: "block text-sm font-medium text-gray-900 dark:text-white" %>
            <%= f.text_area :description, 
                class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 transition-colors", 
                placeholder: 'Describe the purpose and scope of this support desk', 
                rows: 3, 
                required: true %>
          </div>

          <!-- Assignee Field -->
          <div class="space-y-2">
            <%= f.label :user_id, 'Assignee *', 
                class: "block text-sm font-medium text-gray-900 dark:text-white" %>
            <%= f.select :user_id, 
                User.with_agent_project_manager_role.order(:first_name, :last_name).map { |user| [user.name, user.id] }, 
                { prompt: "Select an assignee" },
                class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 transition-colors", 
                required: true %>
          </div>
        </div>

        <!-- Products and Services -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Product Categories -->
          <div class="space-y-2">
            <%= f.label :software_ids, 'Product Categories *', 
                class: "block text-sm font-medium text-gray-900 dark:text-white" %>
            <%= f.collection_select :software_ids, Software.all, :id, :name,
                { prompt: "Select products", include_hidden: false },
                class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 transition-colors",
                data: { action: "change->form#updateGroupwareOptions" },
                multiple: true %>
            <p class="text-xs text-gray-500 dark:text-gray-400">Hold Ctrl/Cmd to select multiple items</p>
          </div>

          <!-- Sub Categories -->
          <div class="space-y-2">
            <%= f.label :groupware_ids, 'Sub Categories *', 
                class: "block text-sm font-medium text-gray-900 dark:text-white" %>
            <%= f.collection_select :groupware_ids, @project.groupwares.where(software_id: @project.software_ids), :id, :name,
                { prompt: "Select sub products", include_hidden: false },
                class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 transition-colors",
                id: "groupware-select",
                multiple: true %>
            <p class="text-xs text-gray-500 dark:text-gray-400">Hold Ctrl/Cmd to select multiple items</p>
          </div>
        </div>
        <!-- Client and Date Information -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Client Selection -->
          <div class="space-y-2">
            <%= f.label :client_id, 'Client *', 
                class: "block text-sm font-medium text-gray-900 dark:text-white" %>
            <%= f.collection_select :client_id, Client.all, :id, :name, 
                { prompt: "Select a client" }, 
                class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 transition-colors", 
                required: true %>
          </div>

          <!-- Start Date -->
          <div class="space-y-2">
            <%= f.label :start_date, 'Start Date *', 
                class: "block text-sm font-medium text-gray-900 dark:text-white" %>
            <%= f.date_field :start_date, 
                class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 transition-colors", 
                required: true %>
          </div>
        </div>

        <!-- Special Service Option -->
        <div class="flex items-center space-x-3 p-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg">
          <div class="flex items-center">
            <%= f.check_box :special, 
                class: "w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600" %>
          </div>
          <div class="flex-1">
            <%= f.label :special, 'Special Service', 
                class: "text-sm font-medium text-gray-900 dark:text-white" %>
            <p class="text-xs text-gray-600 dark:text-gray-400">Mark this as a special service desk with enhanced priority</p>
          </div>
        </div>

        <!-- Content/Subject Section -->
        <div class="space-y-2">
          <%= f.label :content, 'Description & Scope *', 
              class: "block text-sm font-medium text-gray-900 dark:text-white" %>
          <div data-controller="text-limit" data-text-limit-limit-value="3000" class="space-y-2">
            <div class="flex justify-between items-center">
              <p class="text-xs text-gray-500 dark:text-gray-400">Provide detailed description and scope of work</p>
              <p id="char-count" class="text-xs text-gray-500 dark:text-gray-400">0/3000</p>
            </div>
            <%= f.rich_text_area :content, 
                id: "content",
                data: { text_limit_target: "content" },
                class: "min-h-[200px] w-full border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 #{@project.errors[:content].any? ? 'border-red-500' : ''}",
                required: true %>
            <% if @project.errors[:content].any? %>
              <p class="text-red-500 text-sm"><%= @project.errors[:content].join(', ') %></p>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Form Actions -->
      <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-gray-200 dark:border-gray-600">
        <%= button_to project_index_path, method: :get, 
            class: 'inline-flex items-center justify-center px-6 py-3 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-lg text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors w-full sm:w-auto' do %>
          Cancel
        <% end %>
        
        <%= f.submit 'Create Support Desk', 
            class: 'inline-flex items-center justify-center px-6 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors w-full sm:w-auto',
            data: { disable_with: 'Creating...' } %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    const form = document.querySelector('form');
    const contentField = document.querySelector('[data-trix-editor]');
    const submitButton = form?.querySelector('input[type="submit"]');

    if (form && contentField && submitButton) {
      form.addEventListener('submit', (event) => {
        const editorContent = contentField.editor?.getDocument().toString().trim();

        if (!editorContent) {
          event.preventDefault();
          contentField.classList.add('border-red-500');
          // Show error message
          const errorMsg = document.createElement('p');
          errorMsg.className = 'text-red-500 text-sm mt-1';
          errorMsg.textContent = 'Content is required';
          if (!contentField.parentNode.querySelector('.text-red-500')) {
            contentField.parentNode.appendChild(errorMsg);
          }
        } else {
          contentField.classList.remove('border-red-500');
          // Remove any existing error messages
          const existingError = contentField.parentNode.querySelector('.text-red-500');
          if (existingError) {
            existingError.remove();
          }
        }
      });

      // Add loading state to submit button
      submitButton.addEventListener('click', function() {
        setTimeout(() => {
          this.disabled = true;
          this.value = 'Creating Support Desk...';
          this.classList.add('opacity-50', 'cursor-not-allowed');
        }, 100);
      });
    }
  });
</script>