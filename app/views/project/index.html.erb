<% provide(:title, "Support Desks") %>

<% if flash[:notice] %>
  <div class="bg-[#1a237e] border border-[#4caf50] text-white px-4 py-3 rounded mb-4 shadow-md">
    <p><%= flash[:notice] %></p>
  </div>
<% elsif flash[:alert] %>
  <div class="bg-red-600 border border-red-400 text-white px-4 py-3 rounded mb-4 shadow-md">
    <p><%= flash[:alert] %></p>
  </div>
<% end %>

<!-- Main Container with responsive padding -->
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 p-2 sm:p-4 lg:p-6">
  <!-- Topbar Section -->
  <div class="mb-4 lg:mb-6">
    <%= render 'project/topbar' %>
  </div>
  
  <!-- Project Table Section with responsive container -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
      <%= render 'project/project_table' %>
    </div>
  </div>
  
  <!-- Pagination Section with improved responsive layout -->
  <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mt-6 p-4 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
    <div class="flex items-center gap-2 sm:gap-4 w-full sm:w-auto justify-center sm:justify-start">
      <% if @page > 1 %>
        <%= link_to 'Previous',
          project_index_path(page: @page - 1, query: params[:query]),
          class: 'bg-blue-600 hover:bg-blue-500 px-3 sm:px-4 py-2 rounded text-white text-sm font-semibold transition-all uppercase flex-shrink-0' %>
      <% end %>
      
      <span class="text-sm font-medium text-gray-700 dark:text-gray-300 whitespace-nowrap">
        Page <%= @page %> of <%= @total_pages %>
      </span>
      
      <% if @page < @total_pages %>
        <%= link_to 'Next',
          project_index_path(page: @page + 1, query: params[:query]),
          class: 'bg-blue-600 hover:bg-blue-500 px-3 sm:px-4 py-2 rounded text-white text-sm font-semibold transition-all uppercase flex-shrink-0' %>
      <% end %>
    </div>
    
    <!-- Page info for larger screens -->
    <div class="hidden sm:flex items-center text-sm text-gray-500 dark:text-gray-400">
      <% if @project.any? %>
        <span>Showing <%= @project.count %> support desk<%= 's' if @project.count != 1 %></span>
      <% else %>
        <span>No support desks found</span>
      <% end %>
    </div>
  </div>
</div>
