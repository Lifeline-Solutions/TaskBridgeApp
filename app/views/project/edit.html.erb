<% provide(:title, "Edit Support Desk: #{@project.title}") %>

<!-- Responsive Container -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <!-- Header Section -->
  <div class="mb-8">
    <%= render 'project/new_back' %>
    <div class="mt-4">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">Edit Support Desk</h1>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Update the support desk details and configuration</p>
    </div>
  </div>

  <!-- Form Container -->
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700">
    <%= form_with model: @project, url: project_path(@project), method: :patch, 
        class: "p-6 sm:p-8", 
        local: true do |f| %>
      
      <div class="space-y-8">
        <!-- Basic Information Section -->
        <div class="border-b border-gray-200 dark:border-gray-600 pb-8">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Basic Information</h2>
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Project Title -->
            <div class="space-y-2">
              <%= f.label :title, 'Support Desk Title *', 
                  class: "block text-sm font-medium text-gray-900 dark:text-white" %>
              <%= f.text_field :title, 
                  class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 transition-colors", 
                  placeholder: 'Enter support desk title', 
                  required: true %>
            </div>

            <!-- Project Description -->
            <div class="space-y-2">
              <%= f.label :description, 'Description *', 
                  class: "block text-sm font-medium text-gray-900 dark:text-white" %>
              <%= f.text_field :description, 
                  class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 transition-colors", 
                  placeholder: 'Brief description of the support desk', 
                  required: true %>
            </div>
          </div>
        </div>

        <!-- Image Management Section -->
        <div class="border-b border-gray-200 dark:border-gray-600 pb-8">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Project Image</h2>
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Current Image Display -->
            <div class="space-y-4">
              <label class="block text-sm font-medium text-gray-900 dark:text-white">Current Image</label>
              <% if @project.image.present? %>
                <div class="relative inline-block">
                  <%= image_tag @project.image, 
                      class: "w-32 h-32 object-cover rounded-lg border-2 border-gray-200 dark:border-gray-600" %>
                  <div class="absolute -top-2 -right-2 bg-green-500 text-white text-xs px-2 py-1 rounded-full">
                    Current
                  </div>
                </div>
              <% else %>
                <div class="w-32 h-32 bg-gray-100 dark:bg-gray-700 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg flex items-center justify-center">
                  <span class="text-gray-500 dark:text-gray-400 text-sm">No image</span>
                </div>
              <% end %>
            </div>

            <!-- Upload New Image -->
            <div class="space-y-2">
              <%= f.label :image, 'Upload New Image', 
                  class: "block text-sm font-medium text-gray-900 dark:text-white" %>
              <%= f.file_field :image, 
                  class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 transition-colors",
                  accept: "image/*" %>
              <p class="text-xs text-gray-500 dark:text-gray-400">Supported formats: JPG, PNG, GIF (Max: 5MB)</p>
            </div>
          </div>
        </div>

        <!-- Assignment & Product Configuration -->
        <div class="border-b border-gray-200 dark:border-gray-600 pb-8">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Assignment & Products</h2>
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Assignee -->
            <div class="space-y-2">
              <%= f.label :user_id, 'Assignee *', 
                  class: "block text-sm font-medium text-gray-900 dark:text-white" %>
              <%= f.select :user_id, 
                  User.with_agent_project_manager_role.order(:first_name, :last_name).map { |user| [user.name, user.id] }, 
                  { prompt: "Select assignee" },
                  class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 transition-colors", 
                  required: true %>
            </div>

            <!-- Client -->
            <div class="space-y-2">
              <%= f.label :client_id, 'Client *', 
                  class: "block text-sm font-medium text-gray-900 dark:text-white" %>
              <%= f.collection_select :client_id, Client.all, :id, :name, 
                  { prompt: "Select client" }, 
                  class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 transition-colors", 
                  required: true %>
            </div>

            <!-- Product Categories -->
            <div class="space-y-2">
              <%= f.label :software_ids, 'Product Categories *', 
                  class: "block text-sm font-medium text-gray-900 dark:text-white" %>
              <%= f.collection_select :software_ids, Software.all, :id, :name,
                  { prompt: "Select products", include_hidden: false },
                  class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 transition-colors",
                  data: { action: "change->form#updateGroupwareOptions" },
                  multiple: true %>
            </div>

            <!-- Sub Categories -->
            <div class="space-y-2">
              <%= f.label :groupware_ids, 'Sub Categories *', 
                  class: "block text-sm font-medium text-gray-900 dark:text-white" %>
              <%= f.collection_select :groupware_ids, @project.groupwares.where(software_id: @project.software_ids), :id, :name,
                  { prompt: "Select sub products", include_hidden: false },
                  class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 transition-colors",
                  id: "groupware-select",
                  multiple: true %>
            </div>
          </div>
        </div>

        <!-- Project Details -->
        <div class="border-b border-gray-200 dark:border-gray-600 pb-8">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Project Details</h2>
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Start Date -->
            <div class="space-y-2">
              <%= f.label :start_date, 'Start Date *', 
                  class: "block text-sm font-medium text-gray-900 dark:text-white" %>
              <%= f.date_field :start_date, 
                  class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 transition-colors", 
                  required: true %>
            </div>

            <!-- Special Service Option -->
            <div class="flex items-center space-x-3 p-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg">
              <div class="flex items-center">
                <%= f.check_box :special, 
                    class: "w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600" %>
              </div>
              <div class="flex-1">
                <%= f.label :special, 'Special Service', 
                    class: "text-sm font-medium text-gray-900 dark:text-white" %>
                <p class="text-xs text-gray-600 dark:text-gray-400">Mark this as a special service desk with enhanced priority</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Content Section -->
        <div class="space-y-2">
          <%= f.label :content, 'Description & Scope *', 
              class: "block text-sm font-medium text-gray-900 dark:text-white" %>
          <div data-controller="text-limit" data-text-limit-limit-value="1200" class="space-y-2">
            <div class="flex justify-between items-center">
              <p class="text-xs text-gray-500 dark:text-gray-400">Provide detailed description and scope of work</p>
              <p id="char-count" class="text-xs text-gray-500 dark:text-gray-400">0/1200</p>
            </div>
            <%= f.rich_text_area :content, 
                id: "content",
                data: { text_limit_target: "content" },
                class: "min-h-[200px] w-full border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 #{@project.errors[:content].any? ? 'border-red-500' : ''}",
                required: true %>
            <% if @project.errors[:content].any? %>
              <p class="text-red-500 text-sm"><%= @project.errors[:content].join(', ') %></p>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Form Actions -->
      <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-gray-200 dark:border-gray-600">
        <%= button_to project_path(@project), method: :get, 
            class: 'inline-flex items-center justify-center px-6 py-3 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-lg text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors w-full sm:w-auto' do %>
          Cancel
        <% end %>
        
        <%= f.submit 'Update Support Desk', 
            class: 'inline-flex items-center justify-center px-6 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors w-full sm:w-auto',
            data: { disable_with: 'Updating...' } %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    const form = document.querySelector('form');
    const contentField = document.querySelector('[data-trix-editor]');
    const submitButton = form?.querySelector('input[type="submit"]');

    if (form && contentField && submitButton) {
      form.addEventListener('submit', (event) => {
        const editorContent = contentField.editor?.getDocument().toString().trim();

        if (!editorContent) {
          event.preventDefault();
          contentField.classList.add('border-red-500');
          // Show error message
          const errorMsg = document.createElement('p');
          errorMsg.className = 'text-red-500 text-sm mt-1';
          errorMsg.textContent = 'Content is required';
          if (!contentField.parentNode.querySelector('.text-red-500')) {
            contentField.parentNode.appendChild(errorMsg);
          }
        } else {
          contentField.classList.remove('border-red-500');
          // Remove any existing error messages
          const existingError = contentField.parentNode.querySelector('.text-red-500');
          if (existingError) {
            existingError.remove();
          }
        }
      });

      // Add loading state to submit button
      submitButton.addEventListener('click', function() {
        setTimeout(() => {
          this.disabled = true;
          this.value = 'Updating Support Desk...';
          this.classList.add('opacity-50', 'cursor-not-allowed');
        }, 100);
      });
    }
  });
</script>

