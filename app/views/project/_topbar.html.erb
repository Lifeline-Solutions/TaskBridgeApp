<div class="w-full">
  <% if can? :create, @project %>
    <% if current_user.has_role? :admin or current_user.has_role?('project manager') %>
      <div class="flex flex-row justify-between items-center w-full gap-2">
        
        <!-- Back Button (left) -->
        <%= button_to root_path, method: :get, 
            class: 'bg-gray-600 hover:bg-gray-700 px-4 py-2.5 rounded-lg font-bold text-slate-100 flex items-center justify-center transition-all duration-200 w-auto' do %>
          &#8656; Back
        <% end %>

        <!-- Search Bar -->
        <div class="flex-1 max-w-2xl px-4">
          <%= form_with url: project_index_path, method: :get, class: 'relative w-full' do |f| %>
            <div class="relative">
              <%= f.text_field :query,
                  value: params[:query],
                  class: "w-full pl-10 pr-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all",
                  placeholder: "Search tickets and defects..." %>
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>
              <% if params[:query].present? %>
                 <%= link_to project_index_path, class: "absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 dark:hover:text-gray-200" do %>
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Add Service Desk Button (right) -->
        <%= button_to new_project_path, method: :get, 
            class: 'bg-[#3F8CFF] hover:bg-[#3A81EB] px-4 py-2.5 rounded-lg font-bold text-slate-100 flex items-center justify-center transition-all duration-200 w-auto' do %>
          + Add Service Desk
        <% end %>

      </div>
    <% end %>
  <% end %>
</div>
