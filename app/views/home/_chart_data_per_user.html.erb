<% if current_user.has_role?('admin') or current_user.has_role?('project manager') %>
  <div class="p-2 w-full">
    <%= form_with url: home_index_path, method: :get, local: true do %>
      <div class="flex flex-col sm:flex-row justify-center gap-2 sm:gap-3">
        <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
          <div class="flex flex-col gap-1 w-full sm:w-auto">
            <%= label_tag :start_date, 'Start Date', class: "capitalize text-sm font-bold" %>
            <%= date_field_tag :start_date, params[:start_date], class: "h-10 sm:h-12 border border-[#3F8CFF] hover:border-[#3A81EB] bg-white dark:bg-gray-700 border-2 rounded-lg w-full" %>
          </div>
          <div class="flex flex-col gap-1 w-full sm:w-auto">
            <%= label_tag :end_date, 'End Date', class: "capitalize text-sm font-bold" %>
            <%= date_field_tag :end_date, params[:end_date], class: "h-10 sm:h-12 border border-[#3F8CFF] hover:border-[#3A81EB] bg-white dark:bg-gray-700 border-2 rounded-lg w-full" %>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
          <div class="flex flex-col gap-1 w-full sm:w-auto">
            <%= label_tag :grouping_period, 'Time Period', class: "capitalize text-sm font-bold" %>
            <%= select_tag :grouping_period, options_for_select([%w[Day day], %w[Month month], %w[Year year]], params[:grouping_period]), class: "h-10 sm:h-12 border border-[#3F8CFF] hover:border-[#3A81EB] bg-white dark:bg-gray-700 border-2 rounded-lg w-full" %>
          </div>
          <div class="flex flex-col gap-1 w-full sm:w-auto">
            <%= label_tag :user_id, "Select User", class: "capitalize text-sm font-bold" %>
            <% assigned_user = User.with_assigned_role %>
            <%= select_tag :user_id, options_from_collection_for_select(assigned_user, :id, :name), include_blank: true, class: "h-10 sm:h-12 border border-[#3F8CFF] hover:border-[#3A81EB] bg-white dark:bg-gray-700 border-2 rounded-lg w-full" %>
          </div>
        </div>
        <div class="flex items-end justify-center sm:justify-start mt-2 sm:mt-0">
          <%= submit_tag 'Search', class: 'h-10 sm:h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] px-4 py-2 rounded font-bold rounded-lg text-slate-100 w-full sm:w-auto', id: 'button' %>
        </div>
      </div>
    <% end %>
    <div class="mt-4 overflow-x-auto">
      <%= column_chart @chart_data_per_user, 
            colors: %w[#3B82F6 #EF4444 #10B981 #F97316 #8B5CF6 #34D399 #F43F5E #A3E635 #6366F1 #EC4899], 
            library: { 
              legend: { position: 'bottom' }, 
              plugins: { datalabels: { align: 'end', anchor: 'end' } },
              responsive: true,
              maintainAspectRatio: false,
              height: '300px'
            } %>
    </div>
    <div class="flex justify-center mt-4">
      <p class="text-base sm:text-lg font-semibold">Total Tickets: <%= @total_tickets_per_project.values.sum %></p>
    </div>
  </div>
<% end %>