<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 mb-4 w-full overflow-x-auto">
  <%= link_to product_index_path do %>
    <div class="col-span-1 flex items-center dark:bg-gray-700 justify-between p-3 sm:p-4 h-20 sm:h-24 rounded shadow hover:shadow-lg w-full border border-gray-200 dark:border-gray-500 hover:border-blue-400 hover:ring-2 hover:ring-blue-200 transition-all duration-200">
      <p class="text-xs sm:text-sm truncate">
        Number of Projects
      </p>
      <span class="text-lg sm:text-xl font-bold">
        <%= current_user.all_product_for_the_current_user_count %>
      </span>
    </div>
  <% end %>
  <% if current_user.projects.any? %>
    <%#= link_to project_tickets_path(project_id: current_user.projects.first.id, status: 'open', user_id: current_user.id), class: 'flex items-center justify-between w-full' do %>
      <div class="col-span-1 flex items-center dark:bg-gray-700 justify-between p-3 sm:p-4 h-20 sm:h-24 rounded shadow hover:shadow-lg w-full border border-gray-200 dark:border-gray-500 hover:border-blue-400 hover:ring-2 hover:ring-blue-200 transition-all duration-200">
        <p class="text-xs sm:text-sm truncate">
          My Open Project
        </p>
        <span class="text-lg sm:text-xl font-bold">
          <%= current_user.all_open_tasks_for_the_current_user_count %>
        </span>
      </div>
    <%# end %>
  <% else %>
    <div class="col-span-1 flex items-center dark:bg-gray-700 justify-between p-3 sm:p-4 h-20 sm:h-24 rounded shadow hover:shadow-lg w-full border border-gray-200 dark:border-gray-500 hover:border-blue-400 hover:ring-2 hover:ring-blue-200 transition-all duration-200">

      <p class="text-xs sm:text-sm truncate">
        No Tasks Projects Available
      </p>
    </div>
  <% end %>

  <% if current_user.products.any? %>
    <%#= link_to all_tickets_project_tickets_path(project_id: current_user.projects.first.id, status: 'open'), class: 'flex items-center justify-between w-full' do %>
      <div class="col-span-1 flex items-center dark:bg-gray-700 justify-between p-3 sm:p-4 h-20 sm:h-24 rounded shadow hover:shadow-lg w-full border border-gray-200 dark:border-gray-500 hover:border-blue-400 hover:ring-2 hover:ring-blue-200 transition-all duration-200">
        <p class="text-xs sm:text-sm truncate">
          Total Number of Open Tickets
        </p>
        <span class="text-lg sm:text-xl font-bold">
          <%= @total_no_of_open_tasks_for_current_user_count %>
        </span>
      </div>
    <%# end %>
  <% else %>
    <div class="col-span-1 flex items-center dark:bg-gray-700 justify-between p-3 sm:p-4 h-20 sm:h-24 rounded shadow hover:shadow-lg w-full border border-gray-200 dark:border-gray-500 hover:border-blue-400 hover:ring-2 hover:ring-blue-200 transition-all duration-200">
      <p class="text-xs sm:text-sm truncate">
        No Open Tasks Available
      </p>
    </div>
  <% end %>
</div>