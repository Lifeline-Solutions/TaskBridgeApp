<div class="relative inline-block text-left">
  <div>
    <button
      type="button"
      class="inline-flex justify-center items-center p-1.5 rounded-full hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white/50 transition-all duration-200"
      id="mobile-menu-button-<%= ticket.id %>"
      aria-expanded="false"
      aria-haspopup="true"
      data-action="click->dropdown#toggle">
      
      <svg class="w-4 h-4 text-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 18.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z" />
      </svg>
    </button>
  </div>

  <div id="dropdown-<%= ticket.id %>"
       data-dropdown-target="menu"
       class="hidden origin-top-right absolute bg-white dark:bg-gray-800 right-0 top-full mt-2 rounded-lg shadow-xl border border-gray-200 dark:border-gray-600 focus:outline-none z-50 w-48 overflow-hidden">
    
    <div class="py-1" role="none">
      <!-- View Action -->
      <div class="flex items-center px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700 border-b border-gray-100 dark:border-gray-600">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-blue-600 dark:text-blue-400 mr-3">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
        <%= link_to 'View Details', project_ticket_path(ticket.project, ticket), 
            class: 'text-sm font-medium text-gray-900 dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-400 flex-1',
            data: { action: "click->dropdown#hide" } %>
      </div>

      <% if can?(:edit, ticket) %>
        <!-- Edit Action -->
        <div class="flex items-center px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700 border-b border-gray-100 dark:border-gray-600">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-green-600 dark:text-green-400 mr-3">
            <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
          </svg>
          <%= link_to 'Edit Ticket', edit_project_ticket_path(ticket.project, ticket), 
              class: 'text-sm font-medium text-gray-900 dark:text-gray-100 hover:text-green-600 dark:hover:text-green-400 flex-1',
              data: { action: "click->dropdown#hide" } %>
        </div>
      <% end %>

      <% if can?(:destroy, ticket) %>
        <!-- Delete Action -->
        <div class="flex items-center px-4 py-3 hover:bg-red-50 dark:hover:bg-red-900/20">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-red-600 dark:text-red-400 mr-3">
            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
          </svg>
          <%= button_to 'Delete', [ticket.project, ticket], 
              method: :delete, 
              data: { 
                turbo_confirm: 'Are you sure you want to delete this ticket?',
                action: "click->dropdown#hide"
              }, 
              class: 'text-sm font-medium text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 flex-1 text-left' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
