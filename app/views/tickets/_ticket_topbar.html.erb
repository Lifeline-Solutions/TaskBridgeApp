<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
  <!-- Project details -->
  <div class="flex items-center gap-3 sm:gap-4 flex-shrink-0">
    <div class="flex-shrink-0">
      <% if @project.image.present? %>
        <%= image_tag(@project.image, class: "w-12 h-12 sm:w-14 sm:h-14 md:w-16 md:h-16 rounded-full object-cover") %>
      <% else %>
        <%= image_tag "default.png", class: "w-12 h-12 sm:w-14 sm:h-14 md:w-16 md:h-16 rounded-full object-cover" %>
      <% end %>
    </div>
    <div class="flex flex-col">
      <h1 class="text-lg sm:text-xl md:text-2xl font-semibold"><%= @project.title %></h1>
      <p class="text-xs sm:text-sm md:text-base">
        <%= @project.description.presence || "Client Description if any" %>
      </p>
    </div>
  </div>

  <!-- Buttons -->
  <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
    <%= link_to new_project_ticket_path(@project),
      class: "flex items-center gap-2 border-2 border-[#3F8CFF] bg-[#3F8CFF] hover:bg-white hover:text-[#3F8CFF] px-3 sm:px-4 py-2 rounded-lg text-white font-bold no-underline transition-colors duration-200" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" />
      </svg>
      <span>New Ticket</span>
    <% end %>

    <% unless current_user.has_role?(:client) %>
      <%= link_to manage_users_project_path(@project), data: { turbo_frame: "modal" },
        class: "flex items-center gap-2 border-2 border-blue-500 bg-white hover:bg-blue-500 px-3 sm:px-4 py-2 rounded-lg text-blue-500 hover:text-white font-medium transition-colors duration-200" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z" />
        </svg>
        <span>Manage Users</span>
      <% end %>
    <% end %>
  </div>
</div>
