<% if ticket.statuses.present? %>
  <% ticket.statuses.each do |status| %>
    <% case status.name %>
      <% when 'Resolved' %>
        <span class="inline-flex items-center px-2 py-1 text-xs sm:text-sm font-semibold rounded-lg bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400">Resolved</span>
      <% when 'Closed' %>
        <span class="inline-flex items-center px-2 py-1 text-xs sm:text-sm font-semibold rounded-lg bg-gray-200 text-gray-800 dark:bg-gray-600 dark:text-gray-200">Closed</span>
      <% when 'Reopened' %>
        <span class="inline-flex items-center px-2 py-1 text-xs sm:text-sm font-semibold rounded-lg bg-red-100 text-red-800 dark:bg-red-900/20 dark:text-red-400">Reopened</span>
      <% when 'New' %>
        <span class="inline-flex items-center px-2 py-1 text-xs sm:text-sm font-semibold rounded-lg bg-red-100 text-red-800 dark:bg-red-900/20 dark:text-red-400">New</span>
      <% when 'Under Development' %>
        <span class="inline-flex items-center px-2 py-1 text-xs sm:text-sm font-semibold rounded-lg bg-blue-100 text-blue-800 dark:bg-blue-900/20 dark:text-blue-400">Under Development</span>
      <% when 'Work in Progress' %>
        <span class="inline-flex items-center px-2 py-1 text-xs sm:text-sm font-semibold rounded-lg bg-gray-100 text-gray-800 dark:bg-gray-600 dark:text-gray-200">Work In Progress</span>
      <% when 'QA Testing' %>
        <span class="inline-flex items-center px-2 py-1 text-xs sm:text-sm font-semibold rounded-lg bg-pink-100 text-pink-800 dark:bg-pink-900/20 dark:text-pink-400">QA Testing</span>
      <% when 'Awaiting Build' %>
        <span class="inline-flex items-center px-2 py-1 text-xs sm:text-sm font-semibold rounded-lg border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300">Awaiting Build</span>
      <% when 'Client Confirmation Pending' %>
        <span class="inline-flex items-center px-2 py-1 text-xs sm:text-sm font-semibold rounded-lg bg-purple-100 text-purple-800 dark:bg-purple-900/20 dark:text-purple-400">Client Confirmation Pending</span>
      <% when 'On-Hold' %>
        <span class="inline-flex items-center px-2 py-1 text-xs sm:text-sm font-semibold rounded-lg bg-yellow-100 text-yellow-800 dark:bg-yellow-900/20 dark:text-yellow-400">On-Hold</span>
      <% when 'Assigned' %>
        <span class="inline-flex items-center px-2 py-1 text-xs sm:text-sm font-semibold rounded-lg bg-blue-100 text-blue-800 dark:bg-blue-900/20 dark:text-blue-400">Assigned</span>
      <% when 'Approved' %>
        <span class="inline-flex items-center px-2 py-1 text-xs sm:text-sm font-semibold rounded-lg bg-green-100 text-green-800 dark:bg-green-900/20 dark:text-green-400">Approved</span>
      <% when 'Pending' %>
        <span class='inline-flex items-center px-2 py-1 text-xs sm:text-sm bg-gradient-to-r from-green-100 to-gray-500 dark:from-green-900/20 dark:to-gray-600 text-center text-green-800 dark:text-green-400 font-semibold rounded-lg'>Pending</span>
      <% when 'Declined' %>
        <span class="inline-flex items-center px-2 py-1 text-xs sm:text-sm font-semibold rounded-lg bg-gray-100 text-gray-800 dark:bg-gray-600 dark:text-gray-200">Declined</span>
    <% end %>
  <% end %>
<% end %>