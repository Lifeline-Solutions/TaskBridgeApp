<% if ticket.statuses.present? %>
  <% ticket.statuses.each do |status| %>
    <% case status.name %>
      <% when 'Resolved' %>
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 border border-green-200 dark:border-green-800">
          <span class="w-1.5 h-1.5 bg-green-500 rounded-full mr-1.5"></span>
          <span class="hidden sm:inline">Resolved</span><span class="sm:hidden">✓</span>
        </span>
      <% when 'Closed' %>
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-gray-200 text-gray-800 dark:bg-gray-600 dark:text-gray-200 border border-gray-300 dark:border-gray-500">
          <span class="w-1.5 h-1.5 bg-gray-500 rounded-full mr-1.5"></span>
          <span class="hidden sm:inline">Closed</span><span class="sm:hidden">■</span>
        </span>
      <% when 'Reopened' %>
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300 border border-red-200 dark:border-red-800">
          <span class="w-1.5 h-1.5 bg-red-500 rounded-full mr-1.5"></span>
          <span class="hidden sm:inline">Reopened</span><span class="sm:hidden">↻</span>
        </span>
      <% when 'New' %>
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300 border border-red-200 dark:border-red-800">
          <span class="w-1.5 h-1.5 bg-red-500 rounded-full mr-1.5"></span>
          <span class="hidden sm:inline">New</span><span class="sm:hidden">New</span>
        </span>
      <% when 'Under Development' %>
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
          <span class="w-1.5 h-1.5 bg-blue-500 rounded-full mr-1.5"></span>
          <span class="hidden sm:inline">Development</span><span class="sm:hidden">Dev</span>
        </span>
      <% when 'Work in Progress' %>
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-indigo-100 text-indigo-800 dark:bg-indigo-900/30 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800">
          <span class="w-1.5 h-1.5 bg-indigo-500 rounded-full mr-1.5"></span>
          <span class="hidden sm:inline">In Progress</span><span class="sm:hidden">In Prog</span>
        </span>
      <% when 'QA Testing' %>
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-pink-100 text-pink-800 dark:bg-pink-900/30 dark:text-pink-300 border border-pink-200 dark:border-pink-800">
          <span class="w-1.5 h-1.5 bg-pink-500 rounded-full mr-1.5"></span>
          <span class="hidden sm:inline">Testing</span><span class="sm:hidden">Testing</span>
        </span>
      <% when 'Awaiting Build' %>
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
          <span class="w-1.5 h-1.5 bg-amber-500 rounded-full mr-1.5"></span>
          <span class="hidden sm:inline">Build</span><span class="sm:hidden">Build</span>
        </span>
      <% when 'Client Confirmation Pending' %>
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300 border border-purple-200 dark:border-purple-800">
          <span class="w-1.5 h-1.5 bg-purple-500 rounded-full mr-1.5"></span>
          <span class="hidden sm:inline">Client Review</span><span class="sm:hidden">Client Review</span>
        </span>
      <% when 'On-Hold' %>
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300 border border-yellow-200 dark:border-yellow-800">
          <span class="w-1.5 h-1.5 bg-yellow-500 rounded-full mr-1.5"></span>
          <span class="hidden sm:inline">On Hold</span><span class="sm:hidden">On Hold</span>
        </span>
      <% when 'Assigned' %>
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-cyan-100 text-cyan-800 dark:bg-cyan-900/30 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800">
          <span class="w-1.5 h-1.5 bg-cyan-500 rounded-full mr-1.5"></span>
          <span class="hidden sm:inline">Assigned</span><span class="sm:hidden">Assigned</span>
        </span>
      <% when 'Approved' %>
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
          <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full mr-1.5"></span>
          <span class="hidden sm:inline">Approved</span><span class="sm:hidden">Approved</span>
        </span>
      <% when 'Pending' %>
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300 border border-orange-200 dark:border-orange-800">
          <span class="w-1.5 h-1.5 bg-orange-500 rounded-full mr-1.5"></span>
          <span class="hidden sm:inline">Pending</span><span class="sm:hidden">Pending</span>
        </span>
      <% when 'Declined' %>
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300 border border-red-200 dark:border-red-800">
          <span class="w-1.5 h-1.5 bg-red-500 rounded-full mr-1.5"></span>
          <span class="hidden sm:inline">Declined</span><span class="sm:hidden">❌</span>
        </span>
    <% end %>
  <% end %>
<% end %>