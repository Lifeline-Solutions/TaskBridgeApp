<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 overflow-hidden" data-controller="modal">
    <!-- Simple Background Overlay -->
    <div class="absolute inset-0 bg-gray-900/60 transition-opacity duration-300" 
         data-action="click->modal#close"></div>

    <!-- Side Panel Container -->
    <div class="fixed inset-y-0 right-0 pl-10 max-w-full flex">
      <!-- Simple close button outside panel -->
      <div class="absolute left-0 top-6 z-20">
        <button class="p-3 text-white bg-gray-900/70 hover:bg-gray-900/90 rounded-l-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-white/50"
                aria-label="Close panel"
                data-action="click->modal#close">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <div class="relative w-screen max-w-2xl lg:max-w-4xl">
        <div class="h-full flex flex-col bg-white dark:bg-gray-900 shadow-xl overflow-hidden transition-transform duration-300 ease-out translate-x-0 border-l-2 border-indigo-500">
          <!-- Simplified Side Panel Header -->
          <div class="sticky top-0 z-10 bg-indigo-600 text-white shadow-lg border-b border-indigo-700">
            <!-- Main header content -->
            <div class="flex items-center justify-between px-6 py-4">
              <div class="flex items-center space-x-4 min-w-0 flex-1">
                <div class="w-10 h-10 bg-indigo-700 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-3 mb-1">
                    <h2 class="text-lg font-bold">Ticket Details</h2>
                    <span class="bg-indigo-700 px-3 py-1 rounded-full text-sm font-medium">
                      #<%= @ticket.unique_id %>
                    </span>
                  </div>
                  <p class="text-indigo-100 text-sm truncate">
                    <%= @ticket.subject %>
                  </p>
                  <div class="flex items-center gap-4 mt-2 text-xs text-indigo-200">
                    <span class="flex items-center gap-1">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                      </svg>
                      <%= @ticket.user&.name || "Unknown" %>
                    </span>
                    <span class="flex items-center gap-1">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                      </svg>
                      <%= @ticket.created_at.strftime("%b %d, %Y") %>
                    </span>
                  </div>
                </div>
              </div>
              
              <!-- Simple close button -->
              <div class="flex-shrink-0 ml-4">
                <button class="p-2 hover:bg-indigo-700 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-white/50"
                        aria-label="Close panel"
                        data-action="click->modal#close">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            </div>
            
            <!-- Status bar -->
            <div class="px-6 pb-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <%= render partial: 'tickets/ticket_status', locals: { ticket: @ticket } %>
                  <%= render partial: 'tickets/priority_severity', locals: { ticket: @ticket } %>
                </div>
                <div class="text-xs text-indigo-200 bg-indigo-700 px-2 py-1 rounded">
                  Last updated <%= time_ago_in_words(@ticket.updated_at) %> ago
                </div>
              </div>
            </div>
          </div>

          <!-- Scrollable Content Area -->
          <div class="flex-1 overflow-y-auto bg-gray-50 dark:bg-gray-900">
            <div class="p-6 space-y-6">

              <!-- Ticket Subject Card -->
              <div class="bg-white dark:bg-gray-800 rounded-lg p-6 border border-gray-200 dark:border-gray-700">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-indigo-600 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-medium text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-2">Subject</h3>
                    <p class="text-lg font-semibold text-gray-900 dark:text-white"><%= @ticket.subject %></p>
                  </div>
                </div>
              </div>

              <!-- Ticket Content Card -->
              <% if @ticket.content.present? %>
                <div class="bg-white dark:bg-gray-800 rounded-lg p-6 border border-gray-200 dark:border-gray-700">
                  <div class="flex items-start gap-4">
                    <div class="w-10 h-10 bg-green-600 rounded-lg flex items-center justify-center flex-shrink-0">
                      <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 2v2h8V6H6zm0 4v6h8v-6H6z" clip-rule="evenodd"/>
                      </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <h3 class="text-sm font-medium text-green-600 dark:text-green-400 uppercase tracking-wider mb-3">Description</h3>
                      <div class="prose prose-sm max-w-none text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-900 rounded-lg p-4 border border-gray-100 dark:border-gray-700">
                        <%= sanitize raw(@ticket.content.to_trix_html.gsub(/\[.*?\]/, '').strip) %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>

              <!-- Image and Details Section -->
              <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
                <div class="px-6 py-4 bg-gray-50 dark:bg-gray-700 border-b border-gray-200 dark:border-gray-600">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
                      <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
                      </svg>
                    </div>
                    <h3 class="text-sm font-medium text-gray-900 dark:text-white">Attachments & Details</h3>
                  </div>
                </div>
                <div class="p-6">
                  <%= render partial: "tickets/ticketshow_top_left" %>
                </div>
              </div>

              <!-- SLA and Target Times -->
              <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
                <div class="px-6 py-4 bg-gray-50 dark:bg-gray-700 border-b border-gray-200 dark:border-gray-600">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-orange-600 rounded-lg flex items-center justify-center">
                      <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                      </svg>
                    </div>
                    <h3 class="text-sm font-medium text-gray-900 dark:text-white">SLA & Target Times</h3>
                  </div>
                </div>
                <div class="p-6">
                  <%= render partial: "tickets/tickets_targets_sla", locals: { ticket: @ticket } %>
                </div>
              </div>

              <!-- Assigned Users Section -->
              <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
                <div class="px-6 py-4 bg-gray-50 dark:bg-gray-700 border-b border-gray-200 dark:border-gray-600">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
                      <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3z"/>
                      </svg>
                    </div>
                    <h3 class="text-sm font-medium text-gray-900 dark:text-white">Assigned Users</h3>
                  </div>
                </div>
                <div class="p-6">
                  <%= render 'tickets/assign_people_tickets' %>
                </div>
              </div>

              <!-- Custom Fields Section -->
              <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
                <div class="px-6 py-4 bg-gray-50 dark:bg-gray-700 border-b border-gray-200 dark:border-gray-600">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-purple-600 rounded-lg flex items-center justify-center">
                      <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2H4zm0 2h12v8H4V6z" clip-rule="evenodd"/>
                      </svg>
                    </div>
                    <h3 class="text-sm font-medium text-gray-900 dark:text-white">Custom Fields</h3>
                  </div>
                </div>
                <div class="p-6">
                  <%= render 'tickets/custom_field' %>
                </div>
              </div>

              <!-- Communication Section -->
              <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
                <div class="px-4 py-3 bg-gradient-to-r from-green-50 to-blue-50 dark:from-green-900/20 dark:to-blue-900/20 border-b border-gray-200 dark:border-gray-600">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-gradient-to-br from-green-500 to-blue-500 rounded-lg flex items-center justify-center">
                      <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"/>
                      </svg>
                    </div>
                    <div>
                      <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Communication</h3>
                      <p class="text-xs text-gray-500 dark:text-gray-400">Messages and updates</p>
                    </div>
                  </div>
                </div>
                <div class="p-4">
                  <div id="messages" class="space-y-3 max-h-64 overflow-y-auto">
                    <%= render 'issues/issues_table', ticket_items: @ticket %>
                  </div>
                  
                  <!-- New Message Section -->
                  <% unless @ticket.statuses.first&.name == 'Closed' %>
                    <div data-controller="messages" class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-600">
                      <button id="newMessageButton"
                              class="flex items-center justify-center gap-2 w-full px-4 py-2 bg-gradient-to-r from-green-600 to-blue-600 hover:from-green-700 hover:to-blue-700 text-white font-medium rounded-lg shadow transition-all duration-200"
                              data-action="click->messages#toggleForm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                        </svg>
                        Add Message
                      </button>
                      <div id="messageFormContainer" class="hidden mt-3 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg" data-messages-target="form">
                        <%= render 'issues/form', project: @project, ticket: @ticket, issue: Issue.new %>
                      </div>
                    </div>
                  <% else %>
                    <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-600">
                      <div class="flex items-center justify-center gap-2 p-3 bg-gray-100 dark:bg-gray-700 rounded-lg">
                        <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                        </svg>
                        <span class="text-sm text-gray-600 dark:text-gray-300">Ticket Closed - No new messages</span>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-col gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                <%= link_to project_ticket_path(@ticket.project, @ticket), 
                    class: 'inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 dark:border-gray-600 shadow-sm text-sm font-medium rounded-lg text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all duration-200',
                    data: { action: "click->modal#close" } do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  View Full Details
                <% end %>
                <% if can?(:edit, @ticket) %>
                  <%= link_to edit_project_ticket_path(@ticket.project, @ticket), 
                      class: 'inline-flex items-center justify-center px-4 py-2.5 border border-transparent shadow-sm text-sm font-medium rounded-lg text-white bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all duration-200',
                      data: { action: "click->modal#close" } do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    Edit Ticket
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Simple escape key functionality -->
  <script>
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        const closeBtn = document.querySelector('[data-action="click->modal#close"]');
        if (closeBtn) closeBtn.click();
      }
    });
  </script>

  <!-- Enhanced Image Modal -->
  <div id="imageModal"
       class="modal hidden fixed inset-0 z-[70] overflow-auto bg-black/90 backdrop-blur-lg flex items-center justify-center p-4"
       data-controller="image-modal"
       data-image-modal-target="modal">
    <!-- Close Button -->
    <button class="absolute top-6 right-6 p-3 text-white bg-black/50 hover:bg-black/70 rounded-full transition-all duration-200 transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-white/50"
            data-action="click->image-modal#closeModal"
            data-image-modal-target="closeButton"
            aria-label="Close image modal">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
    
    <!-- Image Container -->
    <div class="relative max-w-7xl max-h-full">
      <img class="block max-w-full max-h-[85vh] object-contain rounded-xl shadow-2xl" 
           id="fullImage" 
           data-image-modal-target="modalImage" 
           alt="Full size image">
    </div>
  </div>
<% end %>