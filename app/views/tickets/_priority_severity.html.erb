
<% if ticket.priority == 'SEVERITY 1' %>
  <span class="inline-flex items-center px-2.5 py-1 rounded-full font-bold text-xs bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300 border border-red-200 dark:border-red-800">
    <span class="hidden sm:inline">SEVERITY </span>1
  </span>
<% elsif ticket.priority == 'SEVERITY 2' %>
  <span class="inline-flex items-center px-2.5 py-1 rounded-full font-bold text-xs bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300 border border-orange-200 dark:border-orange-800">
    <span class="hidden sm:inline">SEVERITY </span>2
  </span>
<% elsif ticket.priority == 'SEVERITY 3' %>
  <span class="inline-flex items-center px-2.5 py-1 rounded-full font-bold text-xs bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300 border border-yellow-200 dark:border-yellow-800">
    <span class="hidden sm:inline">SEVERITY </span>3
  </span>
<% else %>
  <span class="inline-flex items-center px-2.5 py-1 rounded-full font-bold text-xs bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
    <span class="hidden sm:inline">SEVERITY </span>4
  </span>
<% end %>