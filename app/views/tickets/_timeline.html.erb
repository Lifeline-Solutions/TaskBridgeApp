<div class="w-full">
  <%= render 'tickets/search_q' %>

  <!-- Mobile Card View (hidden on lg and up) -->
  <div class="lg:hidden space-y-2">
    <% @ticket.each do |ticket| %>
      <% if ticket.present? %>
        <div class="<%= case ticket.issue
                       when 'SUPPORT' then 'bg-[#007ACC]'
                       when 'NEW FEATURE' then 'bg-[#00B894]'
                       when 'BUG' then 'bg-[#E53935]'
                       when 'REQUEST' then 'bg-[#6c5CE7]'
                       when 'INCIDENT' then 'bg-[#F39C12]'
                       when 'CHANGE REQUEST' then 'bg-[#2ECC71]'
                       else 'bg-gray-500'
                       end %> rounded-lg shadow-sm overflow-hidden">
          <!-- Card Header -->
          <div class="px-3 py-2 border-b border-white border-opacity-20">
            <div class="flex items-center justify-between text-white">
              <div class="flex items-center space-x-2">
                <span class="font-medium text-xs">
                  <%= link_to ticket.unique_id, project_ticket_path(ticket.project, ticket), class: "text-white hover:text-gray-200 font-semibold" %>
                </span>
                <span class="text-xs opacity-70">•</span>
                <span class="text-xs opacity-80"><%= ticket.issue %></span>
              </div>
              <span class="text-xs opacity-80">
                <%= ticket.created_at.strftime("%d %b") %>
              </span>
            </div>
          </div>

          <!-- Card Content -->
          <div class="p-3 space-y-2">
            <!-- Summary Section -->
            <div class="flex items-start space-x-2">
              <%= render partial: 'tickets/summary', locals: { ticket: ticket } %>
            </div>

            <!-- Priority and Status Row -->
            <div class="flex items-center justify-between">
              <div class="flex-shrink-0">
                <%= render partial: 'tickets/priority_severity', locals: { ticket: ticket } %>
              </div>
              <div class="flex-shrink-0 ml-2">
                <%= render partial: 'tickets/ticket_status', locals: { ticket: ticket } %>
              </div>
            </div>

            <!-- Progress Bar -->
            <div class="w-full flex justify-center">
              <%= render partial: 'tickets/progress_bar', locals: { ticket: ticket } %>
            </div>

            <!-- Assignment Info -->
            <div class="space-y-1">
              <div class="flex items-center justify-between text-xs">
                <span class="text-white opacity-70">Assigned:</span>
                <div class="text-right">
                  <% ticket.users.each do |user| %>
                    <% if user.name.present? %>
                      <div class="text-white text-xs">
                        <%= user.name.split(' ').first %>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </div>

              <div class="flex items-center justify-between text-xs">
                <span class="text-white opacity-70">Reporter:</span>
                <span class="text-white text-xs">
                  <%= ticket.user.name.split(' ').first if ticket.user.name.present? %>
                </span>
              </div>

              <% if ticket.add_statuses.present? %>
                <div class="flex items-center justify-between text-xs">
                  <span class="text-white opacity-70">Updated:</span>
                  <span class="text-white text-xs">
                    <%= ticket.add_statuses.first.updated_at.strftime('%d %b') %>
                  </span>
                </div>
              <% end %>
            </div>

            <!-- Actions -->
            <div class="flex justify-end pt-1 border-t border-white border-opacity-20">
              <div data-controller="dropdown" data-dropdown-ticket-id-value="<%= ticket.id %>">
                <%= render partial: 'tickets/action_dropdown', locals: { ticket: ticket } %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- Desktop Table View (hidden on mobile, shown on lg and up) -->
  <div class="hidden lg:block overflow-x-auto h-full">
    <table class="min-w-full divide-y" aria-label="Tickets Table">
      <thead>
        <%= render partial: "tickets/ticket_table_headers" %>
      </thead>
      <tbody class="text-sm">
        <% @ticket.each do |ticket| %>
          <% if ticket.present? %>
            <tr class="<%= case ticket.issue
                           when 'SUPPORT' then 'bg-[#007ACC]'
                           when 'NEW FEATURE' then 'bg-[#00B894]'
                           when 'BUG' then 'bg-[#E53935]'
                           when 'REQUEST' then 'bg-[#6c5CE7]'
                           when 'INCIDENT' then 'bg-[#F39C12]'
                           when 'CHANGE REQUEST' then 'bg-[#2ECC71]'
                           else ''
                           end %> hover:opacity-90 transition-opacity">
              <!-- Date -->
              <td class="px-2 py-2 whitespace-nowrap text-white">
                <%= link_to ticket.created_at.strftime("%d %b %Y"), project_ticket_path(ticket.project, ticket), class: "text-white hover:text-gray-200" %>
              </td>

              <!-- Ticket ID -->
              <td class="px-4 py-4 whitespace-nowrap font-medium uppercase text-white">
                <% if ticket.unique_id.present? %>
                  <%= link_to ticket.unique_id, project_ticket_path(ticket.project, ticket), class: "text-white hover:text-gray-200" %>
                <% end %>
              </td>

              <!-- Issue Type -->
              <td class="px-4 py-4 whitespace-nowrap text-white">
                <%= link_to ticket.issue, project_ticket_path(ticket.project, ticket), class: "text-white hover:text-gray-200" %>
              </td>

              <!-- Severity -->
              <td class="px-4 py-4 whitespace-nowrap">
                <%= render partial: 'tickets/priority_severity', locals: { ticket: ticket } %>
              </td>

              <!-- Summary -->
              <td class="px-4 py-4">
                <div class="grid grid-cols-[auto_1fr_auto] items-center gap-3 sm:gap-4">
                  <%= render partial: 'tickets/summary', locals: { ticket: ticket } %>
                </div>
              </td>

              <!-- Assigned To -->
              <td class="px-4 py-4 whitespace-nowrap text-white">
                <div class="flex flex-col gap-1">
                  <% ticket.users.each do |user| %>
                    <% if user.name.present? %>
                      <div class="text-xs">
                        <span class="font-medium"><%= user.name %></span>
                        <span class="font-semibold opacity-80">
                          <% if user.teams.any? %>
                            (<%= user.teams.map(&:name).join(', ') %>)
                          <% else %>
                            (No Team)
                          <% end %>
                        </span>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </td>

              <!-- Status -->
              <td class="px-4 py-4 whitespace-nowrap">
                <%= render partial: 'tickets/ticket_status', locals: { ticket: ticket } %>
              </td>

              <!-- Progress Bar -->
              <td class="px-4 py-4 whitespace-nowrap">
                <%= render partial: 'tickets/progress_bar', locals: { ticket: ticket } %>
              </td>

              <!-- Reported By -->
              <td class="px-4 py-4 whitespace-nowrap text-white text-xs">
                <% if ticket.user.name.present? %>
                  <%= ticket.user.name %>
                <% end %>
              </td>

              <!-- Last Updated -->
              <td class="px-4 py-4 whitespace-nowrap text-sm text-white">
                <% if ticket.add_statuses.present? %>
                  <%= ticket.add_statuses.first.updated_at.strftime('%H:%M %d %b %Y') %>
                <% end %>
              </td>

              <!-- Actions -->
              <td class="px-4 py-4 whitespace-nowrap font-medium" data-controller="dropdown" data-dropdown-ticket-id-value="<%= ticket.id %>">
                <%= render partial: 'tickets/action_dropdown', locals: { ticket: ticket } %>
              </td>

              <% if current_user.has_role?(:admin) || current_user.has_role?(:agent) || current_user.has_role?('project manager') %>
                <td class="py-2 px-4 font-bold text-center text-white text-xs">
                  <% closed_status = ticket.add_statuses.joins(:status).where(statuses: { name: %w[Closed Resolved Declined] }).order(updated_at: :desc).first %>
                  <% if ticket.created_at %>
                    <% if closed_status %>
                      <%= distance_of_time_in_words(ticket.created_at, closed_status.updated_at).gsub('about ', '') %>
                    <% else %>
                      <%= distance_of_time_in_words(ticket.created_at, Time.current).gsub('about ', '') %>
                    <% end %>
                  <% else %>
                    N/A
                  <% end %>
                </td>
                <td class="px-4 py-4 whitespace-nowrap text-sm text-center hide-on-sidebar text-white">
                  <%= ticket.update_count %>
                </td>
                <td class="px-4 py-4 whitespace-nowrap text-sm text-center hide-on-sidebar text-white">
                  <%= ticket.last_updated_at ? ticket.last_updated_at.strftime("%T") : 'Never' %>
                </td>
              <% end %>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const sidebar = document.getElementById("sidebar");
    const tableColumns = document.querySelectorAll(".hide-on-sidebar");

    function toggleColumns() {
      const isExpanded = sidebar && sidebar.classList.contains("w-64");
      tableColumns.forEach(col => {
        col.style.display = isExpanded ? "none" : "table-cell";
      });
    }

    if (sidebar) {
      toggleColumns();
      const observer = new MutationObserver(toggleColumns);
      observer.observe(sidebar, { attributes: true, attributeFilter: ['class'] });
    }

    document.querySelectorAll("th[scope='col']").forEach(header => {
      header.addEventListener("click", function() {
        const table = this.closest("table");
        const headerIndex = Array.from(this.parentElement.children).indexOf(this);
        const tbody = table.querySelector("tbody");
        const rows = Array.from(tbody.querySelectorAll("tr"));
        const isAscending = !this.classList.contains("asc");
        table.querySelectorAll("th[scope='col']").forEach(h => {
          h.classList.remove("asc", "desc");
        });

        this.classList.add(isAscending ? "asc" : "desc");

        rows.sort((rowA, rowB) => {
          const cellA = rowA.children[headerIndex].textContent.trim();
          const cellB = rowB.children[headerIndex].textContent.trim();

          if (!isNaN(cellA)) {
            return isAscending ? cellA - cellB : cellB - cellA;
          }

          const dateA = Date.parse(cellA);
          const dateB = Date.parse(cellB);
          if (!isNaN(dateA)) {
            return isAscending ? dateA - dateB : dateB - dateA;
          }

          return isAscending ? cellA.localeCompare(cellB) : cellB.localeCompare(cellA);
        });

        rows.forEach(row => tbody.appendChild(row));
      });
    });
  });
</script>