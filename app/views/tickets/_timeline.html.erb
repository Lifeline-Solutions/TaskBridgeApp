<!-- Responsive Timeline Container -->
<div class="relative w-full mb-6 bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm border border-gray-200 dark:border-gray-700">
  <!-- Timeline Header -->
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Activity Timeline</h3>
    <span class="text-sm text-gray-500 dark:text-gray-400"><%= @events.count %> events</span>
  </div>

  <!-- Mobile: Vertical Timeline, Desktop: Horizontal Timeline -->
  <div class="lg:hidden">
    <!-- Mobile Vertical Timeline -->
    <ol class="relative border-l border-gray-200 dark:border-gray-700 ml-4">
      <% @events.each_with_index do |event, index| %>
        <li class="mb-6 ml-6">
          <span class="absolute flex items-center justify-center w-8 h-8 bg-blue-100 rounded-full -left-4 ring-4 ring-white dark:ring-gray-800 dark:bg-blue-900">
            <span class="text-xs font-bold text-blue-800 dark:text-blue-300"><%= index + 1 %></span>
          </span>
          
          <div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-3 border border-gray-200 dark:border-gray-600">
            <div class="flex flex-col space-y-1">
              <h4 class="text-sm font-semibold text-gray-900 dark:text-white"><%= event.user&.name || "System" %></h4>
              <time class="text-xs text-gray-500 dark:text-gray-400"><%= event.created_at.strftime("%b %d, %Y at %H:%M") %></time>
              <p class="text-sm text-gray-700 dark:text-gray-300 mt-2"><%= event.details %></p>
            </div>
          </div>
        </li>
      <% end %>
    </ol>
  </div>

  <!-- Desktop: Horizontal Timeline -->
  <div class="hidden lg:block relative">
    <!-- Scroll Controls -->
    <button
      id="scroll-left"
      class="absolute left-0 top-1/2 -translate-y-1/2 z-20 p-2 bg-white dark:bg-gray-700 rounded-full shadow-md hover:shadow-lg border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-all duration-200"
      style="display: none;"
      aria-label="Scroll timeline left">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>

    <!-- Timeline Container -->
    <div id="timeline-container" class="overflow-x-auto scrollbar-thin scrollbar-thumb-gray-300 dark:scrollbar-thumb-gray-600 px-8">
      <ol class="flex items-start space-x-8 pb-4" style="min-width: max-content;">
        <% @events.each_with_index do |event, index| %>
          <li class="flex-shrink-0 relative">
            <!-- Timeline Node -->
            <div class="flex flex-col items-center">
              <div class="w-10 h-10 bg-blue-100 dark:bg-blue-900 rounded-full flex items-center justify-center mb-3 border-4 border-white dark:border-gray-800 shadow-md">
                <span class="text-sm font-bold text-blue-800 dark:text-blue-300"><%= index + 1 %></span>
              </div>
              
              <!-- Timeline Content -->
              <div class="w-64 bg-gray-50 dark:bg-gray-700 rounded-lg p-4 border border-gray-200 dark:border-gray-600 shadow-sm">
                <h4 class="font-semibold text-gray-900 dark:text-white text-sm mb-1"><%= event.user&.name || "System" %></h4>
                <time class="text-xs text-gray-500 dark:text-gray-400 mb-2 block"><%= event.created_at.strftime("%b %d, %Y at %H:%M") %></time>
                <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed"><%= event.details %></p>
              </div>
              
              <!-- Connecting Line -->
              <% unless index == @events.count - 1 %>
                <div class="absolute top-5 left-10 w-8 h-0.5 bg-gray-300 dark:bg-gray-600"></div>
              <% end %>
            </div>
          </li>
        <% end %>
      </ol>
    </div>

    <button
      id="scroll-right"
      class="absolute right-0 top-1/2 -translate-y-1/2 z-20 p-2 bg-white dark:bg-gray-700 rounded-full shadow-md hover:shadow-lg border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-all duration-200"
      style="display: none;"
      aria-label="Scroll timeline right">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </button>
  </div>

  <!-- Right Scroll Button -->
  <button
    id="scroll-right"
    class="absolute right-0 z-10 p-2 bg-gray-300 rounded-full shadow hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-500 dark:bg-gray-700 dark:hover:bg-gray-600"
    style="top: 50%; transform: translateY(-50%); display: none;"
    aria-label="Scroll right">
    &#8594;
  </button>
</div>

<style>
  /* Hide the horizontal scrollbar */
  #timeline-container {
    overflow-x: hidden;
    display: flex;
    white-space: nowrap;
  }
</style>

<script>
  document.addEventListener('turbo:load', () => {
    const timelineContainer = document.getElementById('timeline-container');
    const scrollLeftButton = document.getElementById('scroll-left');
    const scrollRightButton = document.getElementById('scroll-right');

    const updateButtonVisibility = () => {
      const scrollWidth = timelineContainer.scrollWidth;
      const clientWidth = timelineContainer.clientWidth;
      const scrollLeft = timelineContainer.scrollLeft;

      if (scrollWidth > clientWidth) {
        scrollLeftButton.style.display = scrollLeft > 0 ? 'block' : 'none';
        scrollRightButton.style.display = scrollLeft < scrollWidth - clientWidth ? 'block' : 'none';
      } else {
        scrollLeftButton.style.display = 'none';
        scrollRightButton.style.display = 'none';
      }
    };

    scrollLeftButton.addEventListener('click', () => {
      timelineContainer.scrollBy({ left: -200, behavior: 'smooth' });
    });

    scrollRightButton.addEventListener('click', () => {
      timelineContainer.scrollBy({ left: 200, behavior: 'smooth' });
    });

    timelineContainer.addEventListener('scroll', updateButtonVisibility);
    window.addEventListener('resize', updateButtonVisibility);

    // Initial check
    updateButtonVisibility();
  });
</script>
