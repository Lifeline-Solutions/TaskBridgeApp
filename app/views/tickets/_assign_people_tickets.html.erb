<% if current_user.has_role?(:admin) || current_user.has_role?('project manager') || current_user.has_role?(:agent) %>
  <div class="col-span-2 mt-6" data-controller="status-modal">
    <div class="flex items-center justify-between mb-4 p-4 rounded-lg bg-gray-50 dark:bg-gray-800 shadow-md border border-gray-200 dark:border-gray-700">
      <div class="flex items-center gap-3 flex-wrap">
      <span class="text-sm font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-200">Assigned Users:</span>
      <% if @ticket.users.any? %>
        <% @ticket.users.each do |user| %>
        <span class="inline-flex items-center px-2 py-1 rounded-full bg-blue-100 dark:bg-blue-700 text-sm font-medium text-blue-800 dark:text-blue-200 mr-2 mb-2">
          <svg class="h-4 w-4 mr-1 text-blue-500 dark:text-blue-300" fill="currentColor" viewBox="0 0 20 20">
          <circle cx="10" cy="10" r="8"/>
          </svg>
          <%= user.name %>
        </span>
        <% end %>
      <% else %>
        <span class="text-red-500 text-sm ml-2">
        No agents assigned. Please assign at least one agent to this ticket.
        </span>
      <% end %>
      </div>
      <% unless (@ticket.statuses.first&.name == 'Closed' or @ticket.statuses.first&.name == 'Resolved') && !current_user.has_role?(:admin) %>
      <button
        data-action="click->status-modal#openModal"
        class="ml-2 px-3 py-1 rounded bg-blue-600 text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-300 transition font-medium"
        aria-label="Assign users"
      >
        Assign
      </button>
      <% end %>
    </div>

    <!-- Assign Users Modal -->
    <div class="hidden fixed inset-0 bg-gray-500 bg-opacity-50 overflow-y-auto h-full w-full z-50"
         data-status-modal-target="modal">
      <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white dark:bg-gray-800">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-medium">Assign Users Modal</h3>
          <button
            data-action="click->status-modal#closeModal"
            class="focus:outline-none text-gray-500 hover:text-gray-700"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <%= form_with url: assign_tag_project_ticket_path(@project, @ticket, data: { turbo: false }), local: true do %>
          <div class="mb-4">
            <%= label_tag :user_id, "Select User", class: "block text-sm font-medium mb-1" %>
            <% available_users = User.with_assigned_role.where.not(id: @ticket.users.pluck(:id)).where(id: @project.users.pluck(:id)).order(:first_name).distinct %>
            <% if available_users.any? %>
              <div class="relative space-y-2">
                <input type="text" id="searchTicketAssignUser" class="mt-1 block w-full pl-3 pr-10 py-2 text-base dark:bg-gray-700 border-gray-300 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md" placeholder="Search User..." onkeyup="filterTicketAssignUserDropdown()">

                <div id="ticketAssignUserDropdown" class="hidden absolute w-full bg-white dark:bg-gray-700 border rounded mt-1 shadow-md max-h-40 overflow-y-auto z-10">
                  <% available_users.each do |user| %>
                    <div class="dropdown-item px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-800 cursor-pointer" data-user-id="<%= user.id %>" onclick="selectTicketAssignUser(this)">
                      <%= user.name %>
                    </div>
                  <% end %>
                </div>

                <input type="hidden" id="selectedTicketAssignUserId" name="user_id" required>
              </div>
            <% else %>
              <p class="text-sm">No available users to assign.</p>
            <% end %>
          </div>

            <div class="flex justify-end space-x-3">
            <button
              type="button"
              data-action="click->status-modal#closeModal"
              class="px-4 py-2 text-sm font-medium border border-gray-300 rounded-md hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
            >
              Cancel
            </button>
            <% if available_users.any? %>
              <%= submit_tag "Assign User", class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
            <% end %>
            </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<script>
  function filterTicketAssignUserDropdown() {
    let input = document.getElementById("searchTicketAssignUser").value.toLowerCase();
    let dropdown = document.getElementById("ticketAssignUserDropdown");
    let items = dropdown.getElementsByClassName("dropdown-item");

    dropdown.classList.remove("hidden");

    let hasMatch = false;
    for (let item of items) {
      let text = item.textContent.toLowerCase();
      if (text.includes(input)) {
        item.style.display = "block";
        hasMatch = true;
      } else {
        item.style.display = "none";
      }
    }

    if (!hasMatch) {
      dropdown.classList.add("hidden");
    }
  }

  function selectTicketAssignUser(element) {
    let userName = element.textContent.trim();
    let userId = element.getAttribute("data-user-id");

    let inputField = document.getElementById("searchTicketAssignUser");
    inputField.value = userName;
    inputField.style.paddingRight = "12px";
    inputField.style.overflow = "visible";

    document.getElementById("selectedTicketAssignUserId").value = userId;
    document.getElementById("ticketAssignUserDropdown").classList.add("hidden");
  }

  document.addEventListener("click", function(event) {
    let dropdown = document.getElementById("ticketAssignUserDropdown");
    let searchInput = document.getElementById("searchTicketAssignUser");

    if (!searchInput.contains(event.target) && !dropdown.contains(event.target)) {
      dropdown.classList.add("hidden");
    }
  });
</script>
