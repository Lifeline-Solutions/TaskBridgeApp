<details class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 group">
  <summary class="w-full flex items-center justify-between px-4 py-3 lg:px-6 border-b border-gray-200 dark:border-gray-600 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-indigo-500 text-lg font-semibold text-gray-900 dark:text-white">
    <span>SLA Information</span>
    <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </summary>
  <div class="p-4 lg:p-6 space-y-4">

  <% if current_user.has_role? :admin or current_user.has_role?('project manager') or current_user.has_role?(:agent) %>
    <!-- Timeline/Progress style for SLA milestones -->
    <div class="flex flex-col gap-4">
      
      <!-- Time Created -->
      <div class="flex flex-wrap items-center gap-3 bg-gray-50 dark:bg-gray-700 rounded-xl p-4 shadow-sm w-full">
        <div class="flex flex-col min-w-0 w-full break-words">
          <span class="text-xs font-semibold text-gray-500 dark:text-gray-400 truncate">Time Created</span>
          <span class="text-sm text-gray-900 dark:text-white font-mono break-words">
            <span class="block md:hidden"><%= @ticket.created_at.strftime("%d %b %Y") %></span>
            <span class="hidden md:block"><%= @ticket.created_at.strftime("%d %b %Y at %I:%M %p") %></span>
          </span>
        </div>
      </div>

      <!-- Target Response -->
      <div class="flex flex-wrap items-center gap-3 bg-blue-50 dark:bg-blue-900/30 rounded-xl p-4 shadow-sm w-full">
        <div class="flex flex-col min-w-0 w-full break-words">
          <span class="text-xs font-semibold text-blue-600 dark:text-blue-300 truncate">Target Response Time</span>
          <span class="text-sm text-gray-900 dark:text-white font-mono break-words">
            <span class="block md:hidden"><%= @ticket.initial_response_deadline.strftime("%d %b %Y") %></span>
            <span class="hidden md:block"><%= @ticket.initial_response_deadline.strftime("%d %b %Y at %I:%M %p") %></span>
          </span>
        </div>
      </div>

      <!-- Target Repair -->
      <div class="flex flex-wrap items-center gap-3 bg-orange-50 dark:bg-orange-900/30 rounded-xl p-4 shadow-sm w-full">
        <div class="flex flex-col min-w-0 w-full break-words">
          <span class="text-xs font-semibold text-orange-600 dark:text-orange-300 truncate">Target Repair Time</span>
          <span class="text-sm text-gray-900 dark:text-white font-mono break-words">
            <span class="block md:hidden"><%= @ticket.target_repair_deadline.strftime("%d %b %Y") %></span>
            <span class="hidden md:block"><%= @ticket.target_repair_deadline.strftime("%d %b %Y at %I:%M %p") %></span>
          </span>
        </div>
      </div>

      <!-- Target Resolution -->
      <div class="flex flex-wrap items-center gap-3 bg-green-50 dark:bg-green-900/30 rounded-xl p-4 shadow-sm w-full">
        <div class="flex flex-col min-w-0 w-full break-words">
          <span class="text-xs font-semibold text-green-600 dark:text-green-300 truncate">Target Resolution Time</span>
          <span class="text-sm text-gray-900 dark:text-white font-mono break-words">
            <span class="block md:hidden"><%= @ticket.resolution_deadline.strftime("%d %b %Y") %></span>
            <span class="hidden md:block"><%= @ticket.resolution_deadline.strftime("%d %b %Y at %I:%M %p") %></span>
          </span>
        </div>
      </div>
    </div>
  <% end %>

  <!-- SLA Status Section -->
  <div class="mt-8 border-t border-gray-200 dark:border-gray-600 pt-6">
    <h4 class="text-base font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
      SLA Status
    </h4>
    <div class="flex flex-col gap-4">
      
      <!-- Response SLA -->
      <div class="bg-blue-50 dark:bg-blue-900/20 rounded-xl p-4 border border-blue-200 dark:border-blue-800 flex flex-col gap-1 w-full">
        <dt class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wide flex items-center gap-1">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M2 10a8 8 0 1116 0A8 8 0 012 10zm8-4a1 1 0 100 2 1 1 0 000-2zm1 8H9v-2h2v2z"/></svg>
          Target Response Time SLA Status
        </dt>
        <dd class="text-sm text-blue-900 dark:text-blue-100 mt-1 capitalize">
          <% if @sla_ticket.present? %>
            <span class="inline-block px-2 py-0.5 rounded bg-blue-100 text-blue-700 text-xs font-semibold" title="Current SLA status">
              <%= @sla_ticket.sla_status %>
            </span>
          <% else %>
            <span class="text-gray-500 dark:text-gray-400">Not set</span>
          <% end %>
        </dd>
      </div>

      <!-- Repair SLA -->
      <div class="bg-orange-50 dark:bg-orange-900/20 rounded-xl p-4 border border-orange-200 dark:border-orange-800 flex flex-col gap-1 w-full">
        <dt class="text-xs font-bold text-orange-600 dark:text-orange-400 uppercase tracking-wide flex items-center gap-1">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-2h2v2zm0-4H9V7h2v2z"/></svg>
          Target Repair Time SLA Status
        </dt>
        <dd class="text-sm text-orange-900 dark:text-orange-100 mt-1">
          <% if @sla_ticket.present? %>
            <span class="inline-block px-2 py-0.5 rounded bg-orange-100 text-orange-700 text-xs font-semibold" title="Target repair deadline">
              <%= @sla_ticket.sla_target_response_deadline %>
            </span>
          <% else %>
            <span class="text-gray-500 dark:text-gray-400">Not set</span>
          <% end %>
        </dd>
      </div>

      <!-- Resolution SLA -->
      <div class="bg-green-50 dark:bg-green-900/20 rounded-xl p-4 border border-green-200 dark:border-green-800 flex flex-col gap-1 w-full">
        <dt class="text-xs font-bold text-green-600 dark:text-green-400 uppercase tracking-wide flex items-center gap-1">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-2h2v2zm0-4H9V7h2v2z"/></svg>
          Target Resolution Time SLA Status
        </dt>
        <dd class="text-sm text-green-900 dark:text-green-100 mt-1">
          <% if @sla_ticket.present? %>
            <span class="inline-block px-2 py-0.5 rounded bg-green-100 text-green-700 text-xs font-semibold" title="Resolution deadline">
              <%= @sla_ticket.sla_resolution_deadline %>
            </span>
          <% else %>
            <span class="text-gray-500 dark:text-gray-400">Not set</span>
          <% end %>
        </dd>
      </div>
    </div>
  </div>

  <!-- Due Date Section -->
  <div class="mt-6 bg-gray-50 dark:bg-gray-700 rounded-xl p-4 border border-gray-200 dark:border-gray-600 flex items-center gap-3">
    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
    <div>
      <dt class="text-sm font-semibold text-gray-700 dark:text-gray-300">Target Due Date:</dt>
      <dd class="text-sm text-gray-900 dark:text-white mt-1">
        <% if @ticket.due_date.present? %>
          <span class="font-mono"><%= @ticket.due_date %></span>
          <span class="text-gray-500 dark:text-gray-400 ml-2">
            (<%= distance_of_time_in_words(DateTime.now, @ticket.due_date) %>)
          </span>
        <% else %>
          <span class="text-gray-500 dark:text-gray-400 italic">No due date set</span>
        <% end %>
      </dd>
    </div>
  </div>

</details>
