<div class="flex items-start sm:items-center gap-3 w-full">
  <!-- Ticket / Project image -->
  <div class="flex-shrink-0">
    <% if ticket.ticket_image.attached? %>
      <%= image_tag ticket.ticket_image, class: "h-9 w-9 sm:h-10 sm:w-10 rounded-lg object-cover border border-gray-200/50 dark:border-gray-600/50 shadow-sm" %>
    <% elsif @project&.image.present? %>
      <%= image_tag @project.image, class: 'h-9 w-9 sm:h-10 sm:w-10 rounded-lg object-cover border border-gray-200/50 dark:border-gray-600/50 shadow-sm' %>
    <% else %>
      <div class="h-9 w-9 sm:h-10 sm:w-10 bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-800 rounded-lg flex items-center justify-center border border-gray-200/50 dark:border-gray-600/50 shadow-sm">
        <svg class="h-4 w-4 sm:h-5 sm:w-5 text-gray-600 dark:text-gray-200" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd"></path>
        </svg>
      </div>
    <% end %>
  </div>

  <!-- Ticket text content -->
  <div class="flex-1 min-w-0">
    <!-- Title / Subject -->
    <div class="font-semibold text-gray-900 dark:text-gray-100 text-sm sm:text-base leading-tight">
      <%= link_to project_ticket_path(ticket.project, ticket),
          class: "hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-200 block truncate" do %>
        <% if ticket.subject.present? %>
          <!-- Mobile truncation -->
          <span class="block sm:hidden"><%= ticket.subject.truncate(35, omission: '...') %></span>
          <!-- Tablet & up -->
          <span class="hidden sm:block"><%= ticket.subject.truncate(55, omission: '...') %></span>
        <% else %>
          <span class="italic text-sm">No subject provided</span>
        <% end %>
      <% end %>
    </div>

    <!-- Content preview -->
    <% if ticket.content.present? %>
      <div class="mt-1 text-gray-700 dark:text-gray-300 text-xs sm:text-sm leading-snug">
        <span class="block sm:hidden"><%= ticket.content.to_plain_text.truncate(40, omission: '...') %></span>
        <span class="hidden sm:block"><%= ticket.content.to_plain_text.truncate(80, omission: '...') %></span>
      </div>
    <% end %>

    <!-- Issue type pill -->
    <div class="mt-2 sm:mt-1 xl:hidden">
      <span class="inline-block text-xs px-2 py-0.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-md font-medium">
        <%= ticket.issue %>
      </span>
    </div>
  </div>
</div>
