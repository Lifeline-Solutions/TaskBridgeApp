<tr>
  <th scope="col" class="p-1 sm:p-2 text-left text-xs sm:text-sm font-medium uppercase tracking-wider hidden sm:table-cell">Date</th>
  <th scope="col" class="p-1 sm:p-2 text-left text-xs sm:text-sm font-medium uppercase tracking-wider">ID</th>
  <th scope="col" class="p-1 sm:p-2 text-left text-xs sm:text-sm font-medium uppercase tracking-wider hidden md:table-cell">Issue Type</th>
  <th scope="col" class="p-1 sm:p-2 text-left text-xs sm:text-sm font-medium uppercase tracking-wider">Severity</th>
  <th scope="col" class="p-1 sm:p-2 text-left text-xs sm:text-sm font-medium uppercase tracking-wider">Summary</th>
  <th scope="col" class="p-1 sm:p-2 text-left text-xs sm:text-sm font-medium uppercase tracking-wider hidden md:table-cell">Assigned</th>
  <th scope="col" class="p-1 sm:p-2 text-left text-xs sm:text-sm font-medium uppercase tracking-wider">Status</th>
  <th scope="col" class="p-1 sm:p-2 text-left text-xs sm:text-sm font-medium uppercase tracking-wider hidden sm:table-cell">Progress</th>
  <th scope="col" class="p-1 sm:p-2 text-left text-xs sm:text-sm font-medium uppercase tracking-wider hidden md:table-cell">Reported</th>
  <th scope="col" class="p-1 sm:p-2 text-left text-xs sm:text-sm font-medium uppercase tracking-wider hidden lg:table-cell">Updated</th>
  <th scope="col" class="p-1 sm:p-2 text-right text-xs sm:text-sm font-medium uppercase tracking-wider">Actions</th>
  <% if current_user.has_role?(:admin) || current_user.has_role?(:agent) || current_user.has_role?('project manager') || current_user.has_role?(:observer) %>
    <th scope="col" class="p-1 sm:p-2 text-left text-xs sm:text-sm font-medium uppercase tracking-wider hide-on-sidebar hidden lg:table-cell">Days</th>
    <th scope="col" class="p-1 sm:p-2 text-left text-xs sm:text-sm font-medium uppercase tracking-wider hide-on-sidebar hidden lg:table-cell">Edits</th>
    <th scope="col" class="p-1 sm:p-2 text-left text-xs sm:text-sm font-medium uppercase tracking-wider hide-on-sidebar hidden lg:table-cell">Last Edit</th>
  <% end %>
</tr>