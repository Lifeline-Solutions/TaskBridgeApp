  <div class="mt-6 col-span-3 flex mr-2 flex-col gap-4 p-4 w-full">
    <h1 class="text-3xl text-center mb-10">Communication Center</h1>
    
    <!-- Filter Tabs -->
    <div class="flex flex-wrap gap-1 sm:gap-2 mb-6 border-b border-gray-200 dark:border-gray-700 overflow-x-auto">
      <button onclick="filterTicketMessages('all')"
              id="tab-all"
              class="flex items-center gap-1 px-2 sm:px-4 py-2 text-xs sm:text-sm font-medium border-b-2 border-blue-500 text-blue-600 dark:text-blue-400 transition-colors whitespace-nowrap">
        <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="hidden sm:inline">All</span>
        <span class="px-1.5 py-0.5 text-xs rounded-full bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">
          <%= @ticket_items.count %>
        </span>
      </button>
      <button onclick="filterTicketMessages('external')"
              id="tab-external"
              class="flex items-center gap-1 px-2 sm:px-4 py-2 text-xs sm:text-sm font-medium border-b-2 border-transparent text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:border-gray-300 dark:hover:border-gray-600 transition-colors whitespace-nowrap">
        <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM10 15a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm1-4a1 1 0 0 1-2 0V6a1 1 0 0 1 2 0v5Z"/>
        </svg>
        <span class="hidden sm:inline">Public</span>
        <span class="px-1.5 py-0.5 text-xs rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">
          <%= @ticket_items.count { |item| item.respond_to?(:message_type) && item.message_type == 'external' } %>
        </span>
      </button>
      <% if current_user.has_role?(:admin) || current_user.has_role?(:agent) || current_user.has_role?('project manager') %>
        <button onclick="filterTicketMessages('internal')"
                id="tab-internal"
                class="flex items-center gap-1 px-2 sm:px-4 py-2 text-xs sm:text-sm font-medium border-b-2 border-transparent text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:border-gray-300 dark:hover:border-gray-600 transition-colors whitespace-nowrap">
          <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="currentColor" viewBox="0 0 16 20">
            <path d="M14 7h-1.5V4.5a4.5 4.5 0 1 0-9 0V7H2a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Zm-5 8a1 1 0 1 1-2 0v-3a1 1 0 1 1 2 0v3Zm1.5-8h-5V4.5a2.5 2.5 0 1 1 5 0V7Z"/>
          </svg>
          <span class="hidden sm:inline">Internal</span>
          <span class="px-1.5 py-0.5 text-xs rounded-full bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300">
            <%= @ticket_items.count { |item| item.respond_to?(:message_type) && item.message_type == 'internal' } %>
          </span>
        </button>
      <% end %>
    </div>

    <!-- Tabs Section -->
    <div id="history" class="tabcontent active">
      <%= render partial: 'issues/issues_table' %>
    </div>

    <% if current_page?(project_ticket_path(@project, @ticket)) %>

      <!-- New message button -->
      <% unless @ticket.statuses.first&.name == 'Closed' %>
        <!-- Single New Message Button -->
        <div class="p-4 border-t border-gray-200 dark:border-gray-600">
          <button id="newTicketMessageButton"
                  class="flex items-center justify-center gap-2 w-2xl px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-md transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
            </svg>
            <span id="ticketButtonText">New Message</span>
          </button>
        </div>

        <!-- Form Container (initially hidden) -->
        <div id="ticketMessageFormContainer" class="hidden">
          <%= render 'issues/form', project: @project, ticket: @ticket, issue: Issue.new %>
        </div>
      <% end %>
    <% end %>
  </div>

  <script>
    function filterTicketMessages(type) {
      const allItems = document.querySelectorAll('[data-message-type]');
      const tabs = document.querySelectorAll('[id^="tab-"]');
      
      // Update tab styles
      tabs.forEach(tab => {
        tab.classList.remove('border-blue-500', 'text-blue-600', 'dark:text-blue-400');
        tab.classList.add('border-transparent', 'text-gray-600', 'dark:text-gray-400');
      });
      
      const activeTab = document.getElementById(`tab-${type}`);
      if (activeTab) {
        activeTab.classList.add('border-blue-500', 'text-blue-600', 'dark:text-blue-400');
        activeTab.classList.remove('border-transparent', 'text-gray-600', 'dark:text-gray-400');
      }
      
      // Filter messages with smooth animation
      allItems.forEach(item => {
        if (type === 'all') {
          item.style.display = '';
          item.style.opacity = '1';
        } else {
          if (item.dataset.messageType === type) {
            item.style.display = '';
            item.style.opacity = '1';
          } else {
            item.style.opacity = '0.3';
            setTimeout(() => {
              if (item.style.opacity === '0.3') {
                item.style.display = 'none';
              }
            }, 150);
          }
        }
      });
    }

    // Initialize with all messages visible
    document.addEventListener('DOMContentLoaded', function() {
      // Set default active tab
      filterTicketMessages('all');
      initializeTicketMessageForm();
    });

    // Ticket message form toggle functionality
    function toggleTicketMessageForm() {
      const messageFormContainer = document.getElementById('ticketMessageFormContainer');
      const buttonText = document.getElementById('ticketButtonText');
      const newMessageButton = document.getElementById('newTicketMessageButton');
      
      if (messageFormContainer && buttonText && newMessageButton) {
        if (messageFormContainer.classList.contains('hidden')) {
          messageFormContainer.classList.remove('hidden');
          buttonText.textContent = 'Cancel';
          newMessageButton.classList.remove('bg-indigo-600', 'hover:bg-indigo-700');
          newMessageButton.classList.add('bg-red-600', 'hover:bg-red-700');
        } else {
          messageFormContainer.classList.add('hidden');
          buttonText.textContent = 'New Message';
          newMessageButton.classList.remove('bg-red-600', 'hover:bg-red-700');
          newMessageButton.classList.add('bg-indigo-600', 'hover:bg-indigo-700');
        }
      }
    }

    function initializeTicketMessageForm() {
      const newMessageButton = document.getElementById('newTicketMessageButton');
      
      if (newMessageButton) {
        // Remove any existing event listeners by cloning the node
        const newButton = newMessageButton.cloneNode(true);
        newMessageButton.parentNode.replaceChild(newButton, newMessageButton);
        
        // Add the event listener to the new button
        newButton.addEventListener('click', function(e) {
          e.preventDefault();
          toggleTicketMessageForm();
        });
      }
    }

    // Initialize on turbo:load as well
    document.addEventListener('turbo:load', function() {
      filterTicketMessages('all');
      initializeTicketMessageForm();
    });
  </script>
