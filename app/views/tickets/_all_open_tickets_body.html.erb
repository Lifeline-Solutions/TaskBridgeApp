
<% @tickets.each do |ticket| %>
  <!-- Mobile Card Layout (hidden on lg and up) -->
  <tr class="lg:hidden">
    <td colspan="10" class="p-0 border-0 align-top">
      <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden hover:shadow-md transition-all duration-200 mb-3">
        <!-- Card Header -->
        <div class="px-2 sm:px-4 py-2 sm:py-3 bg-gray-50 dark:bg-gray-700 border-b border-gray-200 dark:border-gray-600">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-2">
            <div class="flex items-center space-x-1 sm:space-x-2">
              <%= link_to project_ticket_path(ticket.project, ticket), class: "font-bold text-xs sm:text-sm text-blue-600 dark:text-blue-400" do %>
                <%= ticket.unique_id if ticket.unique_id.present? %>
              <% end %>
              <span class="text-[10px] sm:text-xs text-gray-500 dark:text-gray-400">•</span>
              <span class="text-[10px] sm:text-xs text-gray-600 dark:text-gray-300 font-medium">
                <%= ticket.project.title.truncate(15) %>
              </span>
            </div>
            <span class="text-[10px] sm:text-xs text-gray-500 dark:text-gray-400">
              <%= ticket.created_at.strftime("%d %b %Y") %>
            </span>
          </div>
        </div>
        <!-- Card Content -->
        <div class="p-2 sm:p-4 space-y-2 sm:space-y-3">
          <!-- Title/Subject -->
          <h3 class="font-semibold text-gray-900 dark:text-gray-100 leading-tight text-sm sm:text-base">
            <%= link_to project_ticket_path(ticket.project, ticket), class: "hover:text-blue-600 dark:hover:text-blue-400 transition-colors" do %>
              <%= ticket.subject.present? ? ticket.subject.truncate(60) : "Untitled Ticket" %>
            <% end %>
          </h3>
          <!-- Status and Priority Row -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-2">
            <div class="flex items-center space-x-1 sm:space-x-2">
              <%= render partial: 'tickets/priority_severity', locals: { ticket: ticket } %>
              <%= render partial: 'tickets/ticket_status', locals: { ticket: ticket } %>
            </div>
          </div>
          <!-- Progress for Mobile -->
          <div class="flex items-center justify-between pt-2 border-t border-gray-100 dark:border-gray-600">
            <span class="text-xs sm:text-sm font-medium text-gray-600 dark:text-gray-400">Progress:</span>
            <div class="flex items-center space-x-1 sm:space-x-2 flex-1 max-w-24 ml-2 sm:ml-3">
              <%= render partial: 'tickets/progress_bar', locals: { ticket: ticket } %>
            </div>
          </div>
          <!-- Assignment Info (if exists) -->
          <% if defined?(ticket.users) && ticket.users.any? %>
            <div class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 pt-2 border-t border-gray-100 dark:border-gray-600">
              <span class="font-medium">Assigned to:</span>
              <%= ticket.users.limit(2).map(&:name).join(", ").truncate(40) %>
              <% if ticket.users.count > 2 %>
                <span class="text-gray-500"> +<%= ticket.users.count - 2 %> more</span>
              <% end %>
              <% ticket.users.each do |user| %>
                <% unless user.teams.any? %>
                  <span class="block text-xs text-red-500">No Team Assigned</span>
                <% end %>
              <% end %>
            </div>
          <% end %>
          <!-- Action Button -->
          <div class="pt-2 border-t border-gray-100 dark:border-gray-600">
            <%= link_to "View Details", project_ticket_path(ticket.project, ticket), 
                class: "inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300" %>
          </div>
          <!-- Dropdown Actions for Mobile -->
          
        </div>
      </div>
    </td>
  </tr>

  <!-- Desktop Table Row (hidden on mobile) -->
  <tr class="hidden lg:table-row bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
    <th scope="row" class="px-2 py-2 font-medium text-gray-900 whitespace-nowrap dark:text-white uppercase">
      <%= link_to ticket.unique_id, project_ticket_path(ticket.project, ticket) if ticket.unique_id.present? %>
    </th>
    <th scope="row" class="px-2 py-2 font-medium text-gray-900 whitespace-nowrap dark:text-white">
      <%= link_to ticket.created_at.strftime("%d %b %Y"), project_ticket_path(ticket.project, ticket) %>
    </th>
    <th scope="row" class="px-2 py-2 font-medium text-gray-900 whitespace-nowrap dark:text-white">
      <%= link_to ticket.project.title, project_ticket_path(ticket.project, ticket) %>
    </th>
    <th scope="row" class="px-2 py-2 font-medium text-gray-900 whitespace-nowrap dark:text-white">
      <%= link_to ticket.issue, project_ticket_path(ticket.project, ticket) %>
    </th>

    <!-- Priority -->
    <td class="px-2 py-2">
      <div class="relative w-full flex justify-center">
        <%= render partial: "tickets/priority_severity", locals: { ticket: ticket } %>
      </div>
    </td>

    <td class="px-4 py-4 grid grid-cols-[auto_1fr_auto] items-center gap-3 sm:gap-4">
      <%= render partial: 'tickets/summary', locals: { ticket: ticket } %>
    </td>

    <!-- Assigned to -->
    <td class="px-4 py-4 whitespace-nowrap">
      <div class="flex flex-col gap-2">
        <% ticket.users.each do |user| %>
          <% if user.name.present? %>
            <span class="font-medium"><%= user.name %></span>
            <span class="font-semibold">
              <% if user.teams.any? %>
                (<%= user.teams.map(&:name).join(', ') %>)
              <% else %>
                (No Team Assigned)
              <% end %>
            </span>
          <% end %>
        <% end %>
      </div>
    </td>

    <!-- Ticket Status -->
    <td class="px-2 py-2">
      <div class="relative w-full flex justify-center">
        <%= render partial: "tickets/ticket_status", locals: { ticket: ticket } %>
      </div>
    </td>

    <!-- Progress Bar -->
    <td class="pl-2 pr-2 py-2">
      <div class="relative w-full flex justify-center">
          <%= render partial: "tickets/progress_bar", locals: { ticket: ticket } %>
      </div>
    </td>

    <!-- View button -->
    <td class="px-4 py-4 whitespace-nowrap font-medium" data-controller="dropdown" data-dropdown-ticket-id-value="<%= ticket.id %>">
      <%= render partial: 'tickets/action_dropdown', locals: { ticket: ticket } %>
    </td>
  </tr>
<% end %>