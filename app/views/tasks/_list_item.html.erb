<%
  today = Date.current
  end_date = task.end_date.is_a?(Date) ? task.end_date : (task.end_date.respond_to?(:to_date) ? task.end_date.to_date : nil)
  if end_date
    days_diff = (end_date - today).to_i
    if days_diff > 7
      bg_class = 'bg-transparent hover:bg-gray-50 dark:hover:bg-gray-700/30'
      border_class = ''
      date_class = 'text-gray-600 dark:text-gray-400'
    elsif days_diff > 3
      bg_class = 'bg-yellow-50/50 hover:bg-yellow-50 dark:bg-yellow-900/10 dark:hover:bg-yellow-900/20'
      border_class = 'border-l-4 border-yellow-400 dark:border-yellow-500'
      date_class = 'text-yellow-700 dark:text-yellow-400 font-medium'
    elsif today > end_date
      bg_class = 'bg-red-50/50 hover:bg-red-50 dark:bg-red-900/10 dark:hover:bg-red-900/20'
      border_class = 'border-l-4 border-red-500 dark:border-red-600'
      date_class = 'text-red-700 dark:text-red-400 font-medium'
    end
  end
%>
<div class="<%= "group #{bg_class} rounded-lg #{border_class} cursor-pointer transition-all duration-200 ease-in-out" %>" 
     onclick="window.location='<%= product_task_path(@product, task) %>'">
  <div class="p-3 sm:p-4">
    <div class="flex flex-col lg:flex-row lg:items-center gap-3 sm:gap-4">
      <!-- Task ID -->
      <div class="flex-shrink-0">
        <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-900/30 dark:to-blue-800/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-700 shadow-sm">
          <% if task.unique_task_id.present? %>
            <%= task.unique_task_id %>
          <% else %>
            <span class="text-gray-500 dark:text-gray-400">No ID</span>
          <% end %>
        </span>
      </div>

      <!-- Task Details - Takes most space -->
      <div class="flex-1 min-w-0 space-y-1.5">
        <!-- Task Name -->
        <h3 class="text-sm sm:text-base font-semibold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
          <%= task.name %>
        </h3>
        
        <!-- Prerequisite Task -->
        <% if task.prerequisite_task.present? %>
          <p class="text-xs text-gray-600 dark:text-gray-400 flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5 flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
            </svg>
            <span class="truncate">
              Prerequisite: 
              <%= link_to "#{task.prerequisite_task.unique_task_id} - #{task.prerequisite_task.name}", 
                          product_task_path(@product, task.prerequisite_task), 
                          class: "text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 hover:underline font-medium",
                          data: { turbo: false },
                          onclick: "event.stopPropagation()" %>
            </span>
          </p>
        <% end %>
      </div>

      <!-- Priority -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <div class="text-xs sm:text-sm transform group-hover:scale-105 transition-transform">
          <%= render partial: 'tasks/priority', locals: { task: task } %>
        </div>
      </div>

      <!-- Due Date -->
      <div class="flex items-center gap-2 <%= date_class %> flex-shrink-0 min-w-[130px]">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 flex-shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
        </svg>
        <span class="text-xs sm:text-sm whitespace-nowrap"><%= task.end_date.strftime("%b %d, %Y") %></span>
      </div>

      <!-- Assigned Users -->
      <div class="flex items-center gap-1 flex-shrink-0">
        <% if task.users.any? %>
          <div class="flex -space-x-2 group-hover:space-x-0.5 transition-all">
            <% task.users.first(3).each do |user| %>
              <% if user.profile_picture.attached? %>
                <%= image_tag user.profile_picture, class: 'object-cover h-9 w-9 rounded-full border-2 border-white dark:border-gray-800 shadow-sm group-hover:shadow-md transition-all', title: user.name %>
              <% elsif user.name_initials.present? %>
                <div class="w-9 h-9 flex items-center justify-center rounded-full bg-gradient-to-br from-blue-400 to-blue-600 dark:from-blue-600 dark:to-blue-800 text-white capitalize border-2 border-white dark:border-gray-800 text-xs font-bold shadow-sm group-hover:shadow-md transition-all" title="<%= user.name %>">
                  <%= user.name_initials %>
                </div>
              <% else %>
                <%= image_tag 'default.png', class: 'w-9 h-9 rounded-full border-2 border-white dark:border-gray-800 shadow-sm group-hover:shadow-md transition-all', title: user.name %>
              <% end %>
            <% end %>
            <% if task.users.count > 3 %>
              <div class="w-9 h-9 flex items-center justify-center rounded-full bg-gradient-to-br from-gray-300 to-gray-400 dark:from-gray-600 dark:to-gray-700 text-gray-700 dark:text-gray-200 border-2 border-white dark:border-gray-800 text-xs font-bold shadow-sm group-hover:shadow-md transition-all" title="<%= task.users.count - 3 %> more users">
                +<%= task.users.count - 3 %>
              </div>
            <% end %>
          </div>
        <% else %>
          <span class="text-xs text-gray-400 dark:text-gray-500 italic px-2 py-1 bg-gray-100 dark:bg-gray-700/50 rounded">Unassigned</span>
        <% end %>
      </div>

      <!-- Comments Count -->
      <div class="flex items-center gap-1.5 text-gray-600 dark:text-gray-400 flex-shrink-0 min-w-[50px] group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
        </svg>
        <span class="text-xs sm:text-sm font-medium"><%= task.messages.count %></span>
      </div>

      <!-- Action Dropdown -->
      <div class="flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity" onclick="event.stopPropagation()">
        <%= render partial: "tasks/action_dropdown", locals: { product: @product, task: task } %>
      </div>

      <!-- Priority -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <div class="text-xs sm:text-sm">
          <%= render partial: 'tasks/priority', locals: { task: task } %>
        </div>
      </div>

      <!-- Due Date -->
      <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
        </svg>
        <span class="text-xs sm:text-sm whitespace-nowrap"><%= task.end_date.strftime("%b %d, %Y") %></span>
      </div>

      <!-- Assigned Users -->
      <div class="flex items-center gap-1 flex-shrink-0">
        <% if task.users.any? %>
          <div class="flex -space-x-2">
            <% task.users.first(3).each do |user| %>
              <% if user.profile_picture.attached? %>
                <%= image_tag user.profile_picture, class: 'object-cover h-8 w-8 rounded-full border-2 border-white dark:border-gray-800', title: user.name %>
              <% elsif user.name_initials.present? %>
                <div class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-300 dark:bg-gray-600 text-gray-800 dark:text-gray-200 capitalize border-2 border-white dark:border-gray-800 text-xs font-medium" title="<%= user.name %>">
                  <%= user.name_initials %>
                </div>
              <% else %>
                <%= image_tag 'default.png', class: 'w-8 h-8 rounded-full border-2 border-white dark:border-gray-800', title: user.name %>
              <% end %>
            <% end %>
            <% if task.users.count > 3 %>
              <div class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-200 dark:bg-gray-700 text-gray-600 dark:text-gray-300 border-2 border-white dark:border-gray-800 text-xs font-medium">
                +<%= task.users.count - 3 %>
              </div>
            <% end %>
          </div>
        <% else %>
          <span class="text-xs text-gray-400 dark:text-gray-500">Unassigned</span>
        <% end %>
      </div>

      <!-- Comments Count -->
      <div class="flex items-center gap-1 text-gray-600 dark:text-gray-400 flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
        </svg>
        <span class="text-xs sm:text-sm"><%= task.messages.count %></span>
      </div>

      <!-- Action Dropdown -->
      <div class="flex-shrink-0" onclick="event.stopPropagation()">
        <%= render partial: "tasks/action_dropdown", locals: { product: @product, task: task } %>
      </div>
    </div>
  </div>
</div>
