<div class="relative inline-block text-left overflow-visible"
  data-controller="dropdown"
  data-dropdown-ticket-id-value="<%= product.id %>">
  <div>
    <button
   type="button"
   class="p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none text-gray-500 dark:text-gray-400"
   id="menu-button-<%= product.id %>"
   aria-expanded="false"
   aria-haspopup="true"
   data-action="click->dropdown#toggle">
   <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
     <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 18.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z" />
   </svg>
    </button>
  </div>

  <div id="dropdown-<%= product.id %>"
    data-dropdown-target="menu"
    class="hidden z-50 p-4 origin-top-right absolute right-0 mt-2 w-24 sm:w-28 md:w-32 lg:w-36 xl:w-40 bg-white dark:bg-gray-600 rounded-md shadow-lg focus:outline-none
        sm:right-0 sm:mt-2
        xs:w-full xs:left-0 xs:right-0 xs:mt-2 xs:rounded-none xs:shadow-none xs:absolute xs:z-50"
  >
    <div class="flex flex-col space-y-2" role="none">
   <div class="flex items-center gap-2">
     <svg xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="h-5 w-5">
    <path stroke-linecap="round" stroke-linejoin="round"
       d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
     </svg>
     <%= link_to 'VIEW',
        product_task_path(product, task),
        class: 'text-sm hover:text-blue-600 hover:underline' %>
   </div>

     <% if can? :edit, product %>
    <div class="flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
      </svg>
      <%= link_to 'EDIT', edit_product_task_path(product, task), class: 'text-sm hover:text-blue-600 hover:underline' %>
    </div>
     <% end %>

     <% if can? :delete, product %>
    <div class="flex items-center gap-2 text-red-600">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
      </svg>
      <%= button_to 'DELETE', product_task_path(product, task), method: :delete,
       data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' },
       class: "text-sm text-red-600 hover:text-red-800 hover:underline" %>
    </div>
     <% end %>
    </div>
  </div>
</div>