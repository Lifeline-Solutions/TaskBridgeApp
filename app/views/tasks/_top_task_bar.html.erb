<div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 items-start px-2 py-4">
  <!-- Back button: Always top left -->
  <div class="w-full flex justify-start mb-3">
    <button onclick="history.back()" class="bg-[#3F8CFF] hover:bg-[#3A81EB] px-4 py-2 h-12 flex items-center rounded-lg font-bold text-slate-100 shadow transition-all duration-150">
      &#8656; Back
    </button>
  </div>
  <!-- Main content -->
  <div class="col-span-1 md:col-span-2 flex flex-col md:flex-row gap-3 md:gap-6">
    <div class="flex flex-col md:flex-row items-start md:items-center gap-3 md:gap-6 w-full">
      <div class="flex flex-col md:flex-row gap-2 md:gap-4 w-full">
        <h1 class="text-lg sm:text-xl md:text-2xl font-semibold break-words leading-tight">
          <%= link_to @product.client.name, product_path(@product.id), class: "hover:underline text-[#3F8CFF]" %> /
          <span class="text-md font-light">
            <%= render partial: 'tasks/priority', locals: { task: @task } %>
          </span>
          <span class="text-xs sm:text-sm text-gray-500">from <%= @task.start_date.strftime('%d-%m-%Y') %> to <%= @task.start_date.strftime('%d-%m-%Y') %></span>
          <% if @task.prerequisite_task.present? %>
            / <span class="text-xs sm:text-sm text-gray-500">Prerequisite Task:
              <%= link_to @task.prerequisite_task.name, product_task_path(@product, @task.prerequisite_task), class: "hover:underline text-[#3F8CFF]" %>
            </span>
          <% end %>
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-gray-600">
          <span class="font-medium"></span>
        </p>
      </div>
    </div>
    <!-- Search section -->
    <div class="flex justify-end w-full">
      <div class="flex flex-col w-full gap-2 md:gap-4">
        <%= form_with url: product_task_path(@product, @task), method: :get, class: 'flex flex-col sm:flex-row gap-2 w-full' do |f| %>
          <div class="flex flex-col sm:flex-row w-full gap-2">
            <%= f.text_field :query, placeholder: "Search", class: "border bg-white dark:bg-gray-800 border-[#3F8CFF] px-3 py-2 hover:border-[#3A81EB] border-2 rounded-lg w-full sm:w-auto focus:outline-none focus:ring-2 focus:ring-[#3F8CFF] transition-all duration-150" %>
            <div class="flex flex-row w-full gap-2">
              <%= f.submit "Search", class: 'bg-[#3F8CFF] hover:bg-[#3A81EB] px-4 py-2 rounded-lg font-bold text-slate-100 shadow w-full sm:w-auto transition-all duration-150' %>
              <%= button_to "Clear", product_task_path(@product, @task), method: :get, class: 'bg-gray-200 hover:bg-gray-300 px-4 py-2 rounded-lg font-bold text-gray-700 w-full sm:w-auto transition-all duration-150', form_class: 'inline' %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>