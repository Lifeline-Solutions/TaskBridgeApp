<% provide(:title, "Edit Task") %>

<div class="max-w-3xl xl:max-w-5xl 2xl:max-w-7xl mx-auto px-6 py-10 bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-800">
  <div class="mb-6 flex items-center">
    <%= link_to product_path(@product.id), method: :get, class: 'flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 font-semibold transition-all duration-150' do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Back
    <% end %>
  </div>
  <h2 class="text-3xl md:text-4xl xl:text-5xl font-extrabold text-gray-800 dark:text-white mb-10 text-center tracking-tight">
    Edit Task Details
  </h2>
  <%= form_with(model: [@product, @task], method: :patch, local: true, data: { turbo: false }, html: { class: "space-y-8" }) do |f| %>
    <% if flash[:alert] %>
      <div class="mb-4 text-red-600">
        <%= flash[:alert] %>
      </div>
    <% end %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <%= f.label :prerequisite, 'Prerequisite Task', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.collection_select :tasks_id, @prerequisite_tasks, :id, :name, { prompt: "No Prerequisite Task", include_blank: true }, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" %>
      </div>
      <div>
        <%= f.label :name, 'Task Name*', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.text_field :name, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", required: true %>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <%= f.label :priority, 'Priority*', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.select :priority, ['SEVERITY 1','SEVERITY 2','SEVERITY 3','SEVERITY 4'], {}, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" %>
      </div>
      <div>
        <%= f.label :image, 'Task Image', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.file_field :image, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" %>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <%= f.label :file, 'Task File', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.file_field :file, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" %>
      </div>
      <div>
        <%= f.label :start_date, 'Start Date*', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.date_field :start_date, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", required: true %>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <%= f.label :end_date, 'End Date*', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.date_field :end_date, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", required: true %>
      </div>
      <div>
        <%= f.label :description, 'Description*', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.rich_text_area :description, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full min-h-[300px] p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", required: true %>
      </div>
    </div>
    <div class="flex flex-col md:flex-row justify-center items-center mt-10 gap-6">
      <%= f.submit "Edit Task", class: 'w-full md:w-auto h-14 bg-gradient-to-r from-blue-600 to-indigo-700 hover:from-blue-700 hover:to-indigo-800 p-4 rounded-xl font-bold text-xl text-white shadow-xl transition-all duration-200' %>
    </div>
  <% end %>
</div>
