<% provide(:title, @dashboard.name) %>

<div class="container mx-auto px-4 py-8">
  <!-- Dashboard Header -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
    <div class="flex justify-between items-start mb-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-800 dark:text-white mb-2">
          <i class="fas fa-chart-line mr-2"></i><%= @dashboard.name %>
        </h1>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          <i class="fas fa-filter mr-1"></i>
          Filter: <span class="font-medium"><%= @dashboard.defect_filter.name %></span>
        </p>
      </div>

      <div class="flex gap-2">
        <%= link_to refresh_dashboard_widget_path(@dashboard),
            method: :post,
            class: "px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg flex items-center gap-2 transition-colors" do %>
          <i class="fas fa-sync-alt"></i>
          Refresh
        <% end %>

        <%= link_to edit_dashboard_widget_path(@dashboard),
            class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg flex items-center gap-2 transition-colors" do %>
          <i class="fas fa-edit"></i>
          Edit
        <% end %>

        <%= link_to dashboard_widget_path(@dashboard),
            method: :delete,
            data: { confirm: 'Are you sure you want to delete this dashboard?' },
            class: "px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg flex items-center gap-2 transition-colors" do %>
          <i class="fas fa-trash"></i>
          Delete
        <% end %>

        <%= link_to dashboard_widgets_path,
            class: "px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg flex items-center gap-2 transition-colors" do %>
          <i class="fas fa-arrow-left"></i>
          Back
        <% end %>
      </div>
    </div>

    <!-- Active Filter Parameters -->
    <% if @dashboard.active_filter_parameters.any? %>
      <div class="border-t border-gray-200 dark:border-gray-700 pt-4">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Active Filters:</h3>
        <div class="flex flex-wrap gap-2">
          <% @dashboard.active_filter_parameters.each do |key, value| %>
            <div class="inline-flex items-center px-3 py-1 rounded-lg bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-sm">
              <span class="font-medium mr-1"><%= key.to_s.titleize %>:</span>
              <span><%= format_filter_value(value) %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Total Defects Count -->
    <div class="border-t border-gray-200 dark:border-gray-700 pt-4 mt-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="text-center p-4 bg-gradient-to-r from-blue-50 to-blue-100 dark:from-blue-900 dark:to-blue-800 rounded-lg">
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">Total Defects Matching Filter</p>
          <p class="text-4xl font-bold text-blue-600 dark:text-blue-400">
            <%= @total_count %>
          </p>
        </div>

        <div class="text-center p-4 bg-gradient-to-r from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 rounded-lg">
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">Last Updated</p>
          <p class="text-lg font-semibold text-gray-800 dark:text-white">
            <%= time_ago_in_words(@dashboard.updated_at) %> ago
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Multiple Chart Visualizations -->
  <% if @charts.present? && @charts.any? %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <% @charts.each do |chart_title, chart_data| %>
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
          <h2 class="text-xl font-bold text-gray-800 dark:text-white mb-4 flex items-center">
            <i class="fas fa-chart-pie mr-2 text-blue-600"></i>
            <%= chart_title %>
          </h2>

          <% if chart_data.any? %>
            <!-- Pie Chart Visualization -->
            <div class="chart-container mb-6" style="min-height: 300px;">
              <%= pie_chart chart_data,
                  library: {
                    legend: { position: 'bottom' },
                    colors: ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899', '#06b6d4', '#84cc16', '#f97316'],
                    animation: { duration: 800 },
                    chartArea: { width: '90%', height: '70%' }
                  },
                  donut: true,
                  download: { filename: "#{@dashboard.name.parameterize}-#{chart_title.parameterize}" },
                  height: "300px" %>
            </div>

            <!-- Data Breakdown Table -->
            <div class="border-t border-gray-200 dark:border-gray-700 pt-4">
              <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Data Breakdown:</h3>
              <div class="space-y-2">
                <% chart_data.sort_by { |_k, v| -v }.each do |label, count| %>
                  <div class="flex justify-between items-center p-2 bg-gray-50 dark:bg-gray-900 rounded">
                    <span class="text-sm text-gray-700 dark:text-gray-300 font-medium"><%= label %></span>
                    <span class="text-lg font-bold text-blue-600 dark:text-blue-400"><%= count %></span>
                  </div>
                <% end %>
              </div>
              
              <!-- Total for this chart -->
              <div class="mt-3 pt-3 border-t border-gray-300 dark:border-gray-600 flex justify-between items-center">
                <span class="text-sm font-semibold text-gray-800 dark:text-gray-200">Total:</span>
                <span class="text-xl font-bold text-gray-900 dark:text-white"><%= chart_data.values.sum %></span>
              </div>
            </div>
          <% else %>
            <p class="text-center text-gray-500 dark:text-gray-400 py-8">No data available for this metric.</p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-12 text-center">
      <i class="fas fa-chart-bar text-6xl text-gray-300 dark:text-gray-600 mb-4"></i>
      <p class="text-xl text-gray-600 dark:text-gray-400">No charts to display</p>
      <p class="text-sm text-gray-500 dark:text-gray-500 mt-2">
        Make sure your filter has active parameters like Priority, Status, Module, etc.
      </p>
    </div>
  <% end %>

  <!-- Detailed Defects Table -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-2xl font-bold text-gray-800 dark:text-white flex items-center">
        <i class="fas fa-table mr-2 text-blue-600"></i>
        Defects Details
      </h2>
      <span class="text-sm text-gray-600 dark:text-gray-400">
        Showing <%= @defects.count %> defect<%= 's' if @defects.count != 1 %>
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-900">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">ID</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Summary</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Priority</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Assignees</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Module</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Created</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
          <% if @defects.any? %>
            <% @defects.limit(50).each do |defect| %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">
                  <%= defect.unique_task_id || defect.id.to_s.first(8) %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900 dark:text-gray-100">
                  <%= truncate(defect.summary, length: 60) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <span class="px-2 py-1 rounded text-xs font-medium <%= priority_badge_class(defect.priority) %>">
                    <%= defect.priority %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <% if defect.statuses.any? %>
                    <span class="px-2 py-1 rounded text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                      <%= defect.statuses.first.name %>
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">
                  <%= defect.assignees.map(&:full_name).join(', ').presence || 'Unassigned' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">
                  <%= defect.qa_module&.name || 'N/A' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                  <%= defect.created_at.strftime('%Y-%m-%d') %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <%= link_to defect_path(defect), class: "text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300" do %>
                    <i class="fas fa-eye"></i> View
                  <% end %>
                </td>
              </tr>
            <% end %>
            <% if @defects.count > 50 %>
              <tr>
                <td colspan="8" class="px-6 py-4 text-center text-sm text-gray-600 dark:text-gray-400 bg-gray-50 dark:bg-gray-900">
                  Showing first 50 of <%= @total_count %> defects.
                  <%= link_to "View all in defect list", index_show_defect_index_path(@dashboard.defect_filter.sanitized_filters),
                      class: "text-blue-600 hover:underline ml-2" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">
                No defects found matching the filter criteria.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if @dashboard.refresh_interval.present? %>
  <script>
    // Auto-refresh functionality
    setTimeout(function() {
      location.reload();
    }, <%= @dashboard.refresh_interval * 1000 %>);
  </script>
<% end %>
