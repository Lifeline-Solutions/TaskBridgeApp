<%= form_with model: dashboard, url: dashboard.persisted? ? dashboard_widget_path(dashboard) : dashboard_widgets_path, local: true, class: "space-y-6" do |f| %>
  <% if dashboard.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
      <h3 class="font-semibold mb-2"><%= pluralize(dashboard.errors.count, "error") %> prohibited this dashboard from being saved:</h3>
      <ul class="list-disc list-inside text-sm">
        <% dashboard.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Dashboard Name -->
  <div>
    <%= f.label :name, "Dashboard Name", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
    <%= f.text_field :name, 
        class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white",
        placeholder: "e.g., Critical Issues Dashboard",
        required: true %>
  </div>

  <!-- Saved Filter Selection -->
  <div>
    <%= f.label :defect_filter_id, "Select Filter", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
    <%= f.select :defect_filter_id,
        options_from_collection_for_select(@saved_filters, :id, :name, dashboard.defect_filter_id),
        { prompt: "Choose a saved filter..." },
        { class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white",
          required: true } %>
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
      The dashboard will automatically create charts for each active parameter in your filter (Priority, Status, Module, etc.).
      <%= link_to "Create new filter", defect_filters_path, class: "text-blue-600 hover:underline", target: "_blank" %>
    </p>
  </div>

  <!-- Advanced Options (Collapsible) -->
  <details class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
    <summary class="font-medium text-gray-700 dark:text-gray-300 cursor-pointer">
      Advanced Options
    </summary>
    
    <div class="mt-4 space-y-4">
      <!-- Refresh Interval -->
      <div>
        <%= f.label :refresh_interval, "Auto-Refresh Interval (seconds)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
        <%= f.number_field :refresh_interval,
            class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white",
            placeholder: "Leave empty for no auto-refresh",
            min: 30 %>
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
          How often to automatically refresh the dashboard data (minimum 30 seconds)
        </p>
      </div>
    </div>
  </details>

  <!-- Actions -->
  <div class="flex justify-end gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
    <%= link_to "Cancel", dashboard_widgets_path, 
        class: "px-6 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" %>
    
    <%= f.submit dashboard.persisted? ? "Update Dashboard" : "Create Dashboard",
        class: "px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors",
        data: { disable_with: "Saving..." } %>
  </div>
<% end %>
