<% provide(:title, "Dashboards") %>

<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800 dark:text-white">
      <i class="fas fa-chart-line mr-2"></i>My Dashboards
    </h1>
    
    <div class="flex gap-2">
      <%= link_to new_dashboard_widget_path, 
          class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg flex items-center gap-2 transition-colors" do %>
        <i class="fas fa-plus"></i>
        Create Dashboard
      <% end %>

      <%= link_to defect_filters_path, 
          class: "px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg flex items-center gap-2 transition-colors" do %>
        <i class="fas fa-filter"></i>
        Manage Filters
      <% end %>
    </div>
  </div>

  <% if @dashboards.empty? %>
    <!-- Empty State -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-12 text-center">
      <i class="fas fa-chart-line text-6xl text-gray-300 dark:text-gray-600 mb-4"></i>
      <h2 class="text-2xl font-semibold text-gray-700 dark:text-gray-300 mb-2">
        No Dashboards Yet
      </h2>
      <p class="text-gray-500 dark:text-gray-400 mb-6">
        Create your first dashboard to visualize defect data from your saved filters.
      </p>
      <%= link_to new_dashboard_widget_path, 
          class: "inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors" do %>
        <i class="fas fa-plus"></i>
        Create Your First Dashboard
      <% end %>
    </div>
  <% else %>
    <!-- Dashboards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @dashboards.each do |dashboard| %>
        <%= link_to dashboard_widget_path(dashboard), class: "block" do %>
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden border border-gray-200 dark:border-gray-700 hover:shadow-lg transition-shadow">
            <!-- Dashboard Header -->
            <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-700 dark:to-gray-800">
              <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-1">
                <%= dashboard.name %>
              </h3>
              <p class="text-xs text-gray-500 dark:text-gray-400">
                <i class="fas fa-filter mr-1"></i>
                <%= dashboard.defect_filter.name %>
              </p>
            </div>

            <!-- Dashboard Info -->
            <div class="px-6 py-4">
              <div class="flex items-center justify-between text-sm">
                <div class="flex items-center text-gray-600 dark:text-gray-400">
                  <i class="fas fa-chart-pie mr-2"></i>
                  Multi-Chart Dashboard
                </div>
                <div class="text-gray-500 dark:text-gray-400 text-xs">
                  <i class="far fa-clock mr-1"></i>
                  <%= time_ago_in_words(dashboard.updated_at) %> ago
                </div>
              </div>
              
              <!-- Active Parameters Preview -->
              <% if dashboard.active_filter_parameters.any? %>
                <div class="mt-3 pt-3 border-t border-gray-100 dark:border-gray-700">
                  <p class="text-xs text-gray-500 dark:text-gray-400 mb-2">Active Filters:</p>
                  <div class="flex flex-wrap gap-1">
                    <% dashboard.active_filter_parameters.take(3).each do |key, value| %>
                      <span class="inline-flex items-center px-2 py-1 rounded text-xs bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                        <%= key.to_s.titleize %>
                      </span>
                    <% end %>
                    <% if dashboard.active_filter_parameters.size > 3 %>
                      <span class="inline-flex items-center px-2 py-1 rounded text-xs bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-400">
                        +<%= dashboard.active_filter_parameters.size - 3 %> more
                      </span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>

            <!-- Dashboard Footer -->
            <div class="px-6 py-3 bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700 flex justify-between items-center">
              <div class="text-xs text-gray-500 dark:text-gray-400">
                <% if dashboard.refresh_interval.present? %>
                  <i class="fas fa-sync-alt mr-1"></i>
                  Refreshes every <%= dashboard.refresh_interval %>s
                <% else %>
                  <i class="fas fa-mouse-pointer mr-1"></i>
                  Manual refresh
                <% end %>
              </div>
              <i class="fas fa-arrow-right text-blue-600 dark:text-blue-400"></i>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
