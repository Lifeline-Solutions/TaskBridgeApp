<div class="mt-6 rounded-lg border border-gray-200 shadow-sm">
  <div class="bg-gray-50 px-4 py-2 border-b border-gray-200">
    <h3 class="text-sm font-semibold text-gray-700">Client Feedback</h3>
  </div>
  <div class="p-4">
    <% if @feedbacks.any? %>
      <% @feedbacks.each do |feedback| %>
        <div class="mb-4 pb-4 border-b border-gray-200 last:border-b-0">
          <!-- Rating row -->
          <div class="flex items-center mb-2">
            <span class="font-medium text-gray-800 mr-2">Rating:</span>
            <div class="flex items-center space-x-1">
              <% feedback.rating.times do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-yellow-400" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.32-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.63.283.95l-3.523 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                </svg>
              <% end %>
              <% (5 - feedback.rating).times do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-300" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M2.866 14.85c-.078.443.36.79.746.592L8 13.187l4.389 2.255c.386.198.824-.149.746-.592l-.83-4.73 3.523-3.356c.329-.32.158-.888-.283-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.63-.283.95l3.523 3.356-.83 4.73z"/>
                </svg>
              <% end %>
            </div>
          </div>

          <!-- Comment -->
          <% if feedback.comment.present? %>
            <p class="mb-2 text-gray-700">
              <span class="font-medium">Comment:</span><br>
              <%= feedback.comment&.body&.to_s&.html_safe %>
            </p>
          <% end %>

          <!-- Metadata -->
          <small class="block text-sm text-gray-500">
            By: <%= feedback.creator&.name || "Unknown" %> 
            on <%= feedback.created_at.strftime("%b %d, %Y %I:%M %p") %>
          </small>
        </div>
      <% end %>
    <% else %>
      <p class="text-gray-500 text-sm">No feedback has been submitted yet.</p>
    <% end %>
  </div>
</div>
