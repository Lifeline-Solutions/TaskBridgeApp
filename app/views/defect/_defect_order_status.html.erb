<% @defects.group_by { |defect| "#{defect.product.client.name} #{defect.product.groupwares.first&.name}" }.each do |group_name, defects| %>
  <!-- Group Header -->
  <tr class="bg-gray-100 dark:bg-gray-700">
    <td colspan="9" class="px-6 py-3 font-semibold text-left">

      <%= link_to "#{group_name.truncate(30)} (#{defects.size})",
                  index_show_defect_index_path(client_name: defects.first.product.client.name),
                  class: "text-blue-700 hover:underline" %>



    </td>
  </tr>
<% end %>
