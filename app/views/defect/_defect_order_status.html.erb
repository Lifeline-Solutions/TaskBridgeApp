<div class="overflow-auto shadow-md sm:rounded-lg border border-gray-200 dark:border-gray-700" style="max-height: calc(100vh - 300px); min-height: 400px;">
  <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
    <thead class="text-xs uppercase bg-gray-100 dark:bg-gray-700 dark:text-gray-400 border-b border-gray-200 dark:border-gray-600">
    <tr>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 w-12 min-w-[3rem] border-r border-gray-200 dark:border-gray-600" style="position: sticky; left: 0; top: 0; z-index: 10;">#</th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 w-28 min-w-[7rem] border-r border-gray-200 dark:border-gray-600" style="position: sticky; left: 3rem; top: 0; z-index: 10;">Defect ID</th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 w-64 min-w-[16rem] border-r border-gray-200 dark:border-gray-600" style="position: sticky; left: 10rem; top: 0; z-index: 10;">Summary</th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 border-r border-gray-200 dark:border-gray-600" style="position: sticky; top: 0; z-index: 1;">Status</th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 border-r border-gray-200 dark:border-gray-600" style="position: sticky; top: 0; z-index: 1;">Priority</th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 border-r border-gray-200 dark:border-gray-600" style="position: sticky; top: 0; z-index: 1;">Module</th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 border-r border-gray-200 dark:border-gray-600" style="position: sticky; top: 0; z-index: 1;">Sub Module</th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 border-r border-gray-200 dark:border-gray-600" style="position: sticky; top: 0; z-index: 1;">Banking Types</th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 border-r border-gray-200 dark:border-gray-600" style="position: sticky; top: 0; z-index: 1;">Labels</th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 border-r border-gray-200 dark:border-gray-600" style="position: sticky; top: 0; z-index: 1;"><%= defect_sort_link(:assignee, 'Assignee(s)') %></th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 border-r border-gray-200 dark:border-gray-600" style="position: sticky; top: 0; z-index: 1;"><%= defect_sort_link(:reporter, 'Reporter') %></th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 border-r border-gray-200 dark:border-gray-600" style="position: sticky; top: 0; z-index: 1;">Created At</th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 border-r border-gray-200 dark:border-gray-600" style="position: sticky; top: 0; z-index: 1;">Retest Count</th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 border-r border-gray-200 dark:border-gray-600" style="position: sticky; top: 0; z-index: 1;">Reopened Count</th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 border-r border-gray-200 dark:border-gray-600" style="position: sticky; top: 0; z-index: 1;">Project</th>
      <th scope="col" class="px-3 py-2 bg-gray-100 dark:bg-gray-700" style="position: sticky; top: 0; z-index: 1;">Actions</th>
    </tr>
    </thead>
    <tbody>
    <% if @defects.present? %>
      <%
        sorted_defects = if @sort_by.present?
                           @defects.to_a
                         else
                           @defects.sort_by { |d| d.defect_unique&.split('-')&.last.to_i || 0 }.reverse
                         end
      %>
      <% sorted_defects.each_with_index do |defect, index| %>
        <% row_number = @start_count + index %>
      <!-- Your defect row rendering here, unchanged -->
      <tr class="group bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 text-left">
        <td class="px-3 py-2 font-semibold text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-800 group-hover:bg-gray-50 dark:group-hover:bg-gray-600 sticky left-0 z-[5] w-12 min-w-[3rem] border-r border-gray-200 dark:border-gray-700">
          <%= row_number %>
        </td>
        <td class="px-3 py-2 whitespace-nowrap bg-white dark:bg-gray-800 group-hover:bg-gray-50 dark:group-hover:bg-gray-600 sticky z-[5] w-28 min-w-[7rem] border-r border-gray-200 dark:border-gray-700" style="left: 3rem;">
          <%= link_to defect_display_id(defect), defect_path(defect), class: "text-blue-600 hover:underline font-medium text-xs" %>
        </td>
        <td class="px-3 py-2 bg-white dark:bg-gray-800 group-hover:bg-gray-50 dark:group-hover:bg-gray-600 sticky z-[5] w-64 min-w-[16rem] border-r border-gray-200 dark:border-gray-700" style="left: 10rem;" title="<%= defect.summary if defect.summary.present? %>">
          <% if defect.summary.present? %>
            <%= defect.summary.truncate(20) %>
          <% end %>
        </td>
        <td class="px-3 py-2 whitespace-nowrap min-w-[160px] border-r border-gray-200 dark:border-gray-700">
          <div class="flex items-center gap-2">
            <%= render partial: 'defect/defect_statuses', locals: { defect: defect } %>
          </div>
        </td>
        <td class="px-3 py-2 whitespace-nowrap border-r border-gray-200 dark:border-gray-700">
          <span class="px-2 py-1 text-xs font-semibold rounded inline-block <%= priority_badge_class(defect.priority) %>">
            <%= defect.priority %>
          </span>
        </td>
        <td class="px-3 py-2 whitespace-nowrap border-r border-gray-200 dark:border-gray-700">
          <%= defect.qa_module&.name || 'Not specified' %>
        </td>
        <td class="px-3 py-2 whitespace-nowrap border-r border-gray-200 dark:border-gray-700">
          <%= defect.submodule&.name || 'Not specified' %>
        </td>
        <td class="px-3 py-2 whitespace-nowrap border-r border-gray-200 dark:border-gray-700">
          <%= defect.banking_type&.name || 'Not specified' %>
        </td>
        <td class="px-3 py-2 border-r border-gray-200 dark:border-gray-700">
          <% defect.labels.each do |label| %>
            <span class="px-2 py-1 text-xs font-medium bg-gray-200 text-gray-700 rounded dark:bg-gray-600 dark:text-gray-100">
              <%= label.name %>
            </span>
          <% end %>
        </td>
        <!-- Assignee(s) -->
        <td class="px-3 py-2 whitespace-nowrap border-r border-gray-200 dark:border-gray-700">
          <div class="flex items-center gap-2">
            <%= render partial: 'defect/user_initials', locals: { defect: defect } %>
            <span class="text-sm"><%= defect.users.map { |u| [u.first_name, u.last_name].compact.join(' ') }
                      .reject(&:blank?)
                      .join(', ')
                      .presence || 'Unassigned' %></span>
          </div>
        </td>
        <!-- Reporter -->
        <td class="px-3 py-2 whitespace-nowrap border-r border-gray-200 dark:border-gray-700">
          <% if defect.creator.present? %>
            <div class="flex gap-2 items-center">
              <!-- Avatar circle with initials -->
              <div class="w-8 h-8 flex items-center justify-center rounded-full text-xs font-medium bg-green-700 text-white">
                <%= defect.creator.name.split.map { |n| n[0] }.join.upcase %>
              </div>
              <!-- Full name -->
              <span class="text-sm"><%= defect.creator.name %></span>
            </div>
          <% else %>
            <p class="text-red-500 text-sm">No reporter set</p>
          <% end %>
        </td>
        <td class="px-3 py-2 whitespace-nowrap min-w-[140px] border-r border-gray-200 dark:border-gray-700">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 flex-shrink-0 text-gray-600 dark:text-gray-400">
              <path d="M12 11.993a.75.75 0 0 0-.75.75v.006c0 .414.336.75.75.75h.006a.75.75 0 0 0 .75-.75v-.006a.75.75 0 0 0-.75-.75H12ZM12 16.494a.75.75 0 0 0-.75.75v.005c0 .414.335.75.75.75h.005a.75.75 0 0 0 .75-.75v-.005a.75.75 0 0 0-.75-.75H12ZM8.999 17.244a.75.75 0 0 1 .75-.75h.006a.75.75 0 0 1 .75.75v.006a.75.75 0 0 1-.75.75h-.006a.75.75 0 0 1-.75-.75v-.006ZM7.499 16.494a.75.75 0 0 0-.75.75v.005c0 .414.336.75.75.75h.005a.75.75 0 0 0 .75-.75v-.005a.75.75 0 0 0-.75-.75H7.5ZM13.499 14.997a.75.75 0 0 1 .75-.75h.006a.75.75 0 0 1 .75.75v.005a.75.75 0 0 1-.75.75h-.006a.75.75 0 0 1-.75-.75v-.005ZM14.25 16.494a.75.75 0 0 0-.75.75v.006c0 .414.335.75.75.75h.005a.75.75 0 0 0 .75-.75v-.006a.75.75 0 0 0-.75-.75h-.005ZM15.75 14.995a.75.75 0 0 1 .75-.75h.005a.75.75 0 0 1 .75.75v.006a.75.75 0 0 1-.75.75H16.5a.75.75 0 0 1-.75-.75v-.006ZM13.498 12.743a.75.75 0 0 1 .75-.75h2.25a.75.75 0 1 1 0 1.5h-2.25a.75.75 0 0 1-.75-.75ZM6.748 14.993a.75.75 0 0 1 .75-.75h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1-.75-.75Z" />
              <path fill-rule="evenodd" d="M18 2.993a.75.75 0 0 0-1.5 0v1.5h-9V2.994a.75.75 0 1 0-1.5 0v1.497h-.752a3 3 0 0 0-3 3v11.252a3 3 0 0 0 3 3h13.5a3 3 0 0 0 3-3V7.492a3 3 0 0 0-3-3H18V2.993ZM3.748 18.743v-7.5a1.5 1.5 0 0 1 1.5-1.5h13.5a1.5 1.5 0 0 1 1.5 1.5v7.5a1.5 1.5 0 0 1-1.5 1.5h-13.5a1.5 1.5 0 0 1-1.5-1.5Z" clip-rule="evenodd" />
            </svg>
            <span class="font-medium text-xs"><%= defect.created_at.strftime('%d-%m-%Y') %></span>
          </div>
        </td>
        <td class="px-3 py-2 text-center border-r border-gray-200 dark:border-gray-700">
          <span class="px-2 py-1 text-xs font-medium rounded">
            <%= defect.retest_count %>
          </span>
        </td>
        <td class="px-3 py-2 text-center border-r border-gray-200 dark:border-gray-700">
          <span class="px-2 py-1 text-xs font-medium rounded">
            <%= (@reopened_counts || {})[defect.id].to_i %>
          </span>
        </td>

        <td class="px-3 py-2 whitespace-nowrap border-r border-gray-200 dark:border-gray-700">
          <% if defect.product.present? %>
            <%= link_to(
                  "#{defect.product.client&.name} #{defect.product.groupwares.first&.name}".truncate(30),
                  product_path(defect.product),
                  class: "text-blue-600 hover:underline text-sm"
                ) %>
          <% else %>
            <span class="text-gray-400 italic text-sm">Not specified</span>
          <% end %>
        </td>
        <td class="px-3 py-2 text-right" data-controller="dropdown" data-dropdown-ticket-id-value="<%= defect.id %>">
          <div class="relative w-full flex justify-start">
            <%= render partial: 'defect/action_dropdown', locals: { defect: defect } %>
          </div>
        </td>
      </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="15" class="px-6 py-4 text-center text-gray-500 dark:text-gray-400">
          No defects found
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>

<!-- Results count display -->
<% if @defects.present? && @total_count && @total_count > 0 %>
  <div class="mt-2 px-3 py-1.5 text-xs text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-800 rounded">
    Showing <span class="font-semibold"><%= @start_count %></span> to <span class="font-semibold"><%= @end_count %></span> of <span class="font-semibold"><%= @total_count %></span> results
  </div>
<% end %>

<div class="flex gap-2 mt-3 items-center">
  <!-- Pagination Controls -->
  <div class="flex gap-2 items-center">
    <!-- First Page Button -->
    <% if @page > 1 %>
      <%= link_to 'First',
                  index_show_defect_index_path(
                    request.query_parameters.merge(page: 1)
                  ),
                  class: 'bg-[#3F8CFF] hover:bg-[#3A81EB] px-3 py-2 rounded text-sm font-medium text-slate-100' %>
    <% else %>
      <button disabled class="bg-gray-300 dark:bg-gray-600 px-3 py-2 rounded text-sm font-medium text-gray-500 dark:text-gray-400 cursor-not-allowed">
        First
      </button>
    <% end %>

    <!-- Previous Page Button -->
    <% if @page > 1 %>
      <%= link_to 'Previous',
                  index_show_defect_index_path(
                    request.query_parameters.merge(page: @page - 1)
                  ),
                  class: 'bg-[#3F8CFF] hover:bg-[#3A81EB] px-3 py-2 rounded text-sm font-medium text-slate-100' %>
    <% else %>
      <button disabled class="bg-gray-300 dark:bg-gray-600 px-3 py-2 rounded text-sm font-medium text-gray-500 dark:text-gray-400 cursor-not-allowed">
        Previous
      </button>
    <% end %>

    <!-- Page Info -->
    <span class="px-2 text-sm text-gray-700 dark:text-gray-300 font-medium">Page <%= @page %> of <%= @total_pages %></span>

    <!-- Next Page Button -->
    <% if @page < @total_pages %>
      <%= link_to 'Next',
                  index_show_defect_index_path(
                    request.query_parameters.merge(page: @page + 1)
                  ),
                  class: 'bg-[#3F8CFF] hover:bg-[#3A81EB] px-3 py-2 rounded text-sm font-medium text-slate-100' %>
    <% else %>
      <button disabled class="bg-gray-300 dark:bg-gray-600 px-3 py-2 rounded text-sm font-medium text-gray-500 dark:text-gray-400 cursor-not-allowed">
        Next
      </button>
    <% end %>

    <!-- Last Page Button -->
    <% if @page < @total_pages %>
      <%= link_to 'Last',
                  index_show_defect_index_path(
                    request.query_parameters.merge(page: @total_pages)
                  ),
                  class: 'bg-[#3F8CFF] hover:bg-[#3A81EB] px-3 py-2 rounded text-sm font-medium text-slate-100' %>
    <% else %>
      <button disabled class="bg-gray-300 dark:bg-gray-600 px-3 py-2 rounded text-sm font-medium text-gray-500 dark:text-gray-400 cursor-not-allowed">
        Last
      </button>
    <% end %>
  </div>
</div>
