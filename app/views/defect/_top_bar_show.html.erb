<!-- Improved Topbar with Clean, Intuitive Design -->
<div class="bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700">
  <div class="max-w-full px-4 py-3">
    <div class="flex items-center justify-between gap-4">
      
      <!-- Left Section: Back and Actions -->
      <div class="flex items-center gap-3">
        <%= button_to defect_index_path, method: :get, class: 'inline-flex items-center gap-2 px-3 py-2 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg font-medium transition-all duration-200' do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
          <span class="hidden sm:inline">Back</span>
        <% end %>

        <div class="hidden sm:block w-px h-8 bg-gray-300 dark:bg-gray-600"></div>

        <button type="button" 
                id="actionsMenuButton"
                class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-all duration-200 shadow-sm hover:shadow">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" />
          </svg>
          <span>Actions</span>
        </button>

        <%= link_to drafts_defect_index_path,
              class: "inline-flex items-center gap-2 px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg font-medium transition-all duration-200 shadow-sm hover:shadow" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" />
          </svg>
          <span class="hidden sm:inline">Drafts</span>
        <% end %>
      </div>

      <!-- Right Section: Filters and Downloads -->
      <div class="flex items-center gap-2">
        <% 
          # Check if any filters are active
          has_active_filters = params[:status].present? || 
                               params[:priority].present? || 
                               params[:user_id].present? || 
                               params[:label_ids].present? || 
                               params[:qa_module_id].present? || 
                               params[:submodule_id].present? || 
                               params[:banking_type_id].present? || 
                               params[:start_date].present? || 
                               params[:end_date].present? || 
                               params[:query].present? || 
                               params[:order].present?
        %>
        
        <% if has_active_filters %>
          <%= link_to index_show_defect_index_path(
                product_id: params[:product_id],
                client_name: params[:client_name]
              ), 
              class: "inline-flex items-center gap-2 px-3 py-2 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg font-medium transition-all duration-200 border border-red-300 dark:border-red-700" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            <span class="hidden md:inline">Clear Filters</span>
          <% end %>

          <button type="button"
                  id="saveFiltersButton"
                  class="inline-flex items-center gap-2 px-3 py-2 text-green-600 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/20 rounded-lg font-medium transition-all duration-200 border border-green-300 dark:border-green-700">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
            </svg>
            <span class="hidden md:inline">Save Filters</span>
          </button>
        <% end %>

        <!-- Filter Button -->
        <div class="relative">
          <button id="filterDropdownButton" 
                  class="inline-flex items-center gap-2 px-4 py-2 <%= has_active_filters ? 'bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border-blue-300 dark:border-blue-700' : 'bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 border-gray-300 dark:border-gray-600' %> border rounded-lg hover:bg-gray-50 dark:hover:bg-gray-600 font-medium transition-all duration-200">
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L12 11.414V15a1 1 0 01-.293.707l-2 2A1 1 0 018 17v-5.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd" />
            </svg>
            <span class="hidden sm:inline">Filters</span>
            <% if has_active_filters %>
              <span class="flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-blue-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
              </span>
            <% end %>
          </button>

          <!-- Filter Dropdown Menu -->
          <div id="filterDropdown" class="hidden absolute bg-white dark:bg-gray-700 right-0 mt-2 w-64 origin-top-right rounded-md shadow-lg border border-gray-200 z-10">
            <%= form_with url: index_show_defect_index_path, method: :get, class: 'p-2 space-y-2', id: 'index-show-filter-form' do |f| %>
              <!-- Hidden fields to preserve context -->
              <% Array(params[:product_id]).each do |product_id| %>
                <%= hidden_field_tag 'product_id[]', product_id %>
              <% end %>
              <%= hidden_field_tag :client_name, params[:client_name] %>

              <!-- Project Filter (Multi-Select) - Only show when multiple projects exist -->
              <% if @products.present? && @products.size > 1 %>
                <div>
                  <%= label_tag 'product_id[]', 'Project', class: 'block font-medium mb-1 text-sm border-gray-300 dark:bg-gray-500' %>
                  <div class="relative inline-block text-left w-full multi-select-dropdown">
                    <button type="button"
                            id="productDropdownButton"
                            class="w-full p-1 text-sm border-gray-300 dark:bg-gray-500 rounded text-left inline-flex justify-between items-center"
                            onclick="toggleDropdown('productDropdown')">
                      <span id="productButtonText">Select Projects...</span>
                      <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </button>

                    <div id="productDropdown" class="absolute z-10 mt-1 bg-white border border-gray-200 rounded-md shadow-lg w-full hidden dropdown-content">
                      <div class="p-2 border-b">
                        <input type="text" 
                              id="productSearch" 
                              placeholder="Search projects..." 
                              class="w-full p-1 text-sm border rounded"
                              onkeyup="filterDropdownItems('productSearch', 'productItems')">
                      </div>
                      
                      <div class="max-h-60 overflow-y-auto">
                        <div id="productItems" class="p-2 space-y-2">
                          <% selected_products = Array(params[:product_id]) %>
                          
                          <!-- Select All Option -->
                          <div class="flex items-center border-b pb-2 mb-2">
                            <%= check_box_tag 'select_all_product', 
                                              'all', 
                                              selected_products.length == @products.length,
                                              id: "select_all_product",
                                              class: "mr-2 select-all-checkbox",
                                              data: { target: 'product' } %>
                            <%= label_tag "select_all_product", "Select All", class: "text-sm font-medium" %>
                          </div>
                          
                          <% @products.each do |product| %>
                            <% display_name = "#{product.client&.name} #{product.groupwares&.first&.name}".strip %>
                            <% display_name = product.document_name if display_name.blank? %>
                            <div class="flex items-center dropdown-item">
                              <%= check_box_tag 'product_id[]',
                                                product.id,
                                                selected_products.include?(product.id.to_s),
                                                id: "product_#{product.id}",
                                                class: "mr-2 product-checkbox" %>
                              <%= label_tag "product_#{product.id}", display_name.truncate(30), class: "text-sm" %>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>

              <!-- Order Filter -->
              <div>
                <%= label_tag :order, 'Sort By', class: 'block font-medium mb-1 text-sm border-gray-300 dark:bg-gray-500' %>
                <%= select_tag :order, options_for_select([['Latest First', 'desc'], ['Oldest First', 'asc']], params[:order]),
                              class: "w-full p-1 text-sm border-gray-300 dark:bg-gray-500 rounded" %>
              </div>

              <!-- Date Range -->
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <%= label_tag :start_date, 'From', class: 'block font-medium mb-1 text-sm border-gray-300 dark:bg-gray-500' %>
                  <%= date_field_tag :start_date, params[:start_date], class: "w-full p-1 text-sm border-gray-300 dark:bg-gray-500 rounded" %>
                </div>
                <div>
                  <%= label_tag :end_date, 'To', class: 'block font-medium mb-1 text-sm border-gray-300 dark:bg-gray-500' %>
                  <%= date_field_tag :end_date, params[:end_date], class: "w-full p-1 text-sm border-gray-300 dark:bg-gray-500 rounded" %>
                </div>
              </div>

              <!-- Status Filter (Multi-Select) -->
              <div>
                <%= label_tag 'status[]', 'Status', class: 'block text-sm border-gray-300 dark:bg-gray-500 font-medium mb-1' %>
                <div class="relative inline-block text-left w-full multi-select-dropdown">
                  <button type="button"
                          id="statusDropdownButton"
                          class="w-full p-1 text-sm border-gray-300 dark:bg-gray-500 rounded text-left inline-flex justify-between items-center"
                          onclick="toggleDropdown('statusDropdown')">
                    <span id="statusButtonText">Filter by Status</span>
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </button>

                  <div id="statusDropdown" class="absolute z-10 mt-1 bg-white border border-gray-200 rounded-md shadow-lg w-full hidden dropdown-content">
                    <div class="p-2 border-b">
                      <input type="text" 
                            id="statusSearch" 
                            placeholder="Search statuses..." 
                            class="w-full p-1 text-sm border rounded"
                            onkeyup="filterDropdownItems('statusSearch', 'statusItems')">
                    </div>
                    
                    <div class="max-h-60 overflow-y-auto">
                      <div id="statusItems" class="p-2 space-y-2">
                        <% selected_statuses = Array(params[:status]).map { |s| s.to_s.downcase } %>
                        
                        <!-- Select All Option -->
                        <div class="flex items-center border-b pb-2 mb-2">
                          <%= check_box_tag 'select_all_status', 
                                            'all', 
                                            selected_statuses.length == @statuses.length,
                                            id: "select_all_status",
                                            class: "mr-2 select-all-checkbox",
                                            data: { target: 'status' } %>
                          <%= label_tag "select_all_status", "Select All", class: "text-sm font-medium" %>
                        </div>
                        
                        <% @statuses.each do |status| %>
                          <div class="flex items-center dropdown-item">
                            <%= check_box_tag 'status[]',
                                              status.name,
                                              selected_statuses.include?(status.name.downcase),
                                              id: "status_#{status.name.parameterize}",
                                              class: "mr-2 status-checkbox" %>
                            <%= label_tag "status_#{status.name.parameterize}", status.name.capitalize, class: "text-sm" %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Priority Filter (Multi-Select) -->
              <div>
                <%= label_tag 'priority[]', 'Priority', class: 'block text-sm border-gray-300 dark:bg-gray-500 font-medium mb-1' %>

                <div class="relative inline-block text-left w-full multi-select-dropdown">
                  <button type="button"
                          id="priorityDropdownButton"
                          class="w-full p-1 text-sm border-gray-300 dark:bg-gray-500 rounded text-left inline-flex justify-between items-center"
                          onclick="toggleDropdown('priorityDropdown')">
                    <span id="priorityButtonText">Filter by Priority</span>
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </button>

                  <div id="priorityDropdown"
                      class="absolute z-10 mt-1 bg-white border border-gray-200 rounded-md shadow-lg w-full hidden dropdown-content">

                    <!-- Search Input -->
                    <div class="p-2 border-b">
                      <input type="text"
                            id="prioritySearch"
                            placeholder="Search priorities..."
                            class="w-full p-1 text-sm border rounded"
                            onkeyup="filterDropdownItems('prioritySearch', 'priorityItems')">
                    </div>

                    <!-- Items -->
                    <div class="max-h-60 overflow-y-auto">
                      <div id="priorityItems" class="p-2 space-y-2">

                        <% 
                          # Define all possible priority options in uppercase for display
                          display_priorities = ['SEVERITY 1', 'SEVERITY 2', 'SEVERITY 3', 'SEVERITY 4']
                          
                          # Get selected priorities from params
                          selected_priorities = Array(params[:priority])
                          
                          # Create a mapping of display values to search patterns for case-insensitive matching
                          priority_patterns = {
                            'SEVERITY 1' => /severity 1/i,
                            'SEVERITY 2' => /severity 2/i, 
                            'SEVERITY 3' => /severity 3/i,
                            'SEVERITY 4' => /severity 4/i
                          }
                        %>

                        <!-- Select All -->
                        <div class="flex items-center border-b pb-2 mb-2">
                          <%= check_box_tag 'select_all_priority',
                                            'all',
                                            selected_priorities.length == display_priorities.length,
                                            id: "select_all_priority",
                                            class: "mr-2 select-all-checkbox",
                                            data: { target: 'priority' } %>
                          <%= label_tag "select_all_priority", "Select All", class: "text-sm font-medium" %>
                        </div>

                        <!-- Priority Items -->
                        <% display_priorities.each do |display_priority| %>
                          <% 
                            # Check if this priority is selected using case-insensitive pattern matching
                            pattern = priority_patterns[display_priority]
                            is_selected = selected_priorities.any? { |selected| pattern.match?(selected) }
                          %>
                          <div class="flex items-center dropdown-item"
                              data-name="<%= display_priority.downcase %>">
                            <%= check_box_tag 'priority[]',
                                              display_priority, # This is what gets sent in params
                                              is_selected,
                                              id: "priority_#{display_priority.parameterize}",
                                              class: "mr-2 priority-checkbox" %>
                            <%= label_tag "priority_#{display_priority.parameterize}",
                                          display_priority,
                                          class: "text-sm" %>
                          </div>
                        <% end %>

                      </div>
                    </div>

                  </div>
                </div>
              </div>

              <script>
                // Case-insensitive filter function
                function filterDropdownItems(searchInputId, itemsContainerId) {
                  const input = document.getElementById(searchInputId).value.toLowerCase();
                  const items = document
                    .getElementById(itemsContainerId)
                    .getElementsByClassName("dropdown-item");

                  Array.from(items).forEach(item => {
                    const name = item.getAttribute("data-name").toLowerCase();
                    item.style.display = name.includes(input) ? "flex" : "none";
                  });
                }

                // Toggle dropdown visibility
                function toggleDropdown(id) {
                  const dropdown = document.getElementById(id);
                  dropdown.classList.toggle('hidden');
                }

                // Update the button text functionality to handle case-insensitive counts
                function updatePriorityButtonText() {
                  const priorityCheckboxes = document.querySelectorAll('.priority-checkbox:not(.select-all-checkbox)');
                  const selectedCount = Array.from(priorityCheckboxes).filter(cb => cb.checked).length;
                  const totalCount = priorityCheckboxes.length;
                  const buttonText = document.getElementById('priorityButtonText');
                  
                  if (selectedCount === 0) {
                    buttonText.textContent = 'Filter by Priority';
                  } else if (selectedCount === totalCount) {
                    buttonText.textContent = 'Filter by Priority (All)';
                  } else {
                    buttonText.textContent = `Filter by Priority (${selectedCount} selected)`;
                  }
                }

                // Initialize button text on page load
                document.addEventListener('turbo:load', function() {
                  updatePriorityButtonText();
                  
                  // Add event listeners to priority checkboxes
                  document.querySelectorAll('.priority-checkbox').forEach(checkbox => {
                    checkbox.addEventListener('change', function() {
                      updatePriorityButtonText();
                    });
                  });
                  
                  // Select all functionality for priorities
                  const selectAllPriority = document.getElementById('select_all_priority');
                  if (selectAllPriority) {
                    selectAllPriority.addEventListener('change', function(e) {
                      const checkboxes = document.querySelectorAll('.priority-checkbox:not(.select-all-checkbox)');
                      checkboxes.forEach(cb => {
                        cb.checked = e.target.checked;
                      });
                      updatePriorityButtonText();
                    });
                  }
                });
              </script>


              <!-- Assignee Filter (Multi-Select) -->
              <div>
                <%= label_tag 'user_id[]', 'Assignee', class: 'block text-xs font-medium mb-1' %>
                <div class="relative inline-block text-left w-full multi-select-dropdown">
                  <button type="button"
                          id="assigneeDropdownButton"
                          class="w-full p-1 text-sm border-gray-300 dark:bg-gray-500 rounded text-left inline-flex justify-between items-center"
                          onclick="toggleDropdown('assigneeDropdown')">
                    <span id="assigneeButtonText">Filter by Assignee</span>
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </button>

                  <div id="assigneeDropdown" class="absolute z-10 mt-1 bg-white border border-gray-200 rounded-md shadow-lg w-full hidden dropdown-content">
                    <div class="p-2 border-b">
                      <input type="text" 
                            id="assigneeSearch" 
                            placeholder="Search assignees..." 
                            class="w-full p-1 text-sm border rounded"
                            onkeyup="filterDropdownItems('assigneeSearch', 'assigneeItems')">
                    </div>
                    
                    <div class="max-h-60 overflow-y-auto">
                      <div id="assigneeItems" class="p-2 space-y-2">
                        <% selected_assignees = Array(params[:user_id]) %>
                        <% assignees_for_filter = User.joins(:defects).where(defects: { id: @defects.except(:select, :order, :limit, :offset).select(:id) }).distinct.order(:first_name, :last_name) %>
                        
                        <!-- Select All Option -->
                        <div class="flex items-center border-b pb-2 mb-2">
                          <%= check_box_tag 'select_all_assignee', 
                                            'all', 
                                            selected_assignees.length == assignees_for_filter.length,
                                            id: "select_all_assignee",
                                            class: "mr-2 select-all-checkbox",
                                            data: { target: 'assignee' } %>
                          <%= label_tag "select_all_assignee", "Select All", class: "text-sm font-medium" %>
                        </div>
                        
                        <% assignees_for_filter.each do |assignee| %>
                          <div class="flex items-center dropdown-item">
                            <%= check_box_tag 'user_id[]',
                                              assignee.id,
                                              selected_assignees.include?(assignee.id.to_s),
                                              id: "assignee_#{assignee.id}",
                                              class: "mr-2 assignee-checkbox" %>
                            <%= label_tag "assignee_#{assignee.id}", "#{assignee.first_name} #{assignee.last_name}", class: "text-sm" %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Reporter Filter (Multi-Select) -->
              <div>
                <%= label_tag 'reporter_id[]', 'Reporter', class: 'block text-xs font-medium mb-1' %>
                <div class="relative inline-block text-left w-full multi-select-dropdown">
                  <button type="button"
                          id="reporterDropdownButton"
                          class="w-full p-1 text-sm border-gray-300 dark:bg-gray-500 rounded text-left inline-flex justify-between items-center"
                          onclick="toggleDropdown('reporterDropdown')">
                    <span id="reporterButtonText">Filter by Reporter</span>
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </button>

                  <div id="reporterDropdown" class="absolute z-10 mt-1 bg-white border border-gray-200 rounded-md shadow-lg w-full hidden dropdown-content">
                    <div class="p-2 border-b">
                      <input type="text" 
                            id="reporterSearch" 
                            placeholder="Search reporters..." 
                            class="w-full p-1 text-sm border rounded"
                            onkeyup="filterDropdownItems('reporterSearch', 'reporterItems')">
                    </div>
                    
                    <div class="max-h-60 overflow-y-auto">
                      <div id="reporterItems" class="p-2 space-y-2">
                        <% selected_reporters = Array(params[:reporter_id]) %>
                        <% reporters_for_filter = User.where(id: @defects.except(:select, :order, :limit, :offset, :distinct).select('DISTINCT defects.created_by')).order(:first_name, :last_name) %>
                        
                        <!-- Select All Option -->
                        <div class="flex items-center border-b pb-2 mb-2">
                          <%= check_box_tag 'select_all_reporter', 
                                            'all', 
                                            selected_reporters.any? && selected_reporters.length == reporters_for_filter.length,
                                            id: "select_all_reporter",
                                            class: "mr-2 select-all-checkbox",
                                            data: { target: 'reporter' } %>
                          <%= label_tag "select_all_reporter", "Select All", class: "text-sm font-medium" %>
                        </div>
                        
                        <% reporters_for_filter.each do |reporter| %>
                          <div class="flex items-center dropdown-item">
                            <%= check_box_tag 'reporter_id[]',
                                              reporter.id,
                                              selected_reporters.include?(reporter.id.to_s),
                                              id: "reporter_#{reporter.id}",
                                              class: "mr-2 reporter-checkbox" %>
                            <%= label_tag "reporter_#{reporter.id}", "#{reporter.first_name} #{reporter.last_name}", class: "text-sm" %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- QA Module Filter (Multi-Select) -->
              <div>
                <%= label_tag 'qa_module_id[]', 'Module', class: 'block text-xs font-medium mb-1' %>
                <div class="relative inline-block text-left w-full multi-select-dropdown">
                  <button type="button"
                          id="moduleDropdownButton"
                          class="w-full p-1 text-sm border-gray-300 dark:bg-gray-500 rounded text-left inline-flex justify-between items-center"
                          onclick="toggleDropdown('moduleDropdown')">
                    <span id="moduleButtonText">Filter by Module</span>
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </button>

                  <div id="moduleDropdown" class="absolute z-10 mt-1 bg-white border border-gray-200 rounded-md shadow-lg w-full hidden dropdown-content">
                    <div class="p-2 border-b">
                      <input type="text" 
                            id="moduleSearch" 
                            placeholder="Search modules..." 
                            class="w-full p-1 text-sm border rounded"
                            onkeyup="filterDropdownItems('moduleSearch', 'moduleItems')">
                    </div>
                    
                    <div class="max-h-60 overflow-y-auto">
                      <div id="moduleItems" class="p-2 space-y-2">
                        <% selected_modules = Array(params[:qa_module_id]) %>
                        
                        <!-- Select All Option -->
