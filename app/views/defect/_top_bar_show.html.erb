                                              selected_labels.include?(label.id.to_s),
                                              id: "label_#{label.id}",
                                              class: "mr-2 labels-checkbox" %>
                            <%= label_tag "label_#{label.id}", label.name, class: "text-sm" %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="pt-2 flex justify-between">
                <%= submit_tag 'Apply Filters', class: 'flex-1 px-4 py-2 text-sm bg-blue-600 rounded-lg hover:bg-blue-700 focus:outline-none text-white font-medium transition-colors duration-200' %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Download Dropdown -->
        <div class="relative">
          <button type="button" 
                  id="downloadDropdownButton"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg font-medium transition-all duration-200 shadow-sm hover:shadow">
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span class="hidden sm:inline">Export</span>
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div id="downloadDropdown" class="hidden absolute right-0 mt-2 w-48 bg-white dark:bg-gray-800 rounded-lg shadow-xl border border-gray-200 dark:border-gray-700 z-20">
            <div class="py-1">
              <%= link_to defects_download_defect_index_path(
                    format: :csv,
                    product_id: params[:product_id],
                    client_name: params[:client_name],
                    query: params[:query],
                    order: params[:order],
                    start_date: params[:start_date],
                    end_date: params[:end_date],
                    priority: params[:priority],
                    user_id: params[:user_id],
                    reporter_id: params[:reporter_id],
                    qa_module_id: params[:qa_module_id],
                    submodule_id: params[:submodule_id],
                    banking_type_id: params[:banking_type_id],
                    status: params[:status],
                    label_ids: params[:label_ids]
                  ), class: "flex items-center gap-3 px-4 py-3 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" do %>
                <svg class="w-5 h-5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9 2a2 2 0 00-2 2v8a2 2 0 002 2h6a2 2 0 002-2V6.414A2 2 0 0016.414 5L14 2.586A2 2 0 0012.586 2H9z"/>
                  <path d="M3 8a2 2 0 012-2v10h8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z"/>
                </svg>
                <span>CSV Format</span>
              <% end %>
              
              <%= link_to defects_download_excel_defect_index_path(
                    product_id: params[:product_id],
                    client_name: params[:client_name],
                    query: params[:query],
                    order: params[:order],
                    start_date: params[:start_date],
                    end_date: params[:end_date],
                    priority: params[:priority],
                    user_id: params[:user_id],
                    reporter_id: params[:reporter_id],
                    qa_module_id: params[:qa_module_id],
                    submodule_id: params[:submodule_id],
                    banking_type_id: params[:banking_type_id],
                    status: params[:status],
                    label_ids: params[:label_ids]
                  ), class: "flex items-center gap-3 px-4 py-3 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" do %>
                <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm5 6a1 1 0 10-2 0v3.586L7.707 10.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V8z" clip-rule="evenodd"/>
                </svg>
                <span>Excel Format</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Actions Modal with Clear Background -->
<div id="actionsModal" 
     data-controller="actions-modal"
     data-action="click->actions-modal#closeOnBackdrop"
     class="hidden fixed inset-0 bg-gray-900/20 backdrop-blur-sm z-50 flex items-center justify-center p-4 transition-opacity duration-200">
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-2xl max-w-md w-full transform transition-all duration-200 scale-95 opacity-0" 
       id="actionsModalContent"
       data-actions-modal-target="content">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 dark:border-gray-700">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Quick Actions</h3>
      <button type="button" 
              id="closeActionsModal"
              data-action="click->actions-modal#close"
              class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    
    <div class="p-6 space-y-2">
      <% if @product.present? %>
        <%= link_to new_defect_path(product_id: @product.id),
              class: 'flex items-center gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700/50 rounded-lg transition-all duration-200 group border border-transparent hover:border-blue-200 dark:hover:border-blue-800' do %>
          <div class="flex-shrink-0 w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center shadow-sm">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </div>
          <div class="flex-1">
            <h4 class="font-medium text-gray-900 dark:text-white">Create Defect</h4>
            <p class="text-xs text-gray-500 dark:text-gray-400">Add a new defect</p>
          </div>
          <svg class="w-5 h-5 text-gray-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        <% end %>

        <%= link_to qa_modules_path(product_id: @product.id),
              class: 'flex items-center gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700/50 rounded-lg transition-all duration-200 group border border-transparent hover:border-purple-200 dark:hover:border-purple-800' do %>
          <div class="flex-shrink-0 w-10 h-10 bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg flex items-center justify-center shadow-sm">
