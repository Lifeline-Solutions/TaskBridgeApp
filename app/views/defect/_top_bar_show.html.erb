            </p>
          <% else %>
            <p class="text-xs text-gray-500 dark:text-gray-400">Set default user</p>
          <% end %>
        </div>
        <svg class="w-5 h-5 text-gray-400 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      <% end %>
    </div>
  </div>
</div>

<!-- Save Filters Modal -->
<div id="saveFiltersModal" class="hidden fixed inset-0 bg-gray-900/20 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-2xl max-w-md w-full p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Save Filter</h3>
      <button type="button" 
              id="closeSaveFiltersModal"
              class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <%= form_with url: defect_filters_path, method: :post, id: "saveFilterForm", class: "space-y-4" do |f| %>
      <!-- Filter Name -->
      <div>
        <%= f.label :name, "Filter Name", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
        <%= f.text_field :name, 
              required: true,
              placeholder: "e.g., High Priority Bugs",
              class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white" %>
      </div>

      <!-- Hidden fields for filter parameters -->
      <%= hidden_field_tag 'defect_filter[product_id]', params[:product_id] %>
      <%= hidden_field_tag 'defect_filter[filters][client_name]', params[:client_name] %>
      <%= hidden_field_tag 'defect_filter[filters][order]', params[:order] %>
      <%= hidden_field_tag 'defect_filter[filters][start_date]', params[:start_date] %>
      <%= hidden_field_tag 'defect_filter[filters][end_date]', params[:end_date] %>
      <%= hidden_field_tag 'defect_filter[filters][query]', params[:query] %>
      
      <% Array(params[:status]).each do |status| %>
        <%= hidden_field_tag 'defect_filter[filters][status][]', status %>
      <% end %>
      
      <% Array(params[:priority]).each do |priority| %>
        <%= hidden_field_tag 'defect_filter[filters][priority][]', priority %>
      <% end %>
      
      <% Array(params[:user_id]).each do |user_id| %>
        <%= hidden_field_tag 'defect_filter[filters][user_id][]', user_id %>
      <% end %>
      
      <% Array(params[:reporter_id]).each do |reporter_id| %>
        <%= hidden_field_tag 'defect_filter[filters][reporter_id][]', reporter_id %>
      <% end %>
      
      <% Array(params[:label_ids]).each do |label_id| %>
        <%= hidden_field_tag 'defect_filter[filters][label_ids][]', label_id %>
      <% end %>
      
      <% Array(params[:qa_module_id]).each do |module_id| %>
        <%= hidden_field_tag 'defect_filter[filters][qa_module_id][]', module_id %>
      <% end %>
      
      <% Array(params[:submodule_id]).each do |submodule_id| %>
        <%= hidden_field_tag 'defect_filter[filters][submodule_id][]', submodule_id %>
      <% end %>
      
      <% Array(params[:banking_type_id]).each do |banking_type_id| %>
        <%= hidden_field_tag 'defect_filter[filters][banking_type_id][]', banking_type_id %>
      <% end %>

      <!-- Action Buttons -->
      <div class="flex justify-end gap-3 pt-2">
        <button type="button"
                id="cancelSaveFilter"
                class="px-4 py-2 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg font-medium transition-colors">
          Cancel
        </button>
        <%= f.submit "Save Filter", 
              class: "px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg font-medium transition-colors" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Active Filters Display (Jira-style) -->
<% if filter_params_present? %>
  <div class="container px-4 pb-4">
    <div class="bg-gray-50 dark:bg-gray-800 px-4 py-3 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
          </svg>
          Active Filters
        </h3>
        <%= link_to index_show_defect_index_path, 
            class: "text-xs text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 font-medium transition-colors duration-150 flex items-center gap-1" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
          Clear All
        <% end %>
      </div>
      
      <div class="flex flex-wrap gap-2">
        <!-- Product Filters -->
        <% Array(params[:product_id]).each do |product_id| %>
          <% if product = @qa_products&.find { |p| p.id.to_s == product_id.to_s } %>
            <%= render_filter_chip("Product", product_display_name(product), 
                remove_filter_path(:product_id, product_id), filter_type: :product) %>
          <% end %>
        <% end %>
        
        <!-- Status Filters -->
        <% Array(params[:status]).each do |status| %>
          <%= render_filter_chip("Status", status.capitalize, 
              remove_filter_path(:status, status), filter_type: :status) %>
        <% end %>
        
        <!-- Priority Filters -->
        <% Array(params[:priority]).each do |priority| %>
          <%= render_filter_chip("Priority", priority, 
              remove_filter_path(:priority, priority), filter_type: :priority) %>
        <% end %>
        
        <!-- Assignee Filters -->
        <% Array(params[:user_id]).each do |user_id| %>
          <% if user = User.find_by(id: user_id) %>
            <%= render_filter_chip("Assignee", user_display_name(user), 
                remove_filter_path(:user_id, user_id), filter_type: :assignee) %>
          <% end %>
        <% end %>
        
        <!-- Reporter Filters -->
        <% Array(params[:reporter_id]).each do |reporter_id| %>
          <% if reporter = User.find_by(id: reporter_id) %>
            <%= render_filter_chip("Reporter", user_display_name(reporter), 
                remove_filter_path(:reporter_id, reporter_id), filter_type: :reporter) %>
          <% end %>
        <% end %>
        
        <!-- Module Filters -->
        <% Array(params[:qa_module_id]).each do |module_id| %>
          <% if qa_module = @qa_modules&.find { |m| m.id.to_s == module_id.to_s } %>
            <%= render_filter_chip("Module", qa_module.name, 
                remove_filter_path(:qa_module_id, module_id), filter_type: :module) %>
          <% end %>
        <% end %>
        
        <!-- Submodule Filters -->
        <% Array(params[:submodule_id]).each do |submodule_id| %>
          <% if submodule = @submodules&.find { |s| s.id.to_s == submodule_id.to_s } %>
            <%= render_filter_chip("Submodule", submodule.name, 
                remove_filter_path(:submodule_id, submodule_id), filter_type: :submodule) %>
          <% end %>
        <% end %>
        
        <!-- Banking Type Filters -->
        <% Array(params[:banking_type_id]).each do |banking_type_id| %>
          <% if banking_type = @banking_types&.find { |bt| bt.id.to_s == banking_type_id.to_s } %>
            <%= render_filter_chip("Banking Type", banking_type.name, 
                remove_filter_path(:banking_type_id, banking_type_id), filter_type: :banking_type) %>
          <% end %>
        <% end %>
        
        <!-- Label Filters -->
        <% Array(params[:label_ids]).each do |label_id| %>
          <% if label = @labels&.find { |l| l.id.to_s == label_id.to_s } %>
            <%= render_filter_chip("Label", label.name, 
                remove_filter_path(:label_ids, label_id), filter_type: :label) %>
          <% end %>
        <% end %>
        
        <!-- Date Range Filter -->
        <% if params[:start_date].present? || params[:end_date].present? %>
          <% date_text = [] %>
          <% date_text << "From: #{params[:start_date]}" if params[:start_date].present? %>
          <% date_text << "To: #{params[:end_date]}" if params[:end_date].present? %>
          <%= render_filter_chip("Date Range", date_text.join(' | '), 
              remove_filter_path(:start_date).gsub(/end_date=[^&]*&?/, '').gsub(/&$/, ''), 
              filter_type: :date) %>
        <% end %>
        
        <!-- Sort Order Filter -->
        <% if params[:order].present? && params[:order] != 'desc' %>
          <% order_text = params[:order] == 'asc' ? 'Oldest First' : 'Custom Order' %>
          <%= render_filter_chip("Sort", order_text, 
              remove_filter_path(:order), filter_type: :order) %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<script>
  // ========== SAVE FILTERS MODAL ==========
  document.addEventListener("turbo:load", function () {
    const saveFiltersButton = document.getElementById("saveFiltersButton");
    const saveFiltersModal = document.getElementById("saveFiltersModal");
    const closeSaveFiltersModal = document.getElementById("closeSaveFiltersModal");
    const cancelSaveFilter = document.getElementById("cancelSaveFilter");

    if (saveFiltersButton && saveFiltersModal) {
      saveFiltersButton.addEventListener("click", function(e) {
        e.stopPropagation();
        saveFiltersModal.classList.remove("hidden");
      });

      const closeModal = function() {
        saveFiltersModal.classList.add("hidden");
      };

      if (closeSaveFiltersModal) {
        closeSaveFiltersModal.addEventListener("click", closeModal);
      }

      if (cancelSaveFilter) {
        cancelSaveFilter.addEventListener("click", closeModal);
      }

      saveFiltersModal.addEventListener("click", function(e) {
        if (e.target === saveFiltersModal) {
          closeModal();
        }
      });
    }
  });

  // ========== DOWNLOAD DROPDOWN ==========
  function initializeDownloadDropdown() {
    const downloadButton = document.getElementById("downloadDropdownButton");
    const downloadDropdown = document.getElementById("downloadDropdown");

    if (downloadButton && downloadDropdown) {
      // Remove existing event listeners by cloning
      const newButton = downloadButton.cloneNode(true);
      downloadButton.parentNode.replaceChild(newButton, downloadButton);
      
      // Re-query the new button
      const freshButton = document.getElementById("downloadDropdownButton");
      const freshDropdown = document.getElementById("downloadDropdown");
      
      if (freshButton && freshDropdown) {
        freshButton.addEventListener("click", function(e) {
          e.stopPropagation();
          freshDropdown.classList.toggle("hidden");
        });

        // Close dropdown when clicking outside
        document.addEventListener("click", function(e) {
          if (!e.target.closest('#downloadDropdownButton') && !e.target.closest('#downloadDropdown')) {
            freshDropdown.classList.add("hidden");
          }
        });
      }
    }
  }

  // Initialize on turbo:load
  document.addEventListener("turbo:load", initializeDownloadDropdown);
  
  // Also initialize on turbo:render (for Turbo frame updates)
  document.addEventListener("turbo:render", initializeDownloadDropdown);
  
  // Initialize on DOMContentLoaded as fallback
  document.addEventListener("DOMContentLoaded", initializeDownloadDropdown);

  // ========== MAIN FILTER DROPDOWN TOGGLE ==========
  document.addEventListener("turbo:load", function () {
    const filterButton = document.getElementById("filterDropdownButton");
    const filterDropdown = document.getElementById("filterDropdown");

    if (filterButton && filterDropdown) {
      // Remove any previously attached event listeners by cloning and replacing
      const newButton = filterButton.cloneNode(true);
      filterButton.parentNode.replaceChild(newButton, filterButton);

      const newDropdown = filterDropdown.cloneNode(true);
      filterDropdown.parentNode.replaceChild(newDropdown, filterDropdown);

      // Re-query after DOM replacement
      const button = document.getElementById("filterDropdownButton");
      const dropdown = document.getElementById("filterDropdown");

      if (button && dropdown) {
        button.addEventListener("click", function (e) {
          e.stopPropagation();
          dropdown.classList.toggle("hidden");
        });

        document.addEventListener("click", function () {
          dropdown.classList.add("hidden");
        });

        dropdown.addEventListener("click", function (e) {
          e.stopPropagation();
        });
      }
    }

    // Initialize the multi-select functionality for index_show
    initializeMultiSelectDropdowns();
    initializeSelectAllFunctionality();
    initializeModuleSubmoduleFiltering();
    updateAllButtonTexts();
  });

  // ========== MULTI-SELECT DROPDOWN MANAGEMENT ==========
  function initializeMultiSelectDropdowns() {
    // Close dropdowns when clicking outside
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.multi-select-dropdown')) {
        document.querySelectorAll('.dropdown-content').forEach(dropdown => {
          dropdown.classList.add('hidden');
        });
      }
    });
  }

  function toggleDropdown(dropdownId) {
    const dropdown = document.getElementById(dropdownId);
    if (dropdown) {
      // Close all other dropdowns
      document.querySelectorAll('.dropdown-content').forEach(otherDropdown => {
        if (otherDropdown.id !== dropdownId) {
          otherDropdown.classList.add('hidden');
        }
      });
      
      // Toggle current dropdown
      dropdown.classList.toggle('hidden');
    }
  }

  function filterDropdownItems(searchInputId, itemsContainerId) {
    const searchTerm = document.getElementById(searchInputId).value.toLowerCase().trim();
    const items = document.getElementById(itemsContainerId).getElementsByClassName('dropdown-item');
    
    Array.from(items).forEach(item => {
      const text = item.textContent.toLowerCase().trim();
      item.style.display = text.includes(searchTerm) ? 'flex' : 'none';
    });
  }

  function initializeSelectAllFunctionality() {
    // Add event listeners to all "Select All" checkboxes
    document.querySelectorAll('.select-all-checkbox').forEach(checkbox => {
      checkbox.addEventListener('change', function(e) {
        const target = this.dataset.target;
        const checkboxes = document.querySelectorAll(`.${target}-checkbox`);
        
        // Update all individual checkboxes to match select-all state
        checkboxes.forEach(cb => {
          cb.checked = e.target.checked;
        });
        
        // Update button text after selecting all
        updateButtonText(checkboxes[0]);
      });
    });

    // Update "Select All" when individual checkboxes change
    document.querySelectorAll('[class$="-checkbox"]').forEach(checkbox => {
      if (!checkbox.classList.contains('select-all-checkbox')) {
        checkbox.addEventListener('change', function() {
          updateSelectAllState(this);
          updateButtonText(this);
        });
      }
    });
  }

  function updateSelectAllState(checkbox) {
    const className = Array.from(checkbox.classList).find(cls => cls.endsWith('-checkbox'));
    if (!className) return;
    
    const target = className.replace('-checkbox', '');
    const selectAllCheckbox = document.querySelector(`.select-all-checkbox[data-target="${target}"]`);
    const checkboxes = document.querySelectorAll(`.${target}-checkbox:not(.select-all-checkbox)`);
    
    if (selectAllCheckbox && checkboxes.length > 0) {
      const allChecked = Array.from(checkboxes).every(cb => cb.checked);
      const someChecked = Array.from(checkboxes).some(cb => cb.checked);
      
      selectAllCheckbox.checked = allChecked;
      selectAllCheckbox.indeterminate = someChecked && !allChecked;
    }
  }

  function updateButtonText(checkbox) {
    const className = Array.from(checkbox.classList).find(cls => cls.endsWith('-checkbox'));
    if (!className) return;
    
    const target = className.replace('-checkbox', '');
    const buttonId = `${target}DropdownButton`;
    const buttonTextId = `${target}ButtonText`;
    const checkboxes = document.querySelectorAll(`.${target}-checkbox:not(.select-all-checkbox)`);
    
    const selectedCount = Array.from(checkboxes).filter(cb => cb.checked).length;
    const totalCount = checkboxes.length;
    
    updateDropdownButtonText(buttonId, buttonTextId, selectedCount, totalCount, getDefaultText(target));
  }

  function updateAllButtonTexts() {
    const filterTypes = ['product', 'status', 'priority', 'assignee', 'reporter', 'module', 'submodule', 'banking-type', 'labels'];
    
    filterTypes.forEach(type => {
      const buttonId = `${type}DropdownButton`;
      const buttonTextId = `${type}ButtonText`;
      const checkboxes = document.querySelectorAll(`.${type}-checkbox:not(.select-all-checkbox)`);
      
      if (checkboxes.length > 0) {
        const selectedCount = Array.from(checkboxes).filter(cb => cb.checked).length;
        const totalCount = checkboxes.length;
        
        updateDropdownButtonText(buttonId, buttonTextId, selectedCount, totalCount, getDefaultText(type));
      }
    });
  }

  function updateDropdownButtonText(buttonId, buttonTextId, selectedCount, totalCount, defaultText) {
    const button = document.getElementById(buttonId);
    const buttonText = document.getElementById(buttonTextId);
    
    if (buttonText) {
      if (selectedCount === 0) {
        buttonText.textContent = defaultText;
      } else if (selectedCount === totalCount) {
        buttonText.textContent = `${defaultText} (All)`;
      } else {
        buttonText.textContent = `${defaultText} (${selectedCount} selected)`;
      }
    }
  }

  function getDefaultText(filterType) {
    const textMap = {
      'product': 'Select Products...',
      'status': 'Filter by Status',
      'priority': 'Filter by Priority',
      'assignee': 'Filter by Assignee',
      'reporter': 'Filter by Reporter',
      'module': 'Filter by Module',
      'submodule': 'Filter by Submodule',
      'banking-type': 'Filter by Banking Type',
      'labels': 'Filter by Labels'
    };
    
    return textMap[filterType] || 'Filter...';
  }

  // ========== MODULE AND SUBMODULE DYNAMIC FILTERING ==========
  function initializeModuleSubmoduleFiltering() {
    // Add event listeners to module checkboxes to update submodule visibility
    document.querySelectorAll('.module-checkbox').forEach(checkbox => {
      checkbox.addEventListener('change', function() {
        updateSubmoduleVisibility();
      });
    });

    // Initialize submodule visibility on page load
    updateSubmoduleVisibility();
  }

  function updateSubmoduleVisibility() {
    const selectedModuleIds = getSelectedModuleIds();
    const submoduleItems = document.querySelectorAll('.submodule-item');
    
    if (selectedModuleIds.length === 0) {
      // If no modules are selected, show all submodules
      submoduleItems.forEach(item => {
        item.style.display = 'flex';
      });
    } else {
      // Show only submodules that belong to selected modules
      submoduleItems.forEach(item => {
        const parentId = item.getAttribute('data-parent-id');
        if (selectedModuleIds.includes(parentId)) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    }
    
    // Update submodule button text to reflect filtered state
    updateSubmoduleButtonText();
  }

  function getSelectedModuleIds() {
    const selectedModules = [];
    document.querySelectorAll('.module-checkbox:checked').forEach(checkbox => {
      selectedModules.push(checkbox.getAttribute('data-parent-id'));
    });
    return selectedModules;
  }

  function updateSubmoduleButtonText() {
    const selectedModuleIds = getSelectedModuleIds();
    const submoduleButtonText = document.getElementById('submoduleButtonText');
    const submoduleCheckboxes = document.querySelectorAll('.submodule-checkbox:not(.select-all-checkbox)');
    
    if (selectedModuleIds.length === 0) {
      // No modules selected - show count of all submodules
      const selectedSubmodules = Array.from(submoduleCheckboxes).filter(cb => cb.checked).length;
      const totalSubmodules = submoduleCheckboxes.length;
      
      if (selectedSubmodules === 0) {
        submoduleButtonText.textContent = 'Filter by Submodule';
      } else if (selectedSubmodules === totalSubmodules) {
        submoduleButtonText.textContent = 'Filter by Submodule (All)';
      } else {
        submoduleButtonText.textContent = `Filter by Submodule (${selectedSubmodules} selected)`;
      }
    } else {
      // Modules selected - show count of visible (filtered) submodules
      const visibleSubmodules = Array.from(submoduleCheckboxes).filter(cb => {
        const parentId = cb.closest('.submodule-item').getAttribute('data-parent-id');
        return selectedModuleIds.includes(parentId);
      });
      
      const selectedVisibleSubmodules = visibleSubmodules.filter(cb => cb.checked).length;
      const totalVisibleSubmodules = visibleSubmodules.length;
      
      if (selectedVisibleSubmodules === 0) {
        submoduleButtonText.textContent = 'Filter by Submodule';
      } else if (selectedVisibleSubmodules === totalVisibleSubmodules) {
        submoduleButtonText.textContent = 'Filter by Submodule (All)';
      } else {
        submoduleButtonText.textContent = `Filter by Submodule (${selectedVisibleSubmodules} selected)`;
      }
    }
  }

  // ========== LABELS FILTER MANAGEMENT ==========
  document.addEventListener("turbo:load", () => {
    const searchInput   = document.getElementById("label-search");
    const dropdown      = document.getElementById("label-dropdown");
    const selectedBox   = document.getElementById("selected-labels");
    const hiddenInputs  = document.getElementById("hidden-labels");

    if (searchInput && dropdown) {
      // Filter dropdown items as user types
      searchInput.addEventListener("input", () => {
        const query = searchInput.value.toLowerCase();
        dropdown.querySelectorAll(".dropdown-item").forEach(item => {
          item.classList.toggle("hidden", !item.dataset.name.toLowerCase().includes(query));
        });
        dropdown.classList.remove("hidden");
      });

      // Handle selecting a label
      dropdown.addEventListener("click", e => {
        if (!e.target.classList.contains("dropdown-item")) return;

        const id   = e.target.dataset.id;
        const name = e.target.dataset.name;

        // Prevent duplicates
        if (document.getElementById(`label-tag-${id}`)) return;

        // Create tag
        const tag = document.createElement("span");
        tag.id = `label-tag-${id}`;
        tag.className = "bg-blue-100 text-blue-800 px-2 py-1 rounded-md text-xs flex items-center gap-1";
        tag.innerHTML = `${name} <button type="button" data-id="${id}" class="remove-tag text-red-500">×</button>`;
        selectedBox.appendChild(tag);

        // Hidden input
        const hidden = document.createElement("input");
        hidden.type = "hidden";
        hidden.name = "label_ids[]";
        hidden.value = id;
        hidden.id = `label-hidden-${id}`;
        hiddenInputs.appendChild(hidden);

        // Reset input & hide dropdown
        searchInput.value = "";
        dropdown.classList.add("hidden");
      });

      // Remove tag
      selectedBox.addEventListener("click", e => {
        if (!e.target.classList.contains("remove-tag")) return;
        const id = e.target.dataset.id;
        document.getElementById(`label-tag-${id}`).remove();
        document.getElementById(`label-hidden-${id}`).remove();
      });

      // Hide dropdown when clicking outside
      document.addEventListener("click", e => {
        if (document.getElementById("label-select") && !document.getElementById("label-select").contains(e.target)) {
          dropdown.classList.add("hidden");
        }
      });
    }

    // Prevent form submission when only updating button text for all checkboxes
    document.querySelectorAll('[class$="-checkbox"]').forEach(checkbox => {
      checkbox.addEventListener('change', function(e) {
        // Only prevent default to avoid unnecessary submissions
        // The form will only submit when the "Apply" button is clicked
        e.stopPropagation();
      });
    });

    // Restore filter state on page load
    document.addEventListener("turbo:load", function () {
      const filterDropdown = document.getElementById("filterDropdown");
      const shouldOpenFilter = sessionStorage.getItem('filterDropdownOpen') === 'true';
      
      if (shouldOpenFilter && filterDropdown) {
        filterDropdown.classList.remove("hidden");
        // Clear the stored state
        sessionStorage.removeItem('filterDropdownOpen');
      }
    });
  });
</script>