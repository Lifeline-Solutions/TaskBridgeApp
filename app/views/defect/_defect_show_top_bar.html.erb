<div class="grid grid-cols-2 mb-2 ">
  <div class="col-span-1 flex">
    <div class="flex flex-wrap gap-1">
      <%= button_to index_show_defect_index_path(product_id: params[:product_id]), method: :get, class: 'bg-[#3F8CFF] hover:bg-[#3A81EB] p-2 rounded font-bold rounded-md text-slate-100', id: 'button' do %>
        &#8656; Back
      <% end %>
    </div>
    <div class="flex items-center gap-3 sm:gap-4">
      <div class="flex flex-col">
        <p class="text-xs sm:text-sm md:text-base pl-4">
          <span class="font-medium uppercase">
            Bug ID: <%= @defect.defect_unique %>
          </span>
          /
          <span class="px-2 py-1 text-xs font-medium rounded <%= priority_badge_class(@defect.priority) %>">
            <%= @defect.priority %>
          </span>
          /
          <span class="py-1 px-2 font-medium">
            <%= @defect.creator.name %>
          </span>

          <% if @defect.retest_count.to_i > 1 %>
            /
            <span class="px-2 py-1 text-xs font-medium rounded bg-yellow-100 text-yellow-800 dark:bg-yellow-800 dark:text-yellow-100">
              Retries: <%= @defect.retest_count %>
            </span>
          <% end %>
        </p>

        <% if @defect.draft? %>
          <%= button_to "Publish",
              publish_defect_path(@defect),
              method: :patch,
              class: "bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded" %>
        <% end %>
      </div>
    </div>
  </div>
</div>