<% provide(:title, "New QA") %>

<%= turbo_frame_tag "modal", data: { controller: "modal" } do %>
  <div class="fixed inset-0 z-50 flex items-start justify-center p-4 overflow-hidden bg-black/40 backdrop-blur-sm" data-action="click->modal#closeOnBackdrop">
    <!-- Dialog (90vh cap, internal scroll only in body) -->
    <div data-modal-target="dialog"
         class="w-full max-w-[80%] h-[95%] bg-white dark:bg-gray-800 rounded-lg shadow-xl flex flex-col overflow-hidden p-4"
         role="dialog"
         aria-modal="true"
         aria-labelledby="new-defect-title">
      <!-- Header -->
      <div class="shrink-0 px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-start">
        <h2 id="new-defect-title" class="text-xl font-semibold text-gray-800 dark:text-white">New Defect</h2>

        <button type="button"
                class="ml-auto text-xl font-bold text-gray-500 hover:text-gray-700 dark:text-gray-300 dark:hover:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 rounded cursor-pointer"
                onclick="history.back()"
                aria-label="Close modal">
          X
        </button>

      </div>
      <!-- Form wrapper (flex) -->
      <%= form_with model: @defect, url: defect_index_url, method: :post, data: { turbo: false }, local: true, html: { class: 'flex flex-col grow overflow-hidden', multipart: true } do |f| %>
        <!-- Scrollable Body -->
        <div id="defect-modal-body" class="grow overflow-y-auto overflow-x-hidden px-6 py-4 space-y-5">
          <% if @defect.errors.any? %>
            <div id="error_explanation" class="mb-2 p-3 bg-red-100 border border-red-400 text-red-700 rounded">
              <h2 class="font-semibold mb-1"><%= pluralize(@defect.errors.count, 'error') %> prohibited this defect from being saved:</h2>
              <ul class="list-disc list-inside text-sm">
                <% @defect.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

      <!-- Project -->
      <div data-controller="project-modules"
       data-project-modules-modules-url-value="<%= modules_by_product_defect_index_path %>"
       class="space-y-3">
        <div class="relative w-full">
          <label for="project-search"
            class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">
            Project *
          </label>

          <!-- Project Search -->
          <input type="text"
                id="project-search"
                placeholder="Type to search projects..."
                value="<%= @selected_product.present? ? @selected_product.client.name + ' - ' + @selected_product.groupwares.map(&:name).join(', ') : '' %>"
                class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm
                        focus:outline-none focus:ring-2 focus:ring-blue-500
                        dark:bg-gray-700 dark:text-white dark:border-gray-600"
                required
          />

          <!-- Hidden product_id field -->
          <%= hidden_field_tag :product_id, params[:product_id], id: "project-id-field" %>

          <!-- Results dropdown -->
          <ul id="project-results"
              class="absolute mt-1 border border-gray-300 rounded-md bg-white dark:bg-gray-700
                    text-sm hidden z-10 w-full max-h-60 overflow-y-auto">
          </ul>
        </div>

        <!-- Issue Type -->
        <div class=" w-full">
          <div>
            <label class="block mb-1 text-xs font-medium text-gray-700 dark:text极-gray-300 tracking-wide uppercase">Issue Type</label>
            <%= f.text_field :issue_type, value: 'Bug', disabled: true,
                class: 'w-full border border-gray-300 rounded-md px-3 py-2 text-sm bg-gray-100 dark:bg-gray-800 dark:border-gray-600 dark:text-white cursor-not-allowed' %>
          </div>

          <!-- Status -->
          <div class="relative flex flex-col gap-2 mt-2">
              <label for="defect_status_id"
                class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">
                  Status *
              </label>
              <%= select_tag "defect[status_id]",
                options_from_collection_for_select(
                  @statuses, :id, :name,
                  (@defect.statuses.first&.id || @statuses.first&.id)
                ),
                id: "defect_status_id",
                class: "block w-full px-3 py-2 border border-gray-300 rounded-lg
                        focus:ring-primary-600 focus:border-primary-600 p-2.5
                        dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400
                        text-transform: uppercase" %>


          </div>

          <!-- Summary -->
          <div>
            <label for="defect_summary" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Summary *</label>
            <%= f.text_field :summary, placeholder: 'Enter concise summary', required: true,
                class: 'w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600 placeholder-gray-400' %>
          </div>

          <!-- Description (CKEditor) -->
          <div>
            <label for="defect_content" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">
              Description *
            </label>
            <%= text_area_tag 'defect[content]',
                @defect.content&.body&.to_s,
                id: 'defect_content',
                class: 'min-h-[200px] w-full border border-gray-300 rounded-md px-3 py-2 text-sm dark:bg-gray-700 dark:text-white dark:border-gray-600',
                data: { required: true } %>

            <p id="defect_content_error" class="mt-1 text-xs text-red-600 hidden">Description is required.</p>
          </div>

          <!-- Reported By -->
          <div>
            <label class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Reported By</label>
            <%= text_field_tag :creator_name, Current.user&.name, disabled: true,
                class: 'w-full border border-gray-300 rounded-md px-3 py-2 text-sm bg-gray-100 dark:bg-gray-800 dark:border-gray-600 dark:text-white cursor-not-allowed' %>
          </div>

          <!-- Priority -->
          <div>
            <label for="defect_priority" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Priority *</label>
            <%= f.select :priority, options_for_select(['SEVERITY 1','SEVERITY 2','SEVERITY 3','SEVERITY 4'], @defect.priority), { prompt: 'Select Priority' },
                class: 'w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600', required: true %>
          </div>

          <!-- Labels -->
          <%= render "defect/form_labels", f: f, defect: @defect %>

          <!-- Assignee -->
          <div class="relative">
                <label for="assignee-search"
                      class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">
                  Assignee *
                </label>

                <% if (default_assignee = DefaultDefectAssignee.instance)&.user.present? %>
                  <input type="text"
                        id="assignee-search"
                        placeholder="Type to search users..."
                        value="<%= default_assignee.user.name %>"
                        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none
                                focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600" />

                  <%= hidden_field_tag 'defect[user_ids][]',
                        default_assignee.user.id,
                        id: "assignee-id-field" %>
                <% else %>
                  <input type="text"
                        id="assignee-search"
                        placeholder="Type to search users..."
                        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none
                                focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600" />

                  <%= hidden_field_tag 'defect[user_ids][]',
                        @defect.user_ids.first,
                        id: "assignee-id-field" %>
                <% end %>

                <!-- Results dropdown -->
                <ul id="assignee-results"
                    class="absolute mt-1 border border-gray-300 rounded-md bg-white dark:bg-gray-700 text-sm hidden z-10 w-full max-h-60 overflow-y-auto">
                </ul>

                <p class="mb-2 text-xs text-gray-500 dark:text-gray-400 italic">
                  You can remove this and type to search for another user if needed.
                </p>
              </div>

              <!-- Banking Type -->
          <div class="relative w-full">
            <label for="banking-type-search"
              class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">
                Banking Type *
            </label>
            <!-- Search input -->
            <input type="text"
                  id="banking-type-search"
                  placeholder="Type to search banking types..."
                  value="<%= @defect.banking_type&.name %>"
                  class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none
                          focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600" />

            <!-- Hidden field for selected banking_type_id -->
            <%= f.hidden_field :banking_type_id, id: "banking-type-id-field" %>

            <!-- Results dropdown -->
            <ul id="banking-type-results"
                class="absolute mt-1 border border-gray-300 rounded-md bg-white dark:bg-gray-700 text-sm hidden z-10 w-full max-h-60 overflow-y-auto">
            </ul>
          </div>

          <!-- QA Module Filter (parent modules) -->
          <div class="w-full">
            <label for="qa_module_id" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">
              Module *
            </label>

            <%= select_tag :qa_module_id,
                  options_from_collection_for_select(@qa_modules, :id, :name, params[:qa_module_id] || @selected_module_id),
                  include_blank: 'Select Module',
                  id: 'qa_module_id',
                  data: {
                    'project-modules-target' => 'moduleSelect',
                    'selected-module-id' => (params[:qa_module_id] || @selected_module_id)
                  },
                  class: 'w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600 disabled:opacity-60',
                  required: true %>
          </div>

                    <!-- Submodule Filter -->
          <div class="w-full">
            <label for="submodule_id" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">
              Sub Module
            </label>

            <%= select_tag :submodule_id,
                  options_from_collection_for_select(@submodules, :id, :name, params[:submodule_id] || @selected_submodule_id),
                  include_blank: 'Select Sub-Module',
                  id: 'submodule_id',
                  data: { 'project-modules-target' => 'submoduleSelect', 'selected-submodule-id' => (params[:submodule_id] || @selected_submodule_id) },
                  class: 'w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600' %>
          </div>
        </div>
        </div>

            <!-- Attachments -->
            <div>
              <label for="defect_attachments" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">
                Attachments *
              </label>

              <%= f.file_field :attachments, multiple: true, direct_upload: true, name: 'defect[attachments][]',
                    id: "defect_attachments",
                    class: 'w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none
                            focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600' %>

              <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-1">You can upload one or multiple files.</p>

              <!-- Previews will go here -->
              <div id="attachment-previews" class="mt-3 flex flex-wrap gap-3"></div>
            </div>
        </div>
        <!-- Footer (fixed) -->
        <div class="flex items-center justify-between pt-4 border-t">
          <%= f.submit "Create",
          data: { disable_with: "Creating..." },
                class: "bg-[#3F8CFF] hover:bg-[#3A81EB] text-white font-medium rounded-lg px-6 py-2 shadow-md" %>

          <%= f.submit "Save as Draft",
            name: "commit",
            value: "draft",
            data: { disable_with: "Saving..." },
            class: "bg-gray-500 hover:bg-gray-600 text-white font-medium rounded-lg px-6 py-2 shadow-md" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<script>
  // Load or preview selected items in the defect new
  document.addEventListener("turbo:load", () => {
    const fileInput = document.getElementById("defect_attachments");
    const previewContainer = document.getElementById("attachment-previews");

    if (!fileInput || !previewContainer) return;

    // keep a persistent list of files across changes
    let allFiles = [];

    fileInput.addEventListener("change", () => {
      // append new files to the existing list
      const newFiles = Array.from(fileInput.files);
      allFiles = allFiles.concat(newFiles);

      // update the <input> with the merged list
      updateFileInput(allFiles);

      // rebuild the preview area
      renderPreviews();
    });

    function renderPreviews() {
      previewContainer.innerHTML = "";
      allFiles.forEach((file, index) => {
        const wrapper = document.createElement("div");
        wrapper.className =
          "relative border rounded-md p-2 w-32 h-32 flex flex-col items-center justify-center text-center bg-gray-50 dark:bg-gray-800 cursor-pointer";

        if (file.type.startsWith("image/")) {
          const img = document.createElement("img");
          img.src = URL.createObjectURL(file);
          img.className = "object-cover w-full h-full rounded-md";
          wrapper.appendChild(img);
          wrapper.addEventListener("click", () =>
            openPreviewPopup("image", img.src, file.name)
          );
        } else if (file.type.startsWith("video/")) {
          const videoIcon = document.createElement("div");
          videoIcon.textContent = "🎬 " + file.name;
          videoIcon.className =
            "text-xs text-gray-700 dark:text-gray-300 break-words p-1";
          wrapper.appendChild(videoIcon);
          wrapper.addEventListener("click", () =>
            openPreviewPopup("video", URL.createObjectURL(file), file.name)
          );
        } else {
          const icon = document.createElement("div");
          icon.textContent = file.name;
          icon.className =
            "text-xs text-gray-700 dark:text-gray-300 break-words p-1";
          wrapper.appendChild(icon);
          wrapper.addEventListener("click", () =>
            openPreviewPopup("file", null, file.name)
          );
        }

        const removeBtn = document.createElement("button");
        removeBtn.innerHTML = "✕";
        removeBtn.type = "button";
        removeBtn.className =
          "absolute top-1 right-1 bg-red-600 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs";
        removeBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          allFiles.splice(index, 1);
          updateFileInput(allFiles);
          renderPreviews();
        });

        wrapper.appendChild(removeBtn);
        previewContainer.appendChild(wrapper);
      });
    }

    function updateFileInput(files) {
      const dataTransfer = new DataTransfer();
      files.forEach((f) => dataTransfer.items.add(f));
      fileInput.files = dataTransfer.files;
    }

    // --- Modal Preview ---
    function openPreviewPopup(type, src, name) {
      // Create overlay
      const overlay = document.createElement("div");
      overlay.className =
        "fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50";

      // Close on background click
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) overlay.remove();
      });

      // Modal content
      const modal = document.createElement("div");
      modal.className =
        "relative bg-white dark:bg-gray-800 p-4 rounded-lg shadow-lg max-w-4xl max-h-[90vh] flex flex-col items-center";

      if (type === "image") {
        const img = document.createElement("img");
        img.src = src;
        img.alt = name;
        img.className = "max-w-full max-h-[80vh] rounded-md";
        modal.appendChild(img);
      } else if (type === "video") {
        const video = document.createElement("video");
        video.src = src;
        video.controls = true;
        video.autoplay = false;
        video.className = "max-w-full max-h-[80vh] rounded-md";
        modal.appendChild(video);
      } else {
        const fileText = document.createElement("p");
        fileText.textContent = `Preview not available for "${name}".`;
        fileText.className = "text-gray-700 dark:text-gray-300";
        modal.appendChild(fileText);
      }

      // Close button
      const closeBtn = document.createElement("button");
      closeBtn.innerHTML = "✕";
      closeBtn.type = "button";
      closeBtn.className =
        "absolute top-2 right-2 bg-red-600 text-white rounded-full w-7 h-7 flex items-center justify-center text-lg";
      closeBtn.addEventListener("click", () => overlay.remove());

      modal.appendChild(closeBtn);
      overlay.appendChild(modal);
      document.body.appendChild(overlay);
    }
  });

  // Store the data in global variables so they're accessible
  window.bankingTypesData = <%= raw (@banking_types || []).map { |bt| { id: bt.id, name: bt.name } }.to_json %>;
  // window.assigneeUsersData = <%= raw @users.map { |u| { id: u.id, name: u.name } }.to_json %>;
  window.assigneeUsersData = <%= raw @assignee_users_data.to_json %>;
  window.projectsData = <%= raw @products_and_clients_defects.map { |name, id|
    { name: name, id: id }
  }.to_json %>;

  function initSearchableDropdowns() {
    // ===== Projects ====
    const projectInput = document.getElementById("project-search");
    const projectResults = document.getElementById("project-results");
    const projectHidden = document.getElementById("project-id-field");

    function renderProjects(projects) {
      projectResults.innerHTML = "";

      if (projects.length > 0) {
        projectResults.classList.remove("hidden");
        projects.forEach(p => {
          const li = document.createElement("li");
          li.textContent = p.name;
          li.className = "px-3 py-2 hover:bg-blue-500 hover:text-white cursor-pointer";
          li.addEventListener("click", function () {
            projectInput.value = p.name;
            if (projectHidden) projectHidden.value = p.id;
            projectResults.classList.add("hidden");

            // Trigger Stimulus action (project-modules#loadModules)
            // projectHidden.dispatchEvent(new Event("change"));
            window.location.href = `/defect/new?product_id=${encodeURIComponent(p.id)}`;
          });
          projectResults.appendChild(li);
        });
      } else {
        projectResults.classList.add("hidden");
      }
    }

    if (projectInput && projectResults && window.projectsData) {
      // Search as you type
      projectInput.addEventListener("input", function () {
        const query = this.value.toLowerCase();
        if (query.length === 0) {
          projectResults.classList.add("hidden");
          return;
        }

        const matches = window.projectsData.filter(p =>
          p.name.toLowerCase().includes(query)
        );
        renderProjects(matches);
      });

      // Show all projects on focus
      projectInput.addEventListener("focus", function () {
        renderProjects(window.projectsData);
      });

      // Hide results when clicking outside
      document.addEventListener("click", function (e) {
        if (projectResults && !projectResults.contains(e.target) && e.target !== projectInput) {
          projectResults.classList.add("hidden");
        }
      });
    }
      
    // ===== Banking Type Search =====
    const bankingTypeInput = document.getElementById("banking-type-search");
    const bankingTypeResults = document.getElementById("banking-type-results");
    const bankingTypeHidden = document.getElementById("banking-type-id-field");

    if (bankingTypeInput && bankingTypeResults && window.bankingTypesData) {
      function renderBankingTypes(list) {
        bankingTypeResults.innerHTML = "";

        if (list.length > 0) {
          bankingTypeResults.classList.remove("hidden");
          list.forEach(bt => {
            const li = document.createElement("li");
            li.textContent = bt.name;
            li.className = "px-3 py-2 hover:bg-blue-500 hover:text-white cursor-pointer";
            li.addEventListener("click", function () {
              bankingTypeInput.value = bt.name;
              if (bankingTypeHidden) bankingTypeHidden.value = bt.id;
              bankingTypeResults.classList.add("hidden");
            });
            bankingTypeResults.appendChild(li);
          });
        } else {
          bankingTypeResults.classList.add("hidden");
        }
      }

      // Filtered search on input
      bankingTypeInput.addEventListener("input", function () {
        const query = this.value.toLowerCase();

        if (query.length === 0) {
          bankingTypeResults.classList.add("hidden");
          return;
        }

        const matches = window.bankingTypesData.filter(bt =>
          bt.name.toLowerCase().includes(query)
        );
        renderBankingTypes(matches);
      });

      // Show all BankingTypes on focus
      bankingTypeInput.addEventListener("focus", function () {
        renderBankingTypes(window.bankingTypesData);
      });

      // Hide results when clicking outside
      document.addEventListener("click", function (e) {
        if (
          bankingTypeResults &&
          !bankingTypeResults.contains(e.target) &&
          e.target !== bankingTypeInput
        ) {
          bankingTypeResults.classList.add("hidden");
        }
      });
    }

    // ===== Assignee Search =====
    const assigneeInput = document.getElementById("assignee-search");
    const assigneeResults = document.getElementById("assignee-results");
    const assigneeHidden = document.getElementById("assignee-id-field");

    if (assigneeInput && assigneeResults && window.assigneeUsersData) {
      function renderAssignees(list) {
        assigneeResults.innerHTML = "";

        if (list.length > 0) {
          assigneeResults.classList.remove("hidden");
          list.forEach(user => {
            const li = document.createElement("li");
            li.textContent = user.name;
            li.className = "px-3 py-2 hover:bg-blue-500 hover:text-white cursor-pointer";
            li.addEventListener("click", function () {
              assigneeInput.value = user.name;
              if (assigneeHidden) assigneeHidden.value = user.id;
              assigneeResults.classList.add("hidden");
            });
            assigneeResults.appendChild(li);
          });
        } else {
          assigneeResults.classList.add("hidden");
        }
      }

      assigneeInput.addEventListener("input", function () {
        const query = this.value.toLowerCase();
        if (assigneeHidden) assigneeHidden.value = "";

        if (query.length === 0) {
          assigneeResults.classList.add("hidden");
          return;
        }

        const matches = window.assigneeUsersData.filter(user =>
          user.name.toLowerCase().includes(query)
        );

        renderAssignees(matches);
      });

      assigneeInput.addEventListener("focus", function () {
        renderAssignees(window.assigneeUsersData);
      });

      document.addEventListener("click", function (e) {
        if (
          assigneeResults &&
          !assigneeResults.contains(e.target) &&
          e.target !== assigneeInput
        ) {
          assigneeResults.classList.add("hidden");
        }
      });
    }
  }

  function initTomSelect() {
    const el = document.getElementById('defect_label_ids_modal');
    if (el && typeof TomSelect !== 'undefined' && !el.tomselect) {
      new TomSelect(el, {
        placeholder: 'Labels: Type to search or add. Press Enter to create new.',
        plugins: ['remove_button'],
        persist: false,
        preload: 'focus',
        valueField: 'id',
        labelField: 'name',
        searchField: ['name'],
        load: function (q, cb) {
          const url = new URL('/labels.json', window.location.origin); // ✅ fixed
          if (q) url.searchParams.set('q', q);
          url.searchParams.set('limit', '100');
          fetch(url.toString())
            .then(r => r.json())
            .then(d => cb(d))
            .catch(() => cb());
        },
        create: function (input, callback) {
          let name = input.trim();
          if (!name) return callback();
          fetch('/labels', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({ name })
          })
            .then(r => r.json())
            .then(data => {
              if (data.id) {
                callback({ id: data.id, name: data.name });
              } else {
                callback();
              }
            })
            .catch(() => callback());
        },
        render: {
          item: (d, e) => `<div class='ts-chip'>${e(d.name)}</div>`,
          option: (d, e) => `<div class='px-2 py-1'>${e(d.name)}</div>`
        }
      });
    }
  }

  function initModuleSubmoduleLoading() {
    // ===== Dynamic module/submodule loading =====
    const modSelect = document.querySelector('[data-project-modules-target="moduleSelect"]');
    const submodSelect = document.querySelector('[data-project-modules-target="submoduleSelect"]');
    
    if (modSelect) {
      modSelect.addEventListener('change', function () {
        const moduleId = this.value;
        if (submodSelect) {
          submodSelect.innerHTML = '<option value="">Select Sub-Module</option>';
          if (moduleId) {
            fetch(`/qa_modules/${moduleId}/submodules`)
              .then(r => r.json())
              .then(submodules => {
                submodules.forEach(sm => {
                  const opt = document.createElement('option');
                  opt.value = sm.id;
                  opt.textContent = sm.name;
                  submodSelect.appendChild(opt);
                });
              })
              .catch(error => {
                console.error('Error loading submodules:', error);
              });
          }
        }
      });
    }

    // Also trigger change event if module is already selected on page load
    if (modSelect && modSelect.value) {
      const event = new Event('change');
      modSelect.dispatchEvent(event);
    }
  }

  function initStatusDropdown() {
    const statusDropdown = document.querySelector("select[name='status_id']");
    if (statusDropdown) {
      statusDropdown.addEventListener("change", () => {
        const url = statusDropdown.dataset.defectStatusUrl;
        const statusId = statusDropdown.value;

        if (url && statusId) {
          fetch(url, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content
            },
            body: JSON.stringify({ status_id: statusId })
          })
          .then(resp => resp.json())
          .then(data => {
            console.log("Status updated:", data);
          })
          .catch(err => console.error("Status update failed:", err));
        }
      });
    }
  }

  // Initialize everything
  function initializeAll() {
    initSearchableDropdowns();
    initTomSelect();
    initModuleSubmoduleLoading();
    initStatusDropdown();
  }

  // Initialize when DOM is loaded
  document.addEventListener('turbo:load', initializeAll);

  // Also initialize when Turbo loads the content
  document.addEventListener('turbo:load', initializeAll);

  // Initialize when the frame is loaded (for modals)
  document.addEventListener('turbo:frame-load', initializeAll);
</script>