<% provide(:title, "New QA") %>

<%= turbo_frame_tag "modal", data: { controller: "modal" } do %>
  <div class="fixed inset-0 z-50 flex items-start justify-center p-4 overflow-hidden bg-black/40 backdrop-blur-sm" data-action="click->modal#closeOnBackdrop">
    <!-- Dialog (90vh cap, internal scroll only in body) -->
    <div class="w-full max-w-[80%] h-[95%] bg-white dark:bg-gray-800 rounded-lg shadow-xl flex flex-col overflow-hidden p-4" role="dialog" aria-modal="true" aria-labelledby="new-defect-title">
      <!-- Header -->
      <div class="shrink-0 px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-start">
        <h2 id="new-defect-title" class="text-xl font-semibold text-gray-800 dark:text-white">New Defect</h2>
        <%= link_to "✕", defect_index_path,
          data: { turbo_frame: "_top" },
          class: "ml-auto text-xl font-bold text-gray-500 hover:text-gray-700 dark:text-gray-300 dark:hover:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 rounded" %>
      </div>
      <!-- Form wrapper (flex) -->
      <%= form_with model: @defect, url: defect_index_url, method: :post, data: { turbo: false }, local: true, html: { class: 'flex flex-col grow overflow-hidden', multipart: true } do |f| %>
        <!-- Scrollable Body -->
        <div id="defect-modal-body" class="grow overflow-y-auto overflow-x-hidden px-6 py-4 space-y-5">
          <% if @defect.errors.any? %>
            <div id="error_explanation" class="mb-2 p-3 bg-red-100 border border-red-400 text-red-700 rounded">
              <h2 class="font-semibold mb-1"><%= pluralize(@defect.errors.count, 'error') %> prohibited this defect from being saved:</h2>
              <ul class="list-disc list-inside text-sm">
                <% @defect.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

      <!-- Project / Module / Submodule (single controller scope) -->
      <div data-controller="project-modules"
       data-project-modules-modules-url-value="<%= modules_by_product_defect_index_path %>"
       class="space-y-3">
        <div>
          <%= f.select :product_id,
            options_for_select(@products_and_clients_defects),
            { prompt: 'Select Project' },
            class: 'w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600',
            required: true,
            data: { action: 'change->project-modules#loadModules', "project-modules-target": 'projectSelect' } %>
        </div>
        <div class="flex flex-col sm:flex-row gap-2">
          <%= f.collection_select :banking_type_id, (@banking_types || []), :id, :name,
            { prompt: 'Select Banking Type' },
            class: 'flex-1 border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600', required: true %>

          <%= f.collection_select :qa_module_id, [], :id, :name,
            { prompt: 'Select Module' },
            class: 'flex-1 border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600 disabled:opacity-60', required: true,
            data: { "project-modules-target": 'moduleSelect', action: 'change->project-modules#loadSubmodules' } %>

          <%= f.collection_select :qa_submodule_id, [], :id, :name,
            { prompt: 'Select Sub-Module' },
            class: 'flex-1 border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600',
            data: { "project-modules-target": 'submoduleSelect' } %>
        </div>
        </div>

            <!-- Summary -->
            <div>
              <label for="defect_summary" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Summary</label>
              <%= f.text_field :summary, placeholder: 'Enter concise summary', required: true,
                    class: 'w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600 placeholder-gray-400' %>
            </div>

            <!-- Description (CKEditor) -->
            <div>
              <label for="defect_content" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Description</label>
              <%= text_area_tag 'defect[content]', @defect.content&.body&.to_s, id: 'defect_content', class: 'min-h-[200px] w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600', data: { required: true } %>
              <p id="defect_content_error" class="mt-1 text-xs text-red-600 hidden">Description is required.</p>
              <p class="mention-help mt-1">
                💡 Type <strong>@</strong> to mention users or <strong>#</strong> to reference defects. Use <strong>ESC</strong> to close suggestions.
              </p>
            </div>

            <!-- Priority / Users / Labels -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="relative">
                <label for="assignee-search"
                      class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">
                  Assignee
                </label>

                <!-- Search input -->
                <input type="text"
                      id="assignee-search"
                      placeholder="Type to search users..."
                      class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none
                              focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600" />

                <!-- Hidden field for selected user ID -->
                <%= hidden_field_tag 'defect[user_id]', nil, id: "assignee-id-field" %>

                <!-- Results dropdown -->
                <ul id="assignee-results"
                    class="absolute mt-1 border border-gray-300 rounded-md bg-white dark:bg-gray-700 text-sm hidden z-10 w-full">
                </ul>
              </div>
              <div>
                <label for="defect_priority" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Priority</label>
                <%= f.select :priority, options_for_select(['SEVERITY 1','SEVERITY 2','SEVERITY 3','SEVERITY 4'], @defect.priority), { prompt: 'Select Priority' },
                      class: 'w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600', required: true %>
              </div>
              <div>
                <label for="defect_label_ids_modal" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Labels</label>
                <select id="defect_label_ids_modal" name="defect[label_ids][]" multiple placeholder="Labels: Type to search or add. Press Enter to create new." class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm dark:bg-gray-700 dark:text-white dark:border-gray-600">
                  <% Label.where(deleted_on: nil).order(:name).each do |label| %>
                    <option value="<%= label.id %>" <%= @defect.labels.include?(label) ? 'selected' : '' %>><%= label.name %></option>
                  <% end %>
                </select>
              </div>
            </div>

            <!-- Attachments -->
            <div>
              <label for="defect_attachments" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Attachments</label>
              <%= f.file_field :attachments, multiple: true, direct_upload: true, name: 'defect[attachments][]',
                    class: 'w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600' %>
              <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-1">You can upload one or multiple files.</p>
            </div>

            <!-- Creator / Issue Type -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Creator</label>
                <%= text_field_tag :creator_name, Current.user&.name, disabled: true,
                      class: 'w-full border border-gray-300 rounded-md px-3 py-2 text-sm bg-gray-100 dark:bg-gray-800 dark:border-gray-600 dark:text-white cursor-not-allowed' %>
              </div>
              <div>
                <label class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Issue Type</label>
                <%= f.text_field :issue_type, value: 'Bug', disabled: true,
                      class: 'w-full border border-gray-300 rounded-md px-3 py-2 text-sm bg-gray-100 dark:bg-gray-800 dark:border-gray-600 dark:text-white cursor-not-allowed' %>
              </div>
            </div>
        </div>
        <!-- Footer (fixed) -->
        <!-- Footer -->
        <div class="flex items-center justify-between pt-4 border-t">
          <%= f.submit "Create",
          data: { disable_with: "Creating..." },
                class: "bg-[#3F8CFF] hover:bg-[#3A81EB] text-white font-medium rounded-lg px-6 py-2 shadow-md" %>

          <%= f.submit "Save as Draft",
            name: "commit",
            value: "draft",
            data: { disable_with: "Saving..." },
            class: "bg-gray-500 hover:bg-gray-600 text-white font-medium rounded-lg px-6 py-2 shadow-md" %>
        </div>
      <% end %>
    </div>
  </div>

<% end %>
<script>
  document.addEventListener('turbo:load', function () {
    // ===== Dynamic module/submodule loading =====
    const modSelect = document.querySelector('[data-project-modules-target="moduleSelect"]');
    const submodSelect = document.querySelector('[data-project-modules-target="submoduleSelect"]');
    if (modSelect) {
      modSelect.addEventListener('change', function () {
        const moduleId = this.value;
        if (submodSelect) {
          submodSelect.innerHTML = '<option value="">Select Sub-Module</option>';
          if (moduleId) {
            fetch(`/qa_modules/${moduleId}/submodules`)
              .then(r => r.json())
              .then(submodules => {
                submodules.forEach(sm => {
                  const opt = document.createElement('option');
                  opt.value = sm.id;
                  opt.textContent = sm.name;
                  submodSelect.appendChild(opt);
                });
              });
          }
        }
      });
    }

    // ===== TomSelect for modal labels =====
    const el = document.getElementById('defect_label_ids_modal');
    if (el && !el.tomselect) {
      new TomSelect(el, {
        placeholder: 'Labels: Type to search or add. Press Enter to create new.',
        plugins: ['remove_button'],
        persist: false,
        preload: 'focus',
        valueField: 'id',
        labelField: 'name',
        searchField: ['name'],
        load: function (q, cb) {
          const url = new URL('/labels.json', window.location.origin);
          if (q) url.searchParams.set('q', q);
          url.searchParams.set('limit', '100');
          fetch(url.toString())
            .then(r => r.json())
            .then(d => cb(d))
            .catch(() => cb());
        },
        create: function (input, callback) {
          let name = input.trim().replace(/\s+/g, '-').toLowerCase();
          if (!name) return callback();
          fetch('/labels', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({ name })
          })
            .then(r => r.json())
            .then(data => {
              if (data.id) {
                callback({ id: data.id, name: data.name });
              } else {
                callback();
              }
            })
            .catch(() => callback());
        },
        render: {
          item: (d, e) => `<div class='ts-chip'>${e(d.name)}</div>`,
          option: (d, e) => `<div class='px-2 py-1'>${e(d.name)}</div>`
        },
        onItemAdd: function () {
          if (this.items.length > 0) {
            this.inputState();
            this.control_input.placeholder = '';
          }
        },
        onClear: function () {
          this.control_input.placeholder =
            'Labels: Type to search or add. Press Enter to create new.';
        }
      });

      // Adjust placeholder when focused and already has items
      el.addEventListener('focus', () => {
        if (el.tomselect && el.tomselect.items.length > 0) {
          el.tomselect.control_input.placeholder = '';
        }
      });
    }

    const assigneeInput = document.getElementById("assignee-search");
    const assigneeResults = document.getElementById("assignee-results");
    const assigneeHidden = document.getElementById("assignee-id-field");

    // Embed @users directly into JS
    let assigneeUsers = <%= raw @users.map { |u| { id: u.id, name: u.name } }.to_json %>;

    assigneeInput.addEventListener("input", () => {
      const query = assigneeInput.value.toLowerCase();
      assigneeResults.innerHTML = "";

      if (query.length === 0) {
        assigneeResults.classList.add("hidden");
        return;
      }

      const matches = assigneeUsers.filter(user =>
        user.name.toLowerCase().includes(query)
      );

      if (matches.length > 0) {
        assigneeResults.classList.remove("hidden");
        matches.forEach(user => {
          const li = document.createElement("li");
          li.textContent = user.name;
          li.className = "px-3 py-2 hover:bg-blue-500 hover:text-white cursor-pointer";
          li.addEventListener("click", () => {
            assigneeInput.value = user.name;
            assigneeHidden.value = user.id;
            assigneeResults.classList.add("hidden");
          });
          assigneeResults.appendChild(li);
        });
      } else {
        assigneeResults.classList.add("hidden");
      }
    });

    // Hide results if clicking outside
    document.addEventListener("click", (e) => {
      if (!assigneeResults.contains(e.target) && e.target !== assigneeInput) {
        assigneeResults.classList.add("hidden");
      }
    });
  });
</script>
