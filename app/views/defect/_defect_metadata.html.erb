<div class="mb-2.5 font-bold capitalize flex">
  <div class="font-medium ml-1">
    <div class="mb-2.5 font-bold capitalize">
      Module:
      <span class="font-light">
        <%= @defect.qa_module&.name || 'Not specified' %>
      </span>
    </div>
    <div class="mb-2.5 font-bold capitalize">Sub-Module:
      <span class="font-light">
        <%= @defect.submodule&.name || 'Not specified' %>
      </span>
    </div>
    <div class="mb-2.5 font-bold capitalize">Product:
      <span class="font-light">
        <%= @defect.product&.content&.to_plain_text&.truncate(30) || 'Not specified' %>
      </span>
    </div>
    <div class="mb-2.5 font-bold capitalize">Banking Type:
      <span class="font-light">
        <%= @defect.banking_type&.name || 'Not specified' %>
      </span>
    </div>
    <div class="mb-2.5 font-bold capitalize">Retest Count:
      <span class="font-light">
        <%= @defect.retest_count || '0' %>
      </span>
    </div>
  </div>
</div>


