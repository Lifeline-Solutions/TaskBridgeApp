<% if @defect.content.present? %>
  <span class="break-words overflow-hidden">
    <div class="pl-8 prose dark:prose-invert max-w-full w-full trix-content">
      <%= @defect.content.body.to_s.html_safe %>
    </div>

    <% if @defect.content.body.attachments.any? %>
      <% @defect.content.body.attachments.each_with_index do |attachment, idx| %>
        <% if attachment.attachable.is_a?(ActiveStorage::Blob) && attachment.attachable.image? %>
          <div class="mb-2 image-preview-block">
            <a href="#"
               class="image-preview-link"
               data-image-url="<%= rails_blob_url(attachment.attachable) %>"
               data-image-download-url="<%= rails_blob_path(attachment.attachable, disposition: 'attachment', only_path: true) %>"
               data-image-name="<%= attachment.attachable.filename.to_s %>"
               data-image-size="<%= number_to_human_size(attachment.attachable.byte_size) %>"
               data-image-created-at="<%= attachment.attachable.created_at.strftime('%Y-%m-%d %H:%M') %>"
               data-image-index="<%= idx %>">
              <img src="<%= rails_representation_url(attachment.attachable.variant(resize_to_limit: [72,72])) %>"
                   alt="Image Preview"
                   class="max-w-xs cursor-pointer pl-2 image-preview-thumb">
            </a>
            <br>
            <%= link_to attachment.attachable.filename.to_s, rails_blob_path(attachment.attachable, disposition: 'attachment', only_path: true), target: "_blank", download: true, class: "text-blue-600 hover:underline pl-2" %>
          </div>
        <% elsif attachment.attachable.is_a?(ActiveStorage::Blob) %>
          <!-- Non-image attachments -->
          <%= link_to attachment.attachable.filename.to_s, rails_blob_path(attachment.attachable, disposition: 'attachment', only_path: true), class: "text-blue-600 hover:underline pl-2" %>
        <% end %>
      <% end %>
    <% end %>
  </span>

  <!-- Modal for image magnification -->
  <div id="imageModal" class="hidden fixed inset-0 z-50 bg-black bg-opacity-80 flex items-center justify-center">
    <div class="bg-white rounded-lg shadow-lg flex flex-row overflow-hidden max-w-3xl w-full">
      <div class="flex-1 flex items-center justify-center p-4 bg-gray-900">
        <img id="modalImage" src="" alt="Magnified Image" class="max-h-[75vh] max-w-[50vw] rounded shadow-lg">
      </div>
      <div class="w-64 p-4 bg-gray-100 border-l">
        <h3 class="font-bold text-lg mb-2">Image Info</h3>
        <p><strong>Name:</strong> <span id="modalImageName"></span></p>
        <p><strong>Size:</strong> <span id="modalImageSize"></span></p>
        <p><strong>Created:</strong> <span id="modalImageCreated"></span></p>
        <p><strong>Updated:</strong> <span id="modalImageUpdated"></span></p>
        <div class="mt-3 flex gap-2">
          <a id="downloadImage" href="#" download class="px-3 py-2 bg-green-600 text-white rounded hover:bg-green-700">Download</a>
          <button id="closeModal" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Close</button>
        </div>
      </div>
    </div>
  </div>
<% end %>

<script>
  // Will reload modal markup to ensure listeners are always fresh after closing
  function reloadImageModal() {
    var modal = document.getElementById('imageModal');
    if (!modal) return;
    // Remove modal from DOM
    modal.parentNode.removeChild(modal);
    // Insert fresh modal markup (same as erb above)
    var modalHtml = `
      <div id="imageModal" class="hidden fixed inset-0 z-50 bg-black bg-opacity-80 flex items-center justify-center">
        <div class="bg-white rounded-lg shadow-lg flex flex-row overflow-hidden max-w-3xl w-full">
          <div class="flex-1 flex items-center justify-center p-4 bg-gray-900">
            <img id="modalImage" src="" alt="Magnified Image" class="max-h-[75vh] max-w-[50vw] rounded shadow-lg">
          </div>
          <div class="w-64 p-4 bg-gray-100 border-l">
            <h3 class="font-bold text-lg mb-2">Image Info</h3>
            <p><strong>Name:</strong> <span id="modalImageName"></span></p>
            <p><strong>Size:</strong> <span id="modalImageSize"></span></p>
            <p><strong>Created:</strong> <span id="modalImageCreated"></span></p>
            <p><strong>Updated:</strong> <span id="modalImageUpdated"></span></p>
            <div class="mt-3 flex gap-2">
              <a id="downloadImage" href="#" download class="px-3 py-2 bg-green-600 text-white rounded hover:bg-green-700">Download</a>
              <button id="closeModal" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Close</button>
            </div>
          </div>
        </div>
      </div>
    `;
    document.body.insertAdjacentHTML('beforeend', modalHtml);
    // Reinitialize listeners
    initImagePreviewModal();
  }

  function initImagePreviewModal() {
    var modal = document.getElementById("imageModal");
    var modalImage = document.getElementById("modalImage");
    var nameEl = document.getElementById("modalImageName");
    var sizeEl = document.getElementById("modalImageSize");
    var createdEl = document.getElementById("modalImageCreated");
    var updatedEl = document.getElementById("modalImageUpdated");
    var downloadBtn = document.getElementById("downloadImage");
    var closeBtn = document.getElementById("closeModal");

    function openModalFromLink(link) {
      if (!link) return;
      modalImage.src = link.dataset.imageUrl || "";
      nameEl.textContent = link.dataset.imageName || "";
      sizeEl.textContent = link.dataset.imageSize || "";
      createdEl.textContent = link.dataset.imageCreatedAt || "";
      updatedEl.textContent = link.dataset.imageUpdatedAt || "";

      var downloadUrl = link.dataset.imageDownloadUrl || link.dataset.imageUrl || "#";
      downloadBtn.href = downloadUrl;
      downloadBtn.setAttribute("download", link.dataset.imageName || "image");

      modal.classList.remove("hidden");
    }

    function closeModal() {
      modal.classList.add("hidden");
      setTimeout(function () {
        modalImage.src = "";
        reloadImageModal(); // Re-render modal to reset all event listeners!
      }, 150);
    }

    document.querySelectorAll(".image-preview-link").forEach(function (link) {
      link.addEventListener("click", function (e) {
        e.preventDefault();
        openModalFromLink(link);
      });
    });

    if (closeBtn) {
      closeBtn.addEventListener("click", function () {
        closeModal();
      });
    }

    if (modal) {
      modal.addEventListener("click", function (e) {
        if (e.target === modal) {
          closeModal();
        }
      });
    }
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });
  }

  // Initialize on DOM ready and Turbo load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initImagePreviewModal);
  } else {
    initImagePreviewModal();
  }
  document.addEventListener("turbo:load", initImagePreviewModal);
</script>

<style>
  /* Fix spacing for Trix paragraphs (divs) validation */
  .trix-content div {
    margin-bottom: 0.75em;
  }
  .trix-content div:last-child {
    margin-bottom: 0;
  }

  /* ===== TABLE STYLING - Comprehensive fix for Word/Docs paste issues ===== */

  /* CRITICAL: Table container must allow horizontal scrolling if needed */
  .prose {
    overflow-x: auto;
  }

  /* Core table structure with fixed layout for consistent column widths */
  .prose table {
    width: 100% !important;
    max-width: 100%;
    border-collapse: collapse !important;
    border-spacing: 0 !important;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    border: 1px solid #000 !important;
    table-layout: fixed !important; /* CRITICAL: Prevents cells from stacking vertically */
    display: table !important; /* Force table display, override any inline styles */
  }

  /* Ensure table rows behave correctly */
  .prose table tr {
    display: table-row !important;
  }

  /* Cell styling with proper constraints */
  .prose th,
  .prose td {
    display: table-cell !important; /* CRITICAL: Force table-cell display */
    padding: 0.5rem 0.75rem !important;
    border: 1px solid #000 !important;
    vertical-align: top !important;
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
    min-width: 50px; /* Prevent overly narrow columns */
    max-width: none; /* Allow proper width distribution */
  }

  /* CRITICAL: Strip nested div/p/span layout interference from pasted content */
  .prose td > div,
  .prose th > div,
  .prose td > p,
  .prose th > p,
  .prose td > span,
  .prose th > span {
    display: inline !important; /* Prevent block-level stacking within cells */
    margin: 0 !important;
    padding: 0 !important;
    width: auto !important;
    max-width: none !important;
  }

  /* Remove any absolute positioning from table cells */
  .prose td,
  .prose th,
  .prose td *,
  .prose th * {
    position: static !important;
  }

  /* Bold table headers */
  .prose th {
    font-weight: 700 !important;
    background-color: #f3f4f6;
    text-align: left;
  }

  /* Table body */
  .prose tbody {
    display: table-row-group !important;
  }

  /* Table header */
  .prose thead {
    display: table-header-group !important;
  }

  /* Dark mode: use a light border color */
  .dark .prose table {
    border-color: #f1f5f9 !important;
  }

  .dark .prose th,
  .dark .prose td {
    border-color: #f1f5f9 !important;
  }

  .dark .prose th {
    background-color: #374151;
  }

  /* Table caption */
  .prose table caption {
    caption-side: top;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  /* Override any inline styles that could break table layout */
  .prose table[border],
  .prose table[style*="border"],
  .prose table[style*="width"],
  .prose table[style*="display"] {
    border-collapse: collapse !important;
    display: table !important;
    width: 100% !important;
  }

  /* Ensure all cells have proper borders regardless of inline styles */
  .prose table[border] th,
  .prose table[border] td,
  .prose table[style*="border"] th,
  .prose table[style*="border"] td {
    border: 1px solid #000 !important;
    display: table-cell !important;
  }

  /* Dark mode for tables with inline borders */
  .dark .prose table[border] th,
  .dark .prose table[border] td,
  .dark .prose table[style*="border"] th,
  .dark .prose table[style*="border"] td {
    border-color: #f1f5f9 !important;
  }

  /* Remove Word/Docs table styling artifacts */
  .prose table[class*="Mso"],
  .prose table[class*="mso"],
  .prose tr[class*="Mso"],
  .prose tr[class*="mso"],
  .prose td[class*="Mso"],
  .prose td[class*="mso"],
  .prose th[class*="Mso"],
  .prose th[class*="mso"] {
    border-collapse: collapse !important;
    display: table !important;
  }

  /* Remove height constraints that could cause stacking */
  .prose table,
  .prose tr,
  .prose td,
  .prose th {
    height: auto !important;
  }

  /* ===== LIST STYLING - Comprehensive fix for Word/Docs paste issues ===== */

  /* Reset any potential duplicate markers from theme/framework */
  .prose ul,
  .prose ol {
    padding-left: 1.5em;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    list-style-position: outside;
  }

  .prose ul {
    list-style-type: disc;
  }

  .prose ol {
    list-style-type: decimal;
  }

  .prose li {
    display: list-item; /* Ensure proper list-item display */
    margin-bottom: 0.25rem;
    padding-left: 0.25rem;
    margin-left: 0;
    text-indent: 0; /* Prevent overlap from pasted styles */
  }

  /* CRITICAL: Remove any custom pseudo-element markers (but keep native ::marker) */
  .prose li::before {
    content: none !important; /* Remove custom bullets/numbers added via ::before */
  }

  /* Reset counters to prevent duplication */
  .prose ul,
  .prose ol {
    counter-reset: none;
  }

  /* Nested lists */
  .prose ul ul {
    list-style-type: circle;
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .prose ul ul ul {
    list-style-type: square;
  }

  .prose ol ol {
    list-style-type: lower-alpha;
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .prose ol ol ol {
    list-style-type: lower-roman;
  }

  /* Dark mode list markers */
  .dark .prose ul,
  .dark .prose ol {
    color: inherit;
  }

  .dark .prose li::marker {
    color: rgba(255, 255, 255, 0.7);
  }

  /* ===== INLINE STYLE PRESERVATION - Critical for Rich Text Formatting ===== */
  /* IMPORTANT: These rules ensure that inline styles from the rich text editor are preserved */
  /* This fixes the QA issue where bold+color formatting loses color after posting */
  
  /* CRITICAL FIX: Tailwind's prose plugin sets colors on strong/b elements that can override inline styles */
  /* We need to ensure inline style attributes take precedence over prose defaults */
  
  /* Force inline color styles to work on bold/strong elements */
  /* The [style] attribute selector increases specificity so inline styles aren't overridden */
  .trix-content strong[style*="color"],
  .trix-content b[style*="color"],
  .prose strong[style*="color"],
  .prose b[style*="color"] {
    /* Don't set any color here - let the inline style attribute apply naturally */
    /* Having this selector ensures it has higher specificity than .prose strong */
  }
  
  /* Ensure all elements with inline color styles can display them */
  .trix-content [style*="color"],
  .prose span[style*="color"],
  .prose em[style*="color"],
  .prose i[style*="color"],
  .prose u[style*="color"],
  .prose div[style*="color"],
  .prose p[style*="color"] {
    /* Inline style will apply due to attribute selector specificity */
  }

  /* Preserve background colors from inline styles */
  .trix-content [style*="background"],
  .prose [style*="background-color"],
  .prose [style*="background"] {
    /* Inline style will apply */
  }
  
  /* Preserve font sizes from inline styles */
  .trix-content [style*="font-size"],
  .prose [style*="font-size"] {
    /* Inline style will apply */
  }

  /* Font size classes */
  .prose .text-tiny {
    font-size: 0.7em;
  }

  .prose .text-small {
    font-size: 0.85em;
  }

  .prose .text-big {
    font-size: 1.4em;
  }

  .prose .text-huge {
    font-size: 1.8em;
  }

  /* Alignment classes */
  .prose .text-center {
    text-align: center;
  }

  .prose .text-right {
    text-align: right;
  }

  .prose .text-justify {
    text-align: justify;
  }

  #imageModal {
      transition: opacity 0.2s;
  }
  #imageModal.hidden {
      opacity: 0;
      pointer-events: none;
  }
  .image-preview-thumb {
      transition: transform 0.2s;
  }
  .image-preview-thumb:hover {
      transform: scale(1.08);
      box-shadow: 0 0 8px #222;
  }
</style>
