<div class="overflow-x-auto shadow-md sm:rounded-lg h-full">
  <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
    <thead class="text-xs uppercase bg-gray-200 dark:bg-gray-700 dark:text-gray-400 w-[100%]">
      <tr>
        <th scope="col" class="px-6 py-3">#</th>
        <th scope="col" class="px-6 py-3">Name of the Client QA</th>
        <th scope="col" class="px-6 py-3">Status</th>
        <th scope="col" class="px-6 py-3">Number of Defects</th>
      </tr>
    </thead>
    <tbody>
    <% if @qa_products.present? %>
      <% @qa_products.each_with_index do |product, index| %>
        <% row_number = @start_count + index %>
        <!-- Product Row -->
        <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 h-12 text-left">
          <td class="px-6 py-3 font-semibold text-gray-600 dark:text-gray-300">
            <%= row_number %>
          </td>
          <td class="px-6 py-3 font-semibold text-left">
            <%= link_to (product.proxy_name.present? ? product.proxy_name : "#{product.client&.name} #{product.groupwares&.first&.name}".truncate(30)),
                        index_show_defect_index_path(client_name: product.client&.name, product_id: product.id),
                        class: "text-blue-700 hover:underline" %>
          </td>
          <td class="px-6 py-3 font-semibold text-left">
            <%= product.statuses.first&.name %>
          </td>
          <td class="px-6 py-3 font-semibold text-left">
            <%= @qa_product_defect_counts[product.id] || 0 %>
          </td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td class="px-6 py-4 text-center text-gray-500 dark:text-gray-400" colspan="4">
          No projects in QA status found
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>

<!-- Results count display -->
<% if @qa_products.present? && @total_count && @total_count > 0 %>
  <div class="mt-3 px-4 py-2 text-sm text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-800 rounded">
    Showing <span class="font-semibold"><%= @start_count %></span> to <span class="font-semibold"><%= @end_count %></span> of <span class="font-semibold"><%= @total_count %></span> results
  </div>
<% end %>

<% if @qa_products.present? %>
  <div class="flex gap-3 mt-5 items-center">
    <!-- Pagination Controls -->
    <div class="flex gap-3 items-center">
      <!-- First Page Button -->
      <% if @page > 1 %>
        <%= link_to 'First',
                    defect_index_path(page: 1, query: params[:query], status: params[:status]),
                    class: 'h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] px-4 py-3 rounded font-bold text-slate-100' %>
      <% else %>
        <button disabled class="h-12 bg-gray-300 dark:bg-gray-600 px-4 py-3 rounded font-bold text-gray-500 dark:text-gray-400 cursor-not-allowed">
          First
        </button>
      <% end %>

      <!-- Previous Page Button -->
      <% if @page > 1 %>
        <%= link_to 'Previous',
                    defect_index_path(page: @page - 1, query: params[:query], status: params[:status]),
                    class: 'h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] px-4 py-3 rounded font-bold text-slate-100' %>
      <% else %>
        <button disabled class="h-12 bg-gray-300 dark:bg-gray-600 px-4 py-3 rounded font-bold text-gray-500 dark:text-gray-400 cursor-not-allowed">
          Previous
        </button>
      <% end %>

      <!-- Page Info -->
      <span class="px-3 text-gray-700 dark:text-gray-300 font-semibold">Page <%= @page %> of <%= @total_pages %></span>

      <!-- Next Page Button -->
      <% if @page < @total_pages %>
        <%= link_to 'Next',
                    defect_index_path(page: @page + 1, query: params[:query], status: params[:status]),
                    class: 'h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] px-4 py-3 rounded font-bold text-slate-100' %>
      <% else %>
        <button disabled class="h-12 bg-gray-300 dark:bg-gray-600 px-4 py-3 rounded font-bold text-gray-500 dark:text-gray-400 cursor-not-allowed">
          Next
        </button>
      <% end %>

      <!-- Last Page Button -->
      <% if @page < @total_pages %>
        <%= link_to 'Last',
                    defect_index_path(page: @total_pages, query: params[:query], status: params[:status]),
                    class: 'h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] px-4 py-3 rounded font-bold text-slate-100' %>
      <% else %>
        <button disabled class="h-12 bg-gray-300 dark:bg-gray-600 px-4 py-3 rounded font-bold text-gray-500 dark:text-gray-400 cursor-not-allowed">
          Last
        </button>
      <% end %>
    </div>
  </div>
<% end %>