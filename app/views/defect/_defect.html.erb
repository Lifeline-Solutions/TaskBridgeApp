<div class="overflow-x-auto shadow-md sm:rounded-lg h-full">
  <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
    <thead class="text-xs uppercase bg-gray-200 dark:bg-gray-700 dark:text-gray-400 w-[100%]">
      <tr>
        <th scope="col" class="px-6 py-3">Name of the Client QA</th>
        <th scope="col" class="px-6 py-3">Status</th>
        <th scope="col" class="px-6 py-3">Number of Defects</th>
      </tr>
    </thead>
    <tbody>
    <tbody>
    <% if @defect_groups.present? %>
      <% @defect_groups.each do |group_name, defects| %>
        <!-- Group Header -->
        <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 h-12 text-left">
          <td class="px-6 py-3 font-semibold text-left">
            <%= link_to "#{group_name.truncate(30)}",
                        index_show_defect_index_path(client_name: defects.first.product.client.name),
                        class: "text-blue-700 hover:underline" %>
          </td>
          <td class="px-6 py-3 font-semibold text-left">
            <%= defects.first.product.statuses.first&.name %>
          </td>
          <td class="px-6 py-3 font-semibold text-left">
            <%= defects.size %>
          </td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td class="px-6 py-4 text-center text-gray-500 dark:text-gray-400" colspan="3">
          No defects found
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>

<% if @defect_groups.present? %>
  <div class="flex gap-10 mt-5">
    <!-- Pagination Controls -->
    <div class="pagination">
      <% if @page > 1 %>
        <%= link_to 'Previous',
                    defect_index_path(page: @page - 1, query: params[:query], status: params[:status]),
                    class: 'mb-4 h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] p-3 rounded font-bold rounded-lg text-slate-100' %>
      <% end %>

      <span>Page <%= @page %> of <%= @total_pages %></span>

      <% if @page < @total_pages %>
        <%= link_to 'Next',
                    defect_index_path(page: @page + 1, query: params[:query], status: params[:status]),
                    class: 'mb-4 h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] p-3 rounded font-bold rounded-lg text-slate-100' %>
      <% end %>
    </div>
  </div>
<% end %>