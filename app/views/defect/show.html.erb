<div class="container p-2">
  <%= render 'defect/defect_show_top_bar', defect: @defect %>

  <div class="grid grid-cols-5 md:items-center mt-4">
    <div class="w-full col-span-4 h-full flex">
      <div class="w-full gap-4">
        <div class="w-full gap-4">
          <div>
            <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">Summary</h3>
            <div class="mt-1 text-gray-900 dark:text-white">
              <%= @defect.summary %>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">Content</h3>
            <div class="mt-1 text-gray-900 dark:text-white">
              <%= render partial: 'defect/content_defect', locals: { defect: @defect } %>
            </div>
          </div>
        </div>

        <%= render "defect/defect_show_attachments" %>
        
        <!-- Messages Section - Make it span all 4 columns -->
        <div class="">
          <%= render 'defect_messages/defect_message' %>
        </div>
      </div>
    </div>

    <%= render 'defect/defect_sidebar' %>
  </div>
  
  <!-- Defect Timeline History -->
  <div class="mt-6">
    <%#= render 'defect/defect_timeline' %>
  </div>
</div>