<%= turbo_frame_tag "assignee_section" do %>
  <div data-controller="assignee-editor" class="flex flex-col gap-2" data-action="click->assignee-editor#openInput">
    <!-- Assignee row -->
    <div class="flex items-center gap-2 cursor-pointer" data-action="click->assignee-editor#openInput">
      <span class="text-gray-600 w-24">Assignee</span>
      <% if defect.users.any? %>
        <% defect.users.each do |user| %>
          <div class="flex items-center gap-2">
            <div class="w-6 h-6 flex items-center justify-center rounded-full bg-indigo-900 text-white text-xs font-semibold">
              <%= user.name.split.map { |n| n[0] }.join.upcase %>
            </div>
            <span class="text-gray-800"><%= user.name %></span>
          </div>
        <% end %>
      <% else %>
        <p class="text-red-500 text-sm">No agents assigned</p>
      <% end %>
    </div>

    <!-- Reporter -->
    <div class="flex items-center gap-2 cursor-pointer" data-action="click->assignee-editor#openInput">
      <span class="text-gray-600 w-24">Reporter</span>
      <% if @defect.creator.present? %>
        <div class="flex items-center gap-2">
          <!-- Avatar circle with initials -->
          <div class="w-6 h-6 flex items-center justify-center rounded-full bg-green-700 text-white text-xs font-semibold">
            <%= @defect.creator.name.split.map { |n| n[0] }.join.upcase %>
          </div>
          <!-- Full name -->
          <span class="text-gray-800"><%= @defect.creator.name %></span>
        </div>
      <% else %>
        <p class="text-red-500 text-sm">No reporter set</p>
      <% end %>
    </div>

    <!-- Hidden input search -->
    <div data-assignee-editor-target="inputContainer" class="mt-2 hidden relative">
      <%= form_with url: add_defect_defect_path(defect),
                    method: :post,
                    data: { turbo_frame: "assignee_section" },
                    html: { id: "assigneeForm" } do |f| %>

        <div class="relative">
          <input type="text"
                 id="searchAssignee"
                 placeholder="Search user..."
                 autocomplete="off"
                 class="w-full border border-gray-300 rounded-md px-3 py-2 pr-10 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"
                 data-action="keyup->assignee-editor#filter keydown->assignee-editor#keydown"
                 data-assignee-editor-target="input">

          <!-- Dropdown carrat -->
          <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-assignee-editor-target="carret">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>
        </div>

        <!-- Dropdown -->
        <div id="assigneeDropdown"
             class="absolute mt-1 w-full bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md shadow-lg max-h-60 overflow-y-auto z-10 hidden"
             data-assignee-editor-target="dropdown">
          <% if defect.product.present? %>
            <% @available_users.each do |user| %>
              <div class="dropdown-item px-4 py-2 hover:bg-gray-200 dark:hover:bg-gray-500 cursor-pointer border-b border-gray-100 dark:border-gray-600 last:border-b-0"
                  data-user-id="<%= user.id %>"
                  data-user-name="<%= user.name %>"
                  data-action="click->assignee-editor#select">
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 flex items-center justify-center rounded-full bg-indigo-900 text-white text-xs font-semibold">
                    <%= user.name.split.map { |n| n[0] }.join.upcase %>
                  </div>
                  <span class="text-gray-800 dark:text-gray-200"><%= user.name %></span>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="px-4 py-2 text-red-500">No product context available.</div>
          <% end %>
        </div>

        <%= hidden_field_tag :user_id, "", id: "selectedAssigneeId", data: { assignee_editor_target: "hiddenField" } %>
      <% end %>
    </div>
  </div>
<% end %>