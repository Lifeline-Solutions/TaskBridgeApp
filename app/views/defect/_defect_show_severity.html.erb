<!-- Priority Field -->
<% if current_user.has_role?(:admin) || 
      current_user.has_role?(:'project manager') || 
      current_user.has_role?(:observer) || 
      current_user.has_role?(:qa) %>
  <div>
    <div class="text-sm font-semibold uppercase tracking-wider mb-1">Severity *</div>

    <%= form_with model: @defect, 
                  url: update_priority_defect_path(@defect), 
                  method: :patch, 
                  remote: true,
                  html: { id: "priorityForm" } do |f| %>
      <div class="relative flex-1">
        <%= f.select :priority, 
                    options_for_select(['SEVERITY 1', 'SEVERITY 2', 'SEVERITY 3', 'SEVERITY 4'], @defect.priority), 
                    {}, 
                    class: "block min-w-[220px] max-w-[280px] border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500",
                    required: true,
                    onchange: "this.form.requestSubmit()" %>
      </div>

      <% if @defect.errors[:priority].any? %>
        <div class="mt-1 text-sm text-red-600"><%= @defect.errors[:priority].join(", ") %></div>
      <% end %>
    <% end %>
  </div>
<% end %>