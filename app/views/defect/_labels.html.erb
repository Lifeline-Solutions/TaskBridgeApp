<div id="labels_section">
  <!-- Show existing labels -->
  <div class="flex flex-wrap gap-2">
    <% defect.labels.each do |label| %>
      <span class="px-2 py-1 bg-gray-200 text-gray-800 rounded-md text-xs font-medium flex items-center gap-1">
        <%= label.name %>
        <%= button_to "✕",
            remove_label_defect_path(@defect, label_id: label.id),
            method: :delete,
            data: { turbo_confirm: "Remove this label?" },
            class: "ml-1 text-red-500 hover:text-red-700 text-xs font-bold inline bg-transparent border-0 cursor-pointer" %>
      </span>
    <% end %>
    <% if defect.labels.empty? %>
      <span class="text-gray-500 text-sm italic">No labels yet</span>
    <% end %>
  </div>
</div>
