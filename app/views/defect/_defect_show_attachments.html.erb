<!-- Attachments Section -->
<div id="attachments" class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Attachments</h2>
  
  <% if @defect.attachments.attached? %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <% @attachments.each do |attachment| %>
        <div class="border border-gray-200 rounded-lg p-4 dark:border-gray-700">
          <% if attachment.image? || attachment.previewable? %>
            <%= image_tag attachment, class: "w-full h-32 object-cover mb-2 rounded" %>
          <% elsif attachment.video? %>
            <video controls class="w-full h-32 object-cover mb-2 rounded">
              <source src="<%= url_for(attachment) %>" type="<%= attachment.content_type %>">
            </video>
          <% else %>
            <div class="w-full h-32 bg-gray-100 dark:bg-gray-800 flex items-center justify-center mb-2 rounded">
              <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
              </svg>
            </div>
          <% end %>

          <!-- Metadata -->
          <div class="text-sm text-gray-700 dark:text-gray-300 space-y-1 mb-3">
            <p class="truncate font-medium">
              <%= link_to attachment.filename,
                          rails_blob_path(attachment, disposition: "attachment"),
                          class: "text-blue-600 dark:text-blue-400 hover:underline",
                          title: attachment.filename.to_s %>
            </p>
            <p><span class="font-semibold">Size:</span> <%= number_to_human_size(attachment.byte_size) %></p>
            <p><span class="font-semibold">Type:</span> <%= attachment.content_type.presence || "unknown" %></p>
            <p><span class="font-semibold">Uploaded:</span> <%= l(attachment.created_at, format: :short) %></p>
          </div>

          <!-- Actions -->
          <div class="flex justify-between items-center">
            <%= link_to 'Download',
                        rails_blob_path(attachment, disposition: "attachment"),
                        class: "text-sm font-medium text-blue-600 dark:text-blue-500 hover:underline" %>
            <% if @defect.creator == current_user %>
                <%= button_to 'Delete',
                        defect_attachment_path(@defect, attachment_id: attachment.id, attachments_page: @attachments_page),
                        method: :delete,
                        class: "text-red-600 dark:text-red-500 hover:text-red-900 dark:hover:text-red-700 text-sm",
                        data: { confirm: 'Are you sure?' } %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Pagination Controls -->
    <% if @attachments_total_pages > 1 %>
      <div class="flex justify-between items-center my-8">
        <% if @attachments_page > 1 %>
          <%= link_to "← Previous", defect_path(@defect, attachments_page: @attachments_page - 1, anchor: 'attachments'), 
                class: "px-3 py-1 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600" %>
        <% else %>
          <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 rounded text-gray-400 dark:text-gray-600 cursor-not-allowed">← Previous</span>
        <% end %>

        <span class="text-sm text-gray-600 dark:text-gray-400">
          Page <%= @attachments_page %> of <%= @attachments_total_pages %>
        </span>

        <% if @attachments_page < @attachments_total_pages %>
          <%= link_to "Next →", defect_path(@defect, attachments_page: @attachments_page + 1, anchor: 'attachments'), 
                class: "px-3 py-1 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600" %>
        <% else %>
          <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 rounded text-gray-400 dark:text-gray-600 cursor-not-allowed">Next →</span>
        <% end %>
      </div>
    <% end %>

  <% else %>
    <p class="text-gray-500 dark:text-gray-400 mb-6">No attachments yet.</p>
  <% end %>

  <!-- Upload Form -->
  <%= form_with url: defect_attachments_path(@defect), method: :post, local: true, multipart: true, data: { turbo: false } do |f| %>
    <div class="flex flex-col space-y-4">
      <div class="flex items-center space-x-4">
        <%= file_field_tag 'attachments[]', 
              multiple: true, 
              direct_upload: true,
              accept: 'image/*,video/*,application/pdf,.doc,.docx,.xls,.xlsx',
              class: "block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 focus:outline-none dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400" %>
        
        <%= submit_tag 'Upload', 
              class: "px-5 py-2.5 text-white bg-[#3F8CFF] hover:bg-[#3A81EB] font-medium rounded-lg text-sm cursor-pointer" %>
      </div>
      <p class="text-xs text-gray-500 dark:text-gray-400">Upload one or multiple files (Max size: 25MB each)</p>
    </div>
  <% end %>
</div>