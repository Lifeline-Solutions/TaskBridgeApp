<!-- Attachments Section -->
<div id="attachments" class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Attachments</h2>

  <% if @attachments.present? %>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm text-left text-gray-600 dark:text-gray-300 border-separate border-spacing-y-2">
        <thead>
        <tr class="text-xs uppercase text-gray-500 dark:text-gray-400">
          <th class="py-2">Name</th>
          <th class="py-2">Size</th>
          <th class="py-2">Date added</th>
          <th class="py-2"></th>
        </tr>
        </thead>
        <tbody>
        <% @attachments.each do |attachment| %>
          <%
            # Check if user is admin
            user_is_admin = current_user.has_role?(:admin)

            # Check if user is the creator of the defect (matching created_by field)
            user_is_creator = @defect.created_by == current_user.id

            # Check if attachment is from comments (embedded in ActionText)
            # ActionText attachments are of class ActionText::Attachment
            # Regular attachments are ActiveStorage::Attachment
            is_from_comments = attachment.is_a?(ActionText::Attachment)

            # Show delete for admin users OR creator, but not for attachments from comments
            show_delete = (user_is_admin || user_is_creator) && !is_from_comments
          %>

          <tr class="bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 rounded-lg">
            <!-- Icon + Filename -->
            <td class="py-3 px-4 flex items-center space-x-2">
              <%
                 # Safe URL generation for both ActiveStorage::Attachment and ActionText::Attachment
                 blob = attachment.respond_to?(:blob) ? attachment.blob : attachment
                 safe_url = begin
                              rails_blob_url(blob, disposition: "inline")
                            rescue => e
                              nil
                            end
                 # Separate download URL with 'attachment' disposition
                 download_url = begin
                                  rails_blob_url(blob, disposition: "attachment")
                                rescue => e
                                  safe_url
                                end
              %>
              <%
                 # Detect Office file types
                 content_type = attachment.content_type.to_s
                 is_word = content_type.include?('wordprocessing') || content_type == 'application/msword'
                 is_excel = content_type.include?('spreadsheet') || content_type == 'application/vnd.ms-excel'
                 is_powerpoint = content_type.include?('presentation') || content_type == 'application/vnd.ms-powerpoint'
              %>

              <% if safe_url && content_type.start_with?('image/') %>
                <%= image_tag safe_url,
                              class: "w-6 h-6 rounded cursor-pointer hover:opacity-80",
                              data: { action: "click->preview#open", url: safe_url, type: content_type } %>
              <% elsif safe_url && content_type.start_with?('video/') %>
                <svg class="w-6 h-6 text-gray-400 cursor-pointer hover:text-gray-600"
                     fill="currentColor" viewBox="0 0 24 24"
                     data-action="click->preview#open"
                     data-url="<%= safe_url %>"
                     data-type="<%= content_type %>">
                  <path d="M17 10.5V7c0-1.1-.9-2-2-2H5C3.9 5 3 5.9 3 7v10c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2v-3.5l4 4v-11l-4 4z"/>
                </svg>
              <% elsif safe_url && is_word %>
                <!-- Word Document Icon -->
                <svg class="w-6 h-6 text-blue-600 cursor-pointer hover:text-blue-800"
                     fill="currentColor" viewBox="0 0 24 24"
                     data-action="click->preview#open"
                     data-url="<%= safe_url %>"
                     data-type="<%= content_type %>">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/>
                  <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke="white" stroke-width="1"/>
                </svg>
              <% elsif safe_url && is_excel %>
                <!-- Excel Spreadsheet Icon -->
                <svg class="w-6 h-6 text-green-600 cursor-pointer hover:text-green-800"
                     fill="currentColor" viewBox="0 0 24 24"
                     data-action="click->preview#open"
                     data-url="<%= safe_url %>"
                     data-type="<%= content_type %>">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/>
                  <path d="M14 2v6h6M10 15l4-4M10 11l4 4" stroke="white" stroke-width="1.5"/>
                </svg>
              <% elsif safe_url && is_powerpoint %>
                <!-- PowerPoint Presentation Icon -->
                <svg class="w-6 h-6 text-orange-600 cursor-pointer hover:text-orange-800"
                     fill="currentColor" viewBox="0 0 24 24"
                     data-action="click->preview#open"
                     data-url="<%= safe_url %>"
                     data-type="<%= content_type %>">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/>
                  <path d="M14 2v6h6M9 13h1.5a1.5 1.5 0 0 1 0 3H9v-3zm0 0v5" stroke="white" stroke-width="1.5" fill="none"/>
                </svg>
              <% else %>
                <svg class="w-6 h-6 text-gray-400 cursor-pointer hover:text-gray-600"
                     fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                     data-action="click->preview#open"
                     data-url="<%= safe_url %>"
                     data-type="<%= content_type %>">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.4a1 1 0 00-.3-.7L13.3 3.3A1 1 0 0012.6 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
              <% end %>

              <%
                 # Safe filename and byte_size access
                 filename = if attachment.respond_to?(:filename)
                              attachment.filename
                            elsif attachment.respond_to?(:blob)
                              attachment.blob.filename
                            else
                              "Unknown File"
                            end

                 byte_size = if attachment.respond_to?(:byte_size)
                               attachment.byte_size
                             elsif attachment.respond_to?(:blob)
                               attachment.blob.byte_size
                             else
                               0
                             end
              %>

              <%= link_to filename,
                          safe_url,
                          class: "font-medium text-blue-600 dark:text-blue-400 hover:underline truncate max-w-xs",
                          title: filename.to_s %>
            </td>

            <!-- Size -->
            <td class="py-3 px-4 whitespace-nowrap">
              <%= number_to_human_size(byte_size) %>
            </td>

            <!-- Date Added -->
            <td class="py-3 px-4 whitespace-nowrap">
              <%
                 created_at = if attachment.respond_to?(:created_at)
                                attachment.created_at
                              elsif attachment.respond_to?(:attachable) && attachment.attachable&.respond_to?(:created_at)
                                attachment.attachable.created_at
                              else
                                Time.current
                              end
              %>
              <%= l(created_at, format: :short) %>
            </td>

            <!-- Actions -->
            <td class="py-3 px-4 flex space-x-3">
              <%= link_to download_url,
                          class: "text-blue-600 dark:text-blue-500 hover:text-blue-800",
                          title: "Download" do %>
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round"
                     class="w-5 h-5">
                  <path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
              <% end %>

              <% if show_delete %>
                <%= button_to defect_attachment_path(@defect, attachment_id: attachment.id, attachments_page: @attachments_page),
                              method: :delete,
                              class: "text-red-600 dark:text-red-500 hover:text-red-800",
                              data: { confirm: 'Are you sure?' } do %>
                  <svg xmlns="http://www.w3.org/2000/svg"
                       width="20" height="20" viewBox="0 0 24 24"
                       fill="none" stroke="currentColor" stroke-width="2"
                       stroke-linecap="round" stroke-linejoin="round"
                       class="w-5 h-5">
                    <polyline points="3 6 5 6 21 6"/>
                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                    <path d="M10 11v6"/>
                    <path d="M14 11v6"/>
                  </svg>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if @attachments_total_pages > 1 %>
      <div class="flex justify-between items-center mt-6 text-sm text-gray-600 dark:text-gray-400">
        <% if @attachments_page > 1 %>
          <%= link_to "← Previous", defect_path(@defect, attachments_page: @attachments_page - 1, anchor: 'attachments'),
                      class: "px-3 py-1 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600" %>
        <% else %>
          <span class="px-3 py-1 text-gray-400">← Previous</span>
        <% end %>

        <span>Page <%= @attachments_page %> of <%= @attachments_total_pages %></span>

        <% if @attachments_page < @attachments_total_pages %>
          <%= link_to "Next →", defect_path(@defect, attachments_page: @attachments_page + 1, anchor: 'attachments'),
                      class: "px-3 py-1 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600" %>
        <% else %>
          <span class="px-3 py-1 text-gray-400">Next →</span>
        <% end %>
      </div>
    <% end %>

  <% else %>
    <p class="text-gray-500 dark:text-gray-400">No attachments yet.</p>
  <% end %>

  <!-- Upload Form -->
  <div class="mt-6">
    <%= form_with url: defect_attachments_path(@defect), method: :post, local: true, multipart: true, data: { turbo: false } do |f| %>
      <div class="flex items-center space-x-4">
        <%= file_field_tag 'attachments[]',
                           multiple: true,
                           direct_upload: true,
                           accept: 'image/*,video/*,audio/*,application/pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx',
                           class: "block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400" %>

        <%= submit_tag 'Upload',
                       class: "px-5 py-2.5 text-white bg-[#3F8CFF] hover:bg-[#3A81EB] font-medium rounded-lg text-sm cursor-pointer" %>
      </div>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">Upload one or multiple files (Max size: 1GB each)</p>
    <% end %>
  </div>
</div>

<!-- Fullscreen Preview Modal -->
<div id="previewModal" class="hidden fixed inset-0 bg-black bg-opacity-90 flex items-center justify-center z-50">
  <!-- Close Button -->
  <button id="closePreviewBtn"
          class="absolute top-4 right-4 z-50 w-12 h-12 flex items-center justify-center rounded-full bg-gray-800 bg-opacity-75 hover:bg-opacity-100 text-white hover:text-red-400 transition-all duration-200 group"
          title="Close preview">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>
  <div id="previewContent" class="max-h-full max-w-full"></div>
</div>

<!-- Style for table previews -->
<style>
    /* Table preview for rich text/HTML tables in modal */
    #previewContent table {
        border-collapse: collapse;
        width: 100%;
        background: #fff;
        color: #111827;
    }
    #previewContent th, #previewContent td {
        border: 2px solid #111827;
        font-weight: bold;
        padding: 8px;
    }
    /* Dark mode for table preview */
    .dark #previewContent table {
        background: #1f2937;
        color: #f3f4f6;
    }
    .dark #previewContent th, .dark #previewContent td {
        border-color: #f3f4f6;
    }
</style>

<!-- Load client-side Office preview libraries from CDN -->
<script src="https://cdn.jsdelivr.net/npm/mammoth@1.6.0/mammoth.browser.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<!-- Script for Preview -->
<script>
  function safePreview(url, type) {
    const container = document.createElement("div");

    // Helper function to check if file is Office document
    const isOfficeDoc = (mimeType) => {
      return mimeType.includes('wordprocessing') ||
             mimeType === 'application/msword' ||
             mimeType.includes('spreadsheet') ||
             mimeType === 'application/vnd.ms-excel' ||
             mimeType.includes('presentation') ||
             mimeType === 'application/vnd.ms-powerpoint';
    };

    if (type.startsWith("image/")) {
      const img = document.createElement("img");
      img.src = url;
      img.className = "max-h-full max-w-full rounded shadow-lg";
      container.appendChild(img);
    } else if (type.startsWith("video/")) {
      const video = document.createElement("video");
      video.controls = true;
      video.className = "max-h-full max-w-full rounded shadow-lg";
      const source = document.createElement("source");
      source.src = url;
      source.type = type;
      video.appendChild(source);
      container.appendChild(video);
    } else if (type.startsWith("audio/")) {
      const audio = document.createElement("audio");
      audio.controls = true;
      audio.className = "w-full";
      const source = document.createElement("source");
      source.src = url;
      source.type = type;
      audio.appendChild(source);
      container.appendChild(audio);
    } else if (type === "application/pdf") {
      const iframe = document.createElement("iframe");
      iframe.src = url;
      iframe.className = "w-[90vw] h-[90vh] rounded bg-white shadow-lg";
      iframe.setAttribute("sandbox", "allow-same-origin allow-scripts allow-popups");
      container.appendChild(iframe);
    } else if (isOfficeDoc(type)) {
      // Office documents (Word, Excel, PowerPoint) - Client-side preview
      const loadingDiv = document.createElement("div");
      loadingDiv.className = "p-6 bg-white dark:bg-gray-800 rounded shadow-lg text-center";
      loadingDiv.innerHTML = \`
        <div class="mb-4">
          <svg class="animate-spin h-8 w-8 mx-auto text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </div>
        <p class="text-gray-700 dark:text-gray-300">Loading document...</p>
      \`;
      container.appendChild(loadingDiv);

      const isWord = type.includes('wordprocessing') || type === 'application/msword';
      const isExcel = type.includes('spreadsheet') || type === 'application/vnd.ms-excel';
      const isPowerPoint = type.includes('presentation') || type === 'application/vnd.ms-powerpoint';

      if (isPowerPoint) {
        container.innerHTML = \`
          <div class="p-6 bg-white dark:bg-gray-800 rounded shadow-lg text-center">
            <p class="mb-4 text-gray-700 dark:text-gray-300">PowerPoint preview not available</p>
            <a href="\${url}" download class="px-6 py-3 bg-orange-600 text-white rounded-lg hover:bg-orange-700">Download File</a>
          </div>
        \`;
      } else {
        fetch(url)
          .then(response => response.arrayBuffer())
          .then(arrayBuffer => {
            if (isWord && typeof mammoth !== 'undefined') {
              mammoth.convertToHtml({ arrayBuffer: arrayBuffer })
                .then(result => {
                  loadingDiv.remove();
                  const previewDiv = document.createElement("div");
                  previewDiv.className = "bg-white dark:bg-gray-800 p-8 rounded shadow-lg max-w-4xl max-h-[90vh] overflow-auto";
                  previewDiv.innerHTML = \`<div class="prose dark:prose-invert max-w-none">\${result.value}</div>\`;
                  container.appendChild(previewDiv);
                })
                .catch(error => {
                  container.innerHTML = \`<div class="p-6 bg-white dark:bg-gray-800 rounded shadow-lg text-center">
                    <p class="mb-4 text-gray-700 dark:text-gray-300">Preview failed</p>
                    <a href="\${url}" download class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Download File</a>
                  </div>\`;
                });
            } else if (isExcel && typeof XLSX !== 'undefined') {
              try {
                const workbook = XLSX.read(arrayBuffer, { type: 'array' });
                loadingDiv.remove();
                const previewDiv = document.createElement("div");
                previewDiv.className = "bg-white dark:bg-gray-800 p-6 rounded shadow-lg max-w-[90vw] max-h-[90vh] overflow-auto";
                let html = '<div class="space-y-6">';
                workbook.SheetNames.forEach((sheetName) => {
                  const worksheet = workbook.Sheets[sheetName];
                  const htmlTable = XLSX.utils.sheet_to_html(worksheet);
                  html += \`<div><h3 class="text-lg font-semibold mb-2 text-gray-800 dark:text-gray-200">\${sheetName}</h3><div class="overflow-x-auto">\${htmlTable}</div></div>\`;
                });
                html += '</div>';
                previewDiv.innerHTML = html;
                const tables = previewDiv.querySelectorAll('table');
                tables.forEach(table => {
                  table.className = 'min-w-full border-collapse border border-gray-300 dark:border-gray-600';
                 const cells = table.querySelectorAll('td, th');
                  cells.forEach(cell => {
                    cell.className = 'border border-gray-300 dark:border-gray-600 px-4 py-2 text-sm text-gray-700 dark:text-gray-300';
                  });
                });
                container.appendChild(previewDiv);
              } catch (error) {
                container.innerHTML = \`<div class="p-6 bg-white dark:bg-gray-800 rounded shadow-lg text-center">
                  <p class="mb-4 text-gray-700 dark:text-gray-300">Preview failed</p>
                  <a href="\${url}" download class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Download File</a>
                </div>\`;
              }
            }
          })
          .catch(error => {
            container.innerHTML = \`<div class="p-6 bg-white dark:bg-gray-800 rounded shadow-lg text-center">
              <p class="mb-4 text-gray-700 dark:text-gray-300">Failed to load document</p>
              <a href="\${url}" download class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Download File</a>
            </div>\`;
          });
      }
    }
    } else if (type === "text/html" || type === "application/xhtml+xml") {
      // If the attachment is an HTML file, fetch and render table content safely
      fetch(url)
        .then(response => response.text())
        .then(html => {
          container.innerHTML = html;
        });
    } else {
      const fallback = document.createElement("div");
      fallback.className = "p-6 bg-white dark:bg-gray-800 rounded shadow-lg text-center";
      fallback.innerHTML = `
        <p class="mb-4 text-gray-700 dark:text-gray-300">Preview not available for this file type.</p>
        <a href="${url}" download class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Download</a>
      `;
      container.appendChild(fallback);
    }

    return container;
  }

  document.addEventListener("click", (e) => {
    const el = e.target.closest("[data-action='click->preview#open']");
    if (!el) return;

    e.preventDefault();
    const url = el.dataset.url;
    const type = el.dataset.type || "";

    const modal = document.getElementById("previewModal");
    const previewContent = document.getElementById("previewContent");

    previewContent.innerHTML = "";
    const preview = safePreview(url, type);
    previewContent.appendChild(preview);
    modal.classList.remove("hidden");
  });

  // Close modal function
  const closeModal = () => {
    const modal = document.getElementById("previewModal");
    const previewContent = document.getElementById("previewContent");
    modal.classList.add("hidden");
    previewContent.innerHTML = "";

    // Stop any playing videos/audio when closing
    const videos = previewContent.querySelectorAll('video, audio');
    videos.forEach(media => {
      media.pause();
      media.src = '';
    });
  };

  // Close button click
  document.getElementById("closePreviewBtn").addEventListener("click", closeModal);

  // ESC key to close
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const modal = document.getElementById("previewModal");
      if (!modal.classList.contains("hidden")) {
        closeModal();
      }
    }
  });

  // Click outside to close
  document.getElementById("previewModal").addEventListener("click", (e) => {
    if (e.target.id === "previewModal") {
      closeModal();
    }
  });
</script>

<!-- Simple Working Preview Script -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log("Preview script loaded");

  // Handle all preview triggers
  document.addEventListener('click', function(e) {
    const trigger = e.target.closest('[data-action="click->preview#open"]');
    if (!trigger) return;

    e.preventDefault();
    const url = trigger.dataset.url;
    const type = trigger.dataset.type;

    if (!url) return;

    const modal = document.getElementById('previewModal');
    const content = document.getElementById('previewContent');

    if (!modal || !content) {
      console.error("Modal elements missing");
      return;
    }

    // Clear previous content
    content.innerHTML = '';

    // Create preview based on type
    if (type.startsWith('image/')) {
      const preview = document.createElement('img');
      preview.src = url;
      preview.className = 'max-w-full max-h-full';
      content.appendChild(preview);
    } else if (type.startsWith('video/')) {
      const preview = document.createElement('video');
      preview.src = url;
      preview.controls = true;
      preview.className = 'max-w-full max-h-full';
      content.appendChild(preview);
    } else if (type === 'application/pdf') {
      const preview = document.createElement('iframe');
      preview.src = url;
      preview.className = 'bg-white';
      preview.style.width = '90vw';
      preview.style.height = '90vh';
      preview.style.border = 'none';
      content.appendChild(preview);
    } else if (type.includes('wordprocessing') || type === 'application/msword') {
      // Word document preview with Mammoth.js
      const loading = document.createElement('div');
      loading.className = 'text-white p-8';
      loading.innerHTML = '<p>Loading Word document...</p>';
      content.appendChild(loading);

      fetch(url)
        .then(res => res.arrayBuffer())
        .then(arrayBuffer => {
          if (typeof mammoth !== 'undefined') {
            return mammoth.convertToHtml({arrayBuffer: arrayBuffer});
          } else {
            throw new Error('Mammoth.js not loaded');
          }
        })
        .then(result => {
          const preview = document.createElement('div');
          preview.className = 'bg-white text-gray-900 p-8 overflow-y-auto overflow-x-auto';
          preview.style.maxHeight = '80vh';
          preview.style.maxWidth = '90vw';
          preview.style.width = 'auto';
          preview.innerHTML = result.value;

          // Add styling for Word document structure
          const style = document.createElement('style');
          style.textContent = `
            #previewContent p { margin-bottom: 1em; line-height: 1.6; }
            #previewContent h1 { font-size: 2em; font-weight: bold; margin: 1em 0 0.5em; }
            #previewContent h2 { font-size: 1.5em; font-weight: bold; margin: 1em 0 0.5em; }
            #previewContent h3 { font-size: 1.25em; font-weight: bold; margin: 1em 0 0.5em; }
            #previewContent ul, #previewContent ol { margin-left: 2em; margin-bottom: 1em; }
            #previewContent li { margin-bottom: 0.5em; }
            #previewContent table { border-collapse: collapse; width: 100%; margin: 1em 0; }
            #previewContent th, #previewContent td { border: 1px solid #ddd; padding: 8px; text-align: left; }
            #previewContent th { background-color: #f3f4f6; font-weight: bold; }
            #previewContent strong { font-weight: bold; }
            #previewContent em { font-style: italic; }
          `;
          preview.appendChild(style);

          content.innerHTML = '';
          content.appendChild(preview);
        })
        .catch(err => {
          console.error('Word preview error:', err);
          content.innerHTML = '<div class="text-white p-8"><p>Could not preview Word document.</p><p class="mt-4"><a href="' + url + '" class="text-blue-400 underline">Download file</a></p></div>';
        });
    } else if (type.includes('spreadsheet') || type === 'application/vnd.ms-excel') {
      // Excel preview with SheetJS
      const loading = document.createElement('div');
      loading.className = 'text-white p-8';
      loading.innerHTML = '<p>Loading Excel file...</p>';
      content.appendChild(loading);

      fetch(url)
        .then(res => res.arrayBuffer())
        .then(arrayBuffer => {
          if (typeof XLSX !== 'undefined') {
            const workbook = XLSX.read(arrayBuffer, {type: 'array'});
            const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
            const html = XLSX.utils.sheet_to_html(firstSheet);

            const preview = document.createElement('div');
            preview.className = 'bg-white text-gray-900 p-8 overflow-y-auto overflow-x-auto';
            preview.style.maxHeight = '80vh';
            preview.style.maxWidth = '90vw';
            preview.style.width = 'auto';
            preview.innerHTML = '<h3 class="text-lg font-bold mb-4 text-gray-900">Sheet: ' + workbook.SheetNames[0] + '</h3>' + html;

            // Add Excel table styling
            const style = document.createElement('style');
            style.textContent = `
              #previewContent table {
                border-collapse: collapse;
                width: max-content;
                min-width: 100%;
                margin: 1em 0;
                font-size: 14px;
              }
              #previewContent th, #previewContent td {
                border: 1px solid #d1d5db;
                padding: 8px 12px;
                text-align: left;
                white-space: nowrap;
              }
              #previewContent th {
                background-color: #f3f4f6;
                font-weight: 600;
                position: sticky;
                top: 0;
                z-index: 10;
              }
              #previewContent tr:nth-child(even) {
                background-color: #f9fafb;
              }
              #previewContent tr:hover {
                background-color: #e5e7eb;
              }
            `;
            preview.appendChild(style);

            content.innerHTML = '';
            content.appendChild(preview);
          } else {
            throw new Error('SheetJS not loaded');
          }
        })
        .catch(err => {
          console.error('Excel preview error:', err);
          content.innerHTML = '<div class="text-white p-8"><p>Could not preview Excel file.</p><p class="mt-4"><a href="' + url + '" class="text-blue-400 underline">Download file</a></p></div>';
        });
    } else {
      const preview = document.createElement('div');
      preview.className = 'text-white p-8';
      preview.innerHTML = '<p>Preview not available for this file type.</p><p class="mt-4"><a href="' + url + '" class="text-blue-400 underline">Download file</a></p>';
      content.appendChild(preview);
    }
    modal.classList.remove('hidden');
  });

  // Close button
  const closeBtn = document.getElementById('closePreview');
  if (closeBtn) {
    closeBtn.addEventListener('click', function() {
      const modal = document.getElementById('previewModal');
      if (modal) modal.classList.add('hidden');
    });
  }

  // ESC key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const modal = document.getElementById('previewModal');
      if (modal && !modal.classList.contains('hidden')) {
        modal.classList.add('hidden');
      }
    }
  });

  // Click outside
  const modal = document.getElementById('previewModal');
  if (modal) {
    modal.addEventListener('click', function(e) {
      if (e.target.id === 'previewModal') {
        modal.classList.add('hidden');
      }
    });
  }
});
</script>
