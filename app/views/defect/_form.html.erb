<!-- filepath: app/views/defect/_form.html.erb -->
<%= form_with model: @defect, url: defect_index_url, method: :post, data: { turbo: true }, local: true do |f| %>
  <!-- Summary (rich text) -->
  <div class="relative z-0 w-full mb-6 group">
    <%= f.label :summary, 'Summary', class: "capitalize block mb-1 text-sm font-medium text-gray-900 dark:text-white" %>
    <%= f.rich_text_area :summary, class: "min-h-[200px] border border-gray-300 rounded-md focus:ring-primary-600 focus:border-primary-600 block w-full p-2 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500 dark:text-white" %>
  </div>

  <!-- Description (was Subject) -->
  <div class="relative z-0 w-full mb-6 group">
    <%= f.label :content, 'Description *', class: "capitalize block mb-1 text-sm font-medium text-gray-900 dark:text-white" %>
    <%= f.rich_text_area :content, class: "min-h-[300px] border border-gray-300 rounded-md focus:ring-primary-600 focus:border-primary-600 block w-full p-2 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500 dark:text-white", required: true %>
  </div>

  <!-- Project: Module & Submodule -->
  <div class="md:gap-6">
    <div class="grid grid-cols-2 gap-2">
      <!-- Module -->
       <div class="relative z-0 w-full mb-6 group">
          <%= f.label :qa_module_id, 'Module *', class: "capitalize block mb-1 text-sm font-medium text-gray-900 dark:text-white" %>
          <%= f.collection_select :qa_module_id, 
                @qa_modules || [], # Safely handle nil case
                :id, 
                :name, 
                { prompt: "Select Module" },
                { class: "border border-gray-300 rounded-md focus:ring-primary-600 focus:border-primary-600 block w-full p-2 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500", 
                  required: true, 
                  id: "qa-module-select",
                  data: { action: "change->modules#loadSubmodules" } } %>
        </div>
      <!-- Submodule -->
      <div class="relative z-0 w-full mb-6 group">
        <%= f.label :qa_submodule_id, 'Sub Module', class: "capitalize block mb-1 text-sm font-medium text-gray-900 dark:text-white" %>
        <%= f.collection_select :submodule_id, 
          @submodules || [], 
          :id, 
          :name, 
          { prompt: "Select Submodule" },
          { class: "border border-gray-300...", 
            id: "submodule-select" } %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-2">
    <!-- Banking Type -->
    <div class="relative z-0 w-full mb-6 group">
      <%= f.label :banking_type_id, 'Banking Type *', class: "capitalize block mb-1 text-sm font-medium text-gray-900 dark:text-white" %>
      <%= f.collection_select :banking_type_id, 
            @banking_types || [], # Safely handle nil case
            :id, 
            :name, 
            { prompt: "Select Banking Type" },
            { class: "border border-gray-300 rounded-md focus:ring-primary-600 focus:border-primary-600 block w-full p-2 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500", 
              required: true } %>
    </div>
    <!-- Priority -->
    <div class="relative z-0 w-full mb-6 group">
      <%= f.label :priority, 'Priority *', class: "capitalize block mb-1 text-sm font-medium text-gray-900 dark:text-white" %>
      <%= f.select :priority, 
            options_for_select(['SEVERITY 1', 'SEVERITY 2', 'SEVERITY 3', 'SEVERITY 4'], @defect.priority),
            {},
            { class: "border border-gray-300 rounded-md focus:ring-primary-600 focus:border-primary-600 block w-full p-2 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500",
              required: true } %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-2">
    <!-- Assignees (multi-select) -->
    <div class="relative z-0 w-full mb-6 group">
      <%= f.label :user_ids, 'Assignees *', class: "capitalize block mb-1 text-sm font-medium text-gray-900 dark:text-white" %>
      <%= select_tag "defect[user_ids][]",
            options_from_collection_for_select(@users, :id, :name, @defect.user_ids),
            multiple: true,
            class: "border border-gray-300 rounded-md focus:ring-primary-600 focus:border-primary-600 block w-full p-2 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500 dark:text-white",
            required: true %>
    </div>
    <!-- Status (disabled) -->
    <div class="relative z-0 w-full mb-6 group">
      <%= f.label :status, 'Status', class: "capitalize block mb-1 text-sm font-medium text-gray-900 dark:text-white" %>
      <%= f.text_field :status, value: 'Bug', disabled: true,
            class: "border border-gray-300 rounded-md focus:ring-primary-600 focus:border-primary-600 block w-full p-2 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500 dark:text-white bg-gray-100 dark:bg-gray-800" %>
    </div>
  </div>

  <!-- Creator (disabled) -->
  <div class="relative z-0 w-full mb-6 group">
    <%= f.label :creator_id, 'Creator', class: "capitalize block mb-1 text-sm font-medium text-gray-900 dark:text-white" %>
    <%= text_field_tag :creator_name, Current.user&.name, disabled: true,
          class: "border border-gray-300 rounded-md focus:ring-primary-600 focus:border-primary-600 block w-full p-2 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500 dark:text-white bg-gray-100 dark:bg-gray-800" %>
  </div>

  <%= f.submit 'Create Defect', class: 'mb-4 h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] p-3 rounded font-bold rounded-lg text-slate-100', id: 'button' %>
<% end %>

<!-- Dynamic Submodule Dropdown -->
<script>
  document.addEventListener('turbo:load', function () {
    const moduleSelect = document.getElementById('qa-module-select');
    const submoduleSelect = document.getElementById('submodule-select');

    moduleSelect.addEventListener('change', function () {
      const moduleId = this.value;
      submoduleSelect.innerHTML = '<option value="">Select Submodule</option>';
      if (moduleId) {
        fetch(`/qa_modules/${moduleId}/submodules`)
          .then(response => response.json())
          .then(submodules => {
            submodules.forEach(submodule => {
              const option = document.createElement('option');
              option.value = submodule.id;
              option.textContent = submodule.name;
              submoduleSelect.appendChild(option);
            });
          });
      }
    });
  });
</script>