<% if @defects_history.present? || @defect.creator.present? %>
  <div class="space-y-6 px-2 sm:px-0">
    <!-- Combined Stream: History + Creation -->
    <%
      # Combine history and creation event, sort by date desc
      creation_event = if @defect.creator
        OpenStruct.new(
          user: @defect.creator,
          history: "created the Work item",
          created_at: @defect.created_at,
          history_type: "Created"
        )
      else
        nil
      end

      all_events = (@defects_history.to_a + [creation_event]).compact
      # Sort by created_at DESC (newest top)
      all_events.sort_by! { |e| e.created_at }.reverse!
    %>

    <% all_events.each do |event| %>
      <%
        parsed = parse_history_item(event.history)
        user = event.user
      %>
      <div class="flex gap-4 group">
        <!-- Avatar Column -->
        <div class="flex-shrink-0 pt-1">
          <%= render_user_avatar(user, "w-8 h-8") %>
        </div>

        <!-- Content Column -->
        <div class="flex-1 min-w-0">
          <!-- Header: User Action Date -->
          <div class="flex items-center gap-2 mb-1">
            <span class="font-semibold text-gray-900 dark:text-gray-100 text-sm">
              <%= user&.name || 'System' %>
            </span>
            <span class="text-sm text-gray-600 dark:text-gray-400">
              <%= parsed[:action] %>
            </span>
            <% if parsed[:field].present? && !parsed[:action].include?(parsed[:field]) && parsed[:field] != 'Info' %>
               <!-- Redundant if action is "changed the Status", but good fallback -->
            <% end %>
          </div>

          <div class="text-xs text-gray-400 dark:text-gray-500 mb-2">
            <%= event.created_at.strftime('%B %d, %Y at %l:%M %p') %>
          </div>

          <!-- Diff Block -->
          <% if parsed[:from].present? || parsed[:to].present? %>
            <% if parsed[:field] == 'Description' %>
              <!-- For descriptions, show compressed side-by-side comparison using flex -->
              <!-- Allow horizontal scroll if container is too narrow -->
              <div class="w-full overflow-x-auto -mx-2 px-2">
                <div class="flex gap-2 items-start min-w-max">
                  <!-- Previous Content (Left) -->
                  <% if parsed[:from].present? %>
                    <div class="w-80 flex-shrink-0 border-l-2 border-red-400 pl-2 py-1 bg-red-50 dark:bg-red-900/20 rounded text-xs max-h-96 overflow-y-auto">
                      <div class="font-semibold text-red-700 dark:text-red-400 mb-1 text-[10px] uppercase tracking-wide">Previous</div>
                      <div class="prose-compact text-xs leading-tight [&_ul]:my-1 [&_ol]:my-1 [&_li]:my-0 [&_p]:my-1 [&_table]:text-xs break-words">
                        <%= parsed[:from] %>
                      </div>
                    </div>
                  <% else %>
                    <div class="w-80 flex-shrink-0"></div>
                  <% end %>

                  <!-- Arrow (Center) -->
                  <div class="flex items-center justify-center pt-4 flex-shrink-0">
                    <svg class="w-5 h-5 text-blue-500 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                  </div>

                  <!-- New Content (Right) -->
                  <% if parsed[:to].present? %>
                    <div class="w-80 flex-shrink-0 border-l-2 border-green-400 pl-2 py-1 bg-green-50 dark:bg-green-900/20 rounded text-xs max-h-96 overflow-y-auto">
                      <div class="font-semibold text-green-700 dark:text-green-400 mb-1 text-[10px] uppercase tracking-wide">New</div>
                      <div class="prose-compact text-xs leading-tight [&_ul]:my-1 [&_ol]:my-1 [&_li]:my-0 [&_p]:my-1 [&_table]:text-xs break-words">
                        <%= parsed[:to] %>
                      </div>
                    </div>
                  <% else %>
                    <div class="w-80 flex-shrink-0"></div>
                  <% end %>
                </div>
              </div>
            <% else %>
              <!-- For other fields, use inline badges -->
              <div class="flex items-center gap-3 text-sm">
                <% if parsed[:from].present? %>
                  <div class="<%= history_badge_class(parsed[:from], :old) %>">
                    <%= parsed[:from] %>
                  </div>
                  <div class="text-gray-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                  </div>
                <% end %>

                <% if parsed[:to].present? %>
                  <div class="<%= history_badge_class(parsed[:to], :new) %>">
                    <%= parsed[:to] %>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% end %>

          <!-- Attachment or Info specific rendering -->
          <% if parsed[:field] == 'Attachment' %>
             <div class="mt-1 text-sm text-blue-600 dark:text-blue-400 flex items-center gap-1">
               <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
               <%= parsed[:to] %>
             </div>
          <% end %>

        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="p-8 text-center text-gray-500 dark:text-gray-400">
    No history available.
  </div>
<% end %>
