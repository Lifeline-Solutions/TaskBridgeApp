<% if @defects_history.present? %><div class="p-5 mb-4 border border-gray-100 rounded-lg bg-gray-50 dark:bg-gray-800 dark:border-gray-700">
  <% (@defects_history || []).each do |defect| %>
    <time class="text-lg font-semibold text-gray-900 dark:text-white"><%= defect.created_at.strftime("%B %d, %Y %H:%M") %></time>
    <ol class="mt-3 divide-y divide-gray-200 dark:divide-gray-700 gap-2">
      <li>
        <div class="items-center block p-3 sm:flex hover:bg-gray-100 dark:hover:bg-gray-700 gap-2">
          <%= render 'defect/defect_user_initials', defect: defect %>
          <div class="text-gray-600 dark:text-gray-400">
            <div class="text-base font-normal"><span class="font-medium text-gray-900 dark:text-white"><%= defect.user.name %></span></div>
            <div class="text-sm font-normal"><%= defect.history_type %></div>
            <div class="text-sm font-normal"><%= defect.history %></div>
          </div>
        </div>
      </li>
    </ol>
  <% end %>
</div>
<% else %>
  <p>No defect history found.</p>
<% end %>