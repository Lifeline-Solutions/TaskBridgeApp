<div class="w-full col-span-1 h-full p-2">
  <!-- Status display -->
  <div class="mb-2.5 font-bold capitalize gap-2">Status:
    <%= render partial: "defect/assign_defect_status" %>
  </div>
  <div class="mb-2.5 font-bold capitalize">
    <%= render partial: 'defect/show_assigned_user', locals: { defect: @defect } %>
  </div>

  

  <div class="mb-2.5 font-bold capitalize">
    <%= render partial: 'defect/defect_show_update_label' %>
  </div>

  <div class="mb-2.5 font-bold capitalize">
    <%= render partial: 'defect/defect_show_severity' %>
  </div>

  <div class="mb-2.5 font-bold capitalize">
    <%= render 'defect/defect_metadata' %>
  </div>

  <div class="mb-2.5">
    <%= render 'defect/defect_links', defect: @defect %>
  </div>
</div>
