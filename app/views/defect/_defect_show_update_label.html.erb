<% if current_user.has_role?(:admin) || current_user.has_role?(:'project manager') || current_user.has_role?(:observer) || current_user.has_role?(:qa) %>
  <div class="mt-4">
    <div class="text-sm font-semibold uppercase tracking-wider mb-1">Label *</div>
    <%= form_with model: @defect, 
                  url: update_label_defect_path(@defect), 
                  method: :patch, 
                  remote: true do |f| %>
      <div class="flex items-center gap-2">
        <div class="relative flex-1">
          
        </div>

        <button type="submit" 
                class="inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 p-2 text-sm font-medium shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
          Update
        </button>
      </div>

      <% if @defect.errors[:label].any? %>
        <div class="mt-1 text-sm text-red-600"><%= @defect.errors[:label].join(", ") %></div>
      <% end %>
    <% end %>
  </div>
<% end %>
