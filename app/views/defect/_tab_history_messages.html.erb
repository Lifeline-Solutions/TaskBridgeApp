<div class="mb-6 mt-6 border-b border-gray-200">
  <nav class="flex space-x-2 justify-start" aria-label="Tabs">
    <button
      class="tablinks px-6 py-2 rounded-t-lg text-sm font-semibold border-b-2 transition focus:outline-none
        text-blue-700 border-blue-700 bg-blue-50
        hover:bg-blue-100 hover:text-blue-800"
      id="tab-comments"
      onclick="openTab(event, 'Comments')"
      type="button"
      aria-selected="true"
    >
      🗨️ Comments
    </button>
    <button
      class="tablinks px-6 py-2 rounded-t-lg text-sm font-semibold border-b-2 transition focus:outline-none
        text-gray-500 border-transparent bg-white
        hover:bg-gray-100 hover:text-blue-700"
      id="tab-history"
      onclick="openTab(event, 'History')"
      type="button"
      aria-selected="false"
    >
      🕒 History
    </button>
  </nav>
</div>

<div id="Comments" class="tabcontent bg-white p-4 rounded-b-lg shadow" style="display: block;">
  <%= render 'defect_messages/defect_message' %>
</div>

<div id="History" class="tabcontent bg-white p-4 rounded-b-lg shadow" style="display: none;">
  <%= render 'defect/timeline' %>
</div>

<script>
  function openTab(evt, tabName) {
    const tabcontent = document.getElementsByClassName("tabcontent");
    const tablinks = document.getElementsByClassName("tablinks");

    // Hide all tab content
    for (let i = 0; i < tabcontent.length; i++) {
      tabcontent[i].style.display = "none";
    }

    // Remove active styling from all tab links
    for (let i = 0; i < tablinks.length; i++) {
      tablinks[i].classList.remove("text-blue-700", "border-blue-700", "bg-blue-50", "hover:bg-blue-100", "hover:text-blue-800");
      tablinks[i].classList.add("text-gray-500", "border-transparent", "bg-white", "hover:bg-gray-100", "hover:text-blue-700");
      tablinks[i].setAttribute("aria-selected", "false");
    }

    // Show current tab content and add active styling to clicked tab
    document.getElementById(tabName).style.display = "block";
    evt.currentTarget.classList.add("text-blue-700", "border-blue-700", "bg-blue-50");
    evt.currentTarget.classList.remove("text-gray-500", "border-transparent", "bg-white");
    evt.currentTarget.setAttribute("aria-selected", "true");
  }

  // Set default tab to open
  document.getElementById("tab-comments").click();
</script>
