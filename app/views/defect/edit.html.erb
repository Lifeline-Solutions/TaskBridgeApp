<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 bg-black bg-opacity-50 flex justify-center items-start z-50 overflow-y-auto py-8" data-controller="modal" data-action="click->modal#closeOnBackdrop">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl w-[90%] max-w-4xl relative m-4">
      <!-- Header -->
      <div class="bg-gray-50 dark:bg-gray-700 px-6 py-4 rounded-t-lg border-b border-gray-200 dark:border-gray-600 flex items-start">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white">Edit Defect</h2>
        <%= link_to "×", defect_path(@defect), 
              class: "ml-auto text-2xl font-bold text-gray-500 hover:text-gray-700 dark:text-gray-300 dark:hover:text-gray-100",
              data: { turbo_frame: "_top" } %>
      </div>
      
      <!-- Content -->
      <div class="p-6">
        <% if @defect.errors.any? %>
          <div id="error_explanation" class="mb-4 p-3 bg-red-100 border border-red-400 text-red-700 rounded">
            <h2 class="font-semibold mb-2"><%= pluralize(@defect.errors.count, "error") %> prohibited this defect from being saved:</h2>
            <ul class="list-disc list-inside">
              <% @defect.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @defect, url: defect_path(@defect), method: :patch, local: true, html: { multipart: true, class: 'space-y-6' }, data: { turbo: false } do |f| %>
          <div data-controller="project-modules"
            data-project-modules-modules-url-value="<%= modules_by_product_defect_index_path %>"
            data-project-modules-current-module-id-value="<%= @selected_module_id %>"
            data-project-modules-current-submodule-id-value="<%= @selected_submodule_id %>">

            
            <!-- Project -->
            <div>
              <label for="defect_product_id" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Project *</label>
              <%= f.select :product_id,
                           options_for_select(@products_and_clients_defects, @defect.product_id),
                           { prompt: "Select Project" },
                           { class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600", 
                             required: true,
                             data: { 
                               action: "change->project-modules#loadModules",
                               "project-modules-target": "projectSelect"
                             } } %>
            </div>

            <!-- Banking type / Module / Submodule -->
            <div class="flex flex-col sm:flex-row gap-2">
              <!-- Banking Type Search -->
              <div class="relative flex-1">
                <label for="banking-type-search" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Banking Type *</label>
                <input type="text"
                      id="banking-type-search"
                      placeholder="Type to search banking types..."
                      value="<%= @defect.banking_type&.name %>"
                      class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600" />

                <%= f.hidden_field :banking_type_id, id: "banking-type-id-field", value: @defect.banking_type_id %>

                <ul id="banking-type-results"
                    class="absolute mt-1 border border-gray-300 rounded-md bg-white dark:bg-gray-700 text-sm hidden z-10 w-full">
                </ul>
              </div>

              <!-- Module -->
              <div class="flex-1">
                <label for="defect_qa_module_id" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Modules *</label>
                <%= f.collection_select :qa_module_id, 
                    @qa_modules, :id, :name,
                    { selected: @defect.qa_module_id, prompt: "Select Module" },
                    { class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600",
                      required: true,
                      data: { 
                        "project-modules-target": "moduleSelect",
                        currentModuleId: @qa_modules,
                        action: "change->project-modules#loadSubmodules" 
                      } } %>

              </div>

              <!-- Submodule -->
              <div class="flex-1">
                <label for="defect_submodule_id" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Sub-Module</label>
                <%= f.collection_select :submodule_id, 
                      @submodules || [], :id, :name,
                      { selected: @defect.submodule_id, prompt: "Select Sub-Module" },
                      { class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600",
                        data: { "project-modules-target": "submoduleSelect" } } %>
              </div>
            </div>

            <!-- Summary -->
            <div>
              <label for="defect_summary" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Summary *</label>
              <%= f.text_field :summary, placeholder: 'Enter concise summary', required: true,
                    class: 'w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600 placeholder-gray-400',
                    value: @defect.summary %>
            </div>

            <!-- Description (CKEditor) -->
            <div>
              <label for="defect_content" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Description *</label>
              <%= text_area_tag 'defect[content]', @defect.content&.to_s, 
                    id: 'defect_content', 
                    class: 'min-h-[200px] w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600', 
                    data: { required: true } %>
              <p id="defect_content_error" class="mt-1 text-xs text-red-600 hidden">Description is required.</p>
            </div>

            <!-- Priority / Users / Status -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <!-- Assignee Search -->
              <div class="relative">
                <%= f.label :user_ids, "Assignee *", class: "block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase" %>

                <%= f.collection_select :user_ids,
                      @users,                # list of users from controller
                      :id, :name,            # value and label
                      { prompt: "Select Assignee" },
                      { class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600",
                        required: true } %>
              </div>

              <!-- Priority -->
              <div>
                <label for="defect_priority" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Priority *</label>
                <%= f.select :priority,
                      options_for_select(['SEVERITY 1','SEVERITY 2','SEVERITY 3','SEVERITY 4'], @defect.priority),
                      { prompt: 'Select Priority' },
                      { class: 'w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600', required: true } %>
              </div>

              <!-- Status -->
              <div>
                <label for="defect_status_ids" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Status *</label>
                <% if @defect.blocked? %>
                  <%= select_tag "defect[status_ids][]",
                       options_from_collection_for_select(@statuses, :id, :name, @defect.statuses.first&.id),
                       { disabled: true, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm bg-gray-100 cursor-not-allowed opacity-60 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600" } %>
                  <p class="text-xs text-orange-600 dark:text-orange-400 mt-1">
                    🚫 Status locked: Blocked by <%= @defect.blocking_defect_names %>
                  </p>
                <% else %>
                  <%= select_tag "defect[status_ids][]",
                       options_from_collection_for_select(@statuses, :id, :name, @defect.statuses.first&.id),
                       { class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600" } %>
                <% end %>
              </div>
            </div>

            <!-- Attachments -->
            <div>
              <label for="defect_attachments" class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Attachments *</label>
              
              <% if @defect.attachments.attached? %>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                  <% @defect.attachments.each do |attachment| %>
                    <div class="border border-gray-200 rounded-lg p-3 dark:border-gray-700">
                      <% if attachment.image? || attachment.previewable? %>
                        <%= image_tag attachment, class: "w-full h-24 object-cover mb-2 rounded" %>
                      <% elsif attachment.video? %>
                        <video controls class="w-full h-24 object-cover mb-2 rounded">
                          <source src="<%= url_for(attachment) %>" type="<%= attachment.content_type %>">
                        </video>
                      <% else %>
                        <div class="w-full h-24 bg-gray-100 dark:bg-gray-800 flex items-center justify-center mb-2 rounded">
                          <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                          </svg>
                        </div>
                      <% end %>
                      
                      <div class="flex justify-between items-center">
                        <%= link_to attachment.filename, rails_blob_path(attachment, disposition: "attachment"), 
                              class: "text-xs font-medium text-blue-600 dark:text-blue-500 hover:underline truncate" %>
                        <%= link_to 'Delete',
                            defect_attachment_path(@defect, attachment_id: attachment.id),
                            data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' },
                            class: "text-red-600 dark:text-red-500 hover:text-red-900 dark:hover:text-red-700 text-xs" %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="text-gray-500 dark:text-gray-400 mb-4">No attachments yet.</p>
              <% end %>

              <!-- Add more attachments -->
              <%= f.file_field :attachments, multiple: true, direct_upload: true, name: 'defect[attachments][]',
                    class: 'block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 focus:outline-none dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400',
                    accept: 'image/*,video/*,application/pdf,.doc,.docx,.xls,.xlsx' %>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Upload additional files (Max size: 25MB each)</p>
            </div>

            <!-- Creator / Issue Type -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Creator</label>
                <%= text_field_tag :creator_name, @defect.creator&.name, disabled: true,
                      class: 'w-full border border-gray-300 rounded-md px-3 py-2 text-sm bg-gray-100 dark:bg-gray-800 dark:border-gray-600 dark:text-white cursor-not-allowed' %>
              </div>
              <div>
                <label class="block mb-1 text-xs font-medium text-gray-700 dark:text-gray-300 tracking-wide uppercase">Issue Type</label>
                <%= f.text_field :issue_type, value: 'Bug', disabled: true,
                      class: 'w-full border border-gray-300 rounded-md px-3 py-2 text-sm bg-gray-100 dark:bg-gray-800 dark:border-gray-600 dark:text-white cursor-not-allowed' %>
              </div>
            </div>

            <!-- Footer -->
            <div class="flex items-center justify-between pt-4 border-t">
              <%= f.submit "Update Defect",
                    data: { disable_with: "Updating..." },
                    class: "bg-[#3F8CFF] hover:bg-[#3A81EB] text-white font-medium rounded-lg px-6 py-2 shadow-md" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<script>
  document.addEventListener('turbo:load', function () {
    // ===== Dynamic module/submodule loading =====
    const projectSelect = document.querySelector('[data-project-modules-target="projectSelect"]');
    const modSelect = document.querySelector('[data-project-modules-target="moduleSelect"]');
    const submodSelect = document.querySelector('[data-project-modules-target="submoduleSelect"]');

    // Load submodules for the selected module on page load
    if (modSelect && modSelect.value) {
      const moduleId = modSelect.value;
      if (submodSelect) {
        submodSelect.innerHTML = '<option value="">Select Sub-Module</option>';
        if (moduleId) {
          fetch(`/qa_modules/${moduleId}/submodules`)
            .then(r => r.json())
            .then(submodules => {
              submodules.forEach(sm => {
                const opt = document.createElement('option');
                opt.value = sm.id;
                opt.textContent = sm.name;
                // Select the current defect's submodule
                if (sm.id == '<%= @defect.submodule_id %>') {
                  opt.selected = true;
                }
                submodSelect.appendChild(opt);
              });
            });
        }
      }
    }

    // ===== Assignee Search =====
    const assigneeInput = document.getElementById("assignee-search");
    const assigneeResults = document.getElementById("assignee-results");
    const assigneeHidden = document.getElementById("assignee-id-field");

    let assigneeUsers = <%= raw @users.map { |u| { id: u.id, name: u.name } }.to_json %>;

    if (assigneeInput) {
      assigneeInput.addEventListener("input", () => {
        const query = assigneeInput.value.toLowerCase();
        assigneeResults.innerHTML = "";

        if (query.length === 0) {
          assigneeResults.classList.add("hidden");
          return;
        }

        const matches = assigneeUsers.filter(user =>
          user.name.toLowerCase().includes(query)
        );

        if (matches.length > 0) {
          assigneeResults.classList.remove("hidden");
          matches.forEach(user => {
            const li = document.createElement("li");
            li.textContent = user.name;
            li.className = "px-3 py-2 hover:bg-blue-500 hover:text-white cursor-pointer";
            li.addEventListener("click", () => {
              assigneeInput.value = user.name;
              assigneeHidden.value = user.id;
              assigneeResults.classList.add("hidden");
            });
            assigneeResults.appendChild(li);
          });
        } else {
          assigneeResults.classList.add("hidden");
        }
      });

      // Hide results if clicking outside
      document.addEventListener("click", (e) => {
        if (!assigneeResults.contains(e.target) && e.target !== assigneeInput) {
          assigneeResults.classList.add("hidden");
        }
      });
    }

    // ===== Banking Type Search =====
    const bankingTypeInput = document.getElementById("banking-type-search");
    const bankingTypeResults = document.getElementById("banking-type-results");
    const bankingTypeHidden = document.getElementById("banking-type-id-field");

    let bankingTypes = <%= raw (@banking_types || []).map { |bt| { id: bt.id, name: bt.name } }.to_json %>;

    if (bankingTypeInput) {
      bankingTypeInput.addEventListener("input", () => {
        const query = bankingTypeInput.value.toLowerCase();
        bankingTypeResults.innerHTML = "";

        if (query.length === 0) {
          bankingTypeResults.classList.add("hidden");
          return;
        }

        const matches = bankingTypes.filter(bt =>
          bt.name.toLowerCase().includes(query)
        );

        if (matches.length > 0) {
          bankingTypeResults.classList.remove("hidden");
          matches.forEach(bt => {
            const li = document.createElement("li");
            li.textContent = bt.name;
            li.className = "px-3 py-2 hover:bg-blue-500 hover:text-white cursor-pointer";
            li.addEventListener("click", () => {
              bankingTypeInput.value = bt.name;
              bankingTypeHidden.value = bt.id;
              bankingTypeResults.classList.add("hidden");
            });
            bankingTypeResults.appendChild(li);
          });
        } else {
          bankingTypeResults.classList.add("hidden");
        }
      });

      // Hide results if clicking outside
      document.addEventListener("click", (e) => {
        if (!bankingTypeResults.contains(e.target) && e.target !== bankingTypeInput) {
          bankingTypeResults.classList.add("hidden");
        }
      });
    }

    // ===== Form Validation =====
    const form = document.querySelector('form');
    if (form) {
      form.addEventListener('submit', function(e) {
        const content = document.getElementById('defect_content');
        const contentError = document.getElementById('defect_content_error');
        
        if (content && content.value.trim() === '') {
          e.preventDefault();
          contentError.classList.remove('hidden');
          content.focus();
        } else {
          contentError.classList.add('hidden');
        }
      });
    }
  });
</script>