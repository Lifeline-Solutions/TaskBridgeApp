<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Saved Report Dashboards</h1>
    <%= link_to 'New Dashboard', new_report_dashboard_path, class: 'bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700' %>
  </div>

  <% if @dashboards.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @dashboards.each do |dashboard| %>
        <div class="bg-white rounded-lg shadow-md border p-6">
          <h3 class="text-lg font-semibold mb-2"><%= dashboard.name %></h3>
          
          <% if dashboard.product %>
            <p class="text-sm text-gray-600 mb-2">Product: <%= dashboard.product.client&.name %> - <%= dashboard.product.groupwares.map(&:name).join(', ') %></p>
          <% end %>
          
          <div class="flex flex-wrap gap-2 mt-4">
            <%= link_to 'View Dashboard', report_dashboard_path(dashboard), class: 'bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700' %>
            <%= link_to 'Apply Filters', apply_report_dashboard_path(dashboard), class: 'bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700' %>
            <%= link_to 'Edit', edit_report_dashboard_path(dashboard), class: 'bg-gray-600 text-white px-3 py-1 rounded text-sm hover:bg-gray-700' %>
            <%= link_to 'Delete', report_dashboard_path(dashboard), method: :delete, data: { confirm: 'Are you sure?' }, class: 'bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700' %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-gray-500 mb-4">No saved dashboards yet.</p>
      <%= link_to 'Create Your First Dashboard', new_report_dashboard_path, class: 'bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700' %>
    </div>
  <% end %>
</div>