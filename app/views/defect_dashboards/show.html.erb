<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <%# Dashboard Header %>
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= @dashboard.name %></h1>
          <% if @dashboard.description.present? %>
            <p class="mt-2 text-gray-600"><%= @dashboard.description %></p>
          <% end %>
        </div>
        
        <div class="flex space-x-3">
          <%= link_to 'Add Widget', new_defect_dashboard_widget_path(@dashboard), 
                class: 'inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
          <%= link_to 'Edit Dashboard', edit_defect_dashboard_path(@dashboard),
                class: 'inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
          <%= link_to 'All Dashboards', defect_dashboards_path,
                class: 'inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50' %>
        </div>
      </div>
    </div>

    <%# Widgets Grid with Turbo Frames for Lazy Loading %>
    <% if @widgets.any? %>
      <div class="grid grid-cols-<%= @dashboard.columns %> gap-6">
        <% @widgets.each do |widget| %>
          <%= turbo_frame_tag dom_id(widget), 
                src: defect_dashboard_widget_path(@dashboard, widget),
                loading: :lazy,
                class: "col-span-#{widget.width} row-span-#{widget.height}" do %>
            
            <%# Loading Skeleton (shown while Turbo Frame is loading) %>
            <div class="bg-white rounded-lg shadow-sm p-6 animate-pulse">
              <div class="flex items-center justify-between mb-4">
                <div class="h-6 bg-gray-200 rounded w-1/2"></div>
                <div class="h-6 w-6 bg-gray-200 rounded"></div>
              </div>
              
              <div class="space-y-3">
                <div class="h-4 bg-gray-100 rounded"></div>
                <div class="h-4 bg-gray-100 rounded w-5/6"></div>
                <div class="h-4 bg-gray-100 rounded w-4/6"></div>
              </div>
              
              <div class="mt-6 h-64 bg-gray-100 rounded"></div>
            </div>
            
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%# Empty State %>
      <div class="text-center py-12 bg-white rounded-lg shadow-sm">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No widgets</h3>
        <p class="mt-1 text-sm text-gray-500">Get started by creating a new widget.</p>
        <div class="mt-6">
          <%= link_to 'Add Widget', new_defect_dashboard_widget_path(@dashboard),
                class: 'inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
        </div>
      </div>
    <% end %>
  </div>
</div>
