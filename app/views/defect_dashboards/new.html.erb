<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-lg shadow px-6 py-8">
      <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Create New Dashboard</h1>
        <p class="mt-2 text-sm text-gray-600">Organize your defects with a customizable dashboard</p>
      </div>

      <%= form_with model: @dashboard, url: defect_dashboards_path, class: "space-y-6" do |f| %>
        <%# Dashboard Name %>
        <div>
          <%= f.label :name, "Dashboard Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :name, 
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
                placeholder: "My Awesome Dashboard",
                required: true %>
          <% if @dashboard.errors[:name].any? %>
            <p class="mt-2 text-sm text-red-600"><%= @dashboard.errors[:name].first %></p>
          <% end %>
        </div>

        <%# Description %>
        <div>
          <%= f.label :description, "Description (optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :description,
                rows: 3,
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
                placeholder: "A brief description of what this dashboard shows..." %>
        </div>

        <%# Columns %>
        <div>
          <%= f.label :columns, "Number of Columns", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :columns, 
                options_for_select([[1, 1], [2, 2], [3, 3], [4, 4]], @dashboard.columns),
                {},
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          <p class="mt-2 text-sm text-gray-500">Choose how many columns your dashboard should have</p>
        </div>

        <%# Is Default %>
        <div class="flex items-start">
          <div class="flex items-center h-5">
            <%= f.check_box :is_default,
                  class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
          </div>
          <div class="ml-3">
            <%= f.label :is_default, "Set as default dashboard", class: "text-sm font-medium text-gray-700" %>
            <p class="text-sm text-gray-500">This dashboard will be shown by default when you visit dashboards</p>
          </div>
        </div>

        <%# Form Actions %>
        <div class="flex items-center justify-end space-x-3 pt-6 border-t border-gray-200">
          <%= link_to 'Cancel', defect_dashboards_path,
                class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          
          <%= f.submit "Create Dashboard",
                class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
