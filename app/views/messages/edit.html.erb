<div class="max-w-4xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Edit Message</h1>

  <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6">
    <%= form_with(model: [@task, @message], local: true) do |f| %>
      
      <!-- Message Type Selector -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Message Type</label>
        <div class="flex gap-4">
          <label class="flex items-center cursor-pointer">
            <%= f.radio_button :message_type, 'external', 
                              checked: (@message.message_type == 'external'),
                              class: "mr-2" %>
            <span class="text-sm flex items-center">
              <svg class="w-4 h-4 mr-1 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
              </svg>
              Public Comment
            </span>
          </label>
          
          <label class="flex items-center cursor-pointer">
            <%= f.radio_button :message_type, 'internal', 
                              checked: (@message.message_type == 'internal'),
                              class: "mr-2" %>
            <span class="text-sm flex items-center">
              <svg class="w-4 h-4 mr-1 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
              </svg>
              Internal Note
            </span>
          </label>
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Internal notes are only visible to team members</p>
      </div>

      <!-- Content -->
      <div class="mb-4">
        <%= f.label :content, "Content", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
        <%= f.rich_text_area :content,
            class: "w-full min-h-[400px] rounded border border-gray-300 dark:border-gray-600 p-2 focus:ring-2 focus:ring-blue-500",
            required: true %>
      </div>

      <%= render 'messages/tag-user' %>

      <div class="flex space-x-3 mt-6">
        <%= f.submit "Update Message",
            class: "px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg" %>
        <%= link_to "Cancel",
            product_task_path(@task.product, @task),
            class: "px-5 py-2.5 bg-gray-300 hover:bg-gray-400 text-gray-800 font-medium rounded-lg" %>
      </div>
    <% end %>
  </div>
</div>
