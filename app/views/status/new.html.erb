<% provide(:title, "New Status") %>

<div class="max-w-md mx-auto mt-10 bg-white dark:bg-gray-800 shadow-lg rounded-lg p-8">
  <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-white text-center">Create New Status</h2>
  <%= form_with model: @status, url: status_index_url, method: :post, data: { turbo: false }, local: true do |f| %>
    <div class="mb-6">
      <%= f.label :name, 'Name*', class: "block mb-2 text-sm font-semibold text-gray-700 dark:text-gray-200" %>
      <%= f.text_field :name, class: "border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-3 bg-gray-50 dark:bg-gray-700 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: 'Enter status name', required: true, autofocus: true %>
    </div>
    <div class="flex justify-end">
      <%= f.submit 'Create Status', class: 'bg-[#3F8CFF] hover:bg-[#3A81EB] px-6 py-2 rounded-lg font-bold text-slate-100 transition-colors duration-200' %>
    </div>
  <% end %>
</div>
