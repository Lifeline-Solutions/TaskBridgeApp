<div class="bg-white shadow rounded-lg p-4 mb-4">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <!-- Left: Actions -->
    <div class="flex flex-col sm:flex-row gap-2 items-stretch sm:items-center w-full sm:w-auto">
      <% if can? :create, @status %>
        <% if current_user.has_role? :admin  %>
          <div class="flex flex-row gap-2 w-full sm:w-auto">
            <%= button_to root_path, method: :get, class: 'flex items-center gap-2 bg-white border border-[#0052CC] hover:bg-[#E3F2FD] px-4 py-2 rounded-lg font-semibold text-[#0052CC] shadow-sm transition w-full sm:w-auto whitespace-normal break-words' do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              <span class="whitespace-normal break-words">Back</span>
            <% end %>
            <%= button_to new_status_path, method: :get, class: 'flex items-center gap-2 bg-[#0052CC] hover:bg-[#0747A6] px-4 py-2 rounded-lg font-semibold text-white shadow-lg transition w-full sm:w-auto whitespace-normal break-words' do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <span class="whitespace-normal break-words">Add Status</span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
    <!-- Right: Search -->
    <div class="flex flex-col sm:flex-row gap-2 items-stretch sm:items-center w-full sm:w-auto">
      <%= form_with url: status_index_path, method: :get, class: 'w-full sm:w-auto' do |f| %>
        <div class="flex flex-col sm:flex-row w-full sm:w-auto">
          <%= f.text_field :query, placeholder: "Search statuses...", class: "w-full sm:w-48 px-2 py-1 border border-[#0052CC] rounded focus:outline-none focus:ring-2 focus:ring-[#0052CC] transition mb-2 sm:mb-0 sm:mr-2" %>
          <div class="flex flex-row gap-2 w-full sm:w-auto">
            <%= f.submit "Search", class: 'bg-[#0052CC] hover:bg-[#0747A6] px-3 py-2 rounded font-semibold text-white shadow-sm transition w-full sm:w-auto'  %>
            <%= button_to "Clear", status_index_path, method: :get, class: 'bg-gray-100 hover:bg-gray-200 px-3 py-2 rounded font-semibold text-[#0052CC] border border-[#0052CC] shadow-sm transition w-full sm:w-auto', form_class: 'inline' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
