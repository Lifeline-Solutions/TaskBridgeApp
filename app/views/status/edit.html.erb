<% provide(:title, "Edit Status") %>

<div class="max-w-md mx-auto mt-10 bg-white dark:bg-gray-800 shadow-lg rounded-lg p-8">
  <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-white text-center">Edit Status</h2>
  <%= form_with model: @status, url: status_path(@status), method: :patch, local: true do |f| %>
    <div class="mb-6">
      <%= f.label :name, "Name", class: "block mb-2 text-sm font-semibold text-gray-700 dark:text-gray-200" %>
      <%= f.text_field :name, class: "border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-3 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-400", placeholder: 'Enter status name', required: true %>
    </div>
    <div class="flex justify-center">
      <%= f.submit "Update Status", class: "w-full h-12 bg-blue-600 hover:bg-blue-700 transition-colors duration-200 p-3 rounded-lg font-bold text-white shadow" %>
    </div>
  <% end %>
</div>
