    <%= link_to defect_index_path, class: 'no-underline' do %>
      <button class="flex items-center space-x-1 bg-[#3F8CFF] hover:bg-[#3A81EB] px-4 py-2 rounded-lg font-bold text-slate-100">
        &#8656; Back
      </button>
    <% end %>
  </div>
  <!-- Right side - Add New Module button -->
