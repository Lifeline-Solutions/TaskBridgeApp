<% provide(:title, "Modules") %>

<%= render "qamodule_index_topbar" %>

<div class="max-w-5xl mx-auto px-4 py-8">
  <!-- Page Title -->
  <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-100 mb-6">
    All Modules
  </h1>

  <!-- Module Selector -->
  <div class="mb-6 flex space-x-6">
    <div>
      <%= form_with url: qa_modules_path, method: :get, local: false do |f| %>
        <%= f.hidden_field :product_id, value: params[:product_id] %>
        <%= f.label :module_id, "Select Module", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.collection_select :module_id, @qa_modules, :id, :name,
              { include_blank: "Choose a module" },
              { class: "mt-1 block w-64 rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm",
                onchange: "this.form.requestSubmit()" } %>
      <% end %>
    </div>

    <!-- Submodules Panel -->
    <turbo-frame id="submodules_frame">
      <% if @qa_module.present? %>
        <div class="mt-6">
          <h2 class="text-xl font-bold text-gray-800 dark:text-gray-100 mb-4">
            Submodules for <%= @qa_module.name %>
          </h2>

          <% if @child_modules.any? %>
            <ol class="list-decimal pl-5 space-y-2">
              <% @child_modules.each do |sub| %>
                <li><%= sub.name %></li>
              <% end %>
            </ol>

            <!-- Pagination Controls -->
            <div class="flex gap-10 mt-5">
              <div class="pagination">
                <% if @page > 1 %>
                  <%= link_to 'Previous',
                              qa_modules_path(product_id: params[:product_id], module_id: @qa_module.id, page: @page - 1, per_page: @per_page),
                              class: 'mb-4 h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] p-3 rounded font-bold text-slate-100' %>
                <% end %>

                <span>Page <%= @page %> of <%= @total_pages %></span>

                <% if @page < @total_pages %>
                  <%= link_to 'Next',
                              qa_modules_path(product_id: params[:product_id], module_id: @qa_module.id, page: @page + 1, per_page: @per_page),
                              class: 'mb-4 h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] p-3 rounded font-bold text-slate-100' %>
                <% end %>
              </div>
            </div>
          <% else %>
            <p class="text-gray-600 dark:text-gray-300">No submodules found.</p>
          <% end %>
        </div>
      <% end %>
    </turbo-frame>
  </div>

  <!-- Existing Table -->
  <% if @qa_modules.any? %>
    <div class="overflow-x-auto shadow rounded-lg border border-gray-200 dark:border-gray-700">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-800">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
              Module Name
            </th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
          <% @qa_modules.each do |mod| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to mod.name, qa_module_path(mod, product_id: params[:product_id]), class: "text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to "View", qa_module_path(mod, product_id: params[:product_id]),
                            class: "text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 mr-3" %>
                <%= link_to "Edit", edit_qa_module_path(mod, product_id: params[:product_id]),
                            class: "text-yellow-600 dark:text-yellow-400 hover:text-yellow-800 dark:hover:text-yellow-300 mr-3" %>
                <%= link_to "Delete", qa_module_path(mod, product_id: params[:product_id]),
                    method: :delete,
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to archive this module?" },
                    class: "text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-600 dark:text-gray-300">
      No modules found.
    </p>
  <% end %>
</div>