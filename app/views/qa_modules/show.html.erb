<% provide(:title, @qa_module.name) %>
<div class="max-w-5xl mx-auto px-4 py-8">
  <!-- Module Details -->
  <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 mb-8">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-2">
          <% if @qa_module.parent %>
            <span class="text-sm font-normal text-gray-500 dark:text-gray-400 mr-2">
              Submodule of <%= @qa_module.parent.name %>:
            </span>
          <% end %>
          <%= @qa_module.name %>
        </h1>
        
        <% if @qa_module.parent %>
          <div class="mt-2 flex items-center text-sm text-gray-500 dark:text-gray-400">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/>
            </svg>
            <%= link_to "View parent module", qa_module_path(@qa_module.parent, product_id: @product_id), 
                       class: "text-blue-600 dark:text-blue-400 hover:underline" %>
          </div>
        <% end %>
      </div>

      <div class="flex space-x-3">
        <%= link_to 'Back', qa_modules_path(product_id: @product_id), class: "px-3 py-1 bg-gray-500 text-white rounded text-sm hover:bg-gray-600" %>
        <%= link_to "Edit", edit_qa_module_path(@qa_module, product_id: @product_id),
                    class: "px-3 py-1 text-sm bg-yellow-500 hover:bg-yellow-600 text-white rounded" %>
      </div>
    </div>
  </div>

  <!-- Child Modules Section -->
  <% if @child_modules.any? %>
    <div class="mb-6 flex justify-between items-center">
      <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100">
        <%= @qa_module.parent ? "Related Modules" : "Child Modules" %>
      </h2>
      <%= link_to "Add #{@qa_module.parent ? 'Related' : 'Child'} Module", 
                  new_qa_module_path(parent_id: @qa_module.id, product_id: @product_id),
                  class: "px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded text-sm" %>
    </div>

    <div class="overflow-x-auto shadow rounded-lg border border-gray-200 dark:border-gray-700">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-800">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
              Module Name
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
              Type
            </th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
          <% @child_modules.each do |child| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to child.name, qa_module_path(child, product_id: @product_id), 
                            class: "text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-gray-500 dark:text-gray-300">
                <% if child.parent_id == @qa_module.id %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                    Child Module
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                    Related Module
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to "View", qa_module_path(child, product_id: @product_id),
                            class: "text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 mr-3" %>
                <%= link_to "Edit", edit_qa_module_path(child, product_id: @product_id),
                            class: "text-yellow-600 dark:text-yellow-400 hover:text-yellow-800 dark:hover:text-yellow-300 mr-3" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 text-center">
      <% if @qa_module.parent %>
        <svg class="mx-auto h-12 w-12 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <h3 class="mt-2 text-lg font-medium text-gray-900 dark:text-gray-100">This is a submodule</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          Submodule of: <%= link_to @qa_module.parent.name, qa_module_path(@qa_module.parent, product_id: @product_id), 
                                 class: "text-blue-600 dark:text-blue-400 hover:underline" %>
        </p>
        <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
          You can add related modules that share this same parent.
        </p>
      <% else %>
        <svg class="mx-auto h-12 w-12 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
        </svg>
        <h3 class="mt-2 text-lg font-medium text-gray-900 dark:text-gray-100">No child modules yet</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          Get started by creating your first child module.
        </p>
      <% end %>
      <div class="mt-6">
        <%= link_to @qa_module.parent ? "Add Related Module" : "Add Child Module", 
                    new_qa_module_path(parent_id: @qa_module.id, product_id: @product_id),
                    class: "inline-flex items-center px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded text-sm" %>
      </div>
    </div>
  <% end %>
</div>