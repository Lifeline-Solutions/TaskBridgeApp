    <% if selected_metrics.include?('ageing') && defects_age_buckets.any? %>
      <div class="mb-8">
        <h2 class="text-xl font-bold mb-4 p-4 bg-gray-50 border-b">Defects by Ageing</h2>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Age Bucket</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Defect Count</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Percentage</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% total_ageing = defects_age_buckets.values.sum %>
              <% defects_age_buckets.each do |bucket, count| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    <%= bucket %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= count %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= number_to_percentage((count.to_f / total_ageing) * 100, precision: 1) %>
                  </td>
                </tr>
              <% end %>
              <tr class="bg-gray-50 font-semibold">
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">Total</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= total_ageing %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">100%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <% if selected_metrics.empty? || (defects_per_creator.empty? && defects_per_status.empty? && defects_per_severity.empty? && defects_per_assignee.empty? && defects_per_module.empty? && defects_per_submodule.empty? && defects_age_buckets.empty?) %>
      <div class="text-center py-8 text-gray-500">
        <i class="fas fa-table text-4xl mb-4 text-gray-300"></i>
        <p class="text-lg">No data available for the selected metrics and filters.</p>
      </div>
    <% end %>
  </div>
</div>