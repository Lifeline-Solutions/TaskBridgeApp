<div class="container justify-between p-4">
  <%= form_with url: reports_path, method: :get, local: true, id: 'reports-form' do %>
    <div class="flex flex-wrap gap-3 items-center">
      <!-- Saved Filters Dropdown -->
      <div class="flex items-center gap-2">
        <label for="dashboard_id" class="font-semibold">Saved Filters:</label>
        <%= select_tag :dashboard_id,
                      options_for_select([['Select a saved filter...', '']] + 
                        @saved_dashboards.map { |df| [df.name, df.id] }, 
                        params[:dashboard_id]),
                      class: "border rounded p-2 bg-white dark:bg-gray-800 min-w-48",
                      id: "dashboard_id" %>
        
        <!-- View Filter Details Button -->
        <% if params[:dashboard_id].present? %>
          <button type="button" id="viewFilterDetailsBtn" 
                  class="px-3 py-2 bg-blue-100 text-blue-700 rounded hover:bg-blue-200 flex items-center gap-1"
                  title="View filter details">
            <i class="fas fa-eye"></i>
            <span class="hidden sm:inline">View Details</span>
          </button>
          
          <button type="button" id="editFilterBtn" 
                  class="px-3 py-2 bg-green-100 text-green-700 rounded hover:bg-green-200 flex items-center gap-1"
                  title="Edit this filter">
            <i class="fas fa-edit"></i>
            <span class="hidden sm:inline">Edit Filter</span>
          </button>
        <% end %>
      </div>

      <!-- Multiple Project Selection with Checkboxes -->
      <div class="dropdown-group">
        <label class="font-semibold">Select Projects:</label>
        <button type="button" id="productDropdownButton" class="border rounded p-2 ml-2 bg-white dark:bg-gray-800 min-w-48 text-left">
          <% selected_products = Array(params[:product_id]).reject(&:blank?) %>
          <% if selected_products.any? %>
            <%= "#{selected_products.size} project(s) selected" %>
          <% else %>
            Select projects...
          <% end %>
        </button>
        <div id="product-options" class="dropdown-options hidden">
          <% @product_options.each do |name, id| %>
            <label class="block pl-6">
              <%= check_box_tag 'product_id[]', id, Array(params[:product_id]).include?(id.to_s), 
                    class: 'product-checkbox' %>
              <span><%= name %></span>
            </label>
          <% end %>
          <div class="mt-2 p-2 border-t">
            <button type="button" id="applyProductSelection" class="w-full bg-blue-500 text-white py-1 px-2 rounded text-sm">
              Apply Selection
            </button>
          </div>
        </div>
      </div>

      <!-- Metrics Section - Show when projects are selected (even if just product_change) -->
      <% if params[:product_id].present? %>
        <div>
          <label class="font-semibold">Date Range:</label>
          <%= date_field_tag :start_date, params[:start_date], class: "border rounded p-2 ml-2 bg-white dark:bg-gray-800" %>
          <span class="mx-1">to</span>
          <%= date_field_tag :end_date, params[:end_date], class: "border rounded p-2 bg-white dark:bg-gray-800" %>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <span class="font-semibold">Metrics:</span>
          
          <!-- Severity Dropdown -->
          <% if @available_options[:severities] && params[:product_id].present? %>
            <div class="dropdown-group">
              <label class="inline-flex items-center gap-1">
                <%= check_box_tag 'metrics[]', 'severity', @selected_metrics.include?('severity'), 
                    class: 'metric-checkbox', 
                    data: { target: 'severity-options' } %>
                <span>Based on Severity</span>
              </label>
              <div id="severity-options" class="dropdown-options hidden">
                <label class="block pl-6 font-semibold border-b pb-1 mb-1">
                  <%= check_box_tag 'select_all_severities', '1', false, class: 'select-all-checkbox', data: { target: 'severities' } %>
                  <span>Select All</span>
                </label>
                <% @available_options[:severities].each do |severity| %>
                  <label class="block pl-6">
                    <%= check_box_tag 'severities[]', severity, @selected_severities.include?(severity), class: 'severities-checkbox' %>
                    <span><%= severity %></span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Reporter Dropdown -->
          <% if @available_options[:reporters] && params[:product_id].present? %>
            <div class="dropdown-group">
              <label class="inline-flex items-center gap-1">
                <%= check_box_tag 'metrics[]', 'reporter', @selected_metrics.include?('reporter'),
                    class: 'metric-checkbox',
                    data: { target: 'reporter-options' } %>
                <span>Based on Reporter</span>
              </label>
              <div id="reporter-options" class="dropdown-options hidden">
                <label class="block pl-6 font-semibold border-b pb-1 mb-1">
                  <%= check_box_tag 'select_all_reporters', '1', false, class: 'select-all-checkbox', data: { target: 'reporters' } %>
                  <span>Select All</span>
                </label>
                <% @available_options[:reporters].each do |id, name| %>
                  <label class="block pl-6">
                    <%= check_box_tag 'reporters[]', id, @selected_reporters.include?(id.to_s), class: 'reporters-checkbox' %>
                    <span><%= name %></span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Status Dropdown -->
          <% if @available_options[:statuses] && params[:product_id].present? %>
            <div class="dropdown-group">
              <label class="inline-flex items-center gap-1">
                <%= check_box_tag 'metrics[]', 'status', @selected_metrics.include?('status'),
                    class: 'metric-checkbox',
                    data: { target: 'status-options' } %>
                <span>Based on Status</span>
              </label>
              <div id="status-options" class="dropdown-options hidden">
                <label class="block pl-6 font-semibold border-b pb-1 mb-1">
                  <%= check_box_tag 'select_all_statuses', '1', false, class: 'select-all-checkbox', data: { target: 'statuses' } %>
                  <span>Select All</span>
                </label>
                <% @available_options[:statuses].each do |id, name| %>
                  <label class="block pl-6">
                    <%= check_box_tag 'statuses[]', name, @selected_statuses.include?(name), class: 'statuses-checkbox' %>
                    <span><%= name %></span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Assignee Dropdown -->
          <% if @available_options[:assignees] && params[:product_id].present? %>
            <div class="dropdown-group">
              <label class="inline-flex items-center gap-1">
                <%= check_box_tag 'metrics[]', 'assignee', @selected_metrics.include?('assignee'),
                    class: 'metric-checkbox',
                    data: { target: 'assignee-options' } %>
                <span>Based on Assignee</span>
              </label>
              <div id="assignee-options" class="dropdown-options hidden">
                <label class="block pl-6 font-semibold border-b pb-1 mb-1">
                  <%= check_box_tag 'select_all_assignees', '1', false, class: 'select-all-checkbox', data: { target: 'assignees' } %>
                  <span>Select All</span>
                </label>
                <% @available_options[:assignees].each do |id, name| %>
                  <label class="block pl-6">
                    <%= check_box_tag 'assignees[]', id, @selected_assignees.include?(id.to_s), class: 'assignees-checkbox' %>
                    <span><%= name %></span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Modules Dropdown -->
          <% if @available_options[:modules] && params[:product_id].present? %>
            <div class="dropdown-group">
              <label class="inline-flex items-center gap-1">
                <%= check_box_tag 'metrics[]', 'modules', @selected_metrics.include?('modules'),
                    class: 'metric-checkbox',
                    data: { target: 'modules-options' } %>
                <span>Based on Modules</span>
              </label>
              <div id="modules-options" class="dropdown-options hidden">
                <label class="block pl-6 font-semibold border-b pb-1 mb-1">
                  <%= check_box_tag 'select_all_modules', '1', false, class: 'select-all-checkbox', data: { target: 'modules' } %>
                  <span>Select All</span>
                </label>
                <% @available_options[:modules].each do |id, name| %>
                  <label class="block pl-6">
                    <%= check_box_tag 'modules[]', id, @selected_modules.include?(id.to_s), class: 'modules-checkbox' %>
                    <span><%= name %></span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Submodules Dropdown -->
          <% if @available_options[:submodules] && params[:product_id].present? %>
            <div class="dropdown-group">
              <label class="inline-flex items-center gap-1">
                <%= check_box_tag 'metrics[]', 'submodules', @selected_metrics.include?('submodules'),
                    class: 'metric-checkbox',
                    data: { target: 'submodules-options' } %>
                <span>Based on Sub Modules</span>
              </label>
              <div id="submodules-options" class="dropdown-options hidden">
                <label class="block pl-6 font-semibold border-b pb-1 mb-1">
                  <%= check_box_tag 'select_all_submodules', '1', false, class: 'select-all-checkbox', data: { target: 'submodules' } %>
                  <span>Select All</span>
                </label>
                <% @available_options[:submodules].each do |id, name, parent_id| %>
                  <label class="block pl-6">
                    <%= check_box_tag 'submodules[]', id, @selected_submodules.include?(id.to_s), class: 'submodules-checkbox' %>
                    <span><%= name %></span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Ageing Dropdown -->
          <% if @available_options[:ageing_types] && params[:product_id].present? %>
            <div class="dropdown-group">
              <label class="inline-flex items-center gap-1">
                <%= check_box_tag 'metrics[]', 'ageing', @selected_metrics.include?('ageing'),
                    class: 'metric-checkbox',
                    data: { target: 'ageing-options' } %>
                <span>Based on Ageing</span>
              </label>
              <div id="ageing-options" class="dropdown-options hidden">
                <% @available_options[:ageing_types].each do |name, value| %>
                  <label class="block pl-6">
                    <%= radio_button_tag 'ageing_type', value, @selected_ageing_type == value %>
                    <span><%= name %></span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Show Apply button only when projects are selected -->
        <%= submit_tag "Apply", class: "ml-2 px-4 py-2 bg-blue-500 text-white rounded" %>
        <% if params[:commit].present? || params[:dashboard_id].present? || params[:view_type].present? %>
          <%= link_to "Clear", "javascript:void(0);", class: "ml-2 px-4 py-2 bg-gray-500 text-white rounded", onclick: "window.location.href='#{reports_path}';" %>
        <% end %>
      <% end %>
    </div>

    <!-- Hidden field to track if this is a product change (not Apply click) -->
    <%= hidden_field_tag :product_change, value: params[:product_change] %>
    
    <!-- Note: dashboard_id is handled by the select dropdown above, no hidden field needed -->

    <!-- Hidden field for view type -->
    <%= hidden_field_tag :view_type, params[:view_type] || 'graphical' %>
  <% end %>

  <!-- Show reports ONLY when user clicks Apply or loads dashboard or switches view (not for product selection) -->
  <% if (params[:commit].present? || params[:dashboard_id].present? || params[:view_type].present?) && params[:product_id].present? && params[:product_change].blank? %>
    <!-- View Toggle and Action Buttons -->
    <div class="mt-4 border-t pt-4 flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <!-- View Toggle Buttons -->
        <div class="flex bg-gray-200 rounded-lg p-1">
          <button type="button" id="graphicalViewBtn" class="view-toggle-btn px-4 py-2 rounded-lg transition-all duration-200 <%= (params[:view_type] || 'graphical') == 'graphical' ? 'bg-blue-500 text-white' : 'text-gray-600 hover:bg-gray-300' %>">
            <i class="fas fa-chart-pie mr-2"></i>Graphical View
          </button>
          <button type="button" id="tabularViewBtn" class="view-toggle-btn px-4 py-2 rounded-lg transition-all duration-200 <%= params[:view_type] == 'tabular' ? 'bg-blue-500 text-white' : 'text-gray-600 hover:bg-gray-300' %>">
            <i class="fas fa-table mr-2"></i>Tabular View
          </button>
        </div>
      </div>

      <div class="flex items-center space-x-2">
        <button type="button" id="openSaveDashboardModal" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 flex items-center">
          <i class="fas fa-save mr-2"></i>Save as Filter
        </button>

        <%= link_to download_report_reports_path(request.query_parameters), class: "bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 flex items-center" do %>
          <i class="fas fa-download mr-2"></i>Download CSV
        <% end %>
      </div>
    </div>

    <!-- Save Dashboard Modal -->
    <div id="saveDashboardModal" class="hidden fixed inset-0 z-50 flex items-center justify-center" style="background-color: rgba(0, 0, 0, 0.5);">
      <div class="bg-white dark:bg-gray-800 rounded-lg p-6 w-96">
        <h3 class="text-lg font-bold mb-4 dark:text-white">Save Current Report as Filter</h3>
        <%= form_with url: save_report_dashboard_path, method: :post, local: true do |f| %>
          <div class="mb-4">
            <%= label_tag 'defect_filter[name]', 'Filter Name', class: 'block font-medium mb-2 dark:text-gray-300' %>
            <%= text_field_tag 'defect_filter[name]', '', class: 'w-full border-2 border-blue-500 dark:border-blue-400 p-2 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-600 dark:bg-gray-700 dark:text-white', required: true %>
          </div>

          <% if @product_options.any? %>
            <div class="mb-4">
              <%= label_tag 'defect_filter[product_id]', 'Project (Optional)', class: 'block font-medium mb-2 dark:text-gray-300' %>
              <%= select_tag 'defect_filter[product_id]', 
                    options_for_select(@product_options, Array(params[:product_id]).first),
                    include_blank: 'Select project...',
                    class: 'w-full border p-2 rounded dark:bg-gray-700 dark:text-white dark:border-gray-600' %>
            </div>
          <% end %>

          <!-- Store all current report filters -->
          <% 
            # When saving filters, store actual selections or mark as "all"
            # Empty arrays mean "all available" were selected
            filter_data = {
              metrics: params[:metrics] || [],
              severities: @selected_severities.any? ? @selected_severities : @available_options[:severities] || [],
              reporters: @selected_reporters.any? ? @selected_reporters : (@available_options[:reporters]&.map { |id, _| id.to_s } || []),
              statuses: @selected_statuses.any? ? @selected_statuses : (@available_options[:statuses]&.map { |_, name| name } || []),
              assignees: @selected_assignees.any? ? @selected_assignees : (@available_options[:assignees]&.map { |id, _| id.to_s } || []),
              modules: @selected_modules.any? ? @selected_modules : (@available_options[:modules]&.map { |id, _| id.to_s } || []),
              submodules: @selected_submodules.any? ? @selected_submodules : (@available_options[:submodules]&.map { |id, _, _| id.to_s } || []),
              ageing_type: params[:ageing_type],
              start_date: params[:start_date],
              end_date: params[:end_date],
              product_id: params[:product_id],
              view_type: params[:view_type] || 'graphical'
            }
          %>
          <%= hidden_field_tag 'defect_filter[filters]', filter_data.to_json %>

          <div class="flex justify-end gap-2">
            <button type="button" id="cancelSaveDashboard" class="px-4 py-2 border rounded hover:bg-gray-100">Cancel</button>
            <%= submit_tag 'Save Filter', class: 'px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700' %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- View Filter Details Modal -->
    <div id="viewFilterDetailsModal" class="hidden fixed inset-0 z-50 flex items-center justify-center" style="background-color: rgba(0, 0, 0, 0.5);">
      <div class="bg-white dark:bg-gray-800 rounded-lg p-6 w-[600px] max-h-[80vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-bold dark:text-white">Filter Details</h3>
          <button type="button" id="closeFilterDetailsModal" class="text-gray-500 hover:text-gray-700 text-2xl">×</button>
        </div>
        
        <div id="filterDetailsContent" class="space-y-4">
          <!-- Content will be populated by JavaScript -->
        </div>
        
        <div class="flex justify-end gap-2 mt-6">
          <button type="button" id="closeFilterDetailsBtn" class="px-4 py-2 border rounded hover:bg-gray-100 dark:hover:bg-gray-700 dark:text-white">Close</button>
        </div>
      </div>
    </div>
  <% end %>
</div>

<!-- Results Display Logic -->
<% if (params[:commit].present? || params[:dashboard_id].present? || params[:view_type].present?) && params[:product_id].present? && params[:product_change].blank? %>
  <!-- Results Display Area - Only show when NOT a product change -->
  <div id="results-container">
    <% if (params[:view_type] || 'graphical') == 'graphical' %>
      <!-- Graphical View -->
      <%= render partial: "defect_per_user", locals: {
        defects_per_creator: @defects_per_creator,
        defects_per_status: @defects_per_status,
        defects_per_severity: @defects_per_severity,
        defects_per_assignee: @defects_per_assignee,
        defects_per_module: @defects_per_module,
        defects_per_submodule: @defects_per_submodule,
        defects_age_buckets: @defects_age_buckets,
        selected_metrics: @selected_metrics
      } %>
    <% else %>
      <!-- Tabular View -->
      <%= render partial: "tabular_view", locals: {
        defects_per_creator: @defects_per_creator,
        defects_per_status: @defects_per_status,
        defects_per_severity: @defects_per_severity,
        defects_per_assignee: @defects_per_assignee,
        defects_per_module: @defects_per_module,
        defects_per_submodule: @defects_per_submodule,
        defects_age_buckets: @defects_age_buckets,
        selected_metrics: @selected_metrics
      } %>
    <% end %>
  </div>
<% elsif params[:product_id].present? && params[:product_change].present? %>
  <!-- Show metrics configuration message after product selection -->
  <div class="container p-4 text-center text-gray-500">
    Products selected! Please configure your metrics and click <strong>"Apply"</strong> to generate the report.<br>
    <span class="text-sm text-gray-400">
      Note: The dropdowns only display items available for the selected product. 
      For example, if you don't see all statuses, it means only those statuses exist among the current product's defects.
    </span>
  </div>
<% elsif params[:product_id].present? %>
  <!-- Show this when projects are selected but no action taken yet -->
  <div class="container p-4 text-center text-gray-500">
    Projects selected! Please configure your metrics and click <strong>"Apply"</strong> to generate the report.<br>
    <span class="text-sm text-gray-400">
      Note: The dropdowns only display items available for the selected project. 
      For example, if you don't see all statuses, it means only those statuses exist among the current project's defects.
    </span>
  </div>
<% else %>
  <div class="container p-4 text-center text-gray-500">
    Please select a project to view reports. <strong>Selecting the date-range is optional</strong>.
  </div>
<% end %>

<style>
  .dropdown-group {
    position: relative;
    margin-right: 1rem;
  }

  .dropdown-options {
    position: absolute;
    top: 100%;
    left: 0;
    background: white;
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 0.5rem;
    z-index: 1000;
    min-width: 300px;
    max-height: 400px;
    overflow-y: auto;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    margin-top: 4px;
  }

  .dropdown-options.hidden {
    display: none;
  }

  .dropdown-options label {
    padding: 0.25rem 0;
    display: flex;
    align-items: center;
    cursor: pointer;
  }

  .dropdown-options label:hover {
    background-color: #f5f5f5;
  }

  .metric-checkbox, .product-checkbox {
    margin-right: 0.5rem;
  }

  .view-toggle-btn {
    transition: all 0.2s ease-in-out;
  }

  .view-toggle-btn.active {
    background-color: #3b82f6;
    color: white;
  }

  /* Fix for scrolling issues at 100% zoom */
  #results-container {
    overflow-x: auto;
    width: 100%;
  }

  /* Ensure container allows scrolling */
  .container {
    overflow: visible;
  }
</style>

<script>
  document.addEventListener('turbo:load', function() {
    // Initialize dropdowns - keep open if they have selected values
    const dropdownGroups = [
      { id: 'severity-options', checkboxClass: 'severities-checkbox' },
      { id: 'reporter-options', checkboxClass: 'reporters-checkbox' },
      { id: 'status-options', checkboxClass: 'statuses-checkbox' },
      { id: 'assignee-options', checkboxClass: 'assignees-checkbox' },
      { id: 'modules-options', checkboxClass: 'modules-checkbox' },
      { id: 'submodules-options', checkboxClass: 'submodules-checkbox' }
    ];

    dropdownGroups.forEach(group => {
      const dropdown = document.getElementById(group.id);
      if (dropdown) {
        const checkboxes = dropdown.querySelectorAll('.' + group.checkboxClass);
        const hasSelectedValues = Array.from(checkboxes).some(cb => cb.checked);
        
        // Close dropdown by default, but keep open if it has selected values
        if (!hasSelectedValues) {
          dropdown.classList.add('hidden');
        }
      }
    });

    // Product dropdown functionality
    const productDropdownButton = document.getElementById('productDropdownButton');
    const productOptions = document.getElementById('product-options');
    const applyProductSelection = document.getElementById('applyProductSelection');

    if (productDropdownButton && productOptions) {
      productDropdownButton.addEventListener('click', function(e) {
        e.stopPropagation();
        productOptions.classList.toggle('hidden');
        
        // Close all other dropdowns
        document.querySelectorAll('.dropdown-options').forEach(otherDropdown => {
          if (otherDropdown.id !== 'product-options') {
            otherDropdown.classList.add('hidden');
          }
        });
      });

      // Apply product selection - Set product_change flag and submit
      // Keep dashboard_id to maintain saved filter selection
      if (applyProductSelection) {
        applyProductSelection.addEventListener('click', function() {
          document.getElementById('product_change').value = 'true';
          // Don't clear dashboard_id - allow applying saved filter to different products
          document.getElementById('reports-form').submit();
        });
      }
    }

    // Toggle dropdown options when metric checkbox is clicked
    document.querySelectorAll('.metric-checkbox').forEach(checkbox => {
      checkbox.addEventListener('change', function() {
        const targetId = this.dataset.target;
        const target = document.getElementById(targetId);
        if (target) {
          target.classList.toggle('hidden');
          
          // Close all other dropdowns
          document.querySelectorAll('.dropdown-options').forEach(otherDropdown => {
            if (otherDropdown.id !== targetId) {
              otherDropdown.classList.add('hidden');
            }
          });
        }
      });
    });

    // Select All functionality for checkbox groups
    document.querySelectorAll('.select-all-checkbox').forEach(selectAllCheckbox => {
      selectAllCheckbox.addEventListener('change', function() {
        const targetGroup = this.dataset.target;
        const groupCheckboxes = document.querySelectorAll('.' + targetGroup + '-checkbox');
        const isChecked = this.checked;
        
        groupCheckboxes.forEach(checkbox => {
          checkbox.checked = isChecked;
        });
      });
    });

    // Update Select All checkbox state when individual checkboxes change
    function updateSelectAllState(groupName) {
      const groupCheckboxes = document.querySelectorAll('.' + groupName + '-checkbox');
      const selectAllCheckbox = document.querySelector('.select-all-checkbox[data-target="' + groupName + '"]');
      
      if (selectAllCheckbox && groupCheckboxes.length > 0) {
        const allChecked = Array.from(groupCheckboxes).every(cb => cb.checked);
        const someChecked = Array.from(groupCheckboxes).some(cb => cb.checked);
        
        selectAllCheckbox.checked = allChecked;
        selectAllCheckbox.indeterminate = someChecked && !allChecked;
      }
    }

    // Add change listeners to all group checkboxes
    ['severities', 'reporters', 'statuses', 'assignees', 'modules', 'submodules'].forEach(groupName => {
      document.querySelectorAll('.' + groupName + '-checkbox').forEach(checkbox => {
        checkbox.addEventListener('change', function() {
          updateSelectAllState(groupName);
        });
      });
      
      // Initialize select all state on page load
      updateSelectAllState(groupName);
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', function(event) {
      if (!event.target.closest('.dropdown-group')) {
        document.querySelectorAll('.dropdown-options').forEach(dropdown => {
          dropdown.classList.add('hidden');
        });
      }
    });

    // Don't clear dashboard_id when products change - allow using saved filter with different products
    // This allows users to apply the same filter criteria to different projects
    
    // Clear product_change flag when Apply is clicked (final report generation)
    // Keep dashboard_id so the saved filter remains selected in the dropdown
    document.querySelector('input[type="submit"]')?.addEventListener('click', function() {
      document.getElementById('product_change').value = '';
      // Don't clear dashboard_id - keep saved filter active
    });

    // Dashboard selection handling
    const dashboardSelect = document.getElementById('dashboard_id');
    if (dashboardSelect) {
      dashboardSelect.removeAttribute('onchange');
      
      dashboardSelect.addEventListener('change', function() {
        if (this.value) {
          const form = document.getElementById('reports-form');
          const url = new URL(form.action);
          url.search = '';
          url.searchParams.set('dashboard_id', this.value);
          window.location.href = url.toString();
        }
      });
    }

    // View toggle functionality - Preserve all filter data when switching views
    const graphicalViewBtn = document.getElementById('graphicalViewBtn');
    const tabularViewBtn = document.getElementById('tabularViewBtn');
    const viewTypeField = document.getElementById('view_type');

    function preserveFiltersAndSubmit(viewType) {
      const form = document.getElementById('reports-form');
      viewTypeField.value = viewType;
      document.getElementById('product_change').value = '';
      
      // Remove any previously created temporary hidden inputs
      form.querySelectorAll('.temp-preserve-filter').forEach(input => input.remove());
      
      // Find all checked checkboxes in the entire form
      const allCheckboxes = form.querySelectorAll('input[type="checkbox"]:checked');
      
      allCheckboxes.forEach(checkbox => {
        // Check if this checkbox is inside a hidden dropdown
        const parentDropdown = checkbox.closest('.dropdown-options');
        if (parentDropdown && parentDropdown.classList.contains('hidden')) {
          // Create a hidden input to preserve this value
          const hiddenInput = document.createElement('input');
          hiddenInput.type = 'hidden';
          hiddenInput.name = checkbox.name;
          hiddenInput.value = checkbox.value;
          hiddenInput.className = 'temp-preserve-filter';
          form.appendChild(hiddenInput);
        }
      });
      
      // Find all checked radio buttons in hidden dropdowns
      const allRadios = form.querySelectorAll('input[type="radio"]:checked');
      
      allRadios.forEach(radio => {
        // Check if this radio is inside a hidden dropdown
        const parentDropdown = radio.closest('.dropdown-options');
        if (parentDropdown && parentDropdown.classList.contains('hidden')) {
          // Create a hidden input to preserve this value
          const hiddenInput = document.createElement('input');
          hiddenInput.type = 'hidden';
          hiddenInput.name = radio.name;
          hiddenInput.value = radio.value;
          hiddenInput.className = 'temp-preserve-filter';
          form.appendChild(hiddenInput);
        }
      });
      
      // Submit the form
      form.submit();
    }

    if (graphicalViewBtn && tabularViewBtn && viewTypeField) {
      graphicalViewBtn.addEventListener('click', function() {
        preserveFiltersAndSubmit('graphical');
      });

      tabularViewBtn.addEventListener('click', function() {
        preserveFiltersAndSubmit('tabular');
      });
    }

    // Save dashboard modal functionality
    const openBtn = document.getElementById('openSaveDashboardModal');
    const modal = document.getElementById('saveDashboardModal');
    const cancel = document.getElementById('cancelSaveDashboard');

    if (openBtn) {
      openBtn.addEventListener('click', function() {
        modal.classList.remove('hidden');
      });
    }

    if (cancel) {
      cancel.addEventListener('click', function() {
        modal.classList.add('hidden');
      });
    }

    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          modal.classList.add('hidden');
        }
      });
    }

    // View Filter Details Modal functionality
    const viewFilterDetailsBtn = document.getElementById('viewFilterDetailsBtn');
    const viewFilterDetailsModal = document.getElementById('viewFilterDetailsModal');
    const closeFilterDetailsModal = document.getElementById('closeFilterDetailsModal');
    const closeFilterDetailsBtn = document.getElementById('closeFilterDetailsBtn');
    
    if (viewFilterDetailsBtn) {
      viewFilterDetailsBtn.addEventListener('click', function() {
        // Get the selected dashboard
        const selectedDashboardId = document.getElementById('dashboard_id').value;
        if (!selectedDashboardId) return;
        
        // Find the dashboard data from @saved_dashboards
        const savedDashboards = <%= raw @saved_dashboards.to_json(methods: [:sanitized_filters], include: { product: { only: [:id, :name], include: { client: { only: [:name] } } } }) %>;
        const dashboard = savedDashboards.find(d => d.id === selectedDashboardId);
        
        if (!dashboard) return;
        
        // Build the filter details HTML
        let detailsHTML = '<div class="space-y-3">';
        
        // Filter Name
        detailsHTML += `<div class="border-b pb-2"><strong class="text-gray-700 dark:text-gray-300">Filter Name:</strong> <span class="dark:text-white">${dashboard.name}</span></div>`;
        
        // Product/Project
        if (dashboard.product) {
          const clientName = dashboard.product.client?.name || 'No Client';
          detailsHTML += `<div class="border-b pb-2"><strong class="text-gray-700 dark:text-gray-300">Project:</strong> <span class="dark:text-white">${clientName} - ${dashboard.product.name || 'Unknown'}</span></div>`;
        }
        
        // Filter Criteria
        const filters = dashboard.sanitized_filters || {};
        
        if (filters.metrics && filters.metrics.length > 0) {
          detailsHTML += `<div class="border-b pb-2"><strong class="text-gray-700 dark:text-gray-300">Metrics:</strong> <span class="dark:text-white">${filters.metrics.join(', ')}</span></div>`;
        }
        
        if (filters.severities && filters.severities.length > 0) {
          detailsHTML += `<div class="border-b pb-2"><strong class="text-gray-700 dark:text-gray-300">Severities:</strong> <span class="dark:text-white">${filters.severities.join(', ')}</span></div>`;
        }
        
        if (filters.reporters && filters.reporters.length > 0) {
          detailsHTML += `<div class="border-b pb-2"><strong class="text-gray-700 dark:text-gray-300">Reporters:</strong> <span class="dark:text-white">${filters.reporters.length} selected</span></div>`;
        }
        
        if (filters.statuses && filters.statuses.length > 0) {
          detailsHTML += `<div class="border-b pb-2"><strong class="text-gray-700 dark:text-gray-300">Statuses:</strong> <span class="dark:text-white">${filters.statuses.join(', ')}</span></div>`;
        }
        
        if (filters.assignees && filters.assignees.length > 0) {
          detailsHTML += `<div class="border-b pb-2"><strong class="text-gray-700 dark:text-gray-300">Assignees:</strong> <span class="dark:text-white">${filters.assignees.length} selected</span></div>`;
        }
        
        if (filters.modules && filters.modules.length > 0) {
          detailsHTML += `<div class="border-b pb-2"><strong class="text-gray-700 dark:text-gray-300">Modules:</strong> <span class="dark:text-white">${filters.modules.length} selected</span></div>`;
        }
        
        if (filters.submodules && filters.submodules.length > 0) {
          detailsHTML += `<div class="border-b pb-2"><strong class="text-gray-700 dark:text-gray-300">Submodules:</strong> <span class="dark:text-white">${filters.submodules.length} selected</span></div>`;
        }
        
        if (filters.ageing_type) {
          detailsHTML += `<div class="border-b pb-2"><strong class="text-gray-700 dark:text-gray-300">Ageing Type:</strong> <span class="dark:text-white">${filters.ageing_type}</span></div>`;
        }
        
        if (filters.start_date) {
          detailsHTML += `<div class="border-b pb-2"><strong class="text-gray-700 dark:text-gray-300">Start Date:</strong> <span class="dark:text-white">${filters.start_date}</span></div>`;
        }
        
        if (filters.end_date) {
          detailsHTML += `<div class="border-b pb-2"><strong class="text-gray-700 dark:text-gray-300">End Date:</strong> <span class="dark:text-white">${filters.end_date}</span></div>`;
        }
        
        detailsHTML += '</div>';
        
        // Populate the modal
        document.getElementById('filterDetailsContent').innerHTML = detailsHTML;
        
        // Show the modal
        viewFilterDetailsModal.classList.remove('hidden');
      });
    }
    
    if (closeFilterDetailsModal) {
      closeFilterDetailsModal.addEventListener('click', function() {
        viewFilterDetailsModal.classList.add('hidden');
      });
    }
    
    if (closeFilterDetailsBtn) {
      closeFilterDetailsBtn.addEventListener('click', function() {
        viewFilterDetailsModal.classList.add('hidden');
      });
    }
    
    if (viewFilterDetailsModal) {
      viewFilterDetailsModal.addEventListener('click', function(e) {
        if (e.target === viewFilterDetailsModal) {
          viewFilterDetailsModal.classList.add('hidden');
        }
      });
    }

    // Edit Filter button functionality
    const editFilterBtn = document.getElementById('editFilterBtn');
    if (editFilterBtn) {
      editFilterBtn.addEventListener('click', function() {
        // Scroll to the top of the form
        const form = document.getElementById('reports-form');
        if (form) {
          form.scrollIntoView({ behavior: 'smooth', block: 'start' });
          
          // Highlight the form briefly to draw attention
          form.style.transition = 'background-color 0.5s';
          form.style.backgroundColor = '#EFF6FF'; // Light blue
          setTimeout(() => {
            form.style.backgroundColor = '';
          }, 2000);

          // Open dropdowns that have selected values
          const dropdownGroups = [
            { id: 'severity-options', checkboxClass: 'severities-checkbox', metricName: 'severity' },
            { id: 'reporter-options', checkboxClass: 'reporters-checkbox', metricName: 'reporter' },
            { id: 'status-options', checkboxClass: 'statuses-checkbox', metricName: 'status' },
            { id: 'assignee-options', checkboxClass: 'assignees-checkbox', metricName: 'assignee' },
            { id: 'modules-options', checkboxClass: 'modules-checkbox', metricName: 'modules' },
            { id: 'submodules-options', checkboxClass: 'submodules-checkbox', metricName: 'submodules' }
          ];

          dropdownGroups.forEach(group => {
            const dropdown = document.getElementById(group.id);
            const checkboxes = document.querySelectorAll('.' + group.checkboxClass);
            const hasSelectedValues = Array.from(checkboxes).some(cb => cb.checked);
            
            // If this dropdown has selected values, ensure the metric checkbox is checked
            // and show the dropdown
            if (hasSelectedValues && dropdown) {
              const metricCheckbox = document.querySelector(`.metric-checkbox[data-target="${group.id}"]`);
              if (metricCheckbox && !metricCheckbox.checked) {
                metricCheckbox.checked = true;
              }
              dropdown.classList.remove('hidden');
            }
          });
        }
      });
    }
  });
</script>