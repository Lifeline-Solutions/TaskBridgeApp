<div class="overflow-x-auto w-full">
  <div class="bg-[#F4F5F7] p-4 rounded-lg shadow-md">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-[#F4F5F7]">
        <tr>
          <th scope="col" class="px-4 py-3 text-left text-xs font-bold text-[#42526E] uppercase tracking-wider">
            Name of the Module
          </th>
          <th scope="col" class="px-4 py-3 text-left text-xs font-bold text-[#42526E] uppercase tracking-wider">
            Description
          </th>
          <th scope="col" class="px-4 py-3 text-center text-xs font-bold text-[#42526E] uppercase tracking-wider">
            View
          </th>
          <th scope="col" class="px-4 py-3 text-center text-xs font-bold text-[#42526E] uppercase tracking-wider">
            Edit
          </th>
          <th scope="col" class="px-4 py-3 text-center text-xs font-bold text-[#42526E] uppercase tracking-wider">
            Delete
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @scripts.each do |script| %>
          <tr class="hover:bg-[#DEEBFF] transition">
            <td class="px-4 py-3 whitespace-nowrap font-semibold text-[#172B4D]">
              <%= script.name %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-[#5E6C84]">
              <%= script.description %>
            </td>
            <td class="px-4 py-3 text-center">
              <!-- Removed link here -->
            </td>
            <td class="px-4 py-3 text-center">
            </td>
            <td class="px-4 py-3 text-center">
              
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
