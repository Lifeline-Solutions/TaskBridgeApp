<!-- Modal Structure -->

<div id="ticketModal" role="dialog" aria-modal="true" aria-hidden="true" class="fixed inset-y-0 right-0 left-[var(--sidebar-width,250px)] flex items-center justify-center hidden z-50" style="background-color: rgba(0, 0, 0, 0.5);">
  <div class="bg-white dark:bg-gray-800 w-full max-w-7xl p-6 rounded-lg shadow-lg max-h-[calc(100vh-3rem)] overflow-auto">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-2xl font-bold">Ticket Details</h2>
      <button onclick="closeModal()" aria-label="Close ticket details" class="text-base text-gray-500 hover:text-gray-700">&times;</button>
    </div>
    <div class="overflow-auto max-h-[calc(100vh-6rem)]">
      <table id="ticketTable" class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400 mb-2">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
        <tr>
          <th>
            Serial
          </th>
          <th>
            Date of Issue
          </th>
          <th>
            Ticket ID
          </th>
          <th>
            Issue
          </th>
          <th>
            Priority
          </th>
          <th>
            Summary
          </th>
          <th>
            Assigned To
          </th>
          <th>
            STATUS
          </th>
          <th>
            VIEW
          </th>
        </tr>
        </thead>
        <tbody id="ticketDetails" class="max-h-9/10">

        </tbody>
      </table>
    </div>
  </div>
</div>
