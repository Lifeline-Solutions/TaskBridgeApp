          </p>
        </td>
        <td class="p-2">${startDate}</td>
        <td class="p-2">${endDate}</td>
        <td class="p-2 truncate max-w-xs" title="${escapeHtml(task.name || 'N/A')}">${escapeHtml(task.name || 'N/A')}</td>
        <td class="p-2">
          <div>${escapeHtml(task.user_name || 'N/A')}</div>
          ${task.user_team || task.team || task.user_team_name ? `<div class="text-sm text-gray-500">${escapeHtml(task.user_team || task.team || task.user_team_name)}</div>` : ''}
        </td>
        <td class="p-2">
          <p class="${statusClass} text-center font-semibold rounded p-1 border-r-2 border-b-4">
