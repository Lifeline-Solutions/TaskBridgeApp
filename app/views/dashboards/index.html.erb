<% provide(:title, "SLA Report") %>

<div class="mx-auto mb-6 p-6">
  <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 mb-4">
    <div class="relative w-full md:w-80">
      <label for="search" class="sr-only">Search teams</label>
      <input type="text" id="search" class="w-full px-4 py-2 border rounded-md dark:bg-gray-700" placeholder="Search Teams..." autocomplete="new-password" onkeyup="filterDropdown()" onfocus="showDropdown()">
      <div id="dropdown" class="absolute w-full border border-gray-300 rounded-md font-medium placeholder-current focus:outline-none bg-white dark:bg-gray-700 dark:border-gray-50 w-full hidden z-10">
        <% @teams.each do |team| %>
          <div class="dropdown-item px-4 py-2 hover:bg-gray-100 hover:dark:bg-gray-900 cursor-pointer" onclick="selectItem(this)"><%= team.name %></div>
        <% end %>
      </div>
    </div>

    <h1 class="text-2xl md:text-3xl font-bold text-center md:text-left">All Service Desks Tickets</h1>

    <button type="button"
            onclick="refreshStats()"
            class="text-white bg-gradient-to-r from-blue-500 via-blue-600 to-blue-700 hover:bg-gradient-to-br focus:ring-4 focus:outline-none focus:ring-blue-300 dark:focus:ring-blue-800 font-medium rounded-lg text-sm px-5 py-2.5 text-center w-full md:w-auto">
      Refresh
    </button>
  </div>

  <!-- Stats Section -->
  <div class="grid sm:grid-cols-5 md:grid-cols-5 lg:grid-cols-5 gap-6 mb-8 mt-6">
    <div class="col-span-1 sm:col-span-5 md:col-span-5 lg:col-span-5">
      <!-- SLA Breakdown Section -->
      <div class="mt-4 text-sm" id="tickets_from_inception_sla_breakdown">
        <div class="grid grid-cols-4 gap-4 mb-4">
          <!-- Total Open Tickets -->

          <a href="#" class="stat-card-link block" data-type="tickets_from_inception" onclick="fetchTicketDetails('<%= @selected_team %>', 'tickets_from_inception_count'); event.stopPropagation();">
            <%= render 'dashboards/stat_card', title: "Total Open Tickets", value: @stats[:tickets_from_inception] || 0, id: "tickets_from_inception_count", class: 'rounded-lg' %>
          </a>


          <!-- Breached -->
          <a href="#" class="stat-card-link block" data-type="tickets_from_inception_response_breached" onclick="fetchTicketDetails('<%= @selected_team %>', 'tickets_from_inception_response_breached'); event.stopPropagation();">
            <div class="bg-white dark:bg-gray-700 p-4 rounded-lg shadow-md hover:shadow-lg transition-shadow text-center">
              <div class="text-lg font-semibold text-gray-600 dark:text-gray-300 mb-1">Breached</div>
              <div class="text-2xl font-bold text-gray-800 dark:text-white" id="tickets_from_inception_response_breached"><%= @stats[:tickets_from_inception_response_breached] || 0 %></div>
            </div>
          </a>

          <!-- Not Breached -->
          <a href="#" class="stat-card-link block" data-type="tickets_from_inception_response_not_breached" onclick="fetchTicketDetails('<%= @selected_team %>', 'tickets_from_inception_response_not_breached'); event.stopPropagation();">
            <div class="bg-white dark:bg-gray-700 p-4 rounded-lg shadow-md hover:shadow-lg transition-shadow text-center">
              <div class="text-lg font-semibold text-gray-600 dark:text-gray-300 mb-1">Not Breached Yet</div>
              <div class="text-2xl font-bold text-gray-800 dark:text-white" id="tickets_from_inception_response_not_breached"><%= @stats[:tickets_from_inception_response_not_breached] || 0 %></div>
            </div>
          </a>

          <a href="#" class="stat-card-link block" data-type="tickets_from_inception_no_sla" onclick="fetchTicketDetails('<%= @selected_team %>', 'tickets_from_inception_no_sla'); event.stopPropagation();">
            <div class="bg-white dark:bg-gray-700 p-4 rounded-lg shadow-md hover:shadow-lg transition-shadow text-center">
              <div class="text-lg font-semibold text-gray-600 dark:text-gray-300 mb-1">NO SLA</div>
              <div class="text-2xl font-bold text-gray-800 dark:text-white" id="tickets_from_inception_no_sla"><%= @stats[:tickets_from_inception_no_sla] || 0 %></div>
            </div>
          </a>
        </div>

      </div>



      <a href="#" class="stat-card-link" data-type="tickets_from_inception_count" onclick="fetchTicketDetails('<%= @selected_team %>', 'tickets_from_inception_count')">
        <!-- Status Breakdown Section -->
        <div class="mt-4 text-sm" data-type="tickets_from_inception_by_status" id="tickets_from_inception_by_status">
          <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Status Breakdown</h3>
          <% if @stats[:tickets_from_inception_by_status].present? %>
            <%# Desired display order requested by user %>
            <% desired_order = ['Assigned', 'Work in Progress', 'Under Development', 'QA Testing', 'Client Information Pending', 'Reopened', 'On-Hold'] %>
            <% ordered_statuses = desired_order.select { |s| @stats[:tickets_from_inception_by_status].key?(s) } + (@stats[:tickets_from_inception_by_status].keys - desired_order) %>
            <% ordered_statuses.each do |status| %>
              <div class="text-lg font-bold mb-2">
                <span class="text-lg font-bold mb-2"><%= status %>:</span> <%= @stats[:tickets_from_inception_by_status][status] %>
              </div>
            <% end %>
          <% else %>
            <div class="text-gray-400">No status breakdown available.</div>
          <% end %>
        </div>
      </a>
      <div class="m-3">
        <h1 class="text-2xl md:text-3xl font-bold text-center mt-4">All Project Tasks</h1>
        <%= render partial: 'dashboards/task_order' %>
      </div>
    </div>



    <div class="col-span-1 sm:col-span-5 md:col-span-5 lg:col-span-5">
      <h1 class="text-3xl font-bold text-center">All Stats Within Last 30 Days</h1>
    </div>
    <div class="col-span-1 sm:col-span-5 md:col-span-5 lg:col-span-5">
      <a href="#" class="stat-card-link" data-type="total_tickets_last_30_days" onclick="fetchTicketDetails('<%= @selected_team %>', 'total_tickets_last_30_days')">
        <%= render 'dashboards/stat_card', title: "Total Tickets Last 30 days", value: @stats[:total_tickets_last_30_days], id: "total_tickets_last_30_days"%>
      </a>
    </div>
    <div class="col-span-1 sm:col-span-2 md:col-span-2 lg:col-span-2">
      <!-- initial Breach -->
      <a href="#" class="stat-card-link" data-type="initial_response_time_breached" onclick="fetchTicketDetails('<%= @selected_team %>', 'initial_response_time_breached')">
        <%= render 'dashboards/stat_card', title: "Initial Response Time - Breached", value: @stats[:breached_tickets_last_30_days], id: "initial_response_time_breached", class: 'col-span-1' %>
      </a>
    </div>
    <div class="col-span-1 sm:col-span-2 md:col-span-2 lg:col-span-2">
      <!-- initial Not Breach -->
      <a href="#" class="stat-card-link" data-type="initial_response_time_not_breached" onclick="fetchTicketDetails('<%= @selected_team %>', 'initial_response_time_not_breached')">
        <%= render 'dashboards/stat_card', title: "Initial Response Time - Not Breached", value: @stats[:not_breached_tickets_last_30_days], id: "initial_response_time_not_breached", class: 'col-span-1'  %>
      </a>
    </div>
    <a href="#" class="stat-card-link" data-type="no_sla_population" onclick="fetchTicketDetails('<%= @selected_team %>', 'no_sla_population')">
      <%= render 'dashboards/stat_card', title: "No SLA-(NEW FEATURE)", value: @stats[:no_sla_tickets_last_30_days], id: "no_sla_population", class: 'col-span-1'  %>
    </a>
    <!-- target repair time breach -->
    <div class="col-span-1 sm:col-span-5 md:col-span-5 lg:col-span-5">
      <div class="grid sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-2 gap-6">
        <div>
          <div class="col-span-1 sm:col-span-2 md:col-span-2 lg:col-span-2">
            <a href="#" class="stat-card-link" data-type="target_repair_time_breached" onclick="fetchTicketDetails('<%= @selected_team %>', 'target_repair_time_breached')">
              <%= render 'dashboards/stat_card', title: "Target Repair Time - Breached", value: @stats[:response_breached_tickets_last_30_days], id: "target_repair_time_breached", class: 'col-span-1'  %>
            </a>
            <div class="grid sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-2">
              <a href="#" class="stat-card-link" data-type="target_repair_time_breached_open" onclick="fetchTicketDetails('<%= @selected_team %>', 'target_repair_time_breached_open')">
                <%= render 'dashboards/stat_card', title: "(Open)", value: @stats[:response_breached_tickets_open_last_30_days], id: "target_repair_time_breached_open", class: 'col-span-1'  %>
              </a>
              <a href="#" class="stat-card-link" data-type="target_repair_time_breached_closed" onclick="fetchTicketDetails('<%= @selected_team %>', 'target_repair_time_breached_closed')">
                <%= render 'dashboards/stat_card', title: "(Closed)", value: @stats[:response_breached_tickets_closed_last_30_days], id: "target_repair_time_breached_closed", class: 'col-span-1'  %>
              </a>
            </div>
          </div>
        </div>
        <div>
          <div class="col-span-1 sm:col-span-2 md:col-span-2 lg:col-span-2">
            <a href="#" class="stat-card-link" data-type="target_resolution_time_breached" onclick="fetchTicketDetails('<%= @selected_team %>', 'target_resolution_time_breached')">
              <%= render 'dashboards/stat_card', title: "Target Resolution Time - Breached", value: @stats[:resolution_breached_tickets_last_30_days], id: "target_resolution_time_breached", class: 'col-span-1'  %>
            </a>
            <div class="grid sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-2">
              <a href="#" class="stat-card-link" data-type="target_resolution_time_breached_open" onclick="fetchTicketDetails('<%= @selected_team %>', 'target_resolution_time_breached_open')">
                <%= render 'dashboards/stat_card', title: "(Open)", value: @stats[:resolution_breached_tickets_last_30_days], id: "target_resolution_time_breached_open", class: 'col-span-1'  %>
              </a>
              <a href="#" class="stat-card-link" data-type="target_resolution_time_breached_closed" onclick="fetchTicketDetails('<%= @selected_team %>', 'target_resolution_time_breached_open')">
                <%= render 'dashboards/stat_card', title: "(Closed)", value: @stats[:resolution_breached_tickets_last_30_days], id: "target_resolution_time_breached_closed", class: 'col-span-1'  %>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-span-1 sm:col-span-5 md:col-span-5 lg:col-span-5">
      <div class="grid sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-2 gap-6">
        <a href="#" class="stat-card-link" data-type="target_repair_time_not_breached" onclick="fetchTicketDetails('<%= @selected_team %>', 'target_repair_time_not_breached')">
          <%= render 'dashboards/stat_card', title: "Target Repair Time - Not Breached", value: @stats[:not_response_breached_tickets_last_30_days], id: "target_repair_time_not_breached", class: 'col-span-1'  %>
        </a>
        <a href="#" class="stat-card-link" data-type="target_resolution_time_not_breached" onclick="fetchTicketDetails('<%= @selected_team %>', 'target_resolution_time_not_breached')">
          <%= render 'dashboards/stat_card', title: "Target Resolution Time - Not Breached", value: @stats[:not_resolution_breached_tickets_last_30_days], id: "target_resolution_time_not_breached", class: 'col-span-1'  %>
        </a>
      </div>
    </div>
    <!-- target repair time not breach -->
  </div>
  <!-- Charts Section -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-white dark:bg-gray-700 p-4 shadow-md rounded-lg">
      <h2 class="text-lg font-semibold mb-3 text-center">Target Repair Time (Breached vs Not Breached)</h2>
      <div id="responseTimeChart">
        <%= pie_chart [["Breached", @stats[:response_breached_tickets_last_30_days]], ["Not Breached", @stats[:not_response_breached_tickets_last_30_days]]], colors: %w[#ff0000 #0000ff] %>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-700 p-4 shadow-md rounded-lg">
      <h2 class="text-lg font-semibold mb-3 text-center">Target Resolution Time (Breached vs Not Breached)</h2>
      <div id="resolutionTimeChart">
        <%= pie_chart [["Breached", @stats[:resolution_breached_tickets_last_30_days]], ["Not Breached", @stats[:not_resolution_breached_tickets_last_30_days]]], colors: %w[#ff0000 #0000ff]%>
      </div>
    </div>
  </div>

  <!-- Charts Section -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
    <div class="bg-white dark:bg-gray-700 p-4 shadow-md rounded-lg">
      <h2 class="text-lg font-semibold mb-3 text-center">Target Repair Time Breached (Closed vs Open)</h2>
      <div id="responseOpenClosedTimeChart">
        <%= pie_chart [["Closed", @stats[:response_breached_tickets_closed_last_30_days]], ["Open", @stats[:response_breached_tickets_open_last_30_days]]], colors: %w[#ff0000 #0000ff] %>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-700 p-4 shadow-md rounded-lg">
      <h2 class="text-lg font-semibold mb-3 text-center">Target Resolution Time Breached (Closed vs Open)</h2>
      <div id="resolutionOpenClosedTimeChart">
        <%= pie_chart [["Closed", @stats[:resolution_breached_tickets_last_30_days]], ["Open", @stats[:not_resolution_breached_tickets_last_30_days]]], colors: %w[#ff0000 #0000ff]%>
      </div>
    </div>
  </div>

  <!-- Charts Section -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
    <div class="bg-white dark:bg-gray-700 p-4 shadow-md rounded-lg">
      <h2 class="text-lg font-semibold mb-3 text-center">Target Repair Time Assignees (Breached)</h2>
      <div id="breachedTicketsAssigneeChart">
        <% if @stats[:breached_tickets_per_assignee] %>
          <%= pie_chart @stats[:breached_tickets_per_assignee].map { |name, count| ["#{name} (#{count})", count] }, legend: "right" %>
        <% else %>
          <p>No data available</p>
        <% end %>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-700 p-4 shadow-md rounded-lg">
      <h2 class="text-lg font-semibold mb-3 text-center">Target Repair Time Clients (Breached)</h2>
      <div id="resolutionTimeChartAssignee">
        <% if @stats[:breached_resolution_tickets_per_project] %>
          <%= pie_chart @stats[:breached_resolution_tickets_per_project].map { |name, count| ["#{name} (#{count})", count] }, legend: "right" %>
        <% else %>
          <p>No data available</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Charts Section -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
    <div class="bg-white dark:bg-gray-700 p-4 shadow-md rounded-lg">
      <h2 class="text-lg font-semibold mb-3 text-center">Target Resolution Time Assignees (Breached)</h2>
      <div id="breachedResolvedTicketsAssigneeChart">
        <% if @stats[:breached_tickets_resolved_per_assignee] %>
          <%= pie_chart @stats[:breached_tickets_resolved_per_assignee].map { |name, count| ["#{name} (#{count})", count] }, legend: "right" %>
        <% else %>
          <p>No data available</p>
        <% end %>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-700 p-4 shadow-md rounded-lg">
      <h2 class="text-lg font-semibold mb-3 text-center">Target Resolution Time Clients (Breached)</h2>
      <div id="resolutionResolvedTimeChartAssignee">
        <% if @stats[:breached_resolution_resolved_tickets_per_project] %>
          <%= pie_chart @stats[:breached_resolution_resolved_tickets_per_project].map { |name, count| ["#{name} (#{count})", count] }, legend: "right" %>
        <% else %>
          <p>No data available</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= render partial: 'dashboards/sla_modal' %>


<script>
  // State
  let selectedTeam = null;

  // Dropdown helpers
  function showDropdown() {
    document.getElementById("dropdown").classList.remove("hidden");
  }

  function hideDropdown(event) {
    if (!event.target.closest(".relative")) {
      document.getElementById("dropdown").classList.add("hidden");
    }
  }

  function filterDropdown() {
    const input = document.getElementById("search").value.toLowerCase();
    const dropdown = document.getElementById("dropdown");
    const items = dropdown.getElementsByClassName("dropdown-item");
    dropdown.classList.remove("hidden");

    for (let item of items) {
      const text = item.textContent || item.innerText;
      item.style.display = text.toLowerCase().includes(input) ? "block" : "none";
    }
  }

  function selectItem(element) {
    const teamName = element.textContent.trim();
    document.getElementById("search").value = teamName;
    selectedTeam = teamName;

    document.querySelectorAll(".dropdown-item").forEach((item) => {
      item.classList.remove("selected");
    });

    element.classList.add("selected");
    document.getElementById("dropdown").classList.add("hidden");

    fetchStats(teamName);
  }

  function refreshStats() {
    if (selectedTeam) {
      fetchStats(selectedTeam);
    } else {
      alert("Please select a team first.");
    }
  }

  // Main stats fetcher
  function fetchStats(teamName) {
    fetch(`/dashboards/fetch_stats?team_name=${encodeURIComponent(teamName)}`)
      .then((response) => response.json())
      .then((data) => {
        // Simple counts
        setTextIfExists("total_tickets_last_30_days", data.total_tickets_last_30_days);
        setTextIfExists("initial_response_time_breached", data.breached_tickets_last_30_days);
        setTextIfExists("initial_response_time_not_breached", data.not_breached_tickets_last_30_days);
        setTextIfExists("target_repair_time_breached", data.response_breached_tickets_last_30_days);
        setTextIfExists("target_repair_time_not_breached", data.not_response_breached_tickets_last_30_days);
        setTextIfExists("target_resolution_time_breached", data.resolution_breached_tickets_last_30_days);
        setTextIfExists("target_resolution_time_not_breached", data.not_resolution_breached_tickets_last_30_days);
        setTextIfExists("target_repair_time_breached_open", data.response_breached_tickets_open_last_30_days);
        setTextIfExists("target_repair_time_breached_closed", data.response_breached_tickets_closed_last_30_days);
        setTextIfExists("target_resolution_time_breached_open", data.resolution_breached_open_last_30_days);
        setTextIfExists("target_resolution_time_breached_closed", data.resolution_breached_closed_last_30_days);
        setTextIfExists("no_sla_population", data.no_sla_tickets_last_30_days);

        // Update SLA breakdown for tickets from inception
        setTextIfExists("tickets_from_inception_no_sla", data.tickets_from_inception_no_sla);
        setTextIfExists("tickets_from_inception_response_breached", data.tickets_from_inception_response_breached);
        setTextIfExists("tickets_from_inception_response_not_breached", data.tickets_from_inception_response_not_breached);

        // NOTE: Depending on your stat_card partial, this might target a container.
        // If this overwrites the whole card, consider targeting a nested element instead.
        setTextIfExists("tickets_from_inception_count", data.tickets_from_inception_count);
        setTextIfExists("tasks_from_inception_count", data.tasks_from_inception_count);

        // Render status-by-status counts with ONLY the numeric counts clickable
        const container = document.getElementById("tickets_from_inception_by_status");
        if (!container) return;

        container.innerHTML = "";
        const statusData = data.tickets_from_inception_by_status;

        if (statusData && Object.keys(statusData).length > 0) {
          // enforce the same desired order on the client
          const desiredOrder = ['Assigned', 'Work in Progress', 'Under Development', 'QA Testing', 'Client Information Pending', 'Reopened', 'On-Hold'];
          const allStatuses = Object.keys(statusData);
          const orderedStatuses = desiredOrder.filter(s => allStatuses.includes(s)).concat(allStatuses.filter(s => !desiredOrder.includes(s)));
          const statuses = orderedStatuses;
          const counts = statuses.map(s => statusData[s]);

          // Build a table where only the COUNT is a button
          container.innerHTML = `
          <table class="min-w-full border-separate border-spacing-2 text-center bg-white dark:bg-gray-700 rounded-lg">
            <thead>
              <tr>
                ${statuses
            .map(
              (status) => `
                  <th class="px-2 py-1 border border-gray-300 font-bold text-md rounded-t-lg bg-gray-100 dark:bg-gray-800">
                    ${escapeHtml(status)}
                  </th>
                `
            )
            .join("")}
              </tr>
            </thead>
            <tbody>
              <tr>
                ${counts
            .map(
              (count, idx) => `
                  <td class="px-2 py-3 border border-blue-400 font-bold text-xl rounded-b-lg">
                    <button
                      type="button"
                      class="status-count inline-flex items-center justify-center w-full cursor-pointer hover:bg-blue-100 dark:hover:bg-blue-900 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-blue-400"
                      data-status="${escapeAttr(statuses[idx])}"
                      title="Show tickets with status: ${escapeAttr(statuses[idx])}"
                    >
                      ${escapeHtml(String(count))}
                    </button>
                  </td>
                `
            )
            .join("")}
              </tr>
            </tbody>
          </table>
        `;

          // Attach click listeners to ONLY the count buttons
          container.querySelectorAll(".status-count").forEach((btn) => {
            btn.addEventListener("click", (e) => {
              e.preventDefault();
              e.stopPropagation();
              const selectedStatus = e.currentTarget.dataset.status;
              // Only show tickets of the selected status
              fetchTicketDetails(selectedTeam || teamName, "tickets_from_inception_by_status", selectedStatus);
            });
          });
        } else {
          container.innerHTML = `<div class="text-gray-400">No status breakdown available.</div>`;
        }

        // Render status-by-status counts for tasks with ONLY the numeric counts clickable
        const tasksContainer = document.getElementById("tasks_from_inception_by_status");
        if (tasksContainer) {
          tasksContainer.innerHTML = "";
          const tasksStatusData = data.tasks_from_inception_by_status;

          if (tasksStatusData && Object.keys(tasksStatusData).length > 0) {
            // enforce the same desired order on the client for tasks
            const desiredOrder = ['Assigned', 'In Progress', 'Under Development', 'QA Testing', 'Client Information Pending', 'Support Testing', 'Reopened', 'On-Hold'];
            const allTaskStatuses = Object.keys(tasksStatusData);
            const orderedTaskStatuses = desiredOrder.filter(s => allTaskStatuses.includes(s)).concat(allTaskStatuses.filter(s => !desiredOrder.includes(s)));
            const taskStatuses = orderedTaskStatuses;
            const taskCounts = taskStatuses.map(s => tasksStatusData[s]);

            // Build a table where only the COUNT is a button
            tasksContainer.innerHTML = `
            <table class="min-w-full border-separate border-spacing-2 text-center bg-white dark:bg-gray-700 rounded-lg">
              <thead>
                <tr>
                  ${taskStatuses
              .map(
                (status) => `
                    <th class="px-2 py-1 border border-gray-300 font-bold text-md rounded-t-lg bg-gray-100 dark:bg-gray-800">
                      ${escapeHtml(status)}
                    </th>
                  `
              )
              .join("")}
                </tr>
              </thead>
              <tbody>
                <tr>
                  ${taskCounts
              .map(
                (count, idx) => `
                    <td class="px-2 py-3 border border-blue-400 font-bold text-xl rounded-b-lg">
                      <button
                        type="button"
                        class="task-status-count inline-flex items-center justify-center w-full cursor-pointer hover:bg-blue-100 dark:hover:bg-blue-900 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-blue-400"
                        data-status="${escapeAttr(taskStatuses[idx])}"
                        title="Show tasks with status: ${escapeAttr(taskStatuses[idx])}"
                      >
                        ${escapeHtml(String(count))}
                      </button>
                    </td>
                  `
              )
              .join("")}
                </tr>
              </tbody>
            </table>
          `;

            // Attach click listeners to ONLY the task status count buttons
            tasksContainer.querySelectorAll(".task-status-count").forEach((btn) => {
              btn.addEventListener("click", (e) => {
                e.preventDefault();
                e.stopPropagation();
                const selectedStatus = e.currentTarget.dataset.status;
                // Only show tasks of the selected status
                fetchTicketDetails(selectedTeam || teamName, "tasks_from_inception_by_status", selectedStatus);
              });
            });
          } else {
            tasksContainer.innerHTML = `<div class="text-gray-400">No status breakdown tasks available.</div>`;
          }
        }

        // Charts
        safeRenderPie("responseTimeChart", [
          [`Breached (${data.response_breached_tickets_last_30_days})`, data.response_breached_tickets_last_30_days],
          [`Not Breached (${data.not_response_breached_tickets_last_30_days})`, data.not_response_breached_tickets_last_30_days]
        ], { colors: ["#ff0000", "#36a2eb"] });

        safeRenderPie("responseOpenClosedTimeChart", [
          [`Closed (${data.response_breached_tickets_closed_last_30_days})`, data.response_breached_tickets_closed_last_30_days],
          [`Open (${data.response_breached_tickets_open_last_30_days})`, data.response_breached_tickets_open_last_30_days]
        ], { colors: ["#36a2eb", "#ff0000"] });

        safeRenderPie("resolutionOpenClosedTimeChart", [
          [`Closed (${data.resolution_breached_closed_last_30_days})`, data.resolution_breached_closed_last_30_days],
          [`Open (${data.resolution_breached_open_last_30_days})`, data.resolution_breached_open_last_30_days]
        ], { colors: ["#36a2eb", "#ff0000"] });

        safeRenderPie("resolutionTimeChart", [
          [`Breached (${data.resolution_breached_tickets_last_30_days})`, data.resolution_breached_tickets_last_30_days],
          [`Not Breached (${data.not_resolution_breached_tickets_last_30_days})`, data.not_resolution_breached_tickets_last_30_days]
        ], { colors: ["#ff0000", "#36a2eb"] });

        // Breached per assignee
        if (document.getElementById("breachedTicketsAssigneeChart")) {
          const assigneeData = Object.entries(data.breached_tickets_per_assignee || {})
            .map(([name, count]) => {
              const formattedName = String(name).replace(/[\[\]"]/g, "");
              return [`${formattedName} (${count})`, count];
            })
            .sort((a, b) => b[1] - a[1]);

          new Chartkick.PieChart("breachedTicketsAssigneeChart", assigneeData, { legend: "right" });
        }

        // Breached resolved per assignee
        if (document.getElementById("breachedResolvedTicketsAssigneeChart") && data.breached_tickets_resolved_per_assignee) {
          const assigneeResolvedData = Object.entries(data.breached_tickets_resolved_per_assignee)
            .map(([name, count]) => {
              const formattedName = String(name).replace(/[\[\]"]/g, "");
              return [`${formattedName} (${count})`, count];
            })
            .sort((a, b) => b[1] - a[1]);

          new Chartkick.PieChart("breachedResolvedTicketsAssigneeChart", assigneeResolvedData, { legend: "right" });
        }

        // Resolution breached per project
        if (document.getElementById("resolutionTimeChartAssignee") && data.breached_resolution_tickets_per_project) {
          const resData = Object.entries(data.breached_resolution_tickets_per_project)
            .map(([name, count]) => {
              const formattedName = String(name).replace(/[\[\]"]/g, "");
              return [`${formattedName} (${count} ticket(s))`, count];
            })
            .sort((a, b) => b[1] - a[1]);

          new Chartkick.PieChart("resolutionTimeChartAssignee", resData, { legend: "right" });
        }

        // Resolution resolved per project
        if (document.getElementById("resolutionResolvedTimeChartAssignee") && data.breached_resolution_resolved_tickets_per_project) {
          const resResolvedData = Object.entries(data.breached_resolution_resolved_tickets_per_project)
            .map(([name, count]) => {
              const formattedName = String(name).replace(/[\[\]"]/g, "");
              return [`${formattedName} (${count} ticket(s))`, count];
            })
            .sort((a, b) => b[1] - a[1]);

          new Chartkick.PieChart("resolutionResolvedTimeChartAssignee", resResolvedData, { legend: "right" });
        }
      })
      .catch((error) => console.error("Error fetching stats:", error));
  }

  // Ticket/Task details fetcher
  function fetchTicketDetails(teamName, type, statusFilter = null) {
    const team = teamName || selectedTeam;
    if (!team) {
      alert("Please select a team first.");
      return;
    }

    let url = `/dashboards/tickets?team_name=${encodeURIComponent(team)}&type=${encodeURIComponent(type)}`;
    if ((type === "tickets_from_inception_by_status" || type === "tasks_from_inception_by_status") && statusFilter) {
      url += `&status=${encodeURIComponent(statusFilter)}`;
    }

    fetch(url)
      .then((response) => response.json())
      .then((data) => {
        // Store data globally for CSV export
        currentTicketData = data;

        // Determine if this is a task or ticket request
        const isTaskRequest = type.includes('tasks');

        if (isTaskRequest) {
          renderTaskDetails(data);
        } else {
          renderTicketDetails(data);
        }

        openModal();
      })
      .catch((error) => console.error("Error fetching details:", error));
  }

  function renderTicketDetails(data) {
    // Update modal title
    document.getElementById("modalTitle").textContent = "Ticket Details";

    // Hide task table, show ticket table
    document.getElementById("taskTable").classList.add("hidden");
    document.getElementById("ticketTable").classList.remove("hidden");

    const container = document.getElementById("ticketDetails");
    if (!container) return;

    container.innerHTML = "";

    if (Array.isArray(data) && data.length > 0) {
      // Ensure tickets are displayed with latest (most recent created_at) first
      data.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

      let count = 0;
      data.forEach((ticket) => {
        count++;
        const tr = document.createElement("tr");
        tr.className = "mb-4 p-4 rounded-lg bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600";

        const ticketURL = `/project/${ticket.project_id}/tickets/${ticket.id}`;

        let priorityClass = "bg-blue-500";
        switch (ticket.priority) {
          case "SEVERITY 1":
            priorityClass = "bg-red-900";
            break;
          case "SEVERITY 2":
            priorityClass = "bg-red-600";
            break;
          case "SEVERITY 3":
            priorityClass = "bg-yellow-500";
            break;
        }

        let statusClass = "bg-blue-500 text-white";
        switch (ticket.status_name) {
          case "Resolved":
            statusClass = "bg-green-500 border-green-600 text-white";
            break;
          case "Closed":
            statusClass = "bg-gray-800 border-gray-900 text-white";
            break;
          case "Reopened":
            statusClass = "bg-red-900 border-red-800 text-white";
            break;
          case "New":
            statusClass = "bg-red-500 border-red-600 text-white";
            break;
          case "Under Development":
            statusClass = "bg-yellow-500 border-yellow-600 text-white";
            break;
          case "Work in Progress":
            statusClass = "bg-gray-500 border-gray-600 text-white";
            break;
          case "QA Testing":
            statusClass = "bg-pink-500 border-pink-600 text-white";
            break;
          case "Awaiting Build":
            statusClass = "border-black dark:border-slate-100 text-black";
            break;
          case "Client Information Pending":
            statusClass = "bg-purple-500 border-purple-600 text-white";
            break;
          case "On-Hold":
            statusClass = "bg-yellow-300 border-yellow-400 text-black";
            break;
          case "Assigned":
            statusClass = "bg-blue-800 border-blue-900 text-white";
            break;
          case "Approved":
            statusClass = "bg-green-800 border-green-900 text-white";
            break;
          case "Pending":
            statusClass = "bg-gradient-to-r from-green-800 to-black border-green-900 text-white";
            break;
          case "Declined":
            statusClass = "bg-gray-800 border-gray-900 text-white";
            break;
        }

        tr.innerHTML = `
        <td class="p-2">${count}</td>
        <td class="p-2 text-gray-500">
          ${new Date(ticket.created_at).toLocaleString()}
        </td>
        <td class="p-2">${escapeHtml(ticket.unique_id)}</td>
        <td class="p-2">${escapeHtml(ticket.issue)}</td>
        <td class="p-2">
          <p class="${priorityClass} p-1 text-center text-white font-bold rounded">
            ${escapeHtml(ticket.priority)}
          </p>
        </td>
        <td class="p-2">${escapeHtml(ticket.subject)}</td>
        <td class="p-2">
          <div>${escapeHtml(ticket.user_name)}</div>
          ${ticket.user_team || ticket.team || ticket.user_team_name ? `<div class="text-sm text-gray-500">${escapeHtml(ticket.user_team || ticket.team || ticket.user_team_name)}</div>` : ''}
        </td>
        <td class="p-2">
          <p class="${statusClass} text-center font-semibold rounded p-1 border-r-2 border-b-4">
            ${escapeHtml(ticket.status_name)}
          </p>
        </td>
        <td class="p-2">
          <a href="${ticketURL}" class="text-blue-500 hover:underline">View Ticket</a>
        </td>
      `;
        container.appendChild(tr);
      });
    } else {
      container.innerHTML = "<tr><td class='p-2' colspan='9'>No tickets found.</td></tr>";
    }
  }

