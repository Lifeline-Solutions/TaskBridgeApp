        container.appendChild(tr);
      });
    } else {
      container.innerHTML = "<tr><td class='p-2' colspan='10'>No tasks found.</td></tr>";
    }
  }

  // Modal helpers
  function openModal() {
    const modal = document.getElementById("ticketModal");
    if (modal) modal.classList.remove("hidden");
  }

  function closeModal() {
    const modal = document.getElementById("ticketModal");
    if (modal) modal.classList.add("hidden");
  }

  // Utilities
  function setTextIfExists(id, value) {
    const el = document.getElementById(id);
    if (el != null) el.innerText = value != null ? value : "";
  }

  function safeRenderPie(containerId, series, options = {}) {
    const el = document.getElementById(containerId);
    if (!el || typeof Chartkick === "undefined" || !Chartkick.PieChart) return;
    el.innerHTML = "";
    new Chartkick.PieChart(containerId, series, options);
  }

  function escapeHtml(str) {
    if (str == null) return "";
    return String(str)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function escapeAttr(str) {
    // Attributes are a subset of HTML text, reuse escapeHtml
    return escapeHtml(str);
  }

  // Global click to close dropdown if outside
  document.addEventListener("click", function (event) {
    const searchInput = document.getElementById("search");
    const dropdown = document.getElementById("dropdown");
    if (!searchInput || !dropdown) return;

    if (!searchInput.contains(event.target) && !dropdown.contains(event.target)) {
      dropdown.classList.add("hidden");
    }
  });

  // CSV Download function
  function downloadCSV() {
    if (!currentTicketData || currentTicketData.length === 0) {
      alert("No data available to download.");
      return;
    }

    // Determine if we're viewing tasks or tickets
    const isTaskTable = !document.getElementById("taskTable").classList.contains("hidden");

    let csvContent;
    let headers;
    let rows;

    if (isTaskTable) {
      // Task CSV headers and content
      headers = ["Serial", "Date Created", "Task ID", "Name", "Priority", "Start Date", "End Date", "Description", "Assigned To", "Team", "Status"];
      rows = currentTicketData.map((task, index) => {
        const startDate = task.start_date ? new Date(task.start_date).toLocaleDateString() : 'N/A';
        const endDate = task.end_date ? new Date(task.end_date).toLocaleDateString() : 'N/A';
        return [
          index + 1,
          new Date(task.created_at).toLocaleString(),
          task.unique_task_id || 'N/A',
          task.name || task.title || '',
          task.priority || '',
          startDate,
          endDate,
          task.description || '',
          task.user_name || '',
          task.user_team || task.team || task.user_team_name || '',
          task.status_name || ''
        ];
      });
    } else {
      // Ticket CSV headers and content
      headers = ["Serial", "Date of Issue", "Ticket ID", "Issue", "Priority", "Summary", "Assigned To", "Team", "Status"];
      rows = currentTicketData.map((ticket, index) => {
        return [
          index + 1,
          new Date(ticket.created_at).toLocaleString(),
          ticket.unique_id || "",
          ticket.issue || "",
          ticket.priority || "",
          ticket.subject || "",
          ticket.user_name || "",
          ticket.user_team || ticket.team || ticket.user_team_name || "",
          ticket.status_name || ""
        ];
      });
    }

    // Create CSV content
    csvContent = headers.join(",") + "\n";
    rows.forEach(row => {
      // Escape quotes and wrap fields with commas or quotes in double quotes
      const escapedRow = row.map(field => {
        const stringField = String(field || "");
        if (stringField.includes(",") || stringField.includes('"') || stringField.includes("\n")) {
          return '"' + stringField.replace(/"/g, '""') + '"';
        }
        return stringField;
      });
      csvContent += escapedRow.join(",") + "\n";
    });

    // Create a Blob and download link
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const link = document.createElement("a");
    const url = URL.createObjectURL(blob);

    // Generate filename with timestamp and team name
    const timestamp = new Date().toISOString().split('T')[0];
    const teamName = selectedTeam || "all_teams";
    const dataType = isTaskTable ? "tasks" : "tickets";
    const filename = `${dataType}_${teamName.replace(/\s+/g, '_')}_${timestamp}.csv`;

    link.setAttribute("href", url);
    link.setAttribute("download", filename);
    link.style.visibility = "hidden";
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }

  // Ensure ONLY the counts are clickable within the "Total Open Tickets from Inceptions" stat card
  document.addEventListener("DOMContentLoaded", () => {
    // Prevent the whole stat card from being clickable for the inception card
    document.querySelectorAll(".stat-card-link").forEach((link) => {
      const type = link.dataset.type;
      if (type === "tickets_from_inception_count") {
        // Remove inline onclick if present
        try {
          link.onclick = null;
        } catch (e) {}
        // Prevent default link behavior
        link.addEventListener("click", (e) => {
          e.preventDefault();
          // Do not fetch anything here; counts inside the table handle their own clicks.
        });
        // Optional: visually indicate non-clickable area
        // link.classList.add("cursor-default");
      } else {
        // For other cards, keep existing behavior: click opens their details
        link.addEventListener("click", function (event) {
          event.preventDefault();
          const teamName = selectedTeam;
          const type = this.dataset.type;
          if (!teamName) {
            alert("Please select a team first.");
            return;
          }
          fetchTicketDetails(teamName, type);
        });
      }
    });
  });
</script>
