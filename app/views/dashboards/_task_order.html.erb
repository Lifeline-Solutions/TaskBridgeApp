<div class="col-span-1 sm:col-span-5 md:col-span-5 lg:col-span-5">
  <!-- SLA Breakdown Section -->
  <div class="mt-4 text-sm" id="tasks_sla_breakdown">
    <div class="grid gap-4 mb-4">
      <!-- Total Tasks Opened -->
      <a href="#" class="stat-card-link block" data-type="tasks_from_inception_count" onclick="fetchTicketDetails('<%= @selected_team %>', 'tasks_from_inception_count'); event.stopPropagation();">
        <%= render 'dashboards/stat_card', title: "Total Projects Tasks Opened", value: @stats[:tasks_from_inception_count] || 0, id: "tasks_from_inception_count", class: 'rounded-lg' %>
      </a>
    </div>
  <!-- Status Breakdown Section -->
    <a href="#" class="stat-card-link" data-type="tasks_from_inception_by_status" onclick="fetchTicketDetails('<%= @selected_team %>', 'tasks_from_inception_by_status')">
      <div class="mt-4 text-sm" data-type="tasks_from_inception_by_status" id="tasks_from_inception_by_status">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Tasks Breakdown</h3>
        <!-- Placeholder: This will be populated by JavaScript in fetchStats() -->

        <% if @stats[:tasks_from_inception_by_status].present? %>
          <%# Desired display order requested by user %>
          <% desired_order = ['To Do', 'Work in Progress', 'Under Development', 'QA Testing', 'Client Information Pending', 'Reopened', 'On-Hold'] %>
          <% ordered_statuses = desired_order.select { |s| @stats[:tasks_from_inception_by_status].key?(s) } + (@stats[:tasks_from_inception_by_status].keys - desired_order) %>
          <% ordered_statuses.each do |status| %>
            <div class="text-lg font-bold mb-2">
              <span class="text-lg font-bold mb-2"><%= status %>:</span> <%= @stats[:tasks_from_inception_by_status][status] %>
            </div>
          <% end %>
        <% else %>
          <div class="text-gray-400">No status breakdown available.</div>
        <% end %>
      </div>
    </a>
  </div>
</div>