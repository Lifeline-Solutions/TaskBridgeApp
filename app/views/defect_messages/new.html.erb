<%= turbo_frame_tag "new_defect_message" do %>
  <div class="p-4 border rounded-lg bg-gray-50 dark:bg-gray-900">
    <%= form_with(model: [@defect, @defect_message], local: false) do |f| %>
      <div class="mb-4">
        <%= f.rich_text_area :content, class: "w-full" %>
      </div>
      <div class="flex space-x-2">
        <%= f.submit "Post Message",
                     class: "px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700" %>
        <%= link_to "Cancel",
                    defect_path(@defect),
                    class: "px-4 py-2 bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400",
                    data: { turbo_frame: "_top" } %>
      </div>
    <% end %>
  </div>
<% end %>
