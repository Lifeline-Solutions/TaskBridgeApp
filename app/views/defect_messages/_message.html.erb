<div class="flex items-start space-x-3 w-full" id="<%= dom_id(message) %>">
  <!-- Timeline dot (icon) -->
  <span class="flex items-center justify-center w-8 h-8 bg-blue-100 rounded-full dark:bg-blue-900">
    <svg class="w-4 h-4 text-blue-800 dark:text-blue-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
      <path d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z"/>
    </svg>
  </span>
 
  <!-- Message Card -->
  <div class="flex-1 p-4 rounded-lg border shadow-sm
              <%= message.user == current_user ?
                  'bg-blue-50 border-blue-200 dark:bg-blue-900/30 dark:border-blue-700' :
                  'bg-white border-gray-200 dark:bg-gray-800 dark:border-gray-700' %>">

    <!-- Message Header -->
    <div class="flex items-center justify-between mb-2">
      <div class="flex items-center gap-3">
        <span class="font-medium text-gray-900 dark:text-white">
          <%= message.user.first_name + ' ' + message.user.last_name %>
        </span>
        <span class="text-xs text-gray-500 dark:text-gray-400">
          <%= message.created_at.strftime("%b %d, %Y %I:%M %p") %>
        </span>
      </div>

      <!-- Message Actions: Only show to owner -->
      <% if message.user == current_user %>
        <div class="flex gap-2">
          <%= link_to edit_defect_defect_message_path(message.defect, message),
                      data: { turbo_frame: dom_id(message, :edit) },
                      class: "text-xs px-2.5 py-0.5 rounded bg-blue-200 text-blue-900 hover:bg-blue-300 dark:bg-blue-700 dark:text-blue-100 hover:no-underline" do %>
            Edit
          <% end %>
          <% deleteDefectMesage = true %>
          <% unless deleteDefectMesage %>
          `  <%= link_to 'Delete',
                defect_defect_message_path(message.defect, message),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: 'Are you sure?',
                  turbo_frame: "_top"
                },
                onclick: "setTimeout(function(){ window.location.reload(); }, 500)",
                class: "text-xs px-2.5 py-0.5 rounded bg-red-200 text-red-900 hover:bg-red-300 dark:bg-red-700 dark:text-red-100 hover:no-underline" %>
          <% end %>`
        </div>
      <% end %>
    </div>

    <!-- Message Content -->
    <div class="prose dark:prose-invert max-w-none <%= message.user == current_user ? 'text-blue-900 dark:text-blue-100' : 'text-gray-700 dark:text-gray-300' %>">
      <%= render "defect_messages/content_defect_message", message: message %>
    </div>

    <!-- Comment-Level Attachments (from Jira import via has_many_attached) -->
    <% if message.respond_to?(:attachments) && message.attachments.any? %>
      <div class="mt-4 space-y-4">
        <div class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
          📎 Attachments (<%= message.attachments.count %>)
        </div>
        <% message.attachments.each do |file| %>
          <div class="p-3 border rounded-lg bg-gray-50 dark:bg-gray-700">
            <% if file.content_type&.start_with?('image/') %>
              <!-- Clickable image -->
              <div class="flex items-start justify-between gap-4">
                <div>
                  <%= image_tag file,
                      class: "rounded max-h-64 w-auto cursor-pointer hover:opacity-90 transition",
                      data: {
                        attachment_preview: true,
                        url: url_for(file),
                        type: file.content_type
                      },
                      alt: file.filename.to_s %>
                </div>
                <div class="ml-4 flex-shrink-0 flex flex-col items-end space-y-2">
                  <span class="text-sm text-gray-600 dark:text-gray-300"><%= file.filename.to_s %></span>
                  <span class="text-xs text-gray-500 dark:text-gray-400"><%= number_to_human_size(file.blob.byte_size) %></span>
                  <%= link_to rails_blob_path(file, disposition: "attachment"),
                              download: file.filename.to_s,
                              class: "inline-flex items-center px-3 py-1.5 bg-gray-100 dark:bg-gray-800 text-sm rounded hover:bg-gray-200 dark:hover:bg-gray-700" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v12m0 0l4-4m-4 4-4-4M21 12v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6" />
                    </svg>
                    Download
                  <% end %>
                </div>
              </div>
            <% elsif file.content_type&.start_with?('video/') %>
              <!-- Video player -->
              <div class="flex flex-col space-y-3">
                <video controls class="rounded max-h-64 w-full">
                  <source src="<%= url_for(file) %>" type="<%= file.content_type %>">
                  Your browser does not support the video tag.
                </video>
                <div class="flex justify-between items-center">
                  <div class="text-sm text-gray-700 dark:text-gray-300"><%= file.filename.to_s %></div>
                  <div>
                    <%= link_to rails_blob_path(file, disposition: "attachment"),
                                download: file.filename.to_s,
                                class: "inline-flex items-center px-3 py-1.5 bg-gray-100 dark:bg-gray-800 text-sm rounded hover:bg-gray-200 dark:hover:bg-gray-700" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v12m0 0l4-4m-4 4-4-4M21 12v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6" />
                      </svg>
                      Download
                    <% end %>
                  </div>
                </div>
              </div>
            <% else %>
              <!-- Other files (PDF, text, etc.) -->
              <div class="flex items-center justify-between">
                <div>
                  <%= link_to file.filename.to_s, url_for(file), class: "text-blue-600 dark:text-blue-400 underline", target: "_blank", rel: "noreferrer" %>
                  <div class="text-xs text-gray-500 dark:text-gray-400"><%= number_to_human_size(file.blob.byte_size) %></div>
                </div>
                <div>
                  <%= link_to rails_blob_path(file, disposition: "attachment"),
                              download: file.filename.to_s,
                              class: "inline-flex items-center px-3 py-1.5 bg-gray-100 dark:bg-gray-800 text-sm rounded hover:bg-gray-200 dark:hover:bg-gray-700" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v12m0 0l4-4m-4 4-4-4M21 12v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6" />
                    </svg>
                    Download
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Attachments Preview (images clickable to open inline modal) -->
    <% if message.content.embeds.any? %>
      <div class="mt-4 space-y-4">
        <% message.content.embeds.each do |file| %>
          <div class="p-3 border rounded-lg bg-gray-50 dark:bg-gray-700">
            <% if file.image? %>
              <!-- Clickable image: data attributes used by the preview script -->
              <div class="flex items-start justify-between gap-4">
                <div>
                  <%= image_tag file,
                      class: "rounded max-h-64 w-auto cursor-pointer hover:opacity-90 transition",
                      data: {
                        attachment_preview: true,
                        url: url_for(file),
                        type: file.content_type
                      },
                      alt: file.filename.to_s %>
                </div>

                <!-- Meta + actions on the right (download) -->
                <div class="ml-4 flex-shrink-0 flex flex-col items-end space-y-2">
                  <span class="text-sm text-gray-600 dark:text-gray-300"><%= file.filename.to_s %></span>
                  <span class="text-xs text-gray-500 dark:text-gray-400"><%= number_to_human_size(file.byte_size) %></span>

                  <%= link_to rails_blob_path(file, disposition: "attachment"),
                              download: file.filename.to_s,
                              rel: "noopener noreferrer",
                              class: "inline-flex items-center px-3 py-1.5 bg-gray-100 dark:bg-gray-800 text-sm rounded hover:bg-gray-200 dark:hover:bg-gray-700",
                              title: "Download #{file.filename.to_s}" do %>
                    <!-- download SVG -->
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v12m0 0l4-4m-4 4-4-4M21 12v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6" />
                    </svg>
                    Download
                  <% end %>
                </div>
              </div>

            <% elsif file.video? %>
              <div class="flex flex-col space-y-3">
                <video controls class="rounded max-h-64 w-full">
                  <source src="<%= url_for(file) %>" type="<%= file.content_type %>">
                  Your browser does not support the video tag.
                </video>

                <div class="flex justify-between items-center">
                  <div class="text-sm text-gray-700 dark:text-gray-300"><%= file.filename.to_s %></div>
                  <div>
                    <%= link_to rails_blob_path(file, disposition: "attachment"),
                                download: file.filename.to_s,
                                rel: "noopener noreferrer",
                                class: "inline-flex items-center px-3 py-1.5 bg-gray-100 dark:bg-gray-800 text-sm rounded hover:bg-gray-200 dark:hover:bg-gray-700",
                                title: "Download #{file.filename.to_s}" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v12m0 0l4-4m-4 4-4-4M21 12v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6" />
                      </svg>
                      Download
                    <% end %>
                  </div>
                </div>
              </div>

            <% else %>
              <!-- Non-image/video files (link + download) -->
              <div class="flex items-center justify-between">
                <div>
                  <%= link_to file.filename.to_s, url_for(file), class: "text-blue-600 dark:text-blue-400 underline", target: "_blank", rel: "noreferrer" %>
                  <div class="text-xs text-gray-500 dark:text-gray-400"><%= number_to_human_size(file.byte_size) %></div>
                </div>

                <div>
                  <%= link_to rails_blob_path(file, disposition: "attachment"),
                              download: file.filename.to_s,
                              rel: "noopener noreferrer",
                              class: "inline-flex items-center px-3 py-1.5 bg-gray-100 dark:bg-gray-800 text-sm rounded hover:bg-gray-200 dark:hover:bg-gray-700",
                              title: "Download #{file.filename.to_s}" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v12m0 0l4-4m-4 4-4-4M21 12v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6" />
                    </svg>
                    Download
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

  </div>
</div>

<%= turbo_frame_tag dom_id(message, :edit) %>

<script>
  // ---- Preview modal helper (creates a single modal on first use) ----
  (function() {
    // Create preview modal once
    function ensurePreviewModal() {
      if (document.getElementById('attachmentPreviewModal')) return;

      const modal = document.createElement('div');
      modal.id = 'attachmentPreviewModal';
      modal.className = 'hidden fixed inset-0 z-50 flex items-center justify-center p-4';
      modal.style.backgroundColor = 'rgba(0, 0, 0, 0.75)';
      modal.innerHTML = `
        <div class="relative max-w-[90vw] max-h-[90vh] w-full">
          <button id="attachmentPreviewClose" class="absolute top-2 right-2 z-50 text-white text-2xl leading-none rounded-md px-2 py-1" style="background-color: rgba(0, 0, 0, 0.3);" onmouseover="this.style.backgroundColor='rgba(0, 0, 0, 0.5)'" onmouseout="this.style.backgroundColor='rgba(0, 0, 0, 0.3)'">×</button>
          <div id="attachmentPreviewContent" class="w-full h-full flex items-center justify-center overflow-auto rounded-lg"></div>
        </div>
      `;
      document.body.appendChild(modal);

      // close handlers
      document.getElementById('attachmentPreviewClose').addEventListener('click', closePreview);
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closePreview();
      });
    }

    function closePreview() {
      const modal = document.getElementById('attachmentPreviewModal');
      if (!modal) return;
      const content = document.getElementById('attachmentPreviewContent');
      if (content) content.innerHTML = '';
      modal.classList.add('hidden');
    }

    function safePreviewElement(url, type) {
      const container = document.createElement('div');
      container.className = 'flex items-center justify-center w-full h-full';

      if (type && type.startsWith('image/')) {
        const img = document.createElement('img');
        img.src = url;
        img.alt = '';
        img.className = 'max-h-[85vh] max-w-[85vw] rounded shadow-lg';
        container.appendChild(img);
      } else if (type && type.startsWith('video/')) {
        const video = document.createElement('video');
        video.controls = true;
        video.className = 'max-h-[85vh] max-w-[85vw] rounded shadow-lg';
        const source = document.createElement('source');
        source.src = url;
        source.type = type;
        video.appendChild(source);
        container.appendChild(video);
      } else if (type && type.startsWith('audio/')) {
        const audio = document.createElement('audio');
        audio.controls = true;
        audio.className = 'w-full';
        const source = document.createElement('source');
        source.src = url;
        source.type = type;
        audio.appendChild(source);
        container.appendChild(audio);
      } else if (type === 'application/pdf') {
        const iframe = document.createElement('iframe');
        iframe.src = url;
        iframe.className = 'w-[90vw] h-[90vh] rounded bg-white';
        iframe.setAttribute('sandbox','allow-same-origin allow-scripts allow-popups');
        container.appendChild(iframe);
      } else {
        // Fallback box with download link
        const box = document.createElement('div');
        box.className = 'p-6 bg-white rounded shadow text-center';
        box.innerHTML = `
          <p class="mb-4">Preview not available for this file type.</p>
          <a href="${url}" target="_blank" rel="noreferrer" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Open / Download</a>
        `;
        container.appendChild(box);
      }

      return container;
    }

    function openPreview(url, type) {
      ensurePreviewModal();
      const modal = document.getElementById('attachmentPreviewModal');
      const content = document.getElementById('attachmentPreviewContent');
      if (!modal || !content) return;
      content.innerHTML = '';
      const el = safePreviewElement(url, type || '');
      content.appendChild(el);
      modal.classList.remove('hidden');
    }

    // Delegate click events to any element that has data-attachment-preview="true"
    document.addEventListener('click', function(e) {
      const target = e.target.closest('[data-attachment-preview="true"]');
      if (!target) return;
      e.preventDefault();

      // URL priority: data-url, src, href
      const url = target.dataset.url || target.src || target.href;
      const type = target.dataset.type || target.getAttribute('data-type') || '';

      if (!url) return;
      openPreview(url, type);
    });

    // Expose for debug if needed (not necessary)
    window._defectMessagePreview = { openPreview, closePreview };

  })();
</script>

<script>
  // keep your existing turbo submit-end reload behaviour intact
  document.addEventListener("turbo:submit-end", function(e) {
    if (e.detail.success) {
      window.location.reload();
    }
  });
</script>