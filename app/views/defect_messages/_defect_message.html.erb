<!-- Messages Section -->
<div id="defect-messages" class="mt-8 w-full">
  <h2 class="text-xl font-semibold mb-4">Comments</h2>

  <!-- DRAFT NOTIFICATION - Add this here -->
  <div data-controller="draft-notification" 
       data-draft-notification-defect-id-value="<%= @defect.id %>"
       data-draft-notification-check-url-value="<%= check_defect_draft_defect_messages_path(@defect) %>">
    
    <div id="draft-notification" class="hidden p-4 mb-4 bg-yellow-50 border border-yellow-200 rounded-lg">
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <svg class="w-5 h-5 text-yellow-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          <span class="text-yellow-800 font-medium">You have an unsaved message draft</span>
        </div>
        <div class="flex gap-2">
          <%= link_to "Continue Editing", 
                      new_defect_defect_message_path(@defect),
                      class: "px-3 py-1 bg-blue-600 text-white rounded text-sm hover:bg-blue-700",
                      data: { turbo_frame: "new_defect_message" } %>
          
          <button type="button" 
                  data-action="click->draft-notification#discardDraft"
                  class="px-3 py-1 bg-gray-600 text-white rounded text-sm hover:bg-gray-700">
            Discard Draft
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scrollable Messages Container -->
  <div class="space-y-4 w-full max-h-[80vh] overflow-y-auto pr-2">
    <% if @timeline_items.present? %>
      <ul class="space-y-4 w-full">
        <% @timeline_items.each do |item| %>
          <% if item.type == 'message' %>
            <%= render partial: "defect_messages/message", locals: { message: item.record } %>
          <% elsif item.type == 'failure_report' %>
            <%= render partial: "defect_messages/failure_report", locals: { report: item.record } %>
          <% end %>
        <% end %>
      </ul>
    <% else %>
      <div class="text-center py-8 bg-gray-50 dark:bg-gray-800 rounded-lg">
        <svg class="w-12 h-12 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
        </svg>
        <p>No timeline items yet.</p>
      </div>
    <% end %>
  </div>

  <div class="mt-6">
    <%= render "defect_messages/new_button", defect: @defect %>
  </div>
</div>