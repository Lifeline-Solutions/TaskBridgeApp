<!-- app/views/default_defect_assignees/_button.html.erb -->
<div id="default-assignee-button" class="inline-flex items-center gap-3">
  <% if DefaultDefectAssignee.user %>
    <span class="text-sm text-gray-600 dark:text-gray-300">
      Default assignee:
      <strong class="ml-1"><%= DefaultDefectAssignee.user.name %></strong>
    </span>

    <%= link_to 'Change', new_default_defect_assignee_path,
                data: { turbo_frame: 'modal' },
                class: "px-3 py-1 text-sm bg-blue-600 text-white rounded" %>

    <%= link_to 'Clear', default_defect_assignee_path,
                method: :delete,
                data: { turbo_confirm: 'Remove the default assignee?' },
                class: "px-2 py-1 text-sm text-red-600 hover:underline" %>
  <% else %>
    <%= link_to 'Set Default Assignee', new_default_defect_assignee_path,
                data: { turbo_frame: 'modal' },
                class: "px-3 py-1 text-sm bg-blue-600 text-white rounded" %>
  <% end %>
</div>
