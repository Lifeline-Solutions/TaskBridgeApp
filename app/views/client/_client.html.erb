<div class="overflow-x-auto shadow-md sm:rounded-lg h-full w-full">
  <!-- Large screens: full table -->
  <table class="hidden lg:table min-w-full text-sm text-left rtl:text-right">
    <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
      <tr>
        <th scope="col" class="px-2 py-2 lg:px-4 lg:py-3 whitespace-nowrap">Name of the Client</th>
        <th scope="col" class="px-2 py-2 lg:px-4 lg:py-3 whitespace-nowrap">No of Users</th>
        <th scope="col" class="px-2 py-2 lg:px-4 lg:py-3 whitespace-nowrap">No of Projects</th>
        <th scope="col" class="px-2 py-2 lg:px-4 lg:py-3 whitespace-nowrap">No of Tickets</th>
        <th scope="col" class="px-2 py-2 lg:px-4 lg:py-3 whitespace-nowrap">Email</th>
        <th scope="col" class="px-2 py-2 lg:px-4 lg:py-3 whitespace-nowrap">Phone</th>
        <th scope="col" class="px-2 py-2 lg:px-4 lg:py-3 whitespace-nowrap">Contact Person</th>
        <th scope="col" class="px-2 py-2 lg:px-4 lg:py-3 whitespace-nowrap">Contact Phone</th>
        <th scope="col" class="px-2 py-2 lg:px-4 lg:py-3 whitespace-nowrap">Contact Email</th>
        <% if can?(:edit, @client) || can?(:delete, @client) %>
          <th scope="col" class="px-2 py-2 lg:px-4 lg:py-3 whitespace-nowrap">ACTIONS</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @client.each do |client| %>
        <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
          <th scope="row" class="px-2 py-2 lg:px-4 lg:py-3 font-medium whitespace-nowrap truncate max-w-[120px] lg:max-w-none">
            <%= client.name %>
          </th>
          <td class="px-2 py-2 lg:px-4 lg:py-3 truncate max-w-[80px] lg:max-w-none">
            <%= client.users_count %>
          </td>
          <td class="px-2 py-2 lg:px-4 lg:py-3 truncate max-w-[80px] lg:max-w-none">
            <%= client.projects_count %>
          </td>
          <td class="px-2 py-2 lg:px-4 lg:py-3 truncate max-w-[80px] lg:max-w-none">
            <%= client.projects.sum { |project| project.tickets.count } %>
          </td>
          <td class="px-2 py-2 lg:px-4 lg:py-3 truncate max-w-[120px] lg:max-w-none">
            <%= client.email %>
          </td>
          <td class="px-2 py-2 lg:px-4 lg:py-3 truncate max-w-[100px] lg:max-w-none">
            <%= client.phone %>
          </td>
          <td class="px-2 py-2 lg:px-4 lg:py-3 truncate max-w-[120px] lg:max-w-none">
            <%= client.client_contact_person %>
          </td>
          <td class="px-2 py-2 lg:px-4 lg:py-3 truncate max-w-[100px] lg:max-w-none">
            <%= client.client_contact_phone_number %>
          </td>
          <td class="px-2 py-2 lg:px-4 lg:py-3 truncate max-w-[120px] lg:max-w-none">
            <%= client.client_contact_person_email %>
          </td>
          <% if can?(:edit, client) || can?(:delete, client) %>
            <td class="px-2 py-2 lg:px-4 lg:py-3 whitespace-nowrap text-right" data-controller="dropdown" data-dropdown-ticket-id-value="<%= client.id %>">
              <div class="relative flex justify-start">
                <%= render partial: 'client/action_dropdown', locals: { client: client } %>
              </div>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
  <!-- Medium screens: reduced table -->
  <table class="hidden sm:table lg:hidden min-w-full text-sm text-left rtl:text-right">
    <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
      <tr>
        <th scope="col" class="px-2 py-2 sm:px-4 sm:py-3 whitespace-nowrap">Name</th>
        <th scope="col" class="px-2 py-2 sm:px-4 sm:py-3 whitespace-nowrap">Users</th>
        <th scope="col" class="px-2 py-2 sm:px-4 sm:py-3 whitespace-nowrap">Projects</th>
        <th scope="col" class="px-2 py-2 sm:px-4 sm:py-3 whitespace-nowrap">Tickets</th>
        <% if can?(:edit, @client) || can?(:delete, @client) %>
          <th scope="col" class="px-2 py-2 sm:px-4 sm:py-3 whitespace-nowrap">ACTIONS</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @client.each do |client| %>
        <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
          <th scope="row" class="px-2 py-2 sm:px-4 sm:py-3 font-medium whitespace-nowrap truncate max-w-[120px] sm:max-w-none">
            <%= client.name %>
          </th>
          <td class="px-2 py-2 sm:px-4 sm:py-3 truncate max-w-[80px] sm:max-w-none">
            <%= client.users_count %>
          </td>
          <td class="px-2 py-2 sm:px-4 sm:py-3 truncate max-w-[80px] sm:max-w-none">
            <%= client.projects_count %>
          </td>
          <td class="px-2 py-2 sm:px-4 sm:py-3 truncate max-w-[80px] sm:max-w-none">
            <%= client.projects.sum { |project| project.tickets.count } %>
          </td>
          <% if can?(:edit, client) || can?(:delete, client) %>
            <td class="px-2 py-2 sm:px-4 sm:py-3 whitespace-nowrap text-right" data-controller="dropdown" data-dropdown-ticket-id-value="<%= client.id %>">
              <div class="relative flex justify-start">
                <%= render partial: 'client/action_dropdown', locals: { client: client } %>
              </div>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
  <!-- Mobile view cards: minimal info -->
  <div class="sm:hidden space-y-4 mt-4">
    <% @client.each do |client| %>
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 flex flex-col gap-2">
        <div class="flex justify-between items-center mb-2">
          <span class="font-semibold text-gray-900 dark:text-white text-base"><%= client.name %></span>
          <% if can?(:edit, client) || can?(:delete, client) %>
            <div class="relative flex justify-end" data-controller="dropdown" data-dropdown-ticket-id-value="<%= client.id %>">
              <%= render partial: 'client/action_dropdown', locals: { client: client } %>
            </div>
          <% end %>
        </div>
        <div class="grid grid-cols-1 gap-y-2 text-sm text-gray-700 dark:text-gray-300">
          <div class="flex justify-between">
            <span>Users:</span>
            <span><%= client.users_count %></span>
          </div>
          <div class="flex justify-between">
            <span>Projects:</span>
            <span><%= client.projects_count %></span>
          </div>
          <div class="flex justify-between">
            <span>Tickets:</span>
            <span><%= client.projects.sum { |project| project.tickets.count } %></span>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
