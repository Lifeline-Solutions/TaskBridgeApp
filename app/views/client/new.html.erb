<% provide(:title, "New Client Record") %>

<div class="max-w-3xl mx-auto bg-white dark:bg-gray-800 shadow-lg rounded-lg p-8 mt-8">
  <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white text-center">Create New Client Record</h2>
  <%= form_with model: @client, url: client_index_url, method: :post, data: { turbo: false }, local: true do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :name, 'Name *', class: "block mb-2 text-sm font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.text_field :name, class: "border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 bg-gray-50 dark:bg-gray-700 dark:placeholder-gray-400", placeholder: 'Enter client name', required: true %>
      </div>
      <div>
        <%= f.label :email, 'Email', class: "block mb-2 text-sm font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.email_field :email, class: "border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 bg-gray-50 dark:bg-gray-700 dark:placeholder-gray-400", placeholder: 'Enter client email' %>
      </div>
      <div>
        <%= f.label :phone, 'Phone', class: "block mb-2 text-sm font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.number_field :phone, class: "border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 bg-gray-50 dark:bg-gray-700 dark:placeholder-gray-400", placeholder: 'Enter phone number' %>
      </div>
      <div>
        <%= f.label :address, 'Address', class: "block mb-2 text-sm font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.text_field :address, class: "border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 bg-gray-50 dark:bg-gray-700 dark:placeholder-gray-400", placeholder: 'Enter address' %>
      </div>
      <div>
        <%= f.label :client_contact_person, 'C.E.O Name', class: "block mb-2 text-sm font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.text_field :client_contact_person, class: "border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 bg-gray-50 dark:bg-gray-700 dark:placeholder-gray-400", placeholder: 'Enter CEO name' %>
      </div>
      <div>
        <%= f.label :client_contact_phone_number, 'C.E.O Phone Number', class: "block mb-2 text-sm font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.number_field :client_contact_phone_number, class: "border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 bg-gray-50 dark:bg-gray-700 dark:placeholder-gray-400", placeholder: 'Enter CEO phone' %>
      </div>
      <div>
        <%= f.label :client_contact_person_email, 'C.E.O Email', class: "block mb-2 text-sm font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.email_field :client_contact_person_email, class: "border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 bg-gray-50 dark:bg-gray-700 dark:placeholder-gray-400", placeholder: 'Enter CEO email' %>
      </div>
      <div>
        <%= f.label :country_code, 'Country', class: "block mb-2 text-sm font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.country_select :country_code, { prompt: 'Select a Country' },
          class: "border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 bg-gray-50 dark:bg-gray-700 dark:placeholder-gray-400" %>
      </div>
    </div>
    <div class="mt-8 flex justify-center">
      <%= f.submit 'Create Client', class: 'w-full md:w-auto px-6 py-3 bg-blue-600 hover:bg-blue-700 rounded-lg font-bold text-white transition-colors duration-200' %>
    </div>
  <% end %>
</div>
