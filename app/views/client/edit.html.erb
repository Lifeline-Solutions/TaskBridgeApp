<% provide(:title, "Edit Client Details: #{@client.name}") %>

<div class="max-w-3xl xl:max-w-5xl 2xl:max-w-7xl mx-auto px-6 py-10 bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-800">
  <div class="mb-6 flex items-center">
    <%= link_to client_index_path, class: 'flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 font-semibold transition-all duration-150' do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Back
    <% end %>
  </div>
  <h2 class="text-3xl md:text-4xl xl:text-5xl font-extrabold text-gray-800 dark:text-white mb-10 text-center tracking-tight">
    Edit Client Details
  </h2>
  <%= form_with model: @client, url: client_path(@client), method: :patch, html: { class: "space-y-8" } do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <%= f.label :name, 'Name *', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.text_field :name, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", placeholder: 'Enter client name', required: true %>
      </div>
      <div>
        <%= f.label :email, 'Email *', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.email_field :email, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", placeholder: 'Enter client email', required: true %>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <%= f.label :phone, 'Phone *', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.number_field :phone, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", placeholder: 'Enter phone number', required: true %>
      </div>
      <div>
        <%= f.label :address, 'Address *', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.text_field :address, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", placeholder: 'Enter address', required: true %>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div>
        <%= f.label :client_contact_person, 'C.E.O Name *', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.text_field :client_contact_person, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", placeholder: 'Enter CEO name', required: true %>
      </div>
      <div>
        <%= f.label :client_contact_phone_number, 'C.E.O Phone No. *', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.number_field :client_contact_phone_number, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", placeholder: 'Enter CEO phone number', required: true %>
      </div>
      <div>
        <%= f.label :client_contact_person_email, 'C.E.O Email *', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.email_field :client_contact_person_email, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", placeholder: 'Enter CEO email', required: true %>
      </div>
      <div>
        <%= f.label :country_code, 'Country *', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.country_select :country_code, { prompt: 'Select a Country' },
          class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", required: true %>
      </div>
    </div>
    <div class="flex flex-col md:flex-row justify-center items-center mt-10 gap-6">
      <%= f.submit "Update Client", class: 'w-full md:w-auto h-14 bg-gradient-to-r from-blue-600 to-indigo-700 hover:from-blue-700 hover:to-indigo-800 p-4 rounded-xl font-bold text-xl text-white shadow-xl transition-all duration-200' %>
    </div>
  <% end %>
</div>