<% provide(:title, "Edit Client Details: #{@client.name}") %>

<div class="max-w-3xl xl:max-w-5xl 2xl:max-w-7xl mx-auto px-4 py-8 bg-white dark:bg-gray-900 rounded-xl shadow-lg">
  <div class="mb-4">
    <%= link_to '← Back', client_index_path, class: 'inline-block px-4 py-2 bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-gray-300 dark:hover:bg-gray-700 font-semibold transition-all duration-150' %>
  </div>
  <h2 class="text-2xl md:text-3xl xl:text-4xl font-extrabold text-gray-800 dark:text-white mb-8 text-center tracking-tight">
    Edit Client Details
  </h2>
  <%= form_with model: @client, url: client_path(@client), method: :patch do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-6">
      <div class="relative z-0 w-full mb-4 group">
        <%= f.label :name, ('Name *'), class: "capitalize block mb-2 text-base xl:text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.text_field :name, class: "border border-gray-300 dark:border-gray-700 rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-3 xl:p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 transition-all duration-150", placeholder: 'Enter client name' %>
      </div>
      <div class="relative z-0 w-full mb-4 group">
        <%= f.label :email, ('Email *'), class: "capitalize block mb-2 text-base xl:text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.email_field :email, class: "border border-gray-300 dark:border-gray-700 rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-3 xl:p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 transition-all duration-150", placeholder: 'Enter client email' %>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-6">
      <div class="relative z-0 w-full mb-4 group">
        <%= f.label :phone, ('Phone *'), class: "capitalize block mb-2 text-base xl:text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.number_field :phone, class: "border border-gray-300 dark:border-gray-700 rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-3 xl:p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 transition-all duration-150", placeholder: 'Enter phone number' %>
      </div>
      <div class="relative z-0 w-full mb-4 group">
        <%= f.label :address, ('Address *'), class: "capitalize block mb-2 text-base xl:text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.text_field :address, class: "border border-gray-300 dark:border-gray-700 rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-3 xl:p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 transition-all duration-150", placeholder: 'Enter address' %>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 xl:grid-cols-4 gap-6">
      <div class="relative z-0 w-full mb-4 group">
        <%= f.label :client_contact_person, ('C.E.O Name *'), class: "capitalize block mb-2 text-base xl:text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.text_field :client_contact_person, class: "border border-gray-300 dark:border-gray-700 rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-3 xl:p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 transition-all duration-150", placeholder: 'Enter CEO name' %>
      </div>
      <div class="relative z-0 w-full mb-4 group">
        <%= f.label :client_contact_phone_number, ('C.E.O Phone No. *'), class: "capitalize block mb-2 text-base xl:text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.number_field :client_contact_phone_number, class: "border border-gray-300 dark:border-gray-700 rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-3 xl:p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 transition-all duration-150", placeholder: 'Enter CEO phone number' %>
      </div>
      <div class="relative z-0 w-full mb-4 group">
        <%= f.label :client_contact_person_email, ('C.E.O Email *'), class: "capitalize block mb-2 text-base xl:text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.email_field :client_contact_person_email, class: "border border-gray-300 dark:border-gray-700 rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-3 xl:p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 transition-all duration-150", placeholder: 'Enter CEO email' %>
      </div>
      <div class="relative z-0 w-full mb-4 group">
        <%= f.label :country_code, 'Country *', class: "capitalize block mb-2 text-base xl:text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.country_select :country_code, { prompt: 'Select a Country' },
          class: "border border-gray-300 dark:border-gray-700 rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-3 xl:p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 transition-all duration-150", required: true %>
      </div>
    </div>
    <div class="flex flex-col md:flex-row justify-center items-center mt-8 gap-4">
      <%= f.submit "Update Client", class: 'w-full md:w-auto h-12 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 p-3 xl:p-4 rounded-xl font-bold text-lg xl:text-xl text-white shadow-lg transition-all duration-150' %>
    </div>
  <% end %>
</div>