<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-8 px-4">
  <!-- Left section: Back & Add Client buttons -->
  <div class="flex flex-row items-center gap-3 w-full md:w-auto">
    <% if can? :create, @client %>
      <% if current_user.has_role? :admin  %>
        <%= button_to root_path, method: :get, class: 'flex items-center gap-2 bg-blue-600 hover:bg-blue-700 px-5 py-2.5 rounded-xl font-semibold text-white shadow-lg transition w-full md:w-auto' do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          <span class="hidden sm:inline">Back</span>
        <% end %>
        <%= button_to 'Add Client +', new_client_path, method: :get, class: 'bg-green-500 hover:bg-green-600 px-5 py-2.5 rounded-xl font-semibold text-white shadow-lg transition w-full md:w-auto' %>
      <% end %>
    <% end %>
  </div>
  <!-- Right section: Search & Clear -->
  <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
    <%= form_with url: client_index_path, method: :get, class: 'flex flex-col sm:flex-row gap-3 w-full md:w-auto' do |f| %>
      <%= f.text_field :query, placeholder: "Search clients...", class: "p-2.5 border border-blue-600 focus:border-blue-700 rounded-xl w-full sm:w-64 transition shadow-sm" %>
      <%= f.submit "Search", class: 'bg-blue-600 hover:bg-blue-700 px-5 py-2.5 rounded-xl font-semibold text-white shadow-lg transition w-full sm:w-auto' %>
    <% end %>
    <%= form_with url: client_index_path, method: :get, class: 'flex w-full sm:w-auto' do |f| %>
      <%= f.submit "Clear", class: 'bg-gray-100 hover:bg-gray-200 px-5 py-2.5 rounded-xl font-semibold text-gray-700 shadow transition w-full sm:w-auto border border-gray-300' %>
    <% end %>
  </div>
</div>
