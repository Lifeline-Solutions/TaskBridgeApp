<% provide(:title, "CS Products") %>

<% if flash[:notice] %>
  <div class="bg-[#1a237e] border border-[#4caf50] text-white px-4 py-3 rounded mb-4 shadow-md w-full max-w-xl mx-auto">
    <p><%= flash[:notice] %></p>
  </div>
<% elsif flash[:alert] %>
  <div class="bg-red-600 border border-red-400 text-white px-4 py-3 rounded mb-4 shadow-md w-full max-w-xl mx-auto">
    <p><%= flash[:alert] %></p>
  </div>
<% end %>

<div class="w-full max-w-6xl mx-auto px-2 sm:px-4">
  <%= render 'software/top_bar_software' %>
  <%= render 'software/software' %>
  <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-10 mt-5 justify-center">
    <!-- Pagination Controls -->
    <div class="pagination flex flex-col sm:flex-row items-center gap-2 sm:gap-4">
      <% if @page > 1 %>
        <%= link_to 'Previous', software_index_path(@client, page: @page - 1), class: 'mb-2 sm:mb-0 h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] px-4 py-2 rounded font-bold text-slate-100 transition-colors duration-200 w-full sm:w-auto text-center' %>
      <% end %>
      <span class="text-sm sm:text-base font-medium text-gray-700 px-2 py-1 rounded bg-gray-100">
        Page <%= @page %> of <%= @total_pages %>
      </span>
      <% if @page < @total_pages %>
        <%= link_to 'Next', software_index_path(@client, page: @page + 1), class: 'mb-2 sm:mb-0 h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] px-4 py-2 rounded font-bold text-slate-100 transition-colors duration-200 w-full sm:w-auto text-center' %>
      <% end %>
    </div>
  </div>
</div>