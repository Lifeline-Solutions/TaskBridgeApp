<div class="w-full mb-4">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <!-- Left: Back & Add Software Buttons -->
    <div class="flex flex-row gap-2 items-center">
      <% if can? :create, @software %>
        <% if current_user.has_role? :admin  %>
          <%= button_to root_path, method: :get, class: 'bg-[#3F8CFF] hover:bg-[#3A81EB] px-3 py-2 rounded-lg font-bold text-slate-100 flex items-center transition-colors duration-200 text-sm md:text-base' do %>
            <span class="mr-1">&#8656;</span> Back
          <% end %>
          <%= button_to 'Add Software +', new_software_path, method: :get, class: 'bg-[#3F8CFF] hover:bg-[#3A81EB] px-3 py-2 rounded-lg font-bold text-slate-100 transition-colors duration-200 text-sm md:text-base'  %>
        <% end %>
      <% end %>
    </div>
    <!-- Right: Search & Clear -->
    <div class="flex flex-col sm:flex-row gap-2 w-full md:w-auto">
      <%= form_with url: software_index_path, method: :get, class: 'flex flex-row gap-2 w-full' do |f| %>
        <%= f.text_field :query, placeholder: "Search", class: "border border-[#3F8CFF] hover:border-[#3A81EB] border-2 rounded-lg w-full px-2 py-1 text-sm md:text-base focus:outline-none focus:ring-2 focus:ring-[#3F8CFF] transition-all duration-200" %>
        <%= f.submit "Search", class: 'px-3 py-2 bg-[#3F8CFF] hover:bg-[#3A81EB] rounded-lg font-bold text-slate-100 transition-colors duration-200 text-sm md:text-base'  %>
      <% end %>
      <%= form_with url: software_index_path, method: :get, class: 'flex flex-row w-full md:w-auto' do |f| %>
        <%= f.submit "Clear", class: 'px-3 py-2 bg-[#3F8CFF] hover:bg-[#3A81EB] rounded-lg font-bold text-slate-100 transition-colors duration-200 text-sm md:text-base w-full md:w-auto'  %>
      <% end %>
    </div>
  </div>
</div>
