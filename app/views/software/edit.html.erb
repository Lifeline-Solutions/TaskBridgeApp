<% provide(:title, "Edit CS Product") %>

<div class="max-w-xl mx-auto bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8 mt-8">
  <h2 class="flex justify-center text-2xl font-bold mb-6 text-gray-800 dark:text-white flex items-center">
    Edit CS Product
  </h2>
  <div class="mb-6 flex items-center">
    <%= link_to software_index_path, class: 'flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 font-semibold transition-all duration-150' do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Back
    <% end %>
  </div>
  <%= form_with model: @software, url: software_path(@software), method: :patch, html: { class: "space-y-6" } do |f| %>
    <div class="flex flex-col">
      <%= f.label :name, "Name", class: "block text-sm font-semibold text-gray-700 dark:text-gray-200 mb-2" %>
      <%= f.text_field :name, class: "border border-gray-300 dark:border-gray-700 rounded focus:ring-2 focus:ring-[#0052CC] focus:border-[#0052CC] block w-full px-4 py-2 text-base dark:bg-gray-700 dark:text-white", placeholder: 'Enter product name', required: true %>
    </div>
    <div class="flex flex-col">
      <%= f.label :description, "Product Description", class: "block text-sm font-semibold text-gray-700 dark:text-gray-200 mb-2" %>
      <%= f.text_area :description, rows: 4, class: "border border-gray-300 dark:border-gray-700 rounded focus:ring-2 focus:ring-[#0052CC] focus:border-[#0052CC] block w-full px-4 py-2 text-base dark:bg-gray-700 dark:text-white", placeholder: 'Describe the product', required: true %>
    </div>
    <div class="flex justify-end">
      <%= f.submit "Update", class: "bg-[#0052CC] hover:bg-[#0065FF] text-white font-bold py-2 px-6 rounded shadow transition-colors duration-150" %>
    </div>
  <% end %>
</div>
