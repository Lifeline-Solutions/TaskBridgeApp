<% provide(:title, "New CS Product") %>

<div class="max-w-xl mx-auto px-4 py-8">
  <%= form_with model: @software, url: software_index_url, method: :post, data: { turbo: false }, local: true, html: { class: "space-y-6" } do |f| %>
    <div class="w-full group">
      <%= f.label :name, 'Product Title', class: "capitalize block mb-2 text-base font-semibold text-gray-900 dark:text-white" %>
      <%= f.text_field :name, class: "border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-3 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500 transition duration-150 ease-in-out", placeholder: 'Enter product title', required: true %>
    </div>
    <div class="w-full group">
      <%= f.label :description, 'Product Description*', class: "capitalize block mb-2 text-base font-semibold text-gray-900 dark:text-white" %>
      <%= f.text_field :description, class: "border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-3 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500 transition duration-150 ease-in-out", placeholder: 'Enter product description', required: true %>
    </div>
    <div class="flex justify-end">
      <%= f.submit "Create Product", class: "h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] px-6 rounded font-bold text-slate-100 transition duration-150 ease-in-out w-full sm:w-auto" %>
    </div>
  <% end %>
</div>
