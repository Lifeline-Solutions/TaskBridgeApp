
<% provide(:title, "Create new location") %>

<div class="max-w-3xl xl:max-w-5xl 2xl:max-w-7xl mx-auto px-6 py-10 bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-800">
  <div class="mb-6 flex items-center">
    <%= link_to location_index_path, class: 'flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 font-semibold transition-all duration-150' do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Back
    <% end %>
  </div>
  <h2 class="text-3xl md:text-4xl xl:text-5xl font-extrabold text-gray-800 dark:text-white mb-10 text-center tracking-tight">
    Create New Location
  </h2>
  <%= form_with  model: @location, url: location_index_url, method: :post, data: { turbo: false }, local: true, html: { class: "space-y-8" } do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <%= f.label :city, 'City *', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.text_field :city, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", required: true %>
      </div>
      <div>
        <%= f.label :country, 'Country *', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.country_select :country, { prompt: 'Select a Country' }, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", required: true %>
      </div>
    </div>
    <div class="flex flex-col md:flex-row justify-center items-center mt-10 gap-6">
      <%= f.submit "Create Location", class: 'w-full md:w-auto h-14 bg-gradient-to-r from-blue-600 to-indigo-700 hover:from-blue-700 hover:to-indigo-800 p-4 rounded-xl font-bold text-xl text-white shadow-xl transition-all duration-200' %>
    </div>
  <% end %>
</div>

<style>
@media (max-width: 640px) {
  .h-14 {
    height: 2.5rem !important;
  }
}
</style>
