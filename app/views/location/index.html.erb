
<% provide(:title, "Location Details") %>

<% if flash[:notice] %>
  <div class="bg-blue-900 border border-green-500 text-white px-4 py-3 rounded mb-4 shadow-md">
    <p><%= flash[:notice] %></p>
  </div>
<% elsif flash[:alert] %>
  <div class="bg-red-600 border border-red-400 text-white px-4 py-3 rounded mb-4 shadow-md">
    <p><%= flash[:alert] %></p>
  </div>
<% end %>

<div class="max-w-3xl xl:max-w-5xl 2xl:max-w-7xl mx-auto px-2 md:px-6 py-6 md:py-10 bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-800">
  <h2 class="text-2xl md:text-4xl font-extrabold text-gray-800 dark:text-white mb-8 text-center tracking-tight">Location Details</h2>
  <div class="overflow-x-auto">
    <table class="min-w-full text-sm text-left rtl:text-right rounded-xl overflow-hidden">
      <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
        <tr>
          <th scope="col" class="px-4 md:px-6 py-3">City</th>
          <th scope="col" class="px-4 md:px-6 py-3">Country</th>
          <% if can? :edit, @client %>
            <th scope="col" class="px-4 md:px-6 py-3">Edit</th>
          <% end %>
          <% if can? :edit, @client %>
            <th scope="col" class="px-4 md:px-6 py-3">Delete</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @location.each do |location| %>
          <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-blue-50 dark:hover:bg-gray-600 transition-colors duration-150">
            <td class="px-4 md:px-6 py-4 font-medium whitespace-nowrap text-gray-900 dark:text-white">
              <%= location.city %>
            </td>
            <td class="px-4 md:px-6 py-4 truncate w-64 text-gray-700 dark:text-gray-300">
              <%= location.country %>
            </td>
            <% if can? :edit, location %>
              <td class="px-4 md:px-6 py-4">
                <%= link_to 'Edit', edit_location_path(location), class: 'h-10 md:h-12 bg-gradient-to-r from-blue-600 to-indigo-700 hover:from-blue-700 hover:to-indigo-800 px-4 py-2 rounded-xl font-bold text-white shadow transition-all duration-200' %>
              </td>
            <% end %>
            <td class="px-4 md:px-6 py-4">
              <% if can? :delete, location %>
                <%= button_to 'Delete', location, method: :delete, data: { 'turbo_method': :delete, 'turbo-confirm': 'Are you sure?' }, class: "border border-b-4 border-r-2 border-red-900 px-4 py-2 rounded-xl uppercase text-red-900 font-bold hover:bg-red-50 transition-all duration-200" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<style>
@media (max-width: 640px) {
  .max-w-3xl {
    padding: 0.5rem !important;
  }
  table {
    font-size: 0.95rem;
  }
  th, td {
    padding-left: 0.5rem !important;
    padding-right: 0.5rem !important;
    padding-top: 0.5rem !important;
    padding-bottom: 0.5rem !important;
  }
}
</style>
