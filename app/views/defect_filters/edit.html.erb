<div class="container mx-auto px-4 py-6">
  <div class="max-w-4xl mx-auto">
    <div class="bg-white shadow-lg rounded-lg">
      <div class="px-6 py-4 border-b border-gray-200">
        <h1 class="text-2xl font-bold text-gray-900">Edit Filter: <%= @defect_filter.name %></h1>
        <p class="text-gray-600 mt-1">Modify your saved filter criteria</p>
        
        <% if Rails.env.development? %>
          <div class="mt-2 p-2 bg-yellow-50 border border-yellow-200 rounded text-xs">
            <strong>Debug - Current Filters:</strong> <%= @current_filters.inspect %>
          </div>
        <% end %>
      </div>

      <div class="p-6">
        <%= form_with model: @defect_filter, url: defect_filter_path(@defect_filter), method: :patch, local: true, class: "space-y-6" do |form| %>
          <!-- Filter Name -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= form.label :name, "Filter Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :name, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
            </div>
          </div>

          <!-- Hidden field to store filters JSON -->
          <%= hidden_field_tag 'defect_filter[filters]', '', id: 'filters_json' %>

          <!-- Projects -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Projects</label>
            <% if Rails.env.development? %>
              <div class="mb-2 p-2 bg-yellow-50 border border-yellow-200 rounded text-xs">
                <strong>Debug Products:</strong> <%= @current_filters['product_id'].inspect %>
              </div>
            <% end %>
            <input type="text"
                   id="projectSearch"
                   placeholder="Search projects..."
                   class="w-full border border-gray-300 rounded-md px-3 py-2 mb-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <div class="border border-gray-300 rounded-md p-3 bg-gray-50 max-h-48 overflow-y-auto" id="projectList">
              <% @qa_products.each do |product| %>
                <label class="flex items-center space-x-2 mb-2 project-item">
                  <%= check_box_tag 'product_id[]', product.id,
                      (Array(@current_filters['product_id']).map(&:to_s).include?(product.id.to_s) rescue false),
                      class: 'rounded border-gray-300 text-blue-600 focus:ring-blue-500 filter-checkbox' %>
                  <span class="text-sm text-gray-700">
                    <%= product.document_name %>
                    <span class="text-xs text-gray-500">(<%= product.client&.name %>)</span>
                  </span>
                </label>
              <% end %>
            </div>
          </div>

          <!-- Status -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
            <% if Rails.env.development? %>
              <div class="mb-2 p-2 bg-yellow-50 border border-yellow-200 rounded text-xs">
                <strong>Debug Status:</strong> <%= @current_filters['status'].inspect %>
              </div>
            <% end %>
            <input type="text"
                   id="statusSearch"
                   placeholder="Search statuses..."
                   class="w-full border border-gray-300 rounded-md px-3 py-2 mb-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <div class="border border-gray-300 rounded-md p-3 bg-gray-50 max-h-32 overflow-y-auto" id="statusList">
              <% @statuses.each do |status| %>
                <label class="flex items-center space-x-2 mb-2 status-item">
                  <%= check_box_tag 'status[]', status.name,
                      (Array(@current_filters['status']).map(&:to_s).include?(status.name.to_s) rescue false),
                      class: 'rounded border-gray-300 text-blue-600 focus:ring-blue-500 filter-checkbox' %>
                  <span class="text-sm text-gray-700"><%= status.name %></span>
                </label>
              <% end %>
            </div>
          </div>

          <!-- Priority -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Priority</label>
            <% if Rails.env.development? %>
              <div class="mb-2 p-2 bg-yellow-50 border border-yellow-200 rounded text-xs">
                <strong>Debug Priority:</strong> <%= @current_filters['priority'].inspect %>
              </div>
            <% end %>
            <div class="flex flex-wrap gap-2">
              <% %w[Severity\ 1 Severity\ 2 Severity\ 3 Severity\ 4].each do |priority| %>
                <% stored_priorities = Array(@current_filters['priority']).map { |p| p.to_s.upcase } %>
                <% is_checked = stored_priorities.include?(priority.upcase) %>
                <% if Rails.env.development? %>
                  <!-- Checking: <%= priority.upcase %> against <%= stored_priorities.inspect %> = <%= is_checked %> -->
                <% end %>
                <label class="flex items-center space-x-2">
                  <%= check_box_tag 'priority[]', priority, is_checked,
                      class: 'rounded border-gray-300 text-blue-600 focus:ring-blue-500 filter-checkbox' %>
                  <span class="text-sm text-gray-700"><%= priority %></span>
                </label>
              <% end %>
            </div>
          </div>

          <!-- Assignees -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Assignees</label>
            <input type="text"
                   id="assigneeSearch"
                   placeholder="Search assignees..."
                   class="w-full border border-gray-300 rounded-md px-3 py-2 mb-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <div class="border border-gray-300 rounded-md p-3 bg-gray-50 max-h-48 overflow-y-auto" id="assigneeList">
              <% @users.each do |user| %>
                <label class="flex items-center space-x-2 mb-2 assignee-item">
                  <%= check_box_tag 'user_id[]', user.id,
                      (Array(@current_filters['user_id']).map(&:to_s).include?(user.id.to_s) rescue false),
                      class: 'rounded border-gray-300 text-blue-600 focus:ring-blue-500 filter-checkbox' %>
                  <span class="text-sm text-gray-700"><%= user.name %></span>
                </label>
              <% end %>
            </div>
          </div>

          <!-- Reporters -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Reporters</label>
            <input type="text"
                   id="reporterSearch"
                   placeholder="Search reporters..."
                   class="w-full border border-gray-300 rounded-md px-3 py-2 mb-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <div class="border border-gray-300 rounded-md p-3 bg-gray-50 max-h-48 overflow-y-auto" id="reporterList">
              <% @users.each do |user| %>
                <label class="flex items-center space-x-2 mb-2 reporter-item">
                  <%= check_box_tag 'reporter_id[]', user.id,
                      (Array(@current_filters['reporter_id']).map(&:to_s).include?(user.id.to_s) rescue false),
                      class: 'rounded border-gray-300 text-blue-600 focus:ring-blue-500 filter-checkbox' %>
                  <span class="text-sm text-gray-700"><%= user.name %></span>
                </label>
              <% end %>
            </div>
          </div>

          <!-- Modules -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Modules</label>
            <input type="text"
                   id="moduleSearch"
                   placeholder="Search modules/submodules..."
                   class="w-full border border-gray-300 rounded-md px-3 py-2 mb-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <div class="border border-gray-300 rounded-md p-3 bg-gray-50 max-h-48 overflow-y-auto" id="moduleList">
              <% @modules.select { |m| m.parent_id.nil? }.each do |module_item| %>
                <div class="mb-2 module-item">
                  <label class="flex items-center space-x-2">
                    <%= check_box_tag 'qa_module_id[]', module_item.id,
                        (Array(@current_filters['qa_module_id']).map(&:to_s).include?(module_item.id.to_s) rescue false),
                        class: 'rounded border-gray-300 text-blue-600 focus:ring-blue-500 filter-checkbox' %>
                    <span class="text-sm font-medium text-gray-700"><%= module_item.name %></span>
                  </label>

                  <!-- Submodules -->
                  <% module_item.children.each do |submodule| %>
                    <div class="ml-6 mt-1">
                      <label class="flex items-center space-x-2">
                        <%= check_box_tag 'submodule_id[]', submodule.id,
                            (Array(@current_filters['submodule_id']).map(&:to_s).include?(submodule.id.to_s) rescue false),
                            class: 'rounded border-gray-300 text-blue-600 focus:ring-blue-500 filter-checkbox' %>
                        <span class="text-sm text-gray-600">└ <%= submodule.name %></span>
                      </label>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Labels -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Labels</label>
            <input type="text"
                   id="labelSearch"
                   placeholder="Search labels..."
                   class="w-full border border-gray-300 rounded-md px-3 py-2 mb-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <div class="border border-gray-300 rounded-md p-3 bg-gray-50 max-h-48 overflow-y-auto" id="labelList">
              <% @labels.each do |label| %>
                <label class="flex items-center space-x-2 mb-2 label-item">
                  <%= check_box_tag 'label_ids[]', label.id,
                      (Array(@current_filters['label_ids']).map(&:to_s).include?(label.id.to_s) rescue false),
                      class: 'rounded border-gray-300 text-blue-600 focus:ring-blue-500 filter-checkbox' %>
                  <span class="text-sm text-gray-700"><%= label.name %></span>
                </label>
              <% end %>
            </div>
          </div>

          <!-- Banking Types -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Banking Types</label>
            <input type="text"
                   id="bankingTypeSearch"
                   placeholder="Search banking types..."
                   class="w-full border border-gray-300 rounded-md px-3 py-2 mb-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <div class="border border-gray-300 rounded-md p-3 bg-gray-50 max-h-48 overflow-y-auto" id="bankingTypeList">
              <% (@banking_types || []).each do |banking_type| %>
                <label class="flex items-center space-x-2 mb-2 banking-type-item">
                  <%= check_box_tag 'banking_type_id[]', banking_type.id,
                      (Array(@current_filters['banking_type_id']).map(&:to_s).include?(banking_type.id.to_s) rescue false),
                      class: 'rounded border-gray-300 text-blue-600 focus:ring-blue-500 filter-checkbox' %>
                  <span class="text-sm text-gray-700"><%= banking_type.name %></span>
                </label>
              <% end %>
            </div>
          </div>

          <!-- Additional Options -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= form.label :query, "Search Query", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= text_field_tag 'query', @current_filters['query'],
                  placeholder: "Search in defect content...",
                  class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 filter-field" %>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Date Range</label>
              <div class="flex space-x-2">
                <%= date_field_tag 'start_date', @current_filters['start_date'],
                    placeholder: "Start date",
                    class: "flex-1 border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 filter-field" %>
                <%= date_field_tag 'end_date', @current_filters['end_date'],
                    placeholder: "End date",
                    class: "flex-1 border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 filter-field" %>
              </div>
            </div>
          </div>

          <!-- Filter Options -->
          <div class="flex flex-wrap gap-4">
            <label class="flex items-center space-x-2">
              <%= check_box_tag 'filter_open', '1', @current_filters['filter_open'] == '1',
                  class: 'rounded border-gray-300 text-blue-600 focus:ring-blue-500 filter-checkbox' %>
              <span class="text-sm text-gray-700">Show only open defects</span>
            </label>
          </div>

          <!-- Action Buttons -->
          <div class="flex space-x-4 pt-6 border-t border-gray-200">
            <%= form.submit 'Update Filter',
                class: 'px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500' %>
            <%= link_to 'Cancel', defect_filters_path,
                class: 'px-6 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-500' %>
            <%= link_to 'Apply Updated Filter', '#',
                id: 'apply-updated-filter',
                class: 'px-6 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const form = document.querySelector('form');
    const applyButton = document.getElementById('apply-updated-filter');
    const filtersJsonField = document.getElementById('filters_json');

    // Function to collect all filter data
    function collectFilterData() {
      const filters = {};

      // Collect checked values from checkboxes
      document.querySelectorAll('.filter-checkbox:checked').forEach(checkbox => {
        const name = checkbox.name.replace('[]', '');
        if (!filters[name]) {
          filters[name] = [];
        }
        filters[name].push(checkbox.value);
      });

      // Collect text field values
      document.querySelectorAll('.filter-field').forEach(field => {
        if (field.value && field.value !== '') {
          filters[field.name] = field.value;
        }
      });

      return filters;
    }

    // Update hidden field before form submission
    if (form && filtersJsonField) {
      form.addEventListener('submit', function(e) {
        const filters = collectFilterData();
        filtersJsonField.value = JSON.stringify(filters);
      });
    }

    // Initialize search functionality for filter sections
    function initializeSearch(inputId, listId, itemClass) {
      const searchInput = document.getElementById(inputId);
      if (!searchInput) return;

      searchInput.addEventListener('input', function() {
        const searchTerm = this.value.toLowerCase();
        const items = document.querySelectorAll(`#${listId} .${itemClass}`);

        items.forEach(item => {
          const text = item.textContent.toLowerCase();
          item.style.display = text.includes(searchTerm) ? 'flex' : 'none';
        });
      });
    }

    // Initialize search for each section
    initializeSearch('projectSearch', 'projectList', 'project-item');
    initializeSearch('statusSearch', 'statusList', 'status-item');
    initializeSearch('assigneeSearch', 'assigneeList', 'assignee-item');
    initializeSearch('reporterSearch', 'reporterList', 'reporter-item');
    initializeSearch('moduleSearch', 'moduleList', 'module-item');
    initializeSearch('labelSearch', 'labelList', 'label-item');
    initializeSearch('bankingTypeSearch', 'bankingTypeList', 'banking-type-item');

    // Apply updated filter button functionality
    if (form && applyButton) {
      applyButton.addEventListener('click', function(e) {
        e.preventDefault();

        // Collect all form data
        const formData = new FormData(form);
        const params = new URLSearchParams();

        // Add all form fields as URL parameters
        for (let [key, value] of formData) {
          if (value && value !== '' && key !== 'defect_filter[filters]' && key !== 'defect_filter[name]') {
            params.append(key, value);
          }
        }

        // Redirect to defect index with filter parameters
        const url = '<%= index_show_defect_index_path %>' + '?' + params.toString();
        window.location.href = url;
      });
    }
  });
</script>
