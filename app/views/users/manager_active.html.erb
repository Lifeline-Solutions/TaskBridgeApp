<div class="mx-auto p-4">
  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold">Active Users</h1>
    <%= link_to "Download CSV", active_manager_users_path(format: :csv, page: params[:page]), class: "px-4 py-2 bg-green-500 text-white rounded hover:bg-green-600" %>
  </div>

  <% if @active_users_manager.any? %>
    <table class="w-full text-sm text-left">
      <thead class="text-xs uppercase bg-gray-50 dark:bg-gray-700">
        <tr>
          <th scope="col" class="px-6 py-3">First Name</th>
          <th scope="col" class="px-6 py-3">Last Name</th>
          <th scope="col" class="px-6 py-3">Email</th>
          <th scope="col" class="px-6 py-3">Teams</th>
          <th scope="col" class="px-6 py-3">Sign-In Count</th>
        </tr>
      </thead>
      <tbody>
        <% @active_users_manager.each do |user| %>
          <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
            <td class="px-6 py-4"><%= user.first_name %></td>
            <td class="px-6 py-4"><%= user.last_name %></td>
            <td class="px-6 py-4"><%= user.email %></td>
            <td class="px-6 py-4"><%= user.teams.pluck(:name).join(", ") %></td>
            <td class="px-6 py-4"><%= user.sign_in_count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <!-- Pagination Controls -->
    <div class="mt-4 flex justify-between items-center">
      <% if @current_page > 1 %>
        <%= link_to "Previous", active_manager_users_path(page: @current_page - 1), class: "px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600" %>
      <% end %>

      <span>Page <%= @current_page %> of <%= @total_pages %></span>

      <% if @current_page < @total_pages %>
        <%= link_to "Next", active_manager_users_path(page: @current_page + 1), class: "px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600" %>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">No active users found.</p>
  <% end %>
</div>
