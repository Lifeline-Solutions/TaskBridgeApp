<div class="bg-white dark:bg-gray-900 shadow rounded-lg px-4 py-3 mb-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
  <!-- Left: Back and Admin Actions -->
  <div class="flex flex-row gap-2 w-full md:w-auto">
  <%= link_to root_path, class: 'flex items-center gap-1 bg-[#0052CC] hover:bg-[#0747A6] px-3 py-2 rounded font-semibold text-white dark:text-white shadow-sm transition-colors duration-150 w-full md:w-auto', title: "Back to Home" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
  <span class="dark:text-white">Back</span>
    <% end %>
    <% if current_user.has_role?(:admin) %>
  <%= link_to new_user_invitation_path, class: 'flex items-center gap-1 bg-[#0052CC] hover:bg-[#0747A6] px-3 py-2 rounded font-semibold text-white dark:text-white shadow-sm transition-colors duration-150 w-full md:w-auto', title: "Add New User" do %>
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
  <span class="dark:text-white">Add New User</span>
      <% end %>
  <%= link_to new_location_path, class: 'flex items-center gap-1 bg-[#0052CC] hover:bg-[#0747A6] px-3 py-2 rounded font-semibold text-white dark:text-white shadow-sm transition-colors duration-150 w-full md:w-auto', title: "Add Location" do %>
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
  <span class="dark:text-white">Add Location</span>
      <% end %>
    <% end %>
  </div>

  <!-- Right: Search and Clear -->
  <div class="w-full md:w-auto">
    <%= form_with url: users_path(@users), method: :get, class: 'flex flex-col gap-2 md:flex-row md:items-end md:gap-2 w-full' do |f| %>
      <div class="flex flex-col w-full">
        <%= f.text_field :query, placeholder: "Search users...", class: "w-full px-3 py-2 border border-[#0052CC] rounded-md focus:ring-2 focus:ring-[#2684FF] focus:border-[#2684FF] transition dark:bg-gray-900 dark:text-white" %>
      </div>
      <div class="flex gap-2 w-full md:w-auto">
  <%= f.submit "Search", class: 'w-full md:w-auto bg-[#0052CC] hover:bg-[#0747A6] px-3 py-2 rounded font-semibold text-white dark:text-white shadow-sm transition-colors duration-150' %>
  <%= button_to "Clear", users_path(@users), method: :get, class: 'w-full md:w-auto bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 px-3 py-2 rounded font-semibold text-[#0052CC] dark:text-white shadow-sm transition-colors duration-150', form_class: 'inline' %>
      </div>
    <% end %>
  </div>
</div>