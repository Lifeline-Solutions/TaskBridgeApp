<div class="overflow-x-auto shadow rounded-lg bg-white dark:bg-[#1D2125]">
  <!-- Responsive Table: Collapses columns as screen shrinks -->
  <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 hidden sm:table">
    <thead class="bg-[#F4F5F7] dark:bg-[#22272B]">
      <tr>
        <th scope="col" class="px-4 py-3 text-xs font-semibold text-[#42526E] dark:text-[#B6C2CF] uppercase tracking-wider text-left">Name</th>
        <th scope="col" class="px-4 py-3 text-xs font-semibold text-[#42526E] dark:text-[#B6C2CF] uppercase tracking-wider text-left">Email</th>
        <th scope="col" class="px-4 py-3 text-xs font-semibold text-[#42526E] dark:text-[#B6C2CF] uppercase tracking-wider text-left hidden lg:table-cell">Roles</th>
        <th scope="col" class="px-4 py-3 text-xs font-semibold text-[#42526E] dark:text-[#B6C2CF] uppercase tracking-wider text-left hidden xl:table-cell">Date Created</th>
        <th scope="col" class="px-4 py-3 text-xs font-semibold text-[#42526E] dark:text-[#B6C2CF] uppercase tracking-wider text-left hidden xl:table-cell">Client</th>
        <th scope="col" class="px-4 py-3 text-xs font-semibold text-[#42526E] dark:text-[#B6C2CF] uppercase tracking-wider text-center">Status</th>
        <th scope="col" class="px-4 py-3 text-xs font-semibold text-[#42526E] dark:text-[#B6C2CF] uppercase tracking-wider text-center hidden md:table-cell">Edit Role</th>
        <th scope="col" class="px-4 py-3 text-xs font-semibold text-[#42526E] dark:text-[#B6C2CF] uppercase tracking-wider text-center hidden md:table-cell">Reset Password</th>
      </tr>
    </thead>
    <tbody class="bg-white dark:bg-[#1D2125] divide-y divide-gray-200 dark:divide-gray-700">
      <% @users.each do |user| %>
        <tr class="hover:bg-[#E9F2FF] dark:hover:bg-[#22272B] transition-colors">
          <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-[#172B4D] dark:text-[#B6C2CF] max-w-[180px] truncate">
            <% if (can?(:manage, user) || (can?(:read, user) && !user.has_role?(:admin))) && user != current_user %>
              <%= link_to user.name, edit_user_path(user), class: "hover:underline text-[#0052CC] dark:text-[#579DFF]" %>
            <% else %>
              <span><%= user.name %></span>
            <% end %>
          </td>
          <td class="px-4 py-3 whitespace-nowrap text-sm text-[#42526E] dark:text-[#B6C2CF] max-w-[200px] truncate"><%= user.email %></td>
          <td class="px-4 py-3 whitespace-nowrap text-sm hidden lg:table-cell">
            <% user.roles.distinct.pluck(:name).each do |role| %>
              <span class="inline-block bg-[#DEEBFF] dark:bg-[#253858] text-[#0747A6] dark:text-[#B6C2CF] rounded px-2 py-1 text-xs font-semibold mr-1 mb-1"><%= role %></span>
            <% end %>
          </td>
          <td class="px-4 py-3 whitespace-nowrap text-sm text-[#42526E] dark:text-[#B6C2CF] hidden xl:table-cell"><%= user.created_at.strftime("%d %b %Y") %></td>
          <td class="px-4 py-3 whitespace-nowrap text-sm text-[#42526E] dark:text-[#B6C2CF] hidden xl:table-cell"><%= user.client&.name || 'No Client Assigned' %></td>
          <td class="px-4 py-3 text-center">
            <% if (can?(:manage, user) || (can?(:read, user) && !user.has_role?(:admin))) && user != current_user %>
              <%= form_with url: status_user_path(user), method: :patch, local: true, remote: true do |form| %>
                <label class="inline-flex items-center cursor-pointer">
                  <%= form.check_box :active, checked: user.active, class: "sr-only peer", data: { confirm: 'Are you sure?' }, onchange: 'this.form.submit()' %>
                  <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-[#0052CC] dark:bg-gray-700 rounded-full peer peer-checked:bg-[#0052CC] transition-all"></div>
                  <div class="absolute ml-1 mt-1 w-4 h-4 bg-white rounded-full shadow transform peer-checked:translate-x-5 transition-all"></div>
                  <span class="ml-3 text-xs font-medium text-[#42526E] dark:text-[#B6C2CF]"><%= user.active ? "Unlocked" : "Locked" %></span>
                </label>
              <% end %>
            <% else %>
              <span class="text-xs font-medium <%= user.active ? 'text-green-600' : 'text-red-600' %>">
                <%= user.active ? "Unlocked" : "Locked" %>
              </span>
            <% end %>
          </td>
          <td class="px-4 py-3 text-center hidden md:table-cell">
            <% if (can?(:manage, user) || (can?(:read, user) && !user.has_role?(:admin))) && user != current_user %>
              <%= link_to 'Edit Roles', edit_user_path(user), class: "inline-flex items-center px-3 py-1 bg-[#0052CC] hover:bg-[#0747A6] text-white rounded text-xs font-semibold shadow-sm transition" %>
            <% end %>
          </td>
          <td class="px-4 py-3 text-center hidden md:table-cell">
            <% if (can?(:manage, user) || (can?(:read, user) && !user.has_role?(:admin))) && user != current_user %>
              <%= button_to 'Reset', reset_user_password_user_path(user), class: "inline-flex items-center px-3 py-1 bg-[#FF5630] hover:bg-[#DE350B] text-white rounded text-xs font-semibold shadow-sm transition", method: :patch, data: { 'turbo_method': :patch, 'turbo-confirm': 'Are you sure?' } %>
            <% end %>
          </td>
        </tr>
        <!-- Collapsed row for hidden columns on medium screens -->
        <tr class="md:hidden border-t border-gray-100 dark:border-gray-700">
          <td colspan="6" class="px-4 pb-3 pt-0">
            <div class="flex flex-wrap gap-2 text-xs text-[#42526E] dark:text-[#B6C2CF] mt-2">
              <div class="flex items-center gap-1">
                <span class="font-semibold">Roles:</span>
                <% user.roles.distinct.pluck(:name).each do |role| %>
                  <span class="inline-block bg-[#DEEBFF] dark:bg-[#253858] text-[#0747A6] dark:text-[#B6C2CF] rounded px-2 py-1 text-xs font-semibold"><%= role %></span>
                <% end %>
              </div>
              <div class="flex items-center gap-1">
                <span class="font-semibold">Date:</span>
                <span><%= user.created_at.strftime("%d %b %Y") %></span>
              </div>
              <div class="flex items-center gap-1">
                <span class="font-semibold">Client:</span>
                <span><%= user.client&.name || 'No Client Assigned' %></span>
              </div>
              <% if (can?(:manage, user) || (can?(:read, user) && !user.has_role?(:admin))) && user != current_user %>
                <div class="flex gap-2 mt-2 w-full">
                  <%= link_to 'Edit Roles', edit_user_path(user), class: "flex-1 inline-flex items-center justify-center px-3 py-1 bg-[#0052CC] hover:bg-[#0747A6] text-white rounded text-xs font-semibold shadow-sm transition" %>
                  <%= button_to 'Reset', reset_user_password_user_path(user), class: "flex-1 inline-flex items-center justify-center px-3 py-1 bg-[#FF5630] hover:bg-[#DE350B] text-white rounded text-xs font-semibold shadow-sm transition", method: :patch, data: { 'turbo_method': :patch, 'turbo-confirm': 'Are you sure?' } %>
                </div>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <!-- Mobile Card View -->
  <div class="sm:hidden space-y-4 px-2">
    <% @users.each do |user| %>
      <div class="bg-white dark:bg-[#1D2125] rounded-xl shadow p-4 flex flex-col gap-3 border border-[#F4F5F7] dark:border-[#22272B]">
        <div class="flex items-center justify-between gap-2">
          <div class="flex-1 min-w-0">
            <div class="font-semibold text-[#172B4D] dark:text-[#B6C2CF] text-base truncate">
              <% if (can?(:manage, user) || (can?(:read, user) && !user.has_role?(:admin))) && user != current_user %>
                <%= link_to user.name, edit_user_path(user), class: "hover:underline text-[#0052CC] dark:text-[#579DFF]" %>
              <% else %>
                <span><%= user.name %></span>
              <% end %>
            </div>
            <div class="text-xs text-[#42526E] dark:text-[#B6C2CF] break-all mt-1"><%= user.email %></div>
          </div>
          <div class="flex-shrink-0 ml-2">
            <% if (can?(:manage, user) || (can?(:read, user) && !user.has_role?(:admin))) && user != current_user %>
              <%= form_with url: status_user_path(user), method: :patch, local: true, remote: true do |form| %>
                <label class="inline-flex items-center cursor-pointer relative">
                  <%= form.check_box :active, checked: user.active, class: "sr-only peer", data: { confirm: 'Are you sure?' }, onchange: 'this.form.submit()' %>
                  <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-[#0052CC] dark:bg-gray-700 rounded-full peer peer-checked:bg-[#0052CC] transition-all"></div>
                  <div class="absolute left-0.5 top-0.5 w-4 h-4 bg-white rounded-full shadow transform peer-checked:translate-x-4 transition-all"></div>
                </label>
              <% end %>
            <% else %>
              <span class="text-xs font-medium <%= user.active ? 'text-green-600' : 'text-red-600' %>">
                <%= user.active ? "Unlocked" : "Locked" %>
              </span>
            <% end %>
          </div>
        </div>
        <div class="flex flex-wrap gap-1 mt-1">
          <% user.roles.distinct.pluck(:name).each do |role| %>
            <span class="inline-block bg-[#DEEBFF] dark:bg-[#253858] text-[#0747A6] dark:text-[#B6C2CF] rounded px-2 py-1 text-xs font-semibold"><%= role %></span>
          <% end %>
        </div>
        <div class="flex flex-col gap-1 text-xs text-[#42526E] dark:text-[#B6C2CF] mt-1">
          <div><span class="font-semibold">Date:</span> <%= user.created_at.strftime("%d %b %Y") %></div>
          <div><span class="font-semibold">Client:</span> <%= user.client&.name || 'No Client Assigned' %></div>
        </div>
        <% if (can?(:manage, user) || (can?(:read, user) && !user.has_role?(:admin))) && user != current_user %>
          <div class="flex gap-2 mt-2">
            <%= link_to 'Edit Roles', edit_user_path(user), class: "flex-1 inline-flex items-center justify-center px-3 py-1 bg-[#0052CC] hover:bg-[#0747A6] text-white rounded text-xs font-semibold shadow-sm transition" %>
            <%= button_to 'Reset', reset_user_password_user_path(user), class: "flex-1 inline-flex items-center justify-center px-3 py-1 bg-[#FF5630] hover:bg-[#DE350B] text-white rounded text-xs font-semibold shadow-sm transition", method: :patch, data: { 'turbo_method': :patch, 'turbo-confirm': 'Are you sure?' } %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="flex flex-col sm:flex-row items-center justify-between mt-6 gap-2">
  <div class="flex-1 flex items-center justify-center sm:justify-start">
    <% if @page > 1 %>
      <%= link_to 'Previous', users_path(page: @page - 1, query: params[:query]), class: 'inline-flex items-center px-4 py-2 bg-[#F4F5F7] hover:bg-[#DEEBFF] text-[#0052CC] rounded font-semibold text-xs shadow-sm transition mr-2' %>
    <% end %>
    <span class="text-sm text-[#42526E] dark:text-[#B6C2CF]">Page <%= @page %> of <%= @total_pages %></span>
    <% if @page < @total_pages %>
      <%= link_to 'Next', users_path(page: @page + 1, query: params[:query]), class: 'inline-flex items-center px-4 py-2 bg-[#F4F5F7] hover:bg-[#DEEBFF] text-[#0052CC] rounded font-semibold text-xs shadow-sm transition ml-2' %>
    <% end %>
  </div>
</div>
