<% provide(:title, "Banking Types") %>

<div class="container mx-auto px-4 py-6">
  <!-- Header -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">
          Banking Types - <%= @product.client&.name %>
        </h1>
        <p class="text-gray-600 dark:text-gray-400">
          Manage banking types for this project
        </p>
      </div>
      <%= link_to index_show_defect_index_path(product_id: @product.id), 
                  class: "inline-flex items-center px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white font-medium rounded-lg transition duration-150" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Defects
      <% end %>
    </div>
  </div>

  <!-- Add Banking Type Form -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Add Banking Type</h2>
    
    <%= form_with url: product_banking_types_path(@product), method: :post, local: true, 
                  html: { class: 'space-y-4' } do |f| %>
      <div class="relative">
        <label for="banking-type-input" class="block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300">
          Banking Type Name
        </label>
        
        <!-- Type-ahead input -->
        <div class="relative">
          <input type="text" 
                 id="banking-type-input"
                 name="banking_type[name]"
                 placeholder="Type to search or create new..."
                 class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600"
                 autocomplete="off"
                 required>
          
          <!-- Dropdown icon -->
          <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>
        </div>
        
        <!-- Suggestions dropdown -->
        <div id="banking-type-suggestions" 
             class="absolute z-10 mt-1 w-full bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md shadow-lg max-h-60 overflow-y-auto hidden">
        </div>
      </div>
      
      <div class="flex gap-3">
        <%= f.submit "Add to Project", 
                     class: "bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg px-6 py-2 transition" %>
        <p class="text-sm text-gray-500 dark:text-gray-400 flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          If the banking type exists, it will be added. If new, it will be created and added.
        </p>
      </div>
    <% end %>
  </div>

  <!-- Assigned Banking Types -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
      Current Banking Types (<%= @assigned_banking_types.count %>)
    </h2>
    
    <% if @assigned_banking_types.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @assigned_banking_types.each do |banking_type| %>
          <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-700 rounded-lg border border-gray-200 dark:border-gray-600">
            <span class="text-gray-900 dark:text-white font-medium"><%= banking_type.name %></span>
            <div class="flex gap-2">
              <%= link_to edit_product_banking_type_path(@product, banking_type), 
                          class: "text-blue-600 hover:text-blue-800 dark:text-blue-400" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
              <% end %>
              <%= button_to remove_product_banking_type_path(@product, banking_type), 
                            method: :delete,
                            data: { confirm: "Remove #{banking_type.name} from this project?" },
                            class: "text-red-600 hover:text-red-800 dark:text-red-400" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 dark:text-gray-400 text-center py-8">
        No banking types added to this project yet. Add one above to get started.
      </p>
    <% end %>
  </div>

  <!-- Available Banking Types (Quick Add) -->
  <% if @available_banking_types.any? %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
        Available Banking Types (<%= @available_banking_types.count %>)
      </h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
        These banking types exist in other projects. Click to add them to this project.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        <% @available_banking_types.each do |banking_type| %>
          <%= button_to add_existing_product_banking_types_path(@product), 
                        params: { banking_type_id: banking_type.id },
                        class: "flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700 rounded-lg border border-gray-200 dark:border-gray-600 hover:bg-blue-50 dark:hover:bg-gray-600 transition" do %>
            <span class="text-gray-900 dark:text-white"><%= banking_type.name %></span>
            <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<!-- Type-ahead JavaScript -->
<script>
  document.addEventListener('turbo:load', function() {
    const input = document.getElementById('banking-type-input');
    const suggestionsDiv = document.getElementById('banking-type-suggestions');
    
    if (!input || !suggestionsDiv) return;
    
    const allBankingTypes = <%= raw @all_banking_types.map(&:name).to_json %>;
    const assignedNames = <%= raw @assigned_banking_types.map(&:name).to_json %>;
    
    input.addEventListener('input', function() {
      const query = this.value.trim().toLowerCase();
      suggestionsDiv.innerHTML = '';
      
      if (query.length === 0) {
        suggestionsDiv.classList.add('hidden');
        return;
      }
      
      // Filter matching banking types
      const matches = allBankingTypes.filter(name => 
        name.toLowerCase().includes(query) && !assignedNames.includes(name)
      );
      
      if (matches.length > 0) {
        suggestionsDiv.classList.remove('hidden');
        
        matches.slice(0, 10).forEach(name => {
          const div = document.createElement('div');
          div.className = 'px-4 py-2 hover:bg-blue-500 hover:text-white cursor-pointer text-gray-900 dark:text-white';
          div.textContent = name;
          div.addEventListener('click', function() {
            input.value = name;
            suggestionsDiv.classList.add('hidden');
          });
          suggestionsDiv.appendChild(div);
        });
        
        // Show "create new" option if exact match doesn't exist
        if (!allBankingTypes.some(name => name.toLowerCase() === query)) {
          const createDiv = document.createElement('div');
          createDiv.className = 'px-4 py-2 bg-green-50 dark:bg-green-900 text-green-800 dark:text-green-200 border-t border-gray-200 dark:border-gray-600';
          createDiv.innerHTML = `<strong>Create new:</strong> "${this.value}"`;
          suggestionsDiv.appendChild(createDiv);  
        }
      } else {
        suggestionsDiv.classList.remove('hidden');
        const createDiv = document.createElement('div');
        createDiv.className = 'px-4 py-2 bg-green-50 dark:bg-green-900 text-green-800 dark:text-green-200';
        createDiv.innerHTML = `<strong>Create new banking type:</strong> "${this.value}"`;
        suggestionsDiv.appendChild(createDiv);
      }
    });
    
    // Show all on focus
    input.addEventListener('focus', function() {
      if (this.value.trim().length > 0) {
        this.dispatchEvent(new Event('input'));
      }
    });
    
    // Hide on click outside
    document.addEventListener('click', function(e) {
      if (!input.contains(e.target) && !suggestionsDiv.contains(e.target)) {
        suggestionsDiv.classList.add('hidden');
      }
    });
  });
</script>