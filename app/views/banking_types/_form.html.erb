<% if @banking_type.errors.any? %>
  <div id="error_explanation">
    <h2><%= pluralize(@banking_type.errors.count, "error") %> prohibited this banking type from being saved:</h2>
    <ul>
      <% @banking_type.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @banking_type, data: { turbo: false } do |form| %>
  <% if banking_type.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mb-6">
      <h2><%= pluralize(banking_type.errors.count, "error") %> prohibited this banking type from being saved:</h2>

      <ul>
        <% banking_type.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.select :product_id, 
      options_for_select(@products_and_clients_defects), 
      { prompt: "Select Project *" },
      { class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600", required: true } %>
  </div>

  <div class="mb-6">
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div class="flex items-center">
    <%= form.submit class: "px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 cursor-pointer" %>
    <%= link_to 'Cancel', banking_types_path, class: "ml-4 px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600" %>
  </div>
<% end %>