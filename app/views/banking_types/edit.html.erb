<% provide(:title, "Edit Banking Type") %>

<div class="container mx-auto px-4 py-6 max-w-2xl">
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Edit Banking Type</h1>
    
    <%= form_with model: @banking_type, url: product_banking_type_path(@product, @banking_type), method: :patch, local: true do |f| %>
      <% if @banking_type.errors.any? %>
        <div class="mb-4 p-4 bg-red-100 dark:bg-red-900 border border-red-400 dark:border-red-700 text-red-700 dark:text-red-200 rounded-lg">
          <h3 class="font-semibold mb-2"><%= pluralize(@banking_type.errors.count, "error") %> prohibited this banking type from being saved:</h3>
          <ul class="list-disc list-inside">
            <% @banking_type.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      
      <div class="mb-6">
        <%= f.label :name, "Banking Type Name", class: "block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.text_field :name, 
                         class: "w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white dark:border-gray-600",
                         required: true %>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
          <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          This will update the banking type globally across all projects that use it.
        </p>
      </div>
      
      <div class="flex gap-3">
        <%= f.submit "Update Banking Type", 
                     class: "bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg px-6 py-2 transition" %>
        <%= link_to "Cancel", product_banking_types_path(@product), 
                    class: "bg-gray-500 hover:bg-gray-600 text-white font-medium rounded-lg px-6 py-2 transition" %>
      </div>
    <% end %>
    
    <% if @banking_type.products.count > 1 %>
      <div class="mt-6 p-4 bg-blue-50 dark:bg-blue-900 border border-blue-200 dark:border-blue-700 rounded-lg">
        <h3 class="font-semibold text-blue-800 dark:text-blue-200 mb-2">Used in Multiple Projects</h3>
        <p class="text-sm text-blue-700 dark:text-blue-300">
          This banking type is currently used in <%= @banking_type.products.count %> projects:
        </p>
        <ul class="mt-2 text-sm text-blue-700 dark:text-blue-300 list-disc list-inside">
          <% @banking_type.products.includes(:client).limit(5).each do |product| %>
            <li><%= product.client&.name %> - <%= product.document_name %></li>
          <% end %>
          <% if @banking_type.products.count > 5 %>
            <li class="font-semibold">... and <%= @banking_type.products.count - 5 %> more</li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>