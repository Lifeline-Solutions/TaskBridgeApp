<div class="grid grid-cols-1 md:grid-cols-2 mb-4 gap-4">
  <!-- Tickets topbar left side -->
  <div class="flex flex-col md:flex-row items-start md:items-center gap-3 sm:gap-4">
    <!-- Make image, name, description, and due date inline on mobile -->
    <div class="flex flex-row items-center gap-2 sm:gap-4 flex-wrap w-full">
      <div class="flex-shrink-0">
        <% if @product.image.present? %>
          <%= image_tag(@product.image, class: 'w-12 h-12 sm:w-14 sm:h-16 rounded-full object-cover') %>
        <% else %>
          <%= image_tag 'default.png', class: 'w-12 h-12 sm:w-14 sm:h-16 rounded-full object-cover' %>
        <% end %>
      </div>
      <div class="flex flex-col justify-center">
        <h1 class="text-base sm:text-lg md:text-xl lg:text-2xl font-semibold break-words whitespace-nowrap"><%= @product.client.name %></h1>
        <p class="text-xs sm:text-sm md:text-base break-words whitespace-nowrap"><%= @product.groupwares.map(&:name).join(' & ').presence || "Client Description if any" %></p>
      </div>
      <!-- Due date details right beside image/details -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-1 sm:gap-2 ml-2">
        <h1 class="text-sm sm:text-md">Due date: <%= @product.end_date&.strftime("%d %b %Y") || 'N/A' %></h1>
        <p class="text-sm sm:text-md <%= 'text-red-500' if @days_remaining.to_i < 10 %>">
          <%= pluralize(@days_remaining, 'day') %> remaining
        </p>
      </div>
    </div>
  </div>

  <!-- Tickets topbar right side -->
  <div class="flex flex-row md:justify-end items-center gap-2 sm:gap-3 flex-wrap">
    <%= link_to new_product_task_path(@product), class: 'bg-[#3F8CFF] hover:bg-[#3A81EB] p-2 sm:px-4 rounded font-bold rounded-lg text-slate-100 text-xs sm:text-sm', id: 'button' do %>
      Add Task
    <% end %>
    
    <% if current_user.has_role?(:admin) || current_user.has_role?('project manager') %>
      <%= link_to manage_users_product_path(@product), data: { turbo_frame: "modal" }, class: "flex items-center gap-2 border-2 border-blue-500 bg-white hover:bg-blue-500 px-2 sm:px-4 py-2 rounded-lg text-blue-500 hover:text-white font-medium transition-colors duration-200 text-xs sm:text-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z" />
        </svg>
        <span>Manage Users</span>
      <% end %>
    <% end %>
  </div>
</div>

<% if flash[:prompt] %>
  <div id="custom-alert" class="fixed inset-0 flex justify-center items-center z-50" style="background-color: rgba(0, 0, 0, 0.5);">
    <div class="bg-white dark:bg-gray-800 rounded-lg p-4 sm:p-6 max-w-xs sm:max-w-sm w-full shadow-lg">
      <h2 class="text-lg sm:text-xl font-semibold mb-2 sm:mb-4 text-gray-800 dark:text-white">Notice</h2>
      <p class="text-gray-600 dark:text-gray-300 text-sm sm:text-base"><%= flash[:prompt] %></p>
      <div class="mt-4 text-right">
        <button id="close-alert" class="bg-blue-500 text-white px-3 py-2 rounded hover:bg-blue-600 text-xs sm:text-sm">
          OK
        </button>
      </div>
    </div>
  </div>

  <script type="text/javascript">
    document.addEventListener("turbo:load", function() {
      const alertBox = document.getElementById("custom-alert");
      const closeButton = document.getElementById("close-alert");

      closeButton.addEventListener("click", function() {
        alertBox.remove(); // Completely removes the modal from the DOM
      });
    });
  </script>
<% end %>
