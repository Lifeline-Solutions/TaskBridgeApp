<div class="product-filter-bar">
  <!-- Main container -->
  <div class="filter-container">
    <!-- Left side controls -->
    <div class="left-controls">
      <!-- Search form -->
      <div class="search-container">
        <form action="<%= product_index_path %>" method="get" class="search-form" data-controller="search-form" data-action="submit->search-form#submit">
          <% if params[:sort_by].present? %>
            <input type="hidden" name="sort_by" value="<%= params[:sort_by] %>">
          <% end %>
          <% if params[:status].present? %>
            <input type="hidden" name="status" value="<%= params[:status] %>">
          <% end %>
          
          <input 
            type="text" 
            name="query" 
            value="<%= params[:query] %>" 
            placeholder="Search by content..." 
            class="search-input"
          >
          <button type="submit" class="search-button">Search</button>
        </form>
        
        <% if params[:query].present? || params[:status].present? || params[:sort_by].present? %>
          <a href="<%= product_index_path %>" class="clear-button">Clear all</a>
        <% end %>
      </div>

      <!-- Category Dropdown -->
      <div class="filter-dropdown" data-controller="product-topbar-dropdown">
        <form action="<%= product_index_path %>" method="get">
          <div class="dropdown-label">
            <label for="status">Category</label>
            <select 
              id="status" 
              name="status" 
              onchange="this.form.submit()" 
              class="dropdown-select"
            >
              <% ['All', *@used_statuses.sort].each do |option| %>
                <option value="<%= option %>" <%= 'selected' if params[:status] == option %>>
                  <%= option %>
                </option>
              <% end %>
            </select>
          </div>
        </form>
        
        <div class="dropdown-menu" data-product-topbar-dropdown-target="menu">
          <% ['All', *@used_statuses.sort].each do |category| %>
            <button 
              class="dropdown-item" 
              data-action="click->product-topbar-dropdown#select"
              data-category="<%= category %>"
            >
              <%= category %>
            </button>
          <% end %>
        </div>
      </div>

      <!-- Sort by Dropdown (fixed) -->
      <div class="filter-dropdown">
        <form action="<%= product_index_path %>" method="get">
          <%# Preserve other params %>
          <% if params[:status].present? %>
            <input type="hidden" name="status" value="<%= params[:status] %>">
          <% end %>
          <% if params[:query].present? %>
            <input type="hidden" name="query" value="<%= params[:query] %>">
          <% end %>
          <div class="dropdown-label">
            <select 
              id="sort_by" 
              name="sort_by" 
              onchange="this.form.submit()" 
              class="dropdown-select"
            >
              <option value="upcoming" <%= 'selected' if params[:sort_by] == 'upcoming' %>>Sort by: Upcoming</option>
              <option value="recent" <%= 'selected' if params[:sort_by] == 'recent' %>>Sort by: Recent</option>
            </select>
          </div>
        </form>
      </div>
    </div>

    <!-- Right side - Add New Project button -->
    <div class="right-controls">
      <% if can? :create, Product %>
        <a href="<%= new_product_path %>" class="add-button">
          <span class="add-icon">＋</span>
          <span>Add New</span>
        </a>
      <% end %>
    </div>
  </div>
</div>

