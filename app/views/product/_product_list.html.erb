<div class="mt-6">
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
    <!-- Mobile card view for small screens -->
    <div class="block sm:hidden">
      <% @product.each do |product| %>
        <div class="border-b border-gray-200 dark:border-gray-700 p-4 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer" onclick="window.location='<%= product_path(product.id) %>'">
          <!-- Mobile card header -->
          <div class="flex items-start space-x-3 mb-3">
            <div class="flex-shrink-0">
              <% if product.image.present? %>
                <%= image_tag(product.image, class: 'w-12 h-12 rounded-lg object-cover') %>
              <% else %>
                <%= image_tag 'default.png', class: 'w-12 h-12 rounded-lg object-cover' %>
              <% end %>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-white truncate">
                <%= product.document_name || 'Untitled Project' %>
              </h3>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                <%= product.client.present? ? product.client.name : 'No Client' %>
              </p>
            </div>
            <% if current_user.has_role?(:admin) && can?(:edit, product) %>
              <div class="flex-shrink-0" onclick="event.stopPropagation();">
                <%= link_to edit_product_path(product), 
                      class: "p-2 rounded-lg hover:bg-blue-100 dark:hover:bg-gray-600 text-gray-400 hover:text-blue-600 dark:text-gray-500 dark:hover:text-blue-400 transition-all",
                      data: { turbo: false } do %>
                  <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 3.487a2.25 2.25 0 1 1 3.182 3.182L7.5 19.213l-4.182.545a.75.75 0 0 1-.83-.83l.545-4.182 12.829-12.829z" />
                  </svg>
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Mobile card details -->
          <div class="grid grid-cols-2 gap-4 text-xs">
            <div>
              <span class="text-gray-500 dark:text-gray-400 block">Status</span>
              <% status_name = product.statuses.first&.name || 'N/A' %>
              <span class="font-medium text-gray-900 dark:text-white"><%= status_name %></span>
            </div>
            <div>
              <span class="text-gray-500 dark:text-gray-400 block">Tasks</span>
              <% total_tasks = product.tasks.count %>
              <% completed_tasks = product.tasks.joins(:statuses).where(statuses: { name: 'Done' }).count %>
              <span class="font-medium text-gray-900 dark:text-white"><%= total_tasks - completed_tasks %>/<%= total_tasks %></span>
            </div>
            <div>
              <span class="text-gray-500 dark:text-gray-400 block">Budget</span>
              <span class="font-medium text-gray-900 dark:text-white">
                <%= number_to_currency(product.budget || 0, unit: '$', precision: 0, delimiter: ',') %>
              </span>
            </div>
            <div>
              <span class="text-gray-500 dark:text-gray-400 block">Due Date</span>
              <% if product.end_date.present? %>
                <span class="font-medium text-gray-900 dark:text-white"><%= product.end_date.strftime('%d %b %y') %></span>
              <% else %>
                <span class="text-gray-400 dark:text-gray-500 italic">No deadline</span>
              <% end %>
            </div>
            <div class="col-span-2">
              <span class="text-gray-500 dark:text-gray-400 block mb-1">Groupware</span>
              <div class="flex flex-wrap gap-1">
                <% groupwares = product.groupwares.map(&:name) %>
                <% if groupwares.present? %>
                  <% groupwares.first(2).each do |gw| %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200">
                      <%= gw %>
                    </span>
                  <% end %>
                  <% if groupwares.count > 2 %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">
                      +<%= groupwares.count - 2 %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="text-sm text-gray-400 dark:text-gray-500">N/A</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Desktop table view -->
    <div class="hidden sm:block overflow-x-auto">
      <table class="w-full text-xs sm:text-sm text-left rtl:text-right text-gray-900 dark:text-gray-400">
        <thead class="text-xs uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-300 border-b border-gray-200 dark:border-gray-600">
          <tr>
            <th scope="col" class="px-3 sm:px-6 py-3 font-medium">Logo</th>
            <%# <th scope="col" class="px-3 sm:px-6 py-3 font-medium">Project Name </th> %>
            <th scope="col" class="hidden md:table-cell px-3 sm:px-6 py-3 font-medium">Client</th>
            <th scope="col" class="hidden md:table-cell px-3 sm:px-6 py-3 font-medium">Groupware</th>
            <th scope="col" class="hidden lg:table-cell px-3 sm:px-6 py-3 font-medium">Status</th>
            <th scope="col" class="px-3 sm:px-6 py-3 font-medium text-center">Tasks</th>
            <th scope="col" class="hidden xl:table-cell px-3 sm:px-6 py-3 font-medium text-center">Budget</th>
            <th scope="col" class="hidden xl:table-cell px-3 sm:px-6 py-3 font-medium text-center">Due Date</th>
            <th scope="col" class="hidden xl:table-cell px-3 sm:px-6 py-3 font-medium">Team</th>
            <% if current_user.has_role?(:admin) && can?(:edit, @product) %>
              <th scope="col" class="px-3 sm:px-6 py-3 font-medium text-center">Edit</th>
            <% end %>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
          <% @product.each do |product| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors cursor-pointer" onclick="window.location='<%= product_path(product.id) %>'">
              <!-- Logo -->
              <td class="px-3 sm:px-6 py-4">
                <div class="flex-shrink-0">
                  <% if product.image.present? %>
                    <%= image_tag(product.image, class: 'w-10 h-10 sm:w-12 sm:h-12 rounded-lg object-cover') %>
                  <% else %>
                    <%= image_tag 'default.png', class: 'w-10 h-10 sm:w-12 sm:h-12 rounded-lg object-cover' %>
                  <% end %>
                </div>
              </td>

              <!-- Project Name -->
              <%# <td class="px-3 sm:px-6 py-4"> %>
                <%# <div class="text-sm font-medium text-gray-900 dark:text-white"> %>
                  <%#= product.document_name || 'Untitled Project' %>
                <%# </div> %>
              <%# </td> %>

              <!-- Client -->
              <td class="hidden md:table-cell px-3 sm:px-6 py-4">
                <div class="text-sm text-gray-700 dark:text-gray-300 truncate max-w-32">
                  <%= product.client.present? ? product.client.name : 'No Client' %>
                </div>
              </td>

              <!-- Groupware -->
              <td class="hidden md:table-cell px-3 sm:px-6 py-4">
                <div class="flex flex-wrap gap-1">
                  <% groupwares = product.groupwares.map(&:name) %>
                  <% if groupwares.present? %>
                    <% groupwares.first(2).each do |gw| %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200">
                        <%= gw %>
                      </span>
                    <% end %>
                    <% if groupwares.count > 2 %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">
                        +<%= groupwares.count - 2 %>
                      </span>
                    <% end %>
                  <% else %>
                    <span class="text-sm text-gray-400 dark:text-gray-500">N/A</span>
                  <% end %>
                </div>
              </td>

              <!-- Status -->
              <td class="hidden lg:table-cell px-3 sm:px-6 py-4">
                <% status_name = product.statuses.first&.name || 'N/A' %>
                <% status_colors = {
                  'Pre Quality Assurance' => 'bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200',
                  'In Progress' => 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
                  'Completed' => 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200',
                  'On Hold' => 'bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200'
                } %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_colors[status_name] || 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200' %>">
                  <%= status_name %>
                </span>
              </td>

              <!-- Tasks -->
              <td class="px-3 sm:px-6 py-4 text-center">
                <% total_tasks = product.tasks.count %>
                <% completed_tasks = product.tasks.joins(:statuses).where(statuses: { name: 'Done' }).count %>
                <% pending_tasks = total_tasks - completed_tasks %>
                <% progress_percentage = total_tasks > 0 ? (completed_tasks.to_f / total_tasks * 100).round : 0 %>
                <div class="flex flex-col items-center gap-1">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                    <%= pending_tasks %>/<%= total_tasks %>
                  </span>
                  <div class="w-full max-w-[60px] bg-gray-200 dark:bg-gray-700 rounded-full h-1.5">
                    <div class="<%= progress_percentage == 100 ? 'bg-green-500' : 'bg-blue-500' %> h-1.5 rounded-full transition-all duration-300" style="width: <%= progress_percentage %>%"></div>
                  </div>
                </div>
              </td>

              <!-- Budget -->
              <td class="hidden xl:table-cell px-3 sm:px-6 py-4 text-center">
                <div class="text-sm font-medium text-gray-900 dark:text-white">
                  <%= number_to_currency(product.budget || 0, unit: '$', precision: 0, delimiter: ',') %>
                </div>
              </td>

              <!-- Due Date -->
              <td class="hidden xl:table-cell px-3 sm:px-6 py-4 text-center">
                <% if product.end_date.present? %>
                  <% days_left = (product.end_date - Date.today).to_i %>
                  <div class="flex flex-col items-center gap-1">
                    <div class="text-sm font-medium <%= days_left < 0 ? 'text-red-600 dark:text-red-400' : days_left < 7 ? 'text-orange-600 dark:text-orange-400' : 'text-gray-700 dark:text-gray-300' %>">
                      <%= product.end_date.strftime('%d %b %y') %>
                    </div>
                    <% if days_left < 0 %>
                      <span class="text-xs text-red-600 dark:text-red-400">
                        <%= days_left.abs %> days overdue
                      </span>
                    <% elsif days_left < 7 %>
                      <span class="text-xs text-orange-600 dark:text-orange-400">
                        <%= days_left %> days left
                      </span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-sm text-gray-400 dark:text-gray-500 italic">No deadline</span>
                <% end %>
              </td>

              <!-- Team Members -->
              <td class="hidden xl:table-cell px-3 sm:px-6 py-4">
                <div class="flex -space-x-2">
                  <% product.users.limit(4).each do |user| %>
                    <% if user.profile_picture.present? %>
                      <%= image_tag user.profile_picture, 
                          class: "inline-block h-8 w-8 rounded-full ring-2 ring-white dark:ring-gray-800",
                          title: "#{user.first_name} #{user.last_name}" %>
                    <% else %>
                      <div class="inline-flex items-center justify-center h-8 w-8 rounded-full ring-2 ring-white dark:ring-gray-800 bg-gradient-to-br from-blue-400 to-purple-500 text-white text-xs font-bold"
                           title="<%= "#{user.first_name} #{user.last_name}" %>">
                        <%= user.first_name&.first&.upcase %><%= user.last_name&.first&.upcase %>
                      </div>
                    <% end %>
                  <% end %>
                  <% if product.users.count > 4 %>
                    <div class="inline-flex items-center justify-center h-8 w-8 rounded-full ring-2 ring-white dark:ring-gray-800 bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-300 text-xs font-bold"
                         title="<%= product.users.count - 4 %> more members">
                      +<%= product.users.count - 4 %>
                    </div>
                  <% end %>
                </div>
              </td>

              <!-- Actions -->
              <% if current_user.has_role?(:admin) && can?(:edit, product) %>
                <td class="px-3 sm:px-6 py-4 text-center" onclick="event.stopPropagation()">
                  <%= link_to edit_product_path(product), 
                        class: "inline-flex p-2 rounded-lg hover:bg-blue-100 dark:hover:bg-gray-600 text-gray-400 hover:text-blue-600 dark:text-gray-500 dark:hover:text-blue-400 transition-all",
                        data: { turbo: false } do %>
                    <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 3.487a2.25 2.25 0 1 1 3.182 3.182L7.5 19.213l-4.182.545a.75.75 0 0 1-.83-.83l.545-4.182 12.829-12.829z" />
                    </svg>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>

  </div>
</div>

<%= render partial: 'product/grid_pagination' %>
