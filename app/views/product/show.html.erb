<% provide(:title, "Project: #{@product.client.name}") %>

<% if flash[:notice] %>
  <div class="bg-[#1a237e] border border-[#4caf50] text-white px-4 py-3 rounded mb-4 shadow-md">
    <p><%= flash[:notice] %></p>
  </div>
<% elsif flash[:alert] %>
  <div class="bg-red-600 border border-red-400 text-white px-4 py-3 rounded mb-4 shadow-md">
    <p><%= flash[:alert] %></p>
  </div>
<% end %>

<%= render 'product/product_show_topbar' %>

<div class="bg-white max-w-full dark:bg-gray-800 rounded-lg shadow p-2 sm:p-4 md:p-6 mb-4 sm:mb-6">
  <%= render 'layouts/alert' %>
  <div class="flex flex-col lg:flex-row gap-4 sm:gap-6 justify-between">
    <!-- First Column: List milestones -->
    <div class="px-2 sm:px-4 md:px-8 lg:px-12 xl:px-16 w-full lg:w-1/2 grid grid-cols-1 gap-2 sm:gap-4">
      <h2 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-white mb-1 sm:mb-2">Milestones</h2>
      <% selected_status_id = params[:status_id].presence || @product.statuses.first&.id %>
      <% milestones = selected_status_id ? @product.milestones.where(status_id: selected_status_id) : @product.milestones.none %>

      <% if milestones.any? %>
        <ul class="space-y-2 sm:space-y-3">
          <% milestones.each do |milestone| %>
            <li class="bg-gray-50 dark:bg-gray-700 p-2 sm:p-4 rounded-md shadow-sm">
              <p class="text-xs sm:text-sm text-gray-800 dark:text-white">
                <strong>Status:</strong> <%= milestone.status&.name || 'N/A' %>
              </p>
              <p class="text-xs sm:text-sm text-gray-800 dark:text-white">
                <strong>Percentage:</strong> <%= milestone.percentage %>%
              </p>
              <% if @product.budget.present? %>
                <p class="text-xs sm:text-sm text-gray-800 dark:text-white">
                  <strong>Amount:</strong>
                  KES <%= number_with_precision(@product.budget * milestone.percentage.to_f / 100, precision: 2) %>
                </p>
              <% end %>

              <div class="mt-1 sm:mt-2">
                <%= render partial: 'product/toggle_paid', locals: { product: @product, milestone: milestone } %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400">No milestones for the selected status.</p>
      <% end %>
    </div>

    <!-- Fourth Column: Documents -->
    <div class="px-2 sm:px-4 md:px-8 lg:px-12 xl:px-16 w-full lg:w-1/2 grid grid-cols-1 gap-2 sm:gap-4">
      <!-- show added documents name and download button -->
      <div class="flex flex-col">
        <% if @product.documents.any? %>
          <ul>
            <% @product.documents.each do |document| %>
              <li class="flex flex-col sm:flex-row gap-1 sm:gap-2 items-start sm:items-center">
                <h1 class="capitalize text-xs sm:text-sm md:text-base text-gray-800 dark:text-white"><%= document.name %></h1>
                <% if document.file.attached? %>
                  <%= link_to "Download", rails_blob_path(document.file, disposition: "attachment"), class: "text-blue-500 dark:text-blue-400 text-xs sm:text-sm px-2 py-1 rounded hover:bg-blue-100 dark:hover:bg-blue-900 transition" %>
                <% else %>
                  <span class="text-xs sm:text-sm text-gray-400 dark:text-gray-300">No file</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400">There are no documents for this product.</p>
        <% end %>
      </div>
    </div>

    <!-- Admin Only Section -->
    <% if current_user.has_role?(:admin) %>
      <div class="px-2 sm:px-4 md:px-8 lg:px-12 xl:px-16 w-full lg:w-1/2 grid grid-cols-1 gap-2 sm:gap-4">
        <%= render partial: 'product/add_statuses', locals: { product: @product } %>
      </div>
    <% end %>
  </div>
</div>

<!-- The products search form partial -->
<div class="w-full">
  <%= render 'product/product_show_search' %>
</div>

<!-- View Toggle Buttons -->
<div class="w-full flex justify-end items-center gap-2 p-2 sm:p-4">
  <div class="inline-flex rounded-lg shadow-sm bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700" role="group">
    <%= link_to product_path(@product, view: 'grid', query: params[:query]), 
        class: "px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium rounded-l-lg transition-colors #{@view_mode == 'grid' ? 'bg-blue-600 text-white' : 'bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700'}", 
        title: "Grid View" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 sm:w-5 sm:h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
      </svg>
      <span class="ml-1 hidden sm:inline">Grid</span>
    <% end %>
    <%= link_to product_path(@product, view: 'list', query: params[:query]), 
        class: "px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium rounded-r-lg transition-colors #{@view_mode == 'list' ? 'bg-blue-600 text-white' : 'bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700'}", 
        title: "List View" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 sm:w-5 sm:h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
      </svg>
      <span class="ml-1 hidden sm:inline">List</span>
    <% end %>
  </div>
</div>

<div class="relative w-full">
  <% if @product.added_to?(current_user) || current_user.has_role?(:admin) || current_user.has_role?(:observer) || current_user.has_role?(:hod) %>
    <% if @view_mode == 'list' %>
      <!-- LIST VIEW -->
      <div class="min-h-[60vh] p-1 sm:p-2">
        <% ordered_statuses = ['Reopened', 'TO DO', 'In Progress', 'On-Hold', 'Await Client Information',
                               'Failed-QA', 'QA-testing', 'Awaiting Build', 'Awaiting Client API',
                               'Blocked', 'Resolved', 'Closed'] %>

        <% categorized_statuses = @tasks_by_status.slice(*ordered_statuses) %>
        <% uncategorized_statuses = @tasks_by_status.except(*ordered_statuses) %>

        <% if @tasks.any? %>
          <div class="space-y-6">
            <% ordered_statuses.each do |status| %>
              <% tasks = categorized_statuses[status] || [] %>
              <% next if tasks.empty? %>

              <!-- Status Section -->
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
                <!-- Status Header -->
                <div class="sticky top-0 z-10 bg-gradient-to-r from-gray-50 to-gray-100 dark:from-gray-700 dark:to-gray-800 px-4 py-3 border-b border-gray-200 dark:border-gray-600 rounded-t-lg">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      <%= render partial: 'tasks/status_icon', locals: { status: status } %>
                      <h2 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-white capitalize">
                        <%= status %>
                      </h2>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400">
                        <%= tasks.count %> <%= tasks.count == 1 ? 'task' : 'tasks' %>
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Status Tasks -->
                <div class="divide-y divide-gray-100 dark:divide-gray-700">
                  <% tasks.each do |task| %>
                    <div class="px-2 py-1">
                      <%= render partial: 'tasks/list_item', locals: { task: task } %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- Uncategorized Tasks Section -->
            <% uncategorized_tasks = uncategorized_statuses.values.flatten.compact %>
            <% if uncategorized_tasks.any? %>
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
                <!-- Status Header -->
                <div class="sticky top-0 z-10 bg-gradient-to-r from-gray-50 to-gray-100 dark:from-gray-700 dark:to-gray-800 px-4 py-3 border-b border-gray-200 dark:border-gray-600 rounded-t-lg">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 sm:w-6 sm:h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0-10.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.25-8.25-3.286Zm0 13.036h.008v.008H12v-.008Z" />
                      </svg>
                      <h2 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-white capitalize">
                        Uncategorized
                      </h2>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400">
                        <%= uncategorized_tasks.count %> <%= uncategorized_tasks.count == 1 ? 'task' : 'tasks' %>
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Status Tasks -->
                <div class="divide-y divide-gray-100 dark:divide-gray-700">
                  <% uncategorized_tasks.each do |task| %>
                    <div class="px-2 py-1">
                      <%= render partial: 'tasks/list_item', locals: { task: task } %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-12">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 mx-auto text-gray-400 dark:text-gray-600 mb-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
            </svg>
            <p class="text-gray-500 dark:text-gray-400">No tasks found</p>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- GRID VIEW (Original) -->
      <div class="min-h-[60vh] p-1 sm:p-2 overflow-x-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-2 sm:gap-4 min-w-full">

        <% ordered_statuses = ['Reopened', 'TO DO', 'In Progress', 'On-Hold', 'Await Client Information',
                               'Failed-QA', 'QA-testing', 'Awaiting Build', 'Awaiting Client API',
                               'Blocked', 'Resolved', 'Closed'] %>

        <% categorized_statuses = @tasks_by_status.slice(*ordered_statuses) %>
        <% uncategorized_statuses = @tasks_by_status.except(*ordered_statuses) %>

        <% ordered_statuses.each do |status| %>
          <% tasks = categorized_statuses[status] || [] %>
          <% next if tasks.empty? %>

          <div class="bg-white dark:bg-gray-700 rounded px-2 py-2 sm:px-3 sm:py-3 shadow flex flex-col min-w-[220px]">
            <!-- Board Header -->
            <div class="flex justify-between items-center mb-2 mx-1">
              <div class="flex items-center gap-2">
                <h2 class="text-xs sm:text-sm md:text-base w-max px-2 py-1 rounded capitalize flex items-center gap-2">
                  <% case status %>
                  <% when "TO DO" %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 sm:w-6 sm:h-6">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m.75 12 3 3m0 0 3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                    </svg>
                  <% when "In Progress" %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 sm:w-6 sm:h-6">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                  <% when "Under Development" %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 sm:w-6 sm:h-6">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                    </svg>
                  <% when "Blocked" %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 sm:w-6 sm:h-6">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0-10.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.25-8.25-3.286Zm0 13.036h.008v.008H12v-.008Z" />
                    </svg>
                  <% end %>
                  <%= status %>
                </h2>
                <p class="text-xs border rounded-full px-2 py-1"><%= tasks.count %></p>
              </div>
              <button class="text-lg sm:text-2xl px-2 py-1 rounded hover:bg-gray-200 dark:hover:bg-gray-800 transition">+</button>
            </div>
            <!-- Board Cards -->
            <div class="grid gap-2 p-1 sm:p-2">
              <% tasks.each do |task| %>
                <%= render partial: 'tasks/card', locals: { task: task } %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% # Render Uncategorized Tasks %>
        <% uncategorized_tasks = uncategorized_statuses.values.flatten.compact %>
        <% if uncategorized_tasks.any? %>
          <div class="bg-white dark:bg-gray-700 rounded px-2 py-2 sm:px-3 sm:py-3 shadow flex flex-col min-w-[220px]">
            <div class="flex justify-between items-center mb-2 mx-1">
              <div class="flex items-center gap-2">
                <h2 class="text-xs sm:text-sm md:text-base w-max px-2 py-1 rounded capitalize flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 sm:w-6 sm:h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0-10.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.25-8.25-3.286Zm0 13.036h.008v.008H12v-.008Z" />
                  </svg>
                  Uncategorized
                </h2>
                <p class="text-xs border rounded-full px-2 py-1"><%= uncategorized_tasks.count %></p>
              </div>
            </div>
            <div class="grid gap-2 p-1 sm:p-2">
              <% uncategorized_tasks.each do |task| %>
                <%= render partial: 'tasks/card', locals: { task: task } %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <% end %>
  <% end %>
</div>
