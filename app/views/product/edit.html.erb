<% provide(:title, "Edit Product: #{@product.client.name}") %>

<div class="max-w-3xl xl:max-w-5xl 2xl:max-w-7xl mx-auto px-6 py-10 bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-800">
  <div class="mb-6 flex items-center">
    <%= link_to product_path, class: 'flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 font-semibold transition-all duration-150' do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Back
    <% end %>
  </div>
  <h2 class="text-3xl md:text-4xl xl:text-5xl font-extrabold text-gray-800 dark:text-white mb-10 text-center tracking-tight">
    Edit Product Details
  </h2>
  <%= form_with model: @product, url: product_path(@product), method: :patch, local: true, data: { turbo: false }, html: { class: "space-y-8" } do |f| %>
    <% if @product.errors.any? %>
      <div class="mb-4 text-red-600">
        <%= pluralize(@product.errors.count, "error") %> prevented this product from being saved:
        <ul>
          <% @product.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <%= f.label :client_id, 'Client Available*', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.collection_select :client_id, Client.all, :id, :name, { prompt: "Select Client" }, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" %>
      </div>
      <% if current_user.has_role?(:admin) %>
        <div>
          <%= f.label :proxy_name, 'Project Proxy Name (Alias)', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
          <%= f.text_field :proxy_name, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", placeholder: "Enter alias name" %>
        </div>
      <% end %>
      <div>
        <%= f.label :image, 'Product Image', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.file_field :image, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" %>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <%= f.label :user_id, 'Assignee*', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.select :user_id, User.with_agent_project_manager_role.order(:first_name, :last_name).map { |u| [u.name, u.id] }, { prompt: 'Assign User' }, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" %>
      </div>
      <div>
        <%= f.label :budget, 'Budget*', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.number_field :budget, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", required: true %>
        <% if @product.errors[:budget].any? %>
          <div class="text-red-500 text-sm"><%= @product.errors[:budget].join(', ') %></div>
        <% end %>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Project Category -->
      <div>
        <label for="software-search-input" class="block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200">
          Product Categories
        </label>

        <div id="selected-software-tags" class="flex flex-wrap gap-2 mb-2 min-h-[2rem]"></div>

        <div class="relative">
          <input type="text"
                id="software-search-input"
                placeholder="Search and select categories..."
                autocomplete="off"
                class="border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500">

          <div id="software-dropdown"
              class="absolute left-0 top-full mt-1 w-full z-50 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg shadow-lg max-h-60 overflow-y-auto hidden">
            <ul id="software-results" class="py-1"></ul>
          </div>
        </div>

        <div id="software-hidden-inputs"></div>
      </div>

      <!-- Sub Category -->
      <div>
        <label for="groupware-search-input" class="block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200">
          Sub Categories
        </label>

        <div id="selected-groupware-tags" class="flex flex-wrap gap-2 mb-2 min-h-[2rem]"></div>

        <div class="relative">
          <input type="text"
                id="groupware-search-input"
                placeholder="Select categories first..."
                autocomplete="off"
                disabled
                class="border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 disabled:opacity-50 disabled:cursor-not-allowed">

          <div id="groupware-dropdown"
              class="absolute left-0 top-full mt-1 w-full z-50 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg shadow-lg max-h-60 overflow-y-auto hidden">
            <ul id="groupware-results" class="py-1"></ul>
          </div>
        </div>

        <div id="groupware-hidden-inputs"></div>
      </div>
    </div>
    <div class="space-y-4">
      <h3 class="text-xl font-bold text-gray-800 dark:text-white">Milestones</h3>
      <div id="milestones-container">
        <% @product.milestones.each_with_index do |milestone, index| %>
          <div class="milestone-field grid grid-cols-1 md:grid-cols-5 gap-4 mb-4 p-4 bg-gray-100 dark:bg-gray-800 rounded-lg" id="milestone-<%= index %>">
            <div>
              <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Status</label>
              <%= f.select "milestones_attributes[#{index}][status_id]", Status.where(name: ['Development', 'User Acceptance Test', 'Pilot', 'Quality Assurance', 'Deploy', 'Production']).map { |s| [s.name, s.id] }, { selected: milestone.status_id }, class: "status-select bg-gray-50 border border-gray-300 dark:border-gray-700 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-2.5 dark:bg-gray-700 dark:placeholder-gray-400 dark:text-white" %>
            </div>
            <div>
              <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Percentage</label>
              <%= f.number_field "milestones_attributes[#{index}][percentage]", value: milestone.percentage, step: "0.01", class: "percentage-input bg-gray-50 border border-gray-300 dark:border-gray-700 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-2.5 dark:bg-gray-700 dark:placeholder-gray-400 dark:text-white", oninput: "calculateAmount(this, #{@product.budget || 0})" %>
            </div>
            <div>
              <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Amount</label>
              <input type="text" readonly value="<%= milestone.amount %>" class="amount-display bg-gray-50 border border-gray-300 dark:border-gray-700 text-gray-900 text-sm rounded-lg w-full p-2.5 dark:bg-gray-700 dark:text-white">
            </div>
            <div class="flex items-center">
              <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white mr-2">Paid</label>
              <%= f.check_box "milestones_attributes[#{index}][paid]", { checked: milestone.paid, disabled: true }, "true", "false" %>
            </div>
            <div class="flex items-end">
              <input type="hidden" name="product[milestones_attributes][<%= index %>][_destroy]" value="false">
              <button type="button" class="mt-4 p-2 bg-red-600 hover:bg-red-800 text-white rounded remove-milestone text-sm font-medium" onclick="this.closest('.milestone-field').remove()">Remove</button>
            </div>
          </div>
        <% end %>
      </div>
      <button type="button" id="add-milestone-button" class="mt-4 p-2 bg-blue-500 text-white rounded w-full md:w-auto">Add Milestone</button>
    </div>
    <div class="space-y-4">
      <h3 class="text-xl font-bold text-gray-800 dark:text-white">Attached Documents</h3>
      <div id="documents-container">
        <%= f.fields_for :documents do |doc| %>
          <div class="document-field mb-4">
            <%= doc.label :name, "Document Name", class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
            <%= doc.text_field :name, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 mb-2" %>
            <% if doc.object.file.attached? %>
              <p class="text-sm text-gray-600">Current File: <%= link_to doc.object.file.filename.to_s, rails_blob_path(doc.object.file, disposition: "attachment"), class: "text-blue-500 underline" %></p>
            <% end %>
            <%= doc.label :file, "Upload File", class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
            <%= doc.file_field :file, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" %>
            <%= doc.hidden_field :_destroy %>
            <%= link_to "Remove", "#", class: "remove-document text-red-500", data: { action: "click->form#removeDocument" } %>
          </div>
        <% end %>
      </div>
      <button type="button" id="add-document-button" class="p-2 bg-blue-500 text-white rounded mb-4 w-full md:w-auto">Add Document</button>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <%= f.label :start_date, 'Start Date', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.date_field :start_date, required: true, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 mb-4" %>
      </div>
      <div>
        <%= f.label :end_date, 'End Date', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.date_field :end_date, required: true, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 mb-4" %>
      </div>
    </div>
    <div>
      <%= f.label :content, 'Subject', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
      <div data-controller="text-limit" data-text-limit-limit-value="3000">
        <p id="char-count">0/3000</p>
        <%= f.rich_text_area :content, id: "content", data: { text_limit_target: "content" }, class: 'min-h-[300px]' %>
      </div>
    </div>
    <div class="flex flex-col md:flex-row justify-center items-center mt-10 gap-6">
      <%= f.submit "Update Product", class: 'w-full md:w-auto h-14 bg-gradient-to-r from-blue-600 to-indigo-700 hover:from-blue-700 hover:to-indigo-800 p-4 rounded-xl font-bold text-xl text-white shadow-xl transition-all duration-200' %>
    </div>
  <% end %>
</div>

<style>
@media (max-width: 640px) {
  #milestones-container, #documents-container {
    overflow-x: auto;
    padding-bottom: 1rem;
  }
  .milestone-field, .document-field {
    min-width: 280px;
  }
  .h-14 {
    height: 2.5rem !important;
  }
}
@media (max-width: 400px) {
  #milestones-container, #documents-container {
    font-size: 0.9rem;
  }
}
</style>

<script>
// ...existing code...
</script>
<script>
  // Add Milestone Button
  document.getElementById('add-milestone-button').addEventListener('click', function () {
    const container = document.getElementById('milestones-container');
    const timestamp = Date.now();
    const budget = document.getElementById('product_budget').value || 0;

    const newField = document.createElement('div');
    newField.classList.add('milestone-field', 'grid', 'grid-cols-1', 'sm:grid-cols-4', 'gap-4', 'mb-4', 'p-4', 'bg-gray-100', 'dark:bg-gray-800', 'rounded-lg');
    newField.id = `milestone-${timestamp}`;

    newField.innerHTML = `
      <div>
        <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Status</label>
        <select name="product[milestones_attributes][${timestamp}][status_id]"
                class="status-select bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">
          <%= options_from_collection_for_select(
              Status.where(name: ['Pre Initiation','End Of Initiation','Pre Development','End Of Development','Pre User Acceptance Test','End Of User Acceptance Test','Pre Pilot','End Of Pilot','Pre Quality Assurance','End Of Quality Assurance','Pre Deploy','End Of Deploy','Pre Production', 'End Of Production']),
                :id,
                :name
              ) %>
        </select>
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Percentage</label>
        <input type="number" step="0.01"
              name="product[milestones_attributes][${timestamp}][percentage]"
              class="percentage-input bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
              oninput="calculateAmount(this, ${budget})">
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Amount</label>
        <input type="text" readonly
              class="amount-display bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
      </div>

      <div class="flex items-end">
        <input type="hidden" name="product[milestones_attributes][${timestamp}][_destroy]" value="false">
        <button type="button"
                class="mt-4 p-2 bg-red-600 hover:bg-red-800 text-white roundedremove-milestone text-sm font-medium"
                onclick="this.closest('.milestone-field').remove()">
          Remove
        </button>
      </div>
    `;

    container.appendChild(newField);
  });

  // Calculate amount function
  function calculateAmount(input, budget) {
    const percentage = parseFloat(input.value) || 0;
    const amountField = input.closest('.milestone-field').querySelector('.amount-display');
    const amount = (budget * percentage / 100).toFixed(2);
    amountField.value = amount;
  }

  document.getElementById('add-document-button').addEventListener('click', function () {
    const container = document.getElementById('documents-container');
    const index = Date.now(); // unique index
    const newField = document.createElement('div');
    newField.classList.add('document-field', 'mb-4');
    newField.innerHTML = `
      <label class="block mb-1">Document Name</label>
      <input type="text" name="product[documents_attributes][${index}][name]" class="border rounded p-2 w-full mb-2" placeholder="Document Name">
      <label class="block mb-1">Upload File</label>
      <input type="file" name="product[documents_attributes][${index}][file]" class="border rounded p-2 w-full">
      <input type="hidden" name="product[documents_attributes][${index}][_destroy]" value="false">
      <a href="#" class="remove-document text-red-500">Remove</a>
    `;
    container.appendChild(newField);
  });

  document.addEventListener('click', function (e) {
    if (e.target.classList.contains('remove-document')) {
      e.preventDefault();
      const field = e.target.closest('.document-field');
      const destroyField = field.querySelector('input[name*="[_destroy]"]');
      if (destroyField) {
        destroyField.value = '1';
        field.style.display = 'none';
      } else {
        field.remove();
      }
    }
  });
</script>
<style>
/* Responsive overflow for milestones & documents on small screens */
@media (max-width: 640px) {
  #milestones-container, #documents-container {
    overflow-x: auto;
    padding-bottom: 1rem;
  }
  .milestone-field, .document-field {
    min-width: 280px;
  }
}
</style>

<script>
  // Run in Turbo frames too
  document.addEventListener('turbo:load', initProjectForm);
  document.addEventListener('turbo:frame-load', initProjectForm);

  function initProjectForm() {
    console.log('initProjectForm called');
    // Initialize BOTH multi-selects - groupware first to set up the global reference
    initGroupwareMultiSelect();
    initSoftwareMultiSelect();
  }

  // ---------- Groupware Multi-Select with Search (Initialize FIRST) ----------
  function initGroupwareMultiSelect() {
    console.log('initGroupwareMultiSelect called');
    const searchInput = document.getElementById('groupware-search-input');
    const dropdown = document.getElementById('groupware-dropdown');
    const resultsContainer = document.getElementById('groupware-results');
    const tagsContainer = document.getElementById('selected-groupware-tags');
    const hiddenInputsContainer = document.getElementById('groupware-hidden-inputs');

    if (!searchInput || !dropdown || !resultsContainer) {
      console.error('Groupware elements not found', { searchInput, dropdown, resultsContainer });
      return;
    }

    // All groupware data with their software_id mapping
    const allGroupware = <%= raw Groupware.all.map { |g| { id: g.id, name: g.name, software_id: g.software_id } }.to_json %>;
    
    // Pre-populate selected groupware
    const existingGroupware = <%= raw @product.groupwares.map { |g| { id: g.id, name: g.name, software_id: g.software_id } }.to_json %>;
    console.log('Existing Groupware:', existingGroupware);
    let selectedGroupware = existingGroupware || [];
    
    let availableGroupware = [];

    // Update available groupware based on selected software IDs
    function updateAvailableOptions(softwareIds) {
      if (softwareIds.length === 0) {
        availableGroupware = [];
        searchInput.disabled = true;
        searchInput.placeholder = 'Select categories first...';

        // Clear selections when no software is selected
        // selectedGroupware = []; // DISABLED AUTO-CLEAR
        renderTags();
        renderHiddenInputs();
      } else {
        availableGroupware = allGroupware.filter(gw =>
          softwareIds.includes(gw.software_id)
        );
        
        searchInput.disabled = false;
        searchInput.placeholder = 'Search and select sub-categories...';

        // Remove groupware that no longer belongs to selected software
        // DISABLED AUTO-FILTERING to preserve existing data
        // selectedGroupware = selectedGroupware.filter(gw =>
        //   availableGroupware.some(ag => ag.id === gw.id)
        // );
        
        renderTags();
        renderHiddenInputs();
      }

      // Clear and hide dropdown
      dropdown.classList.add('hidden');
      searchInput.value = '';
    }

    // Show dropdown on focus
    searchInput.addEventListener('focus', () => {
      if (!searchInput.disabled) {
        renderDropdown('');
        dropdown.classList.remove('hidden');
      }
    });

    // Search as user types
    searchInput.addEventListener('input', (e) => {
      if (!searchInput.disabled) {
        const query = e.target.value.toLowerCase();
        renderDropdown(query);
        dropdown.classList.remove('hidden');
      }
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.add('hidden');
      }
    });

    // Render dropdown options
    function renderDropdown(query) {
      resultsContainer.innerHTML = '';

      const filtered = availableGroupware.filter(gw => {
        const isSelected = selectedGroupware.some(s => s.id === gw.id);
        const matchesQuery = gw.name.toLowerCase().includes(query);
        return !isSelected && matchesQuery;
      });

      if (filtered.length === 0) {
        const noResults = document.createElement('li');
        noResults.className = 'px-4 py-2 text-sm text-gray-500 dark:text-gray-400';
        noResults.textContent = selectedGroupware.length === availableGroupware.length
          ? 'All sub-categories selected'
          : availableGroupware.length === 0
            ? 'No sub-categories available'
            : 'No matching sub-categories';
        resultsContainer.appendChild(noResults);
        return;
      }

      filtered.forEach(gw => {
        const li = document.createElement('li');
        li.className = 'px-4 py-2 hover:bg-green-500 hover:text-white cursor-pointer text-sm text-gray-900 dark:text-white transition-colors';
        li.textContent = gw.name;
        li.addEventListener('click', () => {
          addGroupware(gw);
          searchInput.value = '';
          renderDropdown('');
          searchInput.focus();
        });
        resultsContainer.appendChild(li);
      });
    }

    // Add selected groupware
    function addGroupware(gw) {
      if (selectedGroupware.some(s => s.id === gw.id)) return;

      selectedGroupware.push(gw);
      renderTags();
      renderHiddenInputs();
    }

    // Remove groupware
    function removeGroupware(gwId) {
      selectedGroupware = selectedGroupware.filter(s => s.id !== gwId);
      renderTags();
      renderHiddenInputs();
      renderDropdown(searchInput.value.toLowerCase());
    }

    // Render selected tags
    function renderTags() {
      tagsContainer.innerHTML = '';

      if (selectedGroupware.length === 0) {
        const placeholder = document.createElement('div');
        placeholder.className = 'text-sm text-gray-400 dark:text-gray-500';
        placeholder.textContent = searchInput.disabled
          ? 'Select categories first'
          : 'No sub-categories selected';
        tagsContainer.appendChild(placeholder);
        return;
      }

      selectedGroupware.forEach(gw => {
        const tag = document.createElement('div');
        tag.className = 'inline-flex items-center gap-1 px-3 py-1 bg-green-500 text-white rounded-full text-sm';
        tag.innerHTML = `
          <span>${gw.name}</span>
          <button type="button"
                  class="ml-1 hover:bg-green-600 rounded-full p-0.5 transition-colors"
                  data-gw-id="${gw.id}">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </button>
        `;

        const removeBtn = tag.querySelector('button');
        removeBtn.addEventListener('click', () => removeGroupware(gw.id));

        tagsContainer.appendChild(tag);
      });
    }

    // Render hidden inputs for form submission
    function renderHiddenInputs() {
      hiddenInputsContainer.innerHTML = '';

      selectedGroupware.forEach(gw => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'product[groupware_ids][]';
        input.value = gw.id;
        hiddenInputsContainer.appendChild(input);
      });
    }

    // Initialize with empty state
    renderTags();

    // Expose the update function globally so software select can trigger it
    window.groupwareMultiSelect = {
      updateAvailableOptions: updateAvailableOptions
    };
  }

  // ---------- Software Multi-Select with Search ----------
  function initSoftwareMultiSelect() {
    const searchInput = document.getElementById('software-search-input');
    const dropdown = document.getElementById('software-dropdown');
    const resultsContainer = document.getElementById('software-results');
    const tagsContainer = document.getElementById('selected-software-tags');
    const hiddenInputsContainer = document.getElementById('software-hidden-inputs');

    if (!searchInput || !dropdown || !resultsContainer) return;

    // Software data from Rails
    const allSoftware = <%= raw Software.all.map { |s| { id: s.id, name: s.name } }.to_json %>;
    
    // Pre-populate selected software
    const existingSoftware = <%= raw @product.softwares.map { |s| { id: s.id, name: s.name } }.to_json %>;
    let selectedSoftware = existingSoftware || [];

    // Show dropdown on focus
    searchInput.addEventListener('focus', () => {
      renderDropdown('');
      dropdown.classList.remove('hidden');
    });

    // Search as user types
    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase();
      renderDropdown(query);
      dropdown.classList.remove('hidden');
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.add('hidden');
      }
    });

    // Render dropdown options
    function renderDropdown(query) {
      resultsContainer.innerHTML = '';

      const filtered = allSoftware.filter(soft => {
        const isSelected = selectedSoftware.some(s => s.id === soft.id);
        const matchesQuery = soft.name.toLowerCase().includes(query);
        return !isSelected && matchesQuery;
      });

      if (filtered.length === 0) {
        const noResults = document.createElement('li');
        noResults.className = 'px-4 py-2 text-sm text-gray-500 dark:text-gray-400';
        noResults.textContent = selectedSoftware.length === allSoftware.length
          ? 'All categories selected'
          : 'No matching categories';
        resultsContainer.appendChild(noResults);
        return;
      }

      filtered.forEach(soft => {
        const li = document.createElement('li');
        li.className = 'px-4 py-2 hover:bg-blue-500 hover:text-white cursor-pointer text-sm text-gray-900 dark:text-white transition-colors';
        li.textContent = soft.name;
        li.addEventListener('click', () => {
          addSoftware(soft);
          searchInput.value = '';
          renderDropdown('');
          searchInput.focus();
        });
        resultsContainer.appendChild(li);
      });
    }

    // Add selected software
    function addSoftware(soft) {
      if (selectedSoftware.some(s => s.id === soft.id)) return;

      selectedSoftware.push(soft);
      renderTags();
      renderHiddenInputs();

      // Update groupware options when software selection changes
      updateGroupwareBasedOnSoftware();
    }

    // Remove software
    function removeSoftware(softId) {
      selectedSoftware = selectedSoftware.filter(s => s.id !== softId);
      renderTags();
      renderHiddenInputs();
      renderDropdown(searchInput.value.toLowerCase());

      // Update groupware options when software is removed
      updateGroupwareBasedOnSoftware();
    }

    // Render selected tags
    function renderTags() {
      tagsContainer.innerHTML = '';

      if (selectedSoftware.length === 0) {
        const placeholder = document.createElement('div');
        placeholder.className = 'text-sm text-gray-400 dark:text-gray-500';
        placeholder.textContent = 'No categories selected';
        tagsContainer.appendChild(placeholder);
        return;
      }

      selectedSoftware.forEach(soft => {
        const tag = document.createElement('div');
        tag.className = 'inline-flex items-center gap-1 px-3 py-1 bg-blue-500 text-white rounded-full text-sm';
        tag.innerHTML = `
          <span>${soft.name}</span>
          <button type="button"
                  class="ml-1 hover:bg-blue-600 rounded-full p-0.5 transition-colors"
                  data-soft-id="${soft.id}">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </button>
        `;

        const removeBtn = tag.querySelector('button');
        removeBtn.addEventListener('click', () => removeSoftware(soft.id));

        tagsContainer.appendChild(tag);
      });
    }

    // Render hidden inputs for form submission
    function renderHiddenInputs() {
      hiddenInputsContainer.innerHTML = '';

      selectedSoftware.forEach(soft => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'product[software_ids][]';
        input.value = soft.id;
        hiddenInputsContainer.appendChild(input);
      });
    }

    // Update groupware options based on selected software
    function updateGroupwareBasedOnSoftware() {
      if (window.groupwareMultiSelect) {
        window.groupwareMultiSelect.updateAvailableOptions(selectedSoftware.map(s => s.id));
      }
    }

    // Initialize with empty state
    renderTags();
    renderHiddenInputs();
    
    // Trigger update for groupware options based on initial software selection
    if (selectedSoftware.length > 0) {
      updateGroupwareBasedOnSoftware();
    }
  }
</script>