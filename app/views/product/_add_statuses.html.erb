<% current_status = @product.statuses.first&.name %>

<%
  status_options = case current_status
  in nil | 'Pre Initiation'
    Status.where(name: ['End of Initiation']).pluck(:name, :id)
  in nil | 'End of Initiation'
    Status.where(name: ['Pre Development']).pluck(:name, :id)
  in nil | 'Pre Development'
    Status.where(name: ['End of Development']).pluck(:name, :id)
  in 'End of Development'
    Status.where(name: ['Pre Quality Assurance']).pluck(:name, :id)
  in nil | 'Pre Quality Assurance'
    Status.where(name: ['End Of Quality Assurance']).pluck(:name, :id)
  in nil | 'End Of Quality Assurance'
    Status.where(name: ['Pre User Acceptance Test']).pluck(:name, :id)
  in 'Pre User Acceptance Test'
    Status.where(name: ['End Of User Acceptance Test']).pluck(:name, :id)
  in 'End of User Acceptance Test'
    Status.where(name: ['Pre Deploy']).pluck(:name, :id)
  in 'Pre Deploy'
    Status.where(name: ['End Of Deploy']).pluck(:name, :id)
  in 'Pre Production'
    Status.where(name: ['End Of Production']).pluck(:name, :id)

                   else
                     []
                   end
%>

<% unless current_status == 'End Of Production' %>
  <%= form_with url: product_status_product_path(@product), local: true do %>
    <div class="relative flex flex-col gap-2">
      <%= select_tag :status_id,
                     options_for_select(status_options),
                     class: "border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500" %>
      <%= submit_tag "UPDATE", class: 'font-semibold bg-blue-500 hover:bg-blue-600 text-white p-3 rounded-lg mt-2' %>
    </div>
  <% end %>
<% end %>