<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 backdrop-blur-sm flex justify-center items-center z-50" style="background-color: rgba(0, 0, 0, 0.5);">
    <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-xl w-full max-w-5xl relative max-h-[90vh] overflow-y-auto">
      <!-- Close Button -->
      <%= link_to "X", product_index_path, data: {
        turbo_frame: "_top"
      }, class: "absolute top-3 right-3 text-xl font-bold text-gray-500 hover:text-gray-700 dark:text-gray-300 dark:hover:text-gray-100" %>
      <!-- Header -->
      <h2 class="text-2xl font-semibold text-gray-800 dark:text-gray-100 mb-6">Add new Project</h2>

      <%= form_with model: @product, url: product_index_url, method: :post, data: { turbo: false }, local: true, html: { multipart: true } do |f| %>
        <div class="space-y-6">
          <!-- Error Messages -->
          <% if @product.errors.any? %>
            <div id="error_explanation" class="bg-red-50 dark:bg-red-900/10 p-4 rounded-lg">
              <h2 class="text-red-600 dark:text-red-400 font-medium mb-2"><%= pluralize(@product.errors.count, "error") %> prohibited this project from being saved:</h2>
              <ul class="list-disc list-inside text-red-500 dark:text-red-400">
                <% @product.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <!-- Client Name -->
          <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
            <div class="relative z-0 w-full mb-6 group">
              <%= f.label :software, ('Client*'), class: "capitalize block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
              <%= f.collection_select :client_id, Client.all, :id, :name, { prompt: "Select Client" }, class: "border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", required: true %>
            </div>
          </div>
          <!-- Project Category and Sub Category -->
          <div class="space-y-4">
            <!-- Project Category -->
            <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
              <div class="relative z-0 w-full mb-6 group">
                <%= f.label :categories, ('Project Category*'), class: "capitalize block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>

                <!-- Selected Tags Display -->
                <div id="selected-software-tags" class="flex flex-wrap gap-2 mb-2 min-h-[2rem]"></div>

                <!-- Search Input -->
                <div class="relative">
                  <input type="text"
                         id="software-search-input"
                         placeholder="Search and select categories..."
                         autocomplete="off"
                         class="border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 bg-white dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">

                  <!-- Dropdown Results -->
                  <div id="software-dropdown"
                       class="absolute z-50 w-full mt-1 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg shadow-lg max-h-60 overflow-y-auto hidden">
                    <ul id="software-results" class="py-1"></ul>
                  </div>
                </div>

                <!-- Hidden Inputs for Form Submission -->
                <div id="software-hidden-inputs"></div>
              </div>
            </div>

            <!-- Sub Category -->
            <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
              <div class="relative z-0 w-full mb-6 group">
                <%= f.label :categories, ('Sub Category*'), class: "capitalize block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>

                <!-- Selected Tags Display -->
                <div id="selected-groupware-tags" class="flex flex-wrap gap-2 mb-2 min-h-[2rem]"></div>

                <!-- Search Input -->
                <div class="relative">
                  <input type="text"
                         id="groupware-search-input"
                         placeholder="Select categories first..."
                         autocomplete="off"
                         disabled
                         class="border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500 disabled:opacity-50 disabled:cursor-not-allowed">

                  <!-- Dropdown Results -->
                  <div id="groupware-dropdown"
                       class="absolute z-50 w-full mt-1 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg shadow-lg max-h-60 overflow-y-auto hidden">
                    <ul id="groupware-results" class="py-1"></ul>
                  </div>
                </div>

                <!-- Hidden Inputs for Form Submission -->
                <div id="groupware-hidden-inputs"></div>
              </div>
            </div>
          </div>


          <!-- Assignee -->
          <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
            <div class="relative z-0 w-full mb-6 group">
              <%= f.label :Assignee, ('Project Lead*'), class: "capitalize block mb-2 text-sm font-medium text-gray-900 dark:text-white"  %>
              <%= f.select :user_id, User.with_agent_project_manager_role.order(:first_name, :last_name).map { |user| [user.name, user.id] }, {}, class: "border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: 'Assign User', required: true %>
            </div>
          </div>

          <!-- Attachments Section -->
          <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
            <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">Attachments (PDF/DOC)</h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Add Document -->
              <div class="relative z-0 w-full group">
                <!-- Documents Field (use :documents with multiple: true for ActiveStorage) -->
                <div id="documents-container">
                  
                </div>
                <button type="button" id="add-document-button" class="mt-4 p-2 bg-blue-500 text-white rounded">Add Document(s)</button>
              </div>
            </div>
          </div>

          <!-- Dates and Budget -->
          <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <!-- Start Date -->
              <div class="relative z-0 w-full group">
                <%= f.label :start_date, 'Start Date*', class: "capitalize block mb-2 text-sm font-medium text-gray-900 dark:text-white"  %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                    <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z"/>
                    </svg>
                  </div>
                  <%= f.date_field :start_date, class: "border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full pl-10 p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", required: true %>
                </div>
              </div>

              <!-- End Date -->
              <div class="relative z-0 w-full group">
                <%= f.label :end_date, 'End Date*', class: "capitalize block mb-2 text-sm font-medium text-gray-900 dark:text-white"  %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                    <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z"/>
                    </svg>
                  </div>
                  <%= f.date_field :end_date, class: "border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full pl-10 p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", required: true %>
                </div>
              </div>

              <!-- Budget -->
              <div class="relative z-0 w-full group">
                <%= f.label :budget, ('Budget*'), class: "capitalize block mb-2 text-sm font-medium text-gray-900 dark:text-white"  %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                    <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 11 20">
                      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1.75 15.363a4.954 4.954 0 0 0 2.638 1.574c2.345.572 4.653-.434 5.155-2.247.502-1.813-1.313-3.79-3.657-4.364-2.344-.574-4.16-2.551-3.658-4.364.502-1.813 2.81-2.818 5.155-2.246A4.97 4.97 0 0 1 10 5.264M6 17.097v1.82m0-17.5v2.138"/>
                    </svg>
                  </div>
                  <%= f.number_field :budget, class: "border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full pl-10 p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: '0.00', required: true %>
                </div>
              </div>
            </div>
          </div>

          <!-- Milestones -->
          <div id="milestones-container">
            <!-- Milestones will be added here dynamically -->
          </div>
          <button type="button" id="add-milestone-button" class="mt-4 p-2 bg-blue-500 text-white rounded">Add Milestone</button>
          

          <!-- Description -->
          <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
            <div class="relative z-0 w-full group">
              <%= f.label :title, ('Project Description*'), class: "capitalize block mb-2 text-sm font-medium text-gray-900 dark:text-white"  %>
              <div data-controller="text-limit" data-text-limit-limit-value="3000">
                <p class="text-sm text-gray-500 dark:text-gray-400 mb-2" id="char-count">0/3000</p>
                <%= f.rich_text_area :content, id: "content",
                                   data: { text_limit_target: "content" },
                                   class: "min-h-[200px] border border-gray-300 rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-white #{'border-red-500' if @product.errors[:content].any?}",
                                   required: true %>
                <% if @product.errors[:content].any? %>
                  <div class="text-red-500 text-sm mt-2"><%= @product.errors[:content].join(', ') %></div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Buttons -->
          <div class="flex justify-end space-x-4">
            <%= f.submit "Save Draft", name: "commit", value: "draft", class: "px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-2 focus:ring-blue-700 focus:text-blue-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700" %>
            <%= f.submit "Create Project", name: "commit", value: "create", class: "px-4 py-2 text-sm font-medium text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<script>
  // Run in Turbo frames too
  document.addEventListener('turbo:load', initProjectForm);
  document.addEventListener('turbo:frame-load', initProjectForm);

  function initProjectForm() {
    const container = document.getElementById('milestones-container');
    const addBtn = document.getElementById('add-milestone-button');
    if (!container || !addBtn) return;

    // Avoid duplicate listeners from Turbo by cloning nodes
    const freshAddBtn = addBtn.cloneNode(true);
    addBtn.replaceWith(freshAddBtn);

    // Master list of statuses from Rails (id, name) — safe JSON
    const STATUSES = <%= raw Status.where(name: ['Pre Initiation','End Of Initiation','Pre Development','End Of Development','Pre User Acceptance Test','End Of User Acceptance Test','Pre Pilot','End Of Pilot','Pre Quality Assurance','End Of Quality Assurance','Pre Deploy','End Of Deploy','Pre Production', 'End Of Production']).pluck(:id,:name).to_json %>;

    // Add rowr
    freshAddBtn.addEventListener('click', () => {
      addMilestoneRow(container);
      syncAllStatusSelects(container, STATUSES);
      enforceAllPercentageLimits(container);
    });

    // Remove row (delegate)
    container.addEventListener('click', (e) => {
      const btn = e.target.closest('.remove-milestone');
      if (!btn) return;
      e.preventDefault();
      btn.closest('.milestone-field').remove();
      syncAllStatusSelects(container, STATUSES);
      enforceAllPercentageLimits(container);
    });

    // Status change → re-sync option sets
    container.addEventListener('change', (e) => {
      if (e.target.matches('.status-select')) {
        syncAllStatusSelects(container, STATUSES);
      }
    });

    // Percentage typing → clamp + recalc amount + refresh max limits
    container.addEventListener('input', (e) => {
      if (e.target.matches('.percentage-input')) {
        clampPercentageForInput(container, e.target);
        updateAmountForInput(e.target);
        enforceAllPercentageLimits(container);
      }
    });

    // Recompute amounts when budget changes
    const budgetInput = document.getElementById('product_budget');
    if (budgetInput) {
      const freshBudget = budgetInput.cloneNode(true);
      budgetInput.replaceWith(freshBudget);
      freshBudget.addEventListener('input', () => {
        container.querySelectorAll('.percentage-input').forEach(updateAmountForInput);
      });
    }

    // Documents UI (kept, with stable ids)
    wireDocumentsUI();

    // Char counter (kept)
    wireCharCounter();

    // Initialize BOTH multi-selects - groupware first to set up the global reference
    initGroupwareMultiSelect();
    initSoftwareMultiSelect();
  }

  // ---------- Milestones helpers ----------
  function addMilestoneRow(container) {
    const timestamp = Date.now();
    const row = document.createElement('div');
    row.className = 'milestone-field grid grid-cols-4 gap-4 mb-4 p-4 bg-gray-100 dark:bg-gray-800 rounded-lg';
    row.id = `milestone-${timestamp}`;

    row.innerHTML = `
      <div>
        <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Status</label>
        <select name="product[milestones_attributes][${timestamp}][status_id]"
                class="status-select bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">
          <!-- options injected by syncAllStatusSelects -->
        </select>
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Percentage</label>
        <input type="number" step="0.01" min="0"
               name="product[milestones_attributes][${timestamp}][percentage]"
               class="percentage-input bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Amount</label>
        <input type="text" readonly
               class="amount-display bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
      </div>

      <div class="flex items-end">
        <input type="hidden" name="product[milestones_attributes][${timestamp}][_destroy]" value="false">
        <button type="button"
                class="mt-4 p-2 bg-red-600 hover:bg-red-800 text-white rounded remove-milestone text-sm font-medium">
          Remove
        </button>
      </div>
    `;
    container.appendChild(row);
  }

  // Build options list: include prompt + full statuses minus exclusions, but keep current
  function buildOptionsFragment(statuses, keepId, excludeIds) {
    const frag = document.createDocumentFragment();
    const prompt = document.createElement('option');
    prompt.value = '';
    prompt.textContent = 'Select milestone…';
    frag.appendChild(prompt);

    statuses.forEach(([id, name]) => {
      const idStr = String(id);
      if (idStr === String(keepId) || !excludeIds.includes(idStr)) {
        const opt = document.createElement('option');
        opt.value = idStr;
        opt.textContent = name;
        frag.appendChild(opt);
      }
    });
    return frag;
  }

  // Remove already-chosen statuses from other selects; restore on change/remove
  function syncAllStatusSelects(container, statuses) {
    const selects = Array.from(container.querySelectorAll('.status-select'));
    const chosenByOther = (self) =>
      selects.filter(s => s !== self).map(s => s.value).filter(Boolean);

    selects.forEach(select => {
      const current = select.value || '';
      const exclude = chosenByOther(select).map(String);
      select.innerHTML = '';
      select.appendChild(buildOptionsFragment(statuses, current, exclude));
      // Restore value if still allowed
      if ([...select.options].some(o => o.value === current)) {
        select.value = current;
      } else {
        select.value = '';
      }
    });
  }

  // Clamp current input so total never exceeds 100; update its max to remainder
  function clampPercentageForInput(container, input) {
    const inputs = Array.from(container.querySelectorAll('.percentage-input'));
    const othersTotal = inputs.filter(i => i !== input)
                              .reduce((s, i) => s + (parseFloat(i.value) || 0), 0);
    const allowed = Math.max(0, 100 - othersTotal);
    input.max = allowed.toFixed(2);

    let val = parseFloat(input.value) || 0;
    if (val > allowed) {
      val = allowed;
      input.value = allowed.toFixed(2);
    }
  }

  // After any change, make sure every input respects its personal remainder cap
  function enforceAllPercentageLimits(container) {
    const inputs = Array.from(container.querySelectorAll('.percentage-input'));
    inputs.forEach(inp => {
      const others = inputs.filter(i => i !== inp).reduce((s, i) => s + (parseFloat(i.value) || 0), 0);
      const allowed = Math.max(0, 100 - others);
      inp.max = allowed.toFixed(2);
      if ((parseFloat(inp.value) || 0) > allowed) {
        inp.value = allowed.toFixed(2);
        updateAmountForInput(inp);
      }
    });
  }

  // Amount = budget * percentage / 100
  function updateAmountForInput(input) {
    const budget = parseFloat(document.getElementById('product_budget')?.value) || 0;
    const pct = parseFloat(input.value) || 0;
    const amount = (budget * pct) / 100;
    const out = input.closest('.milestone-field').querySelector('.amount-display');
    if (out) out.value = amount.toFixed(2);
  }

  // ---------- Documents (kept) ----------
  function wireDocumentsUI() {
    const addDocBtn = document.getElementById('add-document-button');
    const docsContainer = document.getElementById('documents-container');
    if (!addDocBtn || !docsContainer) return;

    const freshBtn = addDocBtn.cloneNode(true);
    addDocBtn.replaceWith(freshBtn);

    freshBtn.addEventListener('click', function () {
      const timestamp = Date.now();
      const wrap = document.createElement('div');
      wrap.classList.add('document-field', 'flex', 'flex-col', 'mb-4', 'p-3', 'border', 'rounded');
      wrap.id = `document-${timestamp}`;

      wrap.innerHTML = `
        <label class="block mb-1 text-sm font-medium">Document Name</label>
        <input type="text" name="product[documents_attributes][${timestamp}][name]" class="border rounded-lg p-2 mb-2" placeholder="Document Name">
        <label class="block mb-1 text-sm font-medium">Upload File</label>
        <input type="file" name="product[documents_attributes][${timestamp}][file]" class="border rounded-lg p-2">
        <a href="#" class="remove-document text-red-500 mt-2 block" data-id="document-${timestamp}">Remove</a>
      `;
      docsContainer.appendChild(wrap);
    });

    document.addEventListener('click', (e) => {
      if (e.target.classList.contains('remove-document')) {
        e.preventDefault();
        const id = e.target.getAttribute('data-id');
        document.getElementById(id)?.remove();
      }
    });
  }

  // ---------- Character counter (kept) ----------
  function wireCharCounter() {
    const contentField = document.querySelector('[data-text-limit-target="content"]');
    const charCount = document.getElementById('char-count');
    if (!contentField || !charCount) return;

    const update = () => {
      const length = contentField.textContent.length;
      charCount.textContent = `${length}/3000`;
      if (length > 3000) {
        charCount.classList.add('text-red-500');
        charCount.classList.remove('text-gray-500', 'dark:text-gray-400');
      } else {
        charCount.classList.remove('text-red-500');
        charCount.classList.add('text-gray-500', 'dark:text-gray-400');
      }
    };

    contentField.addEventListener('input', update);
    update();
  }

  // ---------- Groupware Multi-Select with Search (Initialize FIRST) ----------
  function initGroupwareMultiSelect() {
    const searchInput = document.getElementById('groupware-search-input');
    const dropdown = document.getElementById('groupware-dropdown');
    const resultsContainer = document.getElementById('groupware-results');
    const tagsContainer = document.getElementById('selected-groupware-tags');
    const hiddenInputsContainer = document.getElementById('groupware-hidden-inputs');

    if (!searchInput || !dropdown || !resultsContainer) return;

    // All groupware data with their software_id mapping
    const allGroupware = <%= raw Groupware.all.map { |g| { id: g.id, name: g.name, software_id: g.software_id } }.to_json %>;
    let selectedGroupware = [];
    let availableGroupware = [];

    // Update available groupware based on selected software IDs
    function updateAvailableOptions(softwareIds) {
      if (softwareIds.length === 0) {
        availableGroupware = [];
        searchInput.disabled = true;
        searchInput.placeholder = 'Select categories first...';

        // Clear selections when no software is selected
        selectedGroupware = [];
        renderTags();
        renderHiddenInputs();
      } else {
        availableGroupware = allGroupware.filter(gw =>
          softwareIds.includes(gw.software_id)
        );
        searchInput.disabled = false;
        searchInput.placeholder = 'Search and select sub-categories...';

        // Remove groupware that no longer belongs to selected software
        selectedGroupware = selectedGroupware.filter(gw =>
          availableGroupware.some(ag => ag.id === gw.id)
        );
        renderTags();
        renderHiddenInputs();
      }

      // Clear and hide dropdown
      dropdown.classList.add('hidden');
      searchInput.value = '';
    }

    // Show dropdown on focus
    searchInput.addEventListener('focus', () => {
      if (!searchInput.disabled) {
        renderDropdown('');
        dropdown.classList.remove('hidden');
      }
    });

    // Search as user types
    searchInput.addEventListener('input', (e) => {
      if (!searchInput.disabled) {
        const query = e.target.value.toLowerCase();
        renderDropdown(query);
        dropdown.classList.remove('hidden');
      }
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.add('hidden');
      }
    });

    // Render dropdown options
    function renderDropdown(query) {
      resultsContainer.innerHTML = '';

      const filtered = availableGroupware.filter(gw => {
        const isSelected = selectedGroupware.some(s => s.id === gw.id);
        const matchesQuery = gw.name.toLowerCase().includes(query);
        return !isSelected && matchesQuery;
      });

      if (filtered.length === 0) {
        const noResults = document.createElement('li');
        noResults.className = 'px-4 py-2 text-sm text-gray-500 dark:text-gray-400';
        noResults.textContent = selectedGroupware.length === availableGroupware.length
          ? 'All sub-categories selected'
          : availableGroupware.length === 0
            ? 'No sub-categories available'
            : 'No matching sub-categories';
        resultsContainer.appendChild(noResults);
        return;
      }

      filtered.forEach(gw => {
        const li = document.createElement('li');
        li.className = 'px-4 py-2 hover:bg-green-500 hover:text-white cursor-pointer text-sm text-gray-900 dark:text-white transition-colors';
        li.textContent = gw.name;
        li.addEventListener('click', () => {
          addGroupware(gw);
          searchInput.value = '';
          renderDropdown('');
          searchInput.focus();
        });
        resultsContainer.appendChild(li);
      });
    }

    // Add selected groupware
    function addGroupware(gw) {
      if (selectedGroupware.some(s => s.id === gw.id)) return;

      selectedGroupware.push(gw);
      renderTags();
      renderHiddenInputs();
    }

    // Remove groupware
    function removeGroupware(gwId) {
      selectedGroupware = selectedGroupware.filter(s => s.id !== gwId);
      renderTags();
      renderHiddenInputs();
      renderDropdown(searchInput.value.toLowerCase());
    }

    // Render selected tags
    function renderTags() {
      tagsContainer.innerHTML = '';

      if (selectedGroupware.length === 0) {
        const placeholder = document.createElement('div');
        placeholder.className = 'text-sm text-gray-400 dark:text-gray-500';
        placeholder.textContent = searchInput.disabled
          ? 'Select categories first'
          : 'No sub-categories selected';
        tagsContainer.appendChild(placeholder);
        return;
      }

      selectedGroupware.forEach(gw => {
        const tag = document.createElement('div');
        tag.className = 'inline-flex items-center gap-1 px-3 py-1 bg-green-500 text-white rounded-full text-sm';
        tag.innerHTML = `
          <span>${gw.name}</span>
          <button type="button"
                  class="ml-1 hover:bg-green-600 rounded-full p-0.5 transition-colors"
                  data-gw-id="${gw.id}">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </button>
        `;

        const removeBtn = tag.querySelector('button');
        removeBtn.addEventListener('click', () => removeGroupware(gw.id));

        tagsContainer.appendChild(tag);
      });
    }

    // Render hidden inputs for form submission
    function renderHiddenInputs() {
      hiddenInputsContainer.innerHTML = '';

      selectedGroupware.forEach(gw => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'product[groupware_ids][]';
        input.value = gw.id;
        hiddenInputsContainer.appendChild(input);
      });
    }

    // Initialize with empty state
    renderTags();

    // Expose the update function globally so software select can trigger it
    window.groupwareMultiSelect = {
      updateAvailableOptions: updateAvailableOptions
    };
  }

  // ---------- Software Multi-Select with Search ----------
  function initSoftwareMultiSelect() {
    const searchInput = document.getElementById('software-search-input');
    const dropdown = document.getElementById('software-dropdown');
    const resultsContainer = document.getElementById('software-results');
    const tagsContainer = document.getElementById('selected-software-tags');
    const hiddenInputsContainer = document.getElementById('software-hidden-inputs');

    if (!searchInput || !dropdown || !resultsContainer) return;

    // Software data from Rails
    const allSoftware = <%= raw Software.all.map { |s| { id: s.id, name: s.name } }.to_json %>;
    let selectedSoftware = [];

    // Show dropdown on focus
    searchInput.addEventListener('focus', () => {
      renderDropdown('');
      dropdown.classList.remove('hidden');
    });

    // Search as user types
    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase();
      renderDropdown(query);
      dropdown.classList.remove('hidden');
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.add('hidden');
      }
    });

    // Render dropdown options
    function renderDropdown(query) {
      resultsContainer.innerHTML = '';

      const filtered = allSoftware.filter(soft => {
        const isSelected = selectedSoftware.some(s => s.id === soft.id);
        const matchesQuery = soft.name.toLowerCase().includes(query);
        return !isSelected && matchesQuery;
      });

      if (filtered.length === 0) {
        const noResults = document.createElement('li');
        noResults.className = 'px-4 py-2 text-sm text-gray-500 dark:text-gray-400';
        noResults.textContent = selectedSoftware.length === allSoftware.length
          ? 'All categories selected'
          : 'No matching categories';
        resultsContainer.appendChild(noResults);
        return;
      }

      filtered.forEach(soft => {
        const li = document.createElement('li');
        li.className = 'px-4 py-2 hover:bg-blue-500 hover:text-white cursor-pointer text-sm text-gray-900 dark:text-white transition-colors';
        li.textContent = soft.name;
        li.addEventListener('click', () => {
          addSoftware(soft);
          searchInput.value = '';
          renderDropdown('');
          searchInput.focus();
        });
        resultsContainer.appendChild(li);
      });
    }

    // Add selected software
    function addSoftware(soft) {
      if (selectedSoftware.some(s => s.id === soft.id)) return;

      selectedSoftware.push(soft);
      renderTags();
      renderHiddenInputs();

      // Update groupware options when software selection changes
      updateGroupwareBasedOnSoftware();
    }

    // Remove software
    function removeSoftware(softId) {
      selectedSoftware = selectedSoftware.filter(s => s.id !== softId);
      renderTags();
      renderHiddenInputs();
      renderDropdown(searchInput.value.toLowerCase());

      // Update groupware options when software is removed
      updateGroupwareBasedOnSoftware();
    }

    // Render selected tags
    function renderTags() {
      tagsContainer.innerHTML = '';

      if (selectedSoftware.length === 0) {
        const placeholder = document.createElement('div');
        placeholder.className = 'text-sm text-gray-400 dark:text-gray-500';
        placeholder.textContent = 'No categories selected';
        tagsContainer.appendChild(placeholder);
        return;
      }

      selectedSoftware.forEach(soft => {
        const tag = document.createElement('div');
        tag.className = 'inline-flex items-center gap-1 px-3 py-1 bg-blue-500 text-white rounded-full text-sm';
        tag.innerHTML = `
          <span>${soft.name}</span>
          <button type="button"
                  class="ml-1 hover:bg-blue-600 rounded-full p-0.5 transition-colors"
                  data-soft-id="${soft.id}">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </button>
        `;

        const removeBtn = tag.querySelector('button');
        removeBtn.addEventListener('click', () => removeSoftware(soft.id));

        tagsContainer.appendChild(tag);
      });
    }

    // Render hidden inputs for form submission
    function renderHiddenInputs() {
      hiddenInputsContainer.innerHTML = '';

      selectedSoftware.forEach(soft => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'product[software_ids][]';
        input.value = soft.id;
        hiddenInputsContainer.appendChild(input);
      });
    }

    // Update groupware options based on selected software
    function updateGroupwareBasedOnSoftware() {
      if (window.groupwareMultiSelect) {
        window.groupwareMultiSelect.updateAvailableOptions(selectedSoftware.map(s => s.id));
      }
    }

    // Initialize with empty state
    renderTags();
  }
</script>
