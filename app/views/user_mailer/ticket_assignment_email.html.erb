
<p>Hello <%= @user.first_name %> <%= @user.last_name %>,</p>

<p>We would like to inform you that <%= [@assigned_user&.first_name, @assigned_user&.last_name].compact.join(' ').presence || @assigned_user&.email || 'Assigned user' %> has been assigned a new ticket regarding: <%= @ticket.unique_id %> assigned by <%= @current_user&.name || @current_user&.email || 'A user' %>.</p>

<p><strong>Ticket Details:</strong></p>
<ul>
  <li><strong>Service Desk Name:</strong> <span class="capitalize"><%= @project.title %></span></li>
  <li><strong>Ticket ID:</strong> <%= @ticket.unique_id %></li>
  <li><strong>Subject:</strong> <%= @ticket.subject %></li>
  <li><strong>Ticket Type:</strong> <%= @ticket.issue %></li>
  <li><strong>Priority:</strong> <%= @ticket.priority %></li>
  <li><strong>Description:</strong> <%= @ticket.content.to_plain_text.truncate(3000) %></li>
</ul>

<p>Click <a href="<%= @url %>">here</a> to view the ticket.</p>

<p>Best regards,</p>
<p><%= @current_user&.name || @current_user&.email || 'A user' %></p>
