<!-- Responsive layout with better spacing -->
<div class="px-2 sm:px-4 py-3 sm:py-4">
  <p class="text-left capitalize text-xs sm:text-sm"> 
    <%= truncate(product.content.to_plain_text, length: 50) %>
  </p>
</div>
<div class="grid grid-cols-3 gap-1 sm:gap-2 px-2 sm:px-4">
    <div class="p-1 sm:p-2">
      <h3 class="text-xs sm:text-sm font-light mb-1 sm:mb-2">Tasks</h3>
      <p class="text-xs sm:text-sm font-semibold">
        <%= product.tasks.joins(:statuses).where(statuses: { name: 'Closed' }).count %> / <%= product.tasks.count %>
      </p>
    </div>
    <div class="p-1 sm:p-2">
      <h3 class="text-xs sm:text-sm font-light mb-1 sm:mb-2">Budget</h3>
      <p class="text-xs sm:text-sm font-semibold">US <%= product&.budget || 0 %></p>
    </div>
    <div class="p-1 sm:p-2">
      <h3 class="text-xs sm:text-sm font-light mb-1 sm:mb-2">Due On</h3>
      <p class="text-xs sm:text-sm font-semibold"><%= product.end_date.strftime("%d-%b-%y") if product.end_date %></p>
    </div>
</div>