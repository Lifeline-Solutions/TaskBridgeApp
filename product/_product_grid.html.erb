<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-6 mt-6">
  <% @product.each do |product| %>
    <div class="bg-white dark:bg-gray-800 shadow-md rounded-lg transition-transform duration-200 hover:scale-105"
         style="cursor:pointer;"
         onclick="window.location='<%= product_path(product.id) %>'">
      <div>
        <div class="flex flex-col md:flex-row md:justify-between mb-2 bg-gray-200 dark:bg-gray-700 p-2 rounded-t-lg gap-2 md:gap-4 flex-wrap">
          <div class="flex flex-col md:flex-row items-start md:items-center gap-2 md:gap-4 flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-shrink-0">
              <% if product.image.present? %>
                <%= image_tag(product.image, class: 'w-8 h-8 rounded-md object-cover') %>
              <% else %>
                <%= image_tag 'default.png', class: 'w-8 h-8 rounded-md object-cover' %>
              <% end %>
            </div>
            <div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-2 min-w-0">
              <p class="text-sm font-semibold uppercase break-words max-w-xs truncate"><%= product.client.present? ? product.client.name : 'No Client Assigned' %></p>
              <span class="hidden md:inline">-</span>
              <p class="text-sm font-semibold capitalize break-words max-w-xs truncate">
                <%= product.groupwares.map(&:name).join(', ') %>
              </p>
            </div>
          </div>
          <div class="flex items-center justify-between md:justify-end gap-2 mt-2 md:mt-0 flex-shrink-0">
            <div class="rounded-full border border-2 p-2 border-white bg-white dark:bg-gray-700 min-w-[70px] text-center">
              <p class="text-sm font-semibold truncate"><%= product.statuses.first&.name %></p>
            </div>
            <% if current_user.has_role?(:admin) && can?(:edit, product) %>
              <div class="flex justify-end">
                <%= link_to edit_product_path(product), 
                      class: "p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-500 dark:text-gray-400",
                      data: { turbo: false } do %>
                  <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 3.487a2.25 2.25 0 1 1 3.182 3.182L7.5 19.213l-4.182.545a.75.75 0 0 1-.83-.83l.545-4.182 12.829-12.829z" />
                  </svg>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
        <div>
          <%= render partial: 'product/task_budget' , locals: { product: product } %>
        </div>
      </div>
      <div class="p-2">
        <hr>
      </div>


      <div class="p-2">
        <!-- All users assigned to the product show first 5 only-->
        <%= render partial: 'product/user_list_index', locals: { product: product } %>
      </div>

      </div>
  <% end %>
</div>
<%= render partial: 'product/grid_pagination' %>