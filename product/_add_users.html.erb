<% if current_user.has_role?(:admin) || current_user.has_role?('project manager') %>
  <div>
    <h4 class="font-medium text-gray-800 dark:text-gray-200 mb-3">Add User</h4>
    <%= form_with url: add_user_product_path(@product), data: { turbo: false }, class: "space-y-3" do %>
      <div>
        <label for="searchAgentUser" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Select User</label>
        <div class="relative space-y-2">
          <input type="text" id="searchAgentUser" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-600 dark:border-gray-500 dark:text-gray-200 text-sm" placeholder="Search User..." onkeyup="filterAgentUserDropdown()">

          <div id="agentUserDropdown" class="hidden absolute w-full bg-white dark:bg-gray-600 border rounded mt-1 shadow-md max-h-40 overflow-y-auto z-10">
            <% User.with_agent_role.where.not(id: @product.users.pluck(:id)).distinct.order(:first_name).each do |user| %>
              <div class="dropdown-item px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer" data-user-id="<%= user.id %>" onclick="selectAgentUser(this)">
                <%= user.name %>
              </div>
            <% end %>
          </div>

          <input type="hidden" id="selectedAgentUserId" name="user_id" required>
        </div>
      </div>
      <div>
        <%= submit_tag "Add User", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-blue-700 dark:hover:bg-blue-600" %>
      </div>
    <% end %>
  </div>
<% end %>

<script>
  function filterAgentUserDropdown() {
    let input = document.getElementById("searchAgentUser").value.toLowerCase();
    let dropdown = document.getElementById("agentUserDropdown");
    let items = dropdown.getElementsByClassName("dropdown-item");

    dropdown.classList.remove("hidden");

    let hasMatch = false;
    for (let item of items) {
      let text = item.textContent.toLowerCase();
      if (text.includes(input)) {
        item.style.display = "block";
        hasMatch = true;
      } else {
        item.style.display = "none";
      }
    }

    if (!hasMatch) {
      dropdown.classList.add("hidden");
    }
  }

  function selectAgentUser(element) {
    let userName = element.textContent.trim();
    let userId = element.getAttribute("data-user-id");

    let inputField = document.getElementById("searchAgentUser");
    inputField.value = userName;
    inputField.style.paddingRight = "12px";
    inputField.style.overflow = "visible";

    document.getElementById("selectedAgentUserId").value = userId;
    document.getElementById("agentUserDropdown").classList.add("hidden");
  }

  document.addEventListener("click", function(event) {
    let dropdown = document.getElementById("agentUserDropdown");
    let searchInput = document.getElementById("searchAgentUser");

    if (!searchInput.contains(event.target) && !dropdown.contains(event.target)) {
      dropdown.classList.add("hidden");
    }
  });
</script>
