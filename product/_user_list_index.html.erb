<div class="flex flex-wrap gap-1 sm:gap-2 items-center">
  <% if product.users.any? %>
    <% product.users.first(5).each do |user| %>
      <% if user.profile_picture.attached? %>
        <%= image_tag user.profile_picture, class: 'w-8 h-8 sm:w-10 sm:h-10 rounded-md' %>
      <% elsif user.name_initials.present? %>
              <span class="w-8 h-8 sm:w-10 sm:h-10 inline-flex items-center justify-center px-2 sm:px-3 py-1 rounded-full text-xs sm:text-sm font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                <%= user.name_initials %>
              </span>
      <% else %>
        <%= image_tag 'default.png', class: 'w-8 h-8 sm:w-10 sm:h-10 rounded-full' %>
      <% end %>
    <% end %>
  <% else %>
    <p class="text-xs sm:text-sm">No users assigned to this product yet.</p>
  <% end %>
</div>