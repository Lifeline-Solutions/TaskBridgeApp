<% provide(:title, "Edit Product: #{@product.client.name}") %>

<div class="max-w-3xl xl:max-w-5xl 2xl:max-w-7xl mx-auto px-6 py-10 bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-800">
  <div class="mb-6 flex items-center">
    <%= link_to product_path, class: 'flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 font-semibold transition-all duration-150' do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Back
    <% end %>
  </div>
  <h2 class="text-3xl md:text-4xl xl:text-5xl font-extrabold text-gray-800 dark:text-white mb-10 text-center tracking-tight">
    Edit Product Details
  </h2>
  <%= form_with model: @product, url: product_path(@product), method: :patch, local: true, data: { turbo: false }, html: { class: "space-y-8" } do |f| %>
    <% if @product.errors.any? %>
      <div class="mb-4 text-red-600">
        <%= pluralize(@product.errors.count, "error") %> prevented this product from being saved:
        <ul>
          <% @product.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <%= f.label :client_id, 'Client Available*', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.collection_select :client_id, Client.all, :id, :name, { prompt: "Select Client" }, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" %>
      </div>
      <div>
        <%= f.label :image, 'Product Image', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.file_field :image, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" %>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <%= f.label :user_id, 'Assignee*', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.select :user_id, User.with_agent_project_manager_role.order(:first_name, :last_name).map { |u| [u.name, u.id] }, { prompt: 'Assign User' }, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" %>
      </div>
      <div>
        <%= f.label :budget, 'Budget*', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.number_field :budget, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500", required: true %>
        <% if @product.errors[:budget].any? %>
          <div class="text-red-500 text-sm"><%= @product.errors[:budget].join(', ') %></div>
        <% end %>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <%= f.label :software_ids, 'Product Categories *', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.collection_select :software_ids, Software.all, :id, :name, { prompt: "Select Product" }, { class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" } %>
      </div>
      <div>
        <%= f.label :groupware_ids, 'Sub Categories *', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.collection_select :groupware_ids, Groupware.all, :id, :name, { prompt: "Select Sub Product" }, { class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" } %>
      </div>
    </div>
    <div class="space-y-4">
      <h3 class="text-xl font-bold text-gray-800 dark:text-white">Milestones</h3>
      <div id="milestones-container">
        <% @product.milestones.each_with_index do |milestone, index| %>
          <div class="milestone-field grid grid-cols-1 md:grid-cols-5 gap-4 mb-4 p-4 bg-gray-100 dark:bg-gray-800 rounded-lg" id="milestone-<%= index %>">
            <div>
              <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Status</label>
              <%= f.select "milestones_attributes[#{index}][status_id]", Status.where(name: ['Development', 'User Acceptance Test', 'Pilot', 'Quality Assurance', 'Deploy', 'Production']).map { |s| [s.name, s.id] }, { selected: milestone.status_id }, class: "status-select bg-gray-50 border border-gray-300 dark:border-gray-700 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-2.5 dark:bg-gray-700 dark:placeholder-gray-400 dark:text-white" %>
            </div>
            <div>
              <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Percentage</label>
              <%= f.number_field "milestones_attributes[#{index}][percentage]", value: milestone.percentage, step: "0.01", class: "percentage-input bg-gray-50 border border-gray-300 dark:border-gray-700 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-2.5 dark:bg-gray-700 dark:placeholder-gray-400 dark:text-white", oninput: "calculateAmount(this, #{@product.budget || 0})" %>
            </div>
            <div>
              <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Amount</label>
              <input type="text" readonly value="<%= milestone.amount %>" class="amount-display bg-gray-50 border border-gray-300 dark:border-gray-700 text-gray-900 text-sm rounded-lg w-full p-2.5 dark:bg-gray-700 dark:text-white">
            </div>
            <div class="flex items-center">
              <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white mr-2">Paid</label>
              <%= f.check_box "milestones_attributes[#{index}][paid]", { checked: milestone.paid, disabled: true }, "true", "false" %>
            </div>
            <div class="flex items-end">
              <input type="hidden" name="product[milestones_attributes][<%= index %>][_destroy]" value="false">
              <button type="button" class="mt-4 p-2 bg-red-600 hover:bg-red-800 text-white rounded remove-milestone text-sm font-medium" onclick="this.closest('.milestone-field').remove()">Remove</button>
            </div>
          </div>
        <% end %>
      </div>
      <button type="button" id="add-milestone-button" class="mt-4 p-2 bg-blue-500 text-white rounded w-full md:w-auto">Add Milestone</button>
    </div>
    <div class="space-y-4">
      <h3 class="text-xl font-bold text-gray-800 dark:text-white">Attached Documents</h3>
      <div id="documents-container">
        <%= f.fields_for :documents do |doc| %>
          <div class="document-field mb-4">
            <%= doc.label :name, "Document Name", class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
            <%= doc.text_field :name, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 mb-2" %>
            <% if doc.object.file.attached? %>
              <p class="text-sm text-gray-600">Current File: <%= link_to doc.object.file.filename.to_s, rails_blob_path(doc.object.file, disposition: "attachment"), class: "text-blue-500 underline" %></p>
            <% end %>
            <%= doc.label :file, "Upload File", class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
            <%= doc.file_field :file, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500" %>
            <%= doc.hidden_field :_destroy %>
            <%= link_to "Remove", "#", class: "remove-document text-red-500", data: { action: "click->form#removeDocument" } %>
          </div>
        <% end %>
      </div>
      <button type="button" id="add-document-button" class="p-2 bg-blue-500 text-white rounded mb-4 w-full md:w-auto">Add Document</button>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <%= f.label :start_date, 'Start Date*', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.date_field :start_date, required: true, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 mb-4" %>
      </div>
      <div>
        <%= f.label :end_date, 'End Date*', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
        <%= f.date_field :end_date, required: true, class: "border border-gray-300 dark:border-gray-700 rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-4 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 mb-4" %>
      </div>
    </div>
    <div>
      <%= f.label :content, 'Subject*', class: "block mb-2 text-lg font-semibold text-gray-700 dark:text-gray-200" %>
      <div data-controller="text-limit" data-text-limit-limit-value="3000">
        <p id="char-count">0/3000</p>
        <%= f.rich_text_area :content, id: "content", data: { text_limit_target: "content" }, class: 'min-h-[300px]' %>
      </div>
    </div>
    <div class="flex flex-col md:flex-row justify-center items-center mt-10 gap-6">
      <%= f.submit "Update Product", class: 'w-full md:w-auto h-14 bg-gradient-to-r from-blue-600 to-indigo-700 hover:from-blue-700 hover:to-indigo-800 p-4 rounded-xl font-bold text-xl text-white shadow-xl transition-all duration-200' %>
    </div>
  <% end %>
</div>

<style>
@media (max-width: 640px) {
  #milestones-container, #documents-container {
    overflow-x: auto;
    padding-bottom: 1rem;
  }
  .milestone-field, .document-field {
    min-width: 280px;
  }
  .h-14 {
    height: 2.5rem !important;
  }
}
@media (max-width: 400px) {
  #milestones-container, #documents-container {
    font-size: 0.9rem;
  }
}
</style>

<script>
// ...existing code...
</script>
<script>
  // Add Milestone Button
  document.getElementById('add-milestone-button').addEventListener('click', function () {
    const container = document.getElementById('milestones-container');
    const timestamp = Date.now();
    const budget = document.getElementById('product_budget').value || 0;

    const newField = document.createElement('div');
    newField.classList.add('milestone-field', 'grid', 'grid-cols-1', 'sm:grid-cols-4', 'gap-4', 'mb-4', 'p-4', 'bg-gray-100', 'dark:bg-gray-800', 'rounded-lg');
    newField.id = `milestone-${timestamp}`;

    newField.innerHTML = `
      <div>
        <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Status</label>
        <select name="product[milestones_attributes][${timestamp}][status_id]"
                class="status-select bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">
          <%= options_from_collection_for_select(
              Status.where(name: ['Pre Initiation','End Of Initiation','Pre Development','End Of Development','Pre User Acceptance Test','End Of User Acceptance Test','Pre Pilot','End Of Pilot','Pre Quality Assurance','End Of Quality Assurance','Pre Deploy','End Of Deploy','Pre Production', 'End Of Production']),
                :id,
                :name
              ) %>
        </select>
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Percentage</label>
        <input type="number" step="0.01"
              name="product[milestones_attributes][${timestamp}][percentage]"
              class="percentage-input bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
              oninput="calculateAmount(this, ${budget})">
      </div>

      <div>
        <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Amount</label>
        <input type="text" readonly
              class="amount-display bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
      </div>

      <div class="flex items-end">
        <input type="hidden" name="product[milestones_attributes][${timestamp}][_destroy]" value="false">
        <button type="button"
                class="mt-4 p-2 bg-red-600 hover:bg-red-800 text-white roundedremove-milestone text-sm font-medium"
                onclick="this.closest('.milestone-field').remove()">
          Remove
        </button>
      </div>
    `;

    container.appendChild(newField);
  });

  // Calculate amount function
  function calculateAmount(input, budget) {
    const percentage = parseFloat(input.value) || 0;
    const amountField = input.closest('.milestone-field').querySelector('.amount-display');
    const amount = (budget * percentage / 100).toFixed(2);
    amountField.value = amount;
  }

  document.getElementById('add-document-button').addEventListener('click', function () {
    const container = document.getElementById('documents-container');
    const index = Date.now(); // unique index
    const newField = document.createElement('div');
    newField.classList.add('document-field', 'mb-4');
    newField.innerHTML = `
      <label class="block mb-1">Document Name</label>
      <input type="text" name="product[documents_attributes][${index}][name]" class="border rounded p-2 w-full mb-2" placeholder="Document Name">
      <label class="block mb-1">Upload File</label>
      <input type="file" name="product[documents_attributes][${index}][file]" class="border rounded p-2 w-full">
      <input type="hidden" name="product[documents_attributes][${index}][_destroy]" value="false">
      <a href="#" class="remove-document text-red-500">Remove</a>
    `;
    container.appendChild(newField);
  });

  document.addEventListener('click', function (e) {
    if (e.target.classList.contains('remove-document')) {
      e.preventDefault();
      const field = e.target.closest('.document-field');
      const destroyField = field.querySelector('input[name*="[_destroy]"]');
      if (destroyField) {
        destroyField.value = '1';
        field.style.display = 'none';
      } else {
        field.remove();
      }
    }
  });
</script>
<style>
/* Responsive overflow for milestones & documents on small screens */
@media (max-width: 640px) {
  #milestones-container, #documents-container {
    overflow-x: auto;
    padding-bottom: 1rem;
  }
  .milestone-field, .document-field {
    min-width: 280px;
  }
}
</style>